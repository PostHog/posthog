                "src",
                "Cargo.toml",
                "$TURBO_ROOT$/rust/ai-research/replay-core-v4/src/**",
                "$TURBO_ROOT$/rust/ai-research/replay-core-v4/tests/**",
                "$TURBO_ROOT$/rust/ai-research/replay-core-v4/Cargo.toml",
                "$TURBO_ROOT$/rust/Cargo.toml",
                "$TURBO_ROOT$/rust/Cargo.lock"
            ]
        }
