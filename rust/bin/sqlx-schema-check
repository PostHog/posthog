#!/usr/bin/env bash
# Deploy-time check: waits until every sqlx migration version that the app image needs is
# applied, so new Rust code does not roll out against an older schema.
#
# Runs in the sqlx-migrate image (it has psql) as an Argo CD Sync hook before the app pods roll.
# The requirements file comes from the app image (see write-sqlx-requirements), so a rollback
# to an older image needs only the versions that the older image needs.
#
# Exit codes, the same as the Node schema check:
#   0  every required version is applied (or shadow mode, or no requirements file)
#   1  required versions are still missing, or recorded as failed, when the wait ends
#   2  the check cannot see the state: a database URL is not set, the file is malformed,
#      or psql fails on the last attempt
# In shadow mode the script logs the result that it would return, and exits 0.
#
# Environment:
#   SQLX_SCHEMA_CHECK_REQUIREMENTS      path of the requirements file
#   SQLX_SCHEMA_CHECK_MODE              shadow (default) or enforce
#   SQLX_SCHEMA_CHECK_APP               app name for the log line
#   SQLX_SCHEMA_CHECK_WAIT_SECONDS      total wait, default 540
#   SQLX_SCHEMA_CHECK_INTERVAL_SECONDS  pause between attempts, default 15
#   PERSONS_DATABASE_URL, BEHAVIORAL_COHORTS_DATABASE_URL, CYCLOTRON_NODE_DATABASE_URL,
#   FLAGS_READ_STORE_DATABASE_URL       the URL of each database that the file names
set -uo pipefail

REQUIREMENTS="${SQLX_SCHEMA_CHECK_REQUIREMENTS:-/shared/sqlx-requirements.txt}"
MODE="${SQLX_SCHEMA_CHECK_MODE:-shadow}"
APP="${SQLX_SCHEMA_CHECK_APP:-unknown}"
WAIT_SECONDS="${SQLX_SCHEMA_CHECK_WAIT_SECONDS:-540}"
INTERVAL_SECONDS="${SQLX_SCHEMA_CHECK_INTERVAL_SECONDS:-15}"

# Bound each psql call, so one slow database cannot use the whole wait.
export PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-5}"
export PGOPTIONS="${PGOPTIONS:--c statement_timeout=5000}"

STARTED_AT=$(date +%s)

url_variable() {
    case "$1" in
        persons) echo "PERSONS_DATABASE_URL" ;;
        behavioral-cohorts) echo "BEHAVIORAL_COHORTS_DATABASE_URL" ;;
        cyclotron-node) echo "CYCLOTRON_NODE_DATABASE_URL" ;;
        flags-read-store) echo "FLAGS_READ_STORE_DATABASE_URL" ;;
        *) return 1 ;;
    esac
}

json_list() {
    if [ "$#" -eq 0 ]; then
        echo "[]"
        return
    fi
    printf '%s\n' "$@" | sed 's/\\/\\\\/g; s/"/\\"/g; s/.*/"&"/' | paste -sd, - | sed 's/.*/[&]/'
}

# One JSON line per run, so the shadow evidence is one log query.
finish() {
    local result="$1" exit_code="$2"
    shift 2
    local elapsed=$(($(date +%s) - STARTED_AT))
    local final_exit="$exit_code"
    if [ "$MODE" != "enforce" ]; then
        final_exit=0
    fi
    printf '{"event":"sqlx_schema_check","app":"%s","mode":"%s","result":"%s","would_exit":%s,"elapsed_seconds":%s,"missing":%s,"errors":%s}\n' \
        "$APP" "$MODE" "$result" "$exit_code" "$elapsed" "$(json_list "${MISSING[@]}")" "$(json_list "${ERRORS[@]}")"
    exit "$final_exit"
}

MISSING=()
ERRORS=()

if [ ! -f "$REQUIREMENTS" ]; then
    # An image built before the requirements file existed. It rolls out as before.
    finish "no_requirements_file" 0
fi

if [ "$MODE" != "shadow" ] && [ "$MODE" != "enforce" ]; then
    ERRORS+=("SQLX_SCHEMA_CHECK_MODE must be shadow or enforce, got '$MODE'")
    MODE=enforce
    finish "error" 2
fi

DATABASES=$(grep -v '^#' "$REQUIREMENTS" | awk 'NF { print $1 }' | sort -u)
if grep -v '^#' "$REQUIREMENTS" | awk 'NF && (NF != 2 || $2 !~ /^[0-9]+$/) { bad = 1 } END { exit !bad }'; then
    ERRORS+=("malformed line in $REQUIREMENTS")
    finish "error" 2
fi

for database in $DATABASES; do
    if ! variable=$(url_variable "$database"); then
        ERRORS+=("unknown database '$database'")
    elif [ -z "${!variable:-}" ]; then
        # Unlike a missing table, a missing URL never means "not used": the image declares it.
        ERRORS+=("$variable is not set for database '$database'")
    fi
done
if [ "${#ERRORS[@]}" -gt 0 ]; then
    finish "error" 2
fi

check_once() {
    MISSING=()
    ERRORS=()
    local database variable rows required
    for database in $DATABASES; do
        variable=$(url_variable "$database")
        if ! rows=$(psql "${!variable}" -X -q -t -A -F ' ' -c "select version, success from _sqlx_migrations" 2>&1); then
            # A database that sqlx-migrate never ran on has no table yet: every version is missing.
            if [[ "$rows" == *'relation "_sqlx_migrations" does not exist'* ]]; then
                rows=""
            else
                ERRORS+=("$database: $(echo "$rows" | head -1)")
                continue
            fi
        fi
        required=$(awk -v db="$database" '!/^#/ && $1 == db { print $2 }' "$REQUIREMENTS" | sort -u)
        while read -r version; do
            [ -n "$version" ] || continue
            if echo "$rows" | grep -qx "$version t"; then
                continue
            fi
            if echo "$rows" | grep -qx "$version f"; then
                # sqlx-migrate stops at a failed migration until someone repairs it.
                MISSING+=("$database $version (recorded as failed)")
            else
                MISSING+=("$database $version")
            fi
        done <<< "$required"
    done
}

deadline=$((STARTED_AT + WAIT_SECONDS))
while true; do
    check_once
    if [ "${#ERRORS[@]}" -eq 0 ] && [ "${#MISSING[@]}" -eq 0 ]; then
        finish "satisfied" 0
    fi
    if [ $(($(date +%s) + INTERVAL_SECONDS)) -ge "$deadline" ]; then
        break
    fi
    sleep "$INTERVAL_SECONDS"
done

# An error wins over missing versions, because the check could not see that database.
if [ "${#ERRORS[@]}" -gt 0 ]; then
    finish "error" 2
fi
finish "missing" 1
