  "query": "\n        UPDATE posthog_persondistinctid\n        SET is_deleted = true, version = COALESCE(version, 0) + 1\n        WHERE team_id = $1 AND person_id = ANY($2) AND is_deleted = false\n        RETURNING person_id, distinct_id, version as \"version!\"\n        ",
