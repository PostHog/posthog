  "query": "/* service='personhog-identity', operation='merge_op_person_rows' */ \n        SELECT person_id, person_uuid, role, status, ordinal,\n               CASE WHEN role = $2 THEN sealed END as \"sealed: Value\"\n        FROM lifecycle_op_person\n        WHERE op_id = $1\n        ORDER BY ordinal\n        ",
