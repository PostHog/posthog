    "cases": [
        {
            "name": "product with nested offer and identifiers",
            "capturedDomIds": ["product-id", "person-id"],
            "input": {
                "@context": "http://schema.org/",
                "@type": "Product",
                "@id": "https://example.com/products/123#product-id",
                "name": "Camera",
                "email": "private@example.com",
                "private@example.com": {
                    "@type": "CustomMetadata",
                    "ratingValue": 4.5
                },
                "offers": {
                    "@type": "Offer",
                    "@id": "https://example.com/offers/1",
                    "price": 100,
                    "priceCurrency": "GBP",
                    "seller": {
                        "@type": "Person",
                        "@id": "#person-id",
                        "name": "Private name"
                    }
                }
            },
            "expected": {
                "@context": "https://schema.org",
                "@type": "Product",
                "@id": "product-id",
                "name": "Camera",
                "offers": {
                    "@type": "Offer",
                    "price": 100,
                    "priceCurrency": "GBP",
                    "seller": {
                        "@type": "Person",
                        "@id": "person-id"
                    }
                }
            }
        },
        {
            "name": "root graph with unknown entity type",
            "capturedDomIds": ["person-id"],
            "input": {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "WebSite",
                        "datePublished": "2026-08-25",
                        "email": "private@example.com",
                        "potentialAction": {
                            "@type": "SearchAction",
                            "actionStatus": "https://schema.org/PotentialActionStatus",
                            "target": "https://example.com/search?q=private"
                        }
                    },
                    {
                        "@type": "FAQPage",
                        "inLanguage": "en",
                        "text": "Private question and answer"
                    },
                    {
                        "@type": "Person",
                        "@id": "person-id",
                        "name": "Private name"
                    },
                    {
                        "@type": "PrivateType",
                        "ratingValue": 4.5,
                        "email": "private@example.com",
                        "customMetadata": {
                            "priceCurrency": "GBP"
                        }
                    },
                    "private@example.com"
                ]
            },
            "expected": {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "WebSite",
                        "datePublished": "2026-08-25",
                        "potentialAction": {
                            "@type": "SearchAction",
                            "actionStatus": "https://schema.org/PotentialActionStatus"
                        }
                    },
                    {
                        "@type": "FAQPage",
                        "inLanguage": "en"
                    },
                    {
                        "@type": "Person",
                        "@id": "person-id"
                    },
                    {
                        "@type": "PrivateType",
                        "ratingValue": 4.5
                    }
                ]
            }
        },
        {
            "name": "type arrays and scalar arrays",
            "capturedDomIds": [],
            "input": {
                "@context": "https://schema.org",
                "@type": ["https://schema.org/Product", "Car", "PrivateType", 42],
                "name": ["Camera", 2, true, null],
                "color": [
                    "black",
                    {
                        "value": "private"
                    }
                ]
            },
            "expected": {
                "@context": "https://schema.org",
                "@type": ["Product", "Car", "PrivateType"],
                "name": ["Camera", 2, true, null]
            }
        },
        {
            "name": "root and nested entity arrays",
            "capturedDomIds": ["person-id"],
            "input": [
                {
                    "@context": "https://schema.org",
                    "@type": "Product",
                    "name": "Camera",
                    "offers": [
                        {
                            "@type": "Offer",
                            "price": 100,
                            "email": "private@example.com"
                        },
                        {
                            "@type": "Person",
                            "@id": "person-id",
                            "name": "Private name"
                        }
                    ]
                },
                {
                    "@context": "https://schema.org",
                    "@type": "Organization",
                    "name": "Acme"
                }
            ],
            "expected": [
                {
                    "@context": "https://schema.org",
                    "@type": "Product",
                    "name": "Camera",
                    "offers": [
                        {
                            "@type": "Offer",
                            "price": 100
                        },
                        {
                            "@type": "Person",
                            "@id": "person-id"
                        }
                    ]
                },
                {
                    "@context": "https://schema.org",
                    "@type": "Organization",
                    "name": "Acme"
                }
            ]
        },
        {
            "name": "invalid schema context",
            "capturedDomIds": [],
            "input": {
                "@context": "https://example.com",
                "@type": "Product",
                "name": "Camera"
            },
            "expected": null
        },
        {
            "name": "BreadcrumbList with nested items",
            "capturedDomIds": ["person-id"],
            "input": {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Private label",
                        "item": {
                            "@type": "Product",
                            "name": "Camera",
                            "email": "private@example.com"
                        }
                    },
                    {
                        "@type": "Person",
                        "@id": "person-id",
                        "name": "Private name"
                    }
                ]
            },
            "expected": {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "item": {
                            "@type": "Product",
                            "name": "Camera"
                        }
                    },
                    {
                        "@type": "Person",
                        "@id": "person-id"
                    }
                ]
            }
        },
        {
            "name": "ItemList with nested items",
            "capturedDomIds": ["person-id"],
            "input": {
                "@context": "https://schema.org",
                "@type": "ItemList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Private label",
                        "item": {
                            "@type": "Product",
                            "name": "Camera",
                            "email": "private@example.com"
                        }
                    },
                    {
                        "@type": "Person",
                        "@id": "person-id",
                        "name": "Private name"
                    }
                ]
            },
            "expected": {
                "@context": "https://schema.org",
                "@type": "ItemList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "item": {
                            "@type": "Product",
                            "name": "Camera"
                        }
                    },
                    {
                        "@type": "Person",
                        "@id": "person-id"
                    }
                ]
            }
        },
        {
            "name": "offer catalog and service roots",
            "capturedDomIds": [],
            "input": [
                {
                    "@context": "https://schema.org",
                    "@type": "OfferCatalog",
                    "name": "Services",
                    "itemListElement": {
                        "@type": "Offer",
                        "price": 100,
                        "email": "private@example.com"
                    }
                },
                {
                    "@context": "https://schema.org",
                    "@type": "Service",
                    "name": "Installation",
                    "serviceType": "Installation",
                    "email": "private@example.com",
                    "provider": {
                        "@type": "EducationalOrganization",
                        "name": "Acme",
                        "telephone": "+44 0000 000000"
                    }
                }
            ],
            "expected": [
                {
                    "@context": "https://schema.org",
                    "@type": "OfferCatalog",
                    "name": "Services",
                    "itemListElement": {
                        "@type": "Offer",
                        "price": 100
                    }
                },
                {
                    "@context": "https://schema.org",
                    "@type": "Service",
                    "name": "Installation",
                    "serviceType": "Installation",
                    "provider": {
                        "@type": "EducationalOrganization",
                        "name": "Acme"
                    }
                }
            ]
        },
        {
            "name": "unallowlisted entity branch",
            "capturedDomIds": ["root-id", "child-id", "product-id", "reference-id"],
            "input": {
                "@context": "https://schema.org",
                "@type": "Product",
                "@id": "root-id",
                "name": "Camera",
                "privateRootValue": "private",
                "customChild": {
                    "@type": "CustomChild",
                    "@id": "child-id",
                    "privateChildValue": "private",
                    "nestedEntity": {
                        "@type": "Product",
                        "@id": "product-id",
                        "name": "Private product name",
                        "ratingValue": 4.5
                    },
                    "idOnlyNode": {
                        "@id": "reference-id",
                        "privateReferenceValue": "private"
                    }
                }
            },
            "expected": {
                "@context": "https://schema.org",
                "@type": "Product",
                "@id": "root-id",
                "name": "Camera"
            }
        },
        {
            "name": "PII-bearing entity types",
            "capturedDomIds": ["contact-id", "person-id", "address-id"],
            "input": [
                {
                    "@context": "https://schema.org",
                    "@type": "ContactPoint",
                    "@id": "contact-id",
                    "name": "Private name",
                    "email": "private@example.com",
                    "telephone": "+44 0000 000000"
                },
                {
                    "@context": "https://schema.org",
                    "@type": "Person",
                    "@id": "person-id",
                    "name": "Private name",
                    "email": "private@example.com"
                },
                {
                    "@context": "https://schema.org",
                    "@type": "PostalAddress",
                    "@id": "address-id",
                    "streetAddress": "Private address"
                }
            ],
            "expected": [
                {
                    "@context": "https://schema.org",
                    "@type": "ContactPoint",
                    "@id": "contact-id"
                },
                {
                    "@context": "https://schema.org",
                    "@type": "Person",
                    "@id": "person-id"
                },
                {
                    "@context": "https://schema.org",
                    "@type": "PostalAddress",
                    "@id": "address-id"
                }
            ]
        },
        {
            "name": "schema context without an entity",
            "capturedDomIds": [],
            "input": {
                "@context": "https://schema.org",
                "privateValue": "private"
            },
            "expected": null
        }
    ],
    "rawSourceCases": [
        {
            "name": "invalid JSON syntax",
            "source": "not json",
            "expected": null
        }
    ],
    "prototypeCases": [
        {
            "name": "inherited context",
            "inheritedProperties": {
                "@context": "https://schema.org",
                "@type": "Product",
                "@id": "inherited-id",
                "name": "Private name",
                "ratingValue": 5
            },
            "capturedDomIds": ["inherited-id"],
            "input": {
                "@type": "Product"
            },
            "expected": null
        },
        {
            "name": "inherited type",
