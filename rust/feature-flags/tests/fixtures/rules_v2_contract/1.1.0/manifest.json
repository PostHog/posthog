{
  "manifest_version": 1,
  "contract": {
    "name": "feature_flag_rules_v2",
    "version": "1.1.0",
    "config_version": 2
  },
  "corpus": {
    "version": "1.0.0",
    "config_version_locked": 1,
    "case_id_pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
    "published_versions_are_immutable": true,
    "expectation_change": "Any changed expected value requires a new corpus version and a review explanation."
  },
  "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "compatibility": {
    "published_versions_are_immutable": true,
    "patch": "Documentation or integrity-tool changes that do not change accepted configs or frozen literals.",
    "minor": "Additive fixtures or artifacts that do not change accepted configs or frozen literals.",
    "major": "Any change to accepted configs, rejected configs, or frozen literals."
  },
  "integrity": {
    "algorithm": "sha256",
    "index": "SHA256SUMS",
    "content": "raw_file_bytes",
    "entry_format": "<lowercase_hex_digest><two_spaces><relative_posix_path><line_feed>",
    "entry_order": "bytewise_path",
    "excluded_from_index": [
      "SHA256SUMS"
    ]
  },
