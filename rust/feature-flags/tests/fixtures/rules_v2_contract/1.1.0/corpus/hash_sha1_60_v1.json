{
  "corpus_version": "1.0.0",
  "algorithm": "sha1_60_v1",
  "definition": {
    "input": "UTF-8 bytes of prefix + identifier + salt concatenated with no separator and no escaping.",
    "identifier_truncation": "Resolved identifiers are truncated to the first 200 Unicode scalar values before hashing. Bytes and UTF-16 code units are not the unit.",
    "group_key_normalization": "Group keys that are JSON safe integers normalize to ordinary decimal strings. No Unicode normalization is applied to any identifier.",
    "digest": "SHA-1 of the input bytes.",
    "n": "The unsigned integer represented by the first 15 hexadecimal digest characters, equal to the first 60 digest bits. It is recorded as a decimal string because it exceeds the safe integer range of JSON consumers.",
    "scale": "0xFFFFFFFFFFFFFFF, which is 2^60 - 1.",
    "hash01": "binary64(n) / binary64(scale) using one IEEE-754 round-to-nearest-even division. binary64(scale) is exactly 2^60. Rounding the exact rational quotient once can differ in the last bit; vectors that differ record that alternative under hash01_if_quotient_rounded_once and it is not the contract value.",
    "rollout": "rollout_percentage of 100 includes every identifier without hashing. Otherwise the identifier is included when hash01 <= rollout_percentage / 100, with the division performed in binary64.",
    "holdout": "Legacy-era holdout membership uses prefix holdout-, an empty salt, and the same comparison as rollout against exclusion_percentage.",
    "variant": "Each variant boundary is the previous boundary plus rollout_percentage / 100, accumulated left to right in binary64 in stored order. The first variant whose boundary satisfies hash01 < boundary is selected.",
    "final_variant_fallback": "When no boundary satisfies the comparison, version 1 returns no variant and version 2 selects the final variant.",
    "empty_identifier": "Version 2 never enters rollout, holdout, or variant assignment with an empty identifier, including at 100 percent.",
    "salts": {
      "rollout": "",
      "variant": "variant",
      "holdout": ""
    },
    "prefixes": {
      "v1_rollout_and_variant": "flag key followed by a dot",
      "v2_rollout_and_variant": "seed followed by a dot",
      "legacy_era_holdout": "holdout-"
    }
  },
