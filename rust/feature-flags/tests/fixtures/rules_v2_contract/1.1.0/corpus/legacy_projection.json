{
  "corpus_version": "1.0.0",
  "config_version": 1,
  "description": "Projection matrix from a version 1 evaluation outcome to each response protocol version. Response protocol versions are independent of the config version, which is 1 for every case.",
  "response_protocols": {
    "flags_v2": {
      "endpoint": "/flags",
      "selected_by": "v=2 or higher, or /decide with v=4 or higher",
      "shape": "flags map of detailed results with reason and metadata; errorsWhileComputingFlags at the top level"
    },
    "flags_v1": {
      "endpoint": "/flags",
      "selected_by": "v=1 or absent, or /decide with v=3",
      "shape": "featureFlags map of every evaluated flag plus featureFlagPayloads for flags with a payload; errorsWhileComputingFlags at the top level"
    },
    "decide_v2": {
      "endpoint": "/decide",
      "selected_by": "v=2",
      "shape": "featureFlags map of enabled flags only"
    },
    "decide_v1": {
      "endpoint": "/decide",
      "selected_by": "v=1 or absent",
      "shape": "featureFlags list of enabled flag keys"
    }
  },
  "asserted_fields": "flags_v2 records key, enabled, variant, failed when true, reason.code, reason.condition_index, metadata.id, metadata.version, and metadata.payload. Live responses carry additional request-level and metadata fields that this corpus does not pin.",
