#!/bin/sh
[ -f "$(dirname "$0")/_/husky.sh" ] && . "$(dirname "$0")/_/husky.sh"

protected_branch='master'
current_branch=$(git branch --show-current)

if [ "$protected_branch" = "$current_branch" ]
then
    echo "Pushing to $protected_branch is a sin! Instead, create a pull request and repent."
    exit 1 # push will not execute
fi

# Use Python because macOS does not include the GNU timeout command.
# A separate process group lets the timeout stop gh, trunk, and their child processes.
queue_guard="$(dirname "$0")/check-merge-queue"
if [ -f "$queue_guard" ] && command -v python3 >/dev/null 2>&1
then
    python3 -c '
import os
import signal
import subprocess
import sys

try:
    with subprocess.Popen(["sh", sys.argv[1], sys.argv[2]], start_new_session=True) as check:
        try:
            result = check.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(check.pid, signal.SIGKILL)
            check.wait()
            result = 0
except OSError:
    result = 0

sys.exit(1 if result == 1 else 0)
' "$queue_guard" "$2" || exit 1
fi

# Catch deterministic CI failures before this push burns a CI matrix.
# Advisories never block; HOGLI_PREFLIGHT_DISABLED=1 makes it a no-op; no hogli → skip.
if command -v hogli >/dev/null 2>&1
then
    hogli ci:preflight --strict || {
        echo "pre-push: ci:preflight found failures — run 'hogli ci:preflight --fix', resolve, and push again."
        exit 1
    }
fi

exit 0
