#!/bin/sh
[ -f "$(dirname "$0")/_/husky.sh" ] && . "$(dirname "$0")/_/husky.sh"

protected_branch='master'
current_branch=$(git branch --show-current)

if [ "$protected_branch" = "$current_branch" ]
then
    echo "Pushing to $protected_branch is a sin! Instead, create a pull request and repent."
    exit 1 # push will not execute
fi

# Refuse to push a branch whose PR sits in the Trunk merge queue, because the push knocks
# it out of the queue. While a PR is queued, trunk-io keeps an open draft test PR whose
# branch is trunk-merge/pr-<number>/<uuid>; batched and dependent PRs appear only in the
# test PR's body (as .../pull/<number> links), so both are checked. Trunk sometimes leaves
# test PRs open after their source PR merged, which is harmless here since only numbers of
# open PRs on the pushed branch are matched.
# TRUNK_QUEUE_PUSH_CHECK_DISABLED=1 skips; no gh, offline, or non-GitHub remote → skip.
if [ -z "$TRUNK_QUEUE_PUSH_CHECK_DISABLED" ] && command -v gh >/dev/null 2>&1
then
    repo=$(printf '%s' "$2" | sed -E 's#^.*github\.com[:/]##; s#\.git$##')
    if [ -n "$repo" ] && [ "$repo" != "$2" ]
    then
        owner=${repo%%/*}
        name=${repo##*/}
        queue_refs=''
        queue_refs_fetched=''
        while read -r local_ref local_sha remote_ref remote_sha
        do
            case "$remote_ref" in
                refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
                *) continue ;;
            esac
            branch_prs=''
            for attempt in 1 2 3
            do
                if branch_prs=$(gh api graphql \
                    -f query='query($owner: String!, $name: String!, $branch: String!) {
                        repository(owner: $owner, name: $name) {
                            pullRequests(headRefName: $branch, states: OPEN, first: 5) { nodes { number } }
                        }
                    }' \
                    -f owner="$owner" -f name="$name" -f branch="$branch" \
                    --jq '.data.repository.pullRequests.nodes[].number' </dev/null 2>/dev/null)
                then
                    break
                fi
                branch_prs=''
                sleep 1
            done
            [ -z "$branch_prs" ] && continue
            if [ -z "$queue_refs_fetched" ]
            then
                for attempt in 1 2 3
                do
                    if queue_refs=$(gh pr list --repo "$repo" --author "app/trunk-io" \
                        --state open --limit 100 --json headRefName,body \
                        --jq '.[] | .headRefName, .body' </dev/null 2>/dev/null)
                    then
                        queue_refs_fetched=1
                        break
                    fi
                    sleep 1
                done
            fi
            [ -z "$queue_refs" ] && continue # gh never got a clean answer, or the queue is empty → fail open
            for pr in $branch_prs
            do
                case "$pr" in
                    *[!0-9]*|'') continue ;;
                esac
                if printf '%s\n' "$queue_refs" | grep -E -q "trunk-merge/pr-$pr/|pull/$pr([^0-9]|\$)"
                then
                    echo "pre-push: PR #$pr ('$branch') is in the Trunk merge queue — this push would remove it from the queue."
                    echo "Do NOT push to this branch. Let the queued PR merge, then make further changes on a NEW branch and open a NEW pull request."
                    echo "If you really need to update this PR instead, comment '/trunk cancel' on PR #$pr, wait for it to leave the queue, then push again."
                    exit 1
                fi
            done
        done
    fi
fi

# Catch deterministic CI failures before this push burns a CI matrix.
# Advisories never block; HOGLI_PREFLIGHT_DISABLED=1 makes it a no-op; no hogli → skip.
if command -v hogli >/dev/null 2>&1
then
    hogli ci:preflight --strict || {
        echo "pre-push: ci:preflight found failures — run 'hogli ci:preflight --fix', resolve, and push again."
        exit 1
    }
fi

exit 0
