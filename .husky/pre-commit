#!/bin/sh
[ -f "$(dirname "$0")/_/husky.sh" ] && . "$(dirname "$0")/_/husky.sh"

# Borrow node_modules/venv from the main clone in a light worktree, when
# lockfiles match -- lets this hook run with zero local installs. Resolve the
# helper relative to this hook file, not cwd: core.hooksPath may be absolute
# (hook file lives in the main clone) or relative (worktree's own checkout),
# and cwd is always the active worktree, which may not contain the helper.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$HOOK_DIR/../bin/helpers/worktree-borrow.sh" ]; then
    . "$HOOK_DIR/../bin/helpers/worktree-borrow.sh"
    posthog_worktree_borrow
fi

# Skip lint-staged during merges — staged files include the entire merge diff,
# not just your changes, making it slow and pointless
[ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ] && exit 0

# Auto-invoked formatter/linter calls during commit are not explicit user
# commands -- skip telemetry so the dashboard reflects intentional usage only.
export POSTHOG_TELEMETRY_OPT_OUT=1

# Fixture-provenance warning. Runs here rather than as a lint-staged task because
# lint-staged prints nothing for a task that succeeds, and this one always does.
# Never blocks: the question it raises is not one a script can answer.
if [ -x .github/scripts/check-fixture-provenance.sh ]; then
    .github/scripts/check-fixture-provenance.sh || true
fi

# Same deal for the HogQL access control doc: warn when documented files change
# without the doc, never block.
if [ -x .github/scripts/check-access-control-doc-sync.sh ]; then
    .github/scripts/check-access-control-doc-sync.sh || true
fi

# Same deal for a product directory that appears without coming from
# `hogli product:bootstrap`: warn at the commit that introduces it, rather than
# leaving the author to find out from CI after the shape is set.
if [ -x .github/scripts/check-product-scaffold.sh ]; then
    .github/scripts/check-product-scaffold.sh || true
fi

# Same deal for hooks under .claude/ and for quill sources changed without their
# consumer guide. A warn-only check has to run here rather than as a lint-staged
# task, because lint-staged discards the output of every task that exits 0.
if [ -x .github/scripts/check-claude-hooks.sh ]; then
    .github/scripts/check-claude-hooks.sh || true
fi

if [ -x .github/scripts/check-quill-agents-md.sh ]; then
    .github/scripts/check-quill-agents-md.sh || true
fi

# Same deal for a comment-heavy staged diff. Run through bash: the script lands
# without its executable bit.
if [ -f .github/scripts/check-comment-density.sh ]; then
    bash .github/scripts/check-comment-density.sh || true
fi

# hoglint checks the staged tree for new boundary problems (`hoglint help hook`). Exit 3 means
# hoglint could not run; a missing command cannot print its own line. Both let the commit
# through, because CI runs the full check. A GUI client may not have the dev env on PATH, so the
# flox venv is the fallback. husky runs this file with `sh -e`, so each command that can fail
# carries its own `||`.
#
# CI does not block while hoglint runs in shadow, so master can carry findings that the ledger
# does not record yet, and every later commit sees them. So a finding blocks here only when it
# sits in a staged file. hoglint runs once, in the full view, because the default view can cut
# the list short. The script prints the rows that block, and counts the rest.
hoglint_bin="$(command -v hoglint 2>/dev/null || true)"
if [ -z "$hoglint_bin" ] && [ -x .flox/cache/venv/bin/hoglint ]; then
    hoglint_bin=.flox/cache/venv/bin/hoglint
fi
hoglint_status=127
hoglint_out="$(mktemp)"
if [ -n "$hoglint_bin" ]; then
    hoglint_status=0
    "$hoglint_bin" check --index --all > "$hoglint_out" 2>&1 || hoglint_status=$?
fi
hoglint_block=0
case "$hoglint_status" in
    0) sed -n '/^hoglint: /p; /^note: /p' "$hoglint_out" ;;
    3) cat "$hoglint_out" ;;
    127) echo "hoglint did not check this commit, because hoglint could not run: the hook could not start the hoglint command. The commit continues. CI runs the full check. To repair hoglint, install the pinned hoglint version again with the dev dependencies." ;;
    *)
        hoglint_python="$(dirname "$hoglint_bin")/python"
        [ -x "$hoglint_python" ] || hoglint_python=python3
        hoglint_filter=0
        "$hoglint_python" .github/scripts/hoglint_shadow.py --hook "$hoglint_out" || hoglint_filter=$?
        case "$hoglint_filter" in
            0) ;;
            1) hoglint_block=1 ;;
            *) echo "hoglint could not tell which findings sit in the files you commit, so this commit goes through. CI runs the full check." ;;
        esac
        ;;
esac
rm -f "$hoglint_out"
[ "$hoglint_block" = 0 ] || exit 1

# Activate Flox environment if available and not already active
# This ensures lint-staged commands work in GUI Git clients (GitHub Desktop, etc.)
if command -v flox > /dev/null 2>&1 && [ -d ".flox/cache" ] && [ -z "$FLOX_ENV" ]; then
    # CI=true so pnpm in flox's on-activate hook doesn't ask for a TTY when
    # cleaning stale node_modules. Pre-commit has no TTY, same as real CI.
    exec env CI=true "$(command -v flox)" activate -- bash -c "POSTHOG_TELEMETRY_OPT_OUT=1 NODE_OPTIONS='--max-old-space-size=8192' pnpm lint-staged"
else
    # Fallback: run without Flox (for non-Flox users or if already activated)
    NODE_OPTIONS='--max-old-space-size=8192' pnpm lint-staged
fi
