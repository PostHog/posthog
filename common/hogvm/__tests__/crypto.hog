let string := 'this is a secure string'
print('string:', string)
print('md5Hex(string):', md5Hex(string))
print('md5Hex(null):', md5Hex(null))
print('md5(string, \'hex\'):', md5(string, 'hex'))
print('md5(null, \'hex\'):', md5(null, 'hex'))
print('md5(string, \'binary\'):', md5(string, 'binary'))
print('md5(null, \'binary\'):', md5(null, 'binary'))
print('md5(string, \'base64\'):', md5(string, 'base64'))
print('md5(null, \'base64\'):', md5(null, 'base64'))
print('md5(string, \'base64url\'):', md5(string, 'base64url'))
print('md5(null, \'base64url\'):', md5(null, 'base64url'))
print('sha256Hex(string):', sha256Hex(string))
print('sha256Hex(null):', sha256Hex(null))
print('sha256(string, \'hex\'):', sha256(string, 'hex'))
print('sha256(null, \'hex\'):', sha256(null, 'hex'))
print('sha256(string, \'binary\'):', sha256(string, 'binary'))
print('sha256(null, \'binary\'):', sha256(null, 'binary'))
print('sha256(string, \'base64\'):', sha256(string, 'base64'))
print('sha256(null, \'base64\'):', sha256(null, 'base64'))
print('sha256(string, \'base64url\'):', sha256(string, 'base64url'))
print('sha256(null, \'base64url\'):', sha256(null, 'base64url'))
print('sha1Hex(string):', sha1Hex(string))
print('sha1Hex(null):', sha1Hex(null))
print('sha1(string, \'hex\'):', sha1(string, 'hex'))
print('sha1(null, \'hex\'):', sha1(null, 'hex'))
print('sha1(string, \'binary\'):', sha1(string, 'binary'))
print('sha1(null, \'binary\'):', sha1(null, 'binary'))
print('sha1(string, \'base64\'):', sha1(string, 'base64'))
print('sha1(null, \'base64\'):', sha1(null, 'base64'))
print('sha1(string, \'base64url\'):', sha1(string, 'base64url'))
print('sha1(null, \'base64url\'):', sha1(null, 'base64url'))

let data := ['1', 'string', 'more', 'keys']
print('data:', data)
print('sha256HmacChainHex(data):', sha256HmacChainHex(data))
print('sha256HmacChain(data, \'hex\'):', sha256HmacChain(data, 'hex'))
print('sha256HmacChain(data, \'base64\'):', sha256HmacChain(data, 'base64'))
print('sha256HmacChain(data, \'binary\'):', sha256HmacChain(data, 'binary'))
print('sha256HmacChain(data, \'base64url\'):', sha256HmacChain(data, 'base64url'))
print('sha1HmacChainHex(data):', sha1HmacChainHex(data))
print('sha1HmacChain(data, \'hex\'):', sha1HmacChain(data, 'hex'))
print('sha1HmacChain(data, \'base64\'):', sha1HmacChain(data, 'base64'))
print('sha1HmacChain(data, \'binary\'):', sha1HmacChain(data, 'binary'))
print('sha1HmacChain(data, \'base64url\'):', sha1HmacChain(data, 'base64url'))

// Known answers, so a wrong implementation fails instead of agreeing on a wrong snapshot.
// SHA-1 vectors from FIPS 180-1, HMAC-SHA1 vectors from RFC 2202 (the cases with textual keys).
print('sha1Hex(\'abc\'):', sha1Hex('abc'))
print('sha1Hex(\'\'):', sha1Hex(''))
print('rfc2202 case 1:', sha1HmacChainHex(['\v\v\v\v\v\v\v\v\v\v\v\v\v\v\v\v\v\v\v\v', 'Hi There']))
print('rfc2202 case 2:', sha1HmacChainHex(['Jefe', 'what do ya want for nothing?']))
print('rfc2202 case 5:', sha1HmacChainHex(['\f\f\f\f\f\f\f\f\f\f\f\f\f\f\f\f\f\f\f\f', 'Test With Truncation']))
