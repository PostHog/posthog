{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':dependencyDashboardApproval',
  ],
  enabledManagers: [
    'pep621',
    'npm',
    'github-actions',
    'gomod',
    'cargo',
    'custom.regex',
    'nodenv',
    'nvm',
  ],
  dependencyDashboard: {
    title: 'Renovate: Dependency Status',
    labels: [
      'dependencies',
    ],
    osvVulnerabilitySummary: 'all',
    reportAbandonment: false,
  },
  prConcurrentLimit: 5,
  gitIgnoredAuthors: [
    '206114724+posthog[bot]@users.noreply.github.com',
    '250237707+tests-posthog[bot]@users.noreply.github.com',
  ],
  vulnerabilityAlerts: {
    enabled: false,
  },
  ignorePaths: [
    'common/hogql_parser/**',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update pinned chrome-headless-shell version in recording-rasterizer Dockerfile',
      managerFilePatterns: [
        '/Dockerfile\\.recording-rasterizer$/',
      ],
      matchStrings: [
        'chrome-headless-shell@(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'chrome-headless-shell',
      datasourceTemplate: 'custom.chrome-for-testing',
      versioningTemplate: 'loose',
    },
    {
      customType: 'regex',
      description: 'Update the Renovate version pinned in the dashboard digest workflow',
      managerFilePatterns: [
        '/^\\.github/workflows/renovate-dashboard-digest\\.yml$/',
      ],
      matchStrings: [
        'renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'renovate',
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      description: 'Update the nodesource nodejs package pinned in the task sandbox images',
      managerFilePatterns: [
        '/^products/tasks/backend/sandbox/images/Dockerfile\\.sandbox-(base|notebook|slim)$/',
        '/^products/tasks/backend/logic/services/modal_sandbox\\.py$/',
      ],
      matchStrings: [
        '(?<currentValue>\\d+\\.\\d+\\.\\d+-\\d+nodesource\\d+)',
      ],
      depNameTemplate: 'nodejs',
      datasourceTemplate: 'deb',
      versioningTemplate: 'deb',
      registryUrlTemplate: 'https://deb.nodesource.com/node_26.x?suite=nodistro&components=main&binaryArch=amd64',
    },
    {
      customType: 'regex',
      description: 'Update the standalone corepack pinned wherever an image or workflow runs corepack enable',
      managerFilePatterns: [
        '/(^|/)Dockerfile[^/]*$/',
        '/^products/tasks/backend/logic/services/modal_sandbox\\.py$/',
        '/^\\.github/workflows/ci-ml-mirror-image-scrub-container\\.yml$/',
        '/^docs/published/handbook/engineering/manual-dev-setup\\.md$/',
      ],
      matchStrings: [
        'corepack@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'corepack',
      datasourceTemplate: 'npm',
    },
  ],
  customDatasources: {
    'chrome-for-testing': {
      defaultRegistryUrlTemplate: 'https://googlechromelabs.github.io/chrome-for-testing/known-good-versions.json',
      transformTemplates: [
        '{"releases": $map(versions, function($v) { {"version": $v.version} })}',
      ],
    },
  },
  npm: {
    minor: {
      groupName: 'npm non-major {{packageName}}',
    },
    patch: {
      groupName: 'npm non-major {{packageName}}',
    },
  },
  pep621: {
    minor: {
      groupName: 'python non-major {{packageName}}',
    },
    patch: {
      groupName: 'python non-major {{packageName}}',
    },
  },
  packageRules: [
    {
      matchDatasources: [
        'npm',
        'pypi',
        'crate',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      matchDatasources: [
        'npm',
      ],
      matchPackageNames: [
        'posthog-js',
        'posthog-js-lite',
        'posthog-node',
        '@posthog/*',
        '@earendil-works/*',
        'typebox',
        '@oxfmt/*',
        '@shadcn/react',
        'kea-typegen',
        '@typescript/native-preview*',
        'shiki',
        'shadcn',
        '@shikijs/*',
      ],
      minimumReleaseAge: null,
    },
    {
      matchDatasources: [
        'pypi',
      ],
      matchPackageNames: [
        'brotli',
        'certifi',
        'hogql-parser',
        'hogql-parser-rs',
        'deltalite',
        'posthoganalytics',
        'pixelhog',
        'django',
        'modal',
        'posthog-hogland',
        'google-ads',
        'grpcio',
      ],
      minimumReleaseAge: null,
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'cargo non-major',
    },
    {
      matchManagers: [
        'cargo',
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchFileNames: [
        '**/go.mod',
        'cli/**',
        'funnel-udf/**',
        'rust/common/hogvm/node/Cargo.toml',
      ],
      groupName: '{{manager}} non-major in {{packageFileDir}}',
    },
    {
      matchManagers: [
        'npm',
        'pep621',
        'cargo',
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '/^v?0\\./',
      groupName: null,
    },
    {
      matchManagers: [
        'pep621',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'dagster*',
      ],
      groupName: 'python dagster non-major',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '@connectrpc/connect',
        '@connectrpc/connect-node',
      ],
      groupName: 'npm connectrpc non-major',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '@bufbuild/protobuf',
        '@bufbuild/protoc-gen-es',
      ],
      groupName: 'npm protobuf-es non-major',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '@earendil-works/pi-*',
      ],
      groupName: 'npm pi non-major',
    },
    {
      matchDepTypes: [
        'requires-python',
        'packageManager',
      ],
      groupName: null,
    },
    {
      matchDepNames: [
        'chrome-headless-shell',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      schedule: [
        'every 2 weeks on Monday',
      ],
      commitMessageExtra: '(chrome-headless-shell)',
      labels: [
        'dependencies',
        'recording-rasterizer',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchDepTypes: [
        'action',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'deb',
      ],
      matchDepNames: [
        'nodejs',
      ],
      dependencyDashboardApproval: false,
      groupName: 'sandbox nodejs',
    },
    {
      matchManagers: [
        'nodenv',
        'nvm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      dependencyDashboardApproval: false,
    },
    {
      matchRegistryUrls: [
        'https://download.pytorch.org/whl/**',
      ],
      registryUrls: [
        'https://pypi.org/pypi/',
      ],
    },
  ],
}
