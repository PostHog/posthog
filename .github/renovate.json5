{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':dependencyDashboardApproval',
    ':separateMultipleMajorReleases',
  ],
  enabledManagers: [
    'pep621',
    'npm',
    'github-actions',
    'gomod',
    'cargo',
    'custom.regex',
    'nodenv',
    'nvm',
  ],
  dependencyDashboardTitle: 'Renovate: Dependency Status',
  dependencyDashboardLabels: [
    'dependencies',
  ],
  dependencyDashboardOSVVulnerabilitySummary: 'all',
  dependencyDashboardReportAbandonment: false,
  configMigration: false,
  // CI bots push regenerated snapshots and OpenAPI types onto PR branches.
  // Without this, Renovate treats those PRs as modified and stops rebasing them
  gitIgnoredAuthors: [
    '206114724+posthog[bot]@users.noreply.github.com',
    '250237707+tests-posthog[bot]@users.noreply.github.com',
  ],
  vulnerabilityAlerts: {
    enabled: false,
  },
  ignorePaths: [
    'common/hogql_parser/**',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update pinned chrome-headless-shell version in recording-rasterizer Dockerfile',
      managerFilePatterns: ['/Dockerfile\\.recording-rasterizer$/'],
      matchStrings: [
        'chrome-headless-shell@(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'chrome-headless-shell',
      datasourceTemplate: 'custom.chrome-for-testing',
      versioningTemplate: 'loose',
    },
    {
      customType: 'regex',
      description: 'Update the Renovate version pinned in the dashboard digest workflow',
      managerFilePatterns: ['/^\\.github/workflows/renovate-dashboard-digest\\.yml$/'],
      matchStrings: ['renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'renovate',
      datasourceTemplate: 'npm',
    },
    {
      customType: 'regex',
      description: 'Update the nodesource nodejs package pinned in the task sandbox images',
      managerFilePatterns: [
        '/^products/tasks/backend/sandbox/images/Dockerfile\\.sandbox-(base|notebook|slim)$/',
        '/^products/tasks/backend/logic/services/modal_sandbox\\.py$/',
      ],
      matchStrings: ['(?<currentValue>\\d+\\.\\d+\\.\\d+-\\d+nodesource\\d+)'],
      depNameTemplate: 'nodejs',
      datasourceTemplate: 'deb',
      versioningTemplate: 'deb',
      registryUrlTemplate: 'https://deb.nodesource.com/node_24.x?suite=nodistro&components=main&binaryArch=amd64',
    },
  ],
  customDatasources: {
    'chrome-for-testing': {
      defaultRegistryUrlTemplate: 'https://googlechromelabs.github.io/chrome-for-testing/known-good-versions.json',
      transformTemplates: [
        '{"releases": $map(versions, function($v) { {"version": $v.version} })}',
      ],
    },
  },
  packageRules: [
    // pnpm and uv refuse versions younger than 7 days, so a shorter wait proposes updates
    // whose lock file update fails. Crates get the same wait
    {
      matchDatasources: ['npm', 'pypi', 'crate'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      minimumReleaseAge: '7 days',
    },
    // Keep in sync with minimumReleaseAgeExclude in pnpm-workspace.yaml
    {
      matchDatasources: ['npm'],
      matchPackageNames: [
        'posthog-js',
        'posthog-js-lite',
        'posthog-node',
        '@posthog/*',
        '@earendil-works/*',
        'typebox',
        '@oxfmt/*',
        '@shadcn/react',
        'kea-typegen',
        '@typescript/native-preview*',
        'shiki',
        'shadcn',
        '@shikijs/*',
      ],
      minimumReleaseAge: null,
    },
    // Keep in sync with exclude-newer-package in pyproject.toml
    {
      matchDatasources: ['pypi'],
      matchPackageNames: [
        'brotli',
        'certifi',
        'hogql-parser',
        'hogql-parser-rs',
        'deltalite',
        'posthoganalytics',
        'pixelhog',
        'django',
        'modal',
        'posthog-hogland',
        'google-ads',
        'grpcio',
      ],
      minimumReleaseAge: null,
    },
    // One non-major group per lock file keeps the dashboard under GitHub's issue size limit.
    // Package files that share a lock file share a group, so merging one group PR does not
    // conflict the others
    {
      matchManagers: ['npm', 'pep621', 'cargo'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: '{{manager}} non-major',
    },
    // Directories with their own lock file, outside the root pnpm, uv and Cargo workspaces
    {
      matchManagers: ['npm', 'pep621', 'cargo', 'gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: [
        '**/go.mod',
        'cli/**',
        'funnel-udf/**',
        'rust/common/hogvm/node/Cargo.toml',
        'services/llm-gateway/**',
        'services/stripe-mock/**',
        'tools/hedgebox-dummy/**',
        'frontend/@posthog/lemon-ui/**',
        'nodejs/src/ingestion/pipelines/sessionreplay/ml-mirror-image-scrub-sidecar/**',
        '.depot/actions/paths-filter/**',
        '.github/actions/paths-filter/**',
        '.github/actions/shared-image-releases/**',
        'products/canvas/packages/canvas_builder/**',
        'products/visual_review/cli/**',
        'rust/batch-import-worker/scripts/**',
      ],
      groupName: '{{manager}} non-major in {{packageFileDir}}',
    },
    // Workspaces with their own lock file and nested package files
    {
      matchManagers: ['npm', 'pep621', 'cargo', 'gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: ['products/desktop/**', 'packages/agent/**'],
      groupName: "{{manager}} non-major in {{lookup (split packageFileDir '/') 0}}/{{lookup (split packageFileDir '/') 1}}",
    },
    // A 0.x minor release can break, so it gets its own PR
    {
      matchManagers: ['npm', 'pep621', 'cargo', 'gomod'],
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '/^v?0\\./',
      groupName: null,
    },
    // Python and pnpm version bumps change the toolchain for every package, so each gets its own PR
    {
      matchDepTypes: ['requires-python', 'packageManager'],
      groupName: null,
    },
    {
      matchDepNames: ['chrome-headless-shell'],
      automerge: true,
      matchUpdateTypes: ['minor', 'patch'],
      schedule: ['every 2 weeks on Monday'],
      commitMessageExtra: '(chrome-headless-shell)',
      labels: ['dependencies', 'recording-rasterizer'],
    },
    // Split github-actions updates out of the default `renovate/pin-dependencies`
    // bundle so they can be approved on the dashboard independently
    {
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    // The sandbox images and the Modal slim image rebuild only when this pin changes,
    // so skip the dashboard approval and open the PR as soon as nodesource ships a release
    {
      matchDatasources: ['deb'],
      matchDepNames: ['nodejs'],
      dependencyDashboardApproval: false,
      groupName: 'sandbox nodejs',
    },
    // A stale Node pin keeps known vulnerabilities in CI, so skip the dashboard approval
    // for `.node-version` and `.nvmrc` updates. A major bump still waits for approval
    {
      matchManagers: ['nodenv', 'nvm'],
      matchUpdateTypes: ['minor', 'patch'],
      dependencyDashboardApproval: false,
    },
  ],
}
