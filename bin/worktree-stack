#!/bin/bash
# Run app services from a git worktree against the machine's single shared dev
# infra (Postgres, ClickHouse, Redis, Kafka, capture, plugin-server, ...), so
# several worktrees can each serve their own copy of the app at the same time.
#
# The worktree's services run under phrocs — the same process manager as the
# main stack — with the same verbs (`start`, `wait`, `stop`, `attach`), the
# same TUI, and the same detached mode. Each worktree gets a stable index and
# a port block derived from it, plus its own Caddy proxy (the same entrypoint
# the main stack serves at :8010). The proxy routes the services this worktree
# overrides to worktree-local ports and every other path to the shared stack.
# The app URL for this worktree is printed by `worktree-stack url`.
#
# The shared infra and the database stay singletons: worktrees do not run
# migrations automatically. Queue work splits deterministically: celery-worker
# pairs with the worktree's Django on a per-worktree broker (Redis db = index),
# and capture + ingestion form a per-worktree ingestion lane on their own Kafka
# topic and consumer group, fed by this worktree's proxy.
# Never run celery-beat per worktree; the scheduler is a singleton.

set -e

usage() {
    cat <<'EOF'
Usage: bin/worktree-stack <command> [args]

Same verbs as the main stack (hogli start / wait / stop), applied to this
worktree's own service block.

Commands:
  start [-d] [svc...]          Run this worktree's services under phrocs.
                               Interactive TUI by default; -d / --detach for
                               detached mode. Named services autostart
                               (default: proxy backend frontend); the rest
                               appear in phrocs stopped, one keypress away.
  up                           Alias for start
  wait [--timeout N] [--json]  Block until this worktree's stack is ready
  stop | down                  Stop this worktree's stack
  attach                       Status TUI against a detached stack
  url                          Print this worktree's app URL
  env                          Print `export` lines for this worktree's ports

Services:
  proxy          Caddy entrypoint for this worktree (docker)
  backend        Django via granian on BACKEND_PORT
  frontend       Vite dev server on VITE_PORT
  celery-worker  Celery worker on this worktree's own broker (Redis db = index);
                 the worktree's Django enqueues there, so tasks split
                 deterministically from the shared stack
  nodejs         plugin-server, general mode (cdp etc.; competing consumer with
                 the shared stack)
  ingestion      plugin-server in ingestion-v2 mode consuming this worktree's
                 own ingestion topic (selecting it also starts capture)
  capture        capture (cargo, from this worktree's rust/) producing to this
                 worktree's own ingestion topic (selecting it also starts ingestion)

phrocs resolves its control socket per directory, so from inside the worktree
plain `hogli wait` and `hogli stop` target this stack too.
EOF
    exit 1
}

COMMAND=${1:-}
shift || true
[[ -z "$COMMAND" ]] && usage

WORKTREE_ROOT="$(git rev-parse --show-toplevel)"
source "$WORKTREE_ROOT/bin/helpers/worktree-borrow.sh"
source "$WORKTREE_ROOT/bin/helpers/dev-env.sh"
MAIN_ROOT="$(posthog_main_repo "$WORKTREE_ROOT")"
[[ -z "$MAIN_ROOT" ]] && MAIN_ROOT="$WORKTREE_ROOT"

STATE_DIR="$WORKTREE_ROOT/.worktree-stack"
PHROCS_CONFIG="$STATE_DIR/mprocs.yaml"
REGISTRY="$MAIN_ROOT/.posthog/worktree-stack-registry"

# ---------------------------------------------------------------------------
# Index allocation: the main checkout is index 0 (the plain single stack);
# each worktree gets the lowest free index >= 1, recorded in a registry file
# under the main checkout so indexes stay stable across sessions.
# ---------------------------------------------------------------------------
registry_lookup() {
    awk -F'\t' -v p="$WORKTREE_ROOT" '$2 == p { print $1 }' "$REGISTRY"
}

allocate_index() {
    if [[ "$WORKTREE_ROOT" == "$MAIN_ROOT" ]]; then
        echo 0
        return
    fi
    mkdir -p "$(dirname "$REGISTRY")"
    touch "$REGISTRY"

    # Lock-free fast path: allocation only ever appends whole lines, so a
    # reader never sees a torn entry. Every command but the first `start`
    # resolves here without touching the lock.
    local existing
    existing="$(registry_lookup)"
    if [[ -n "$existing" ]]; then
        echo "$existing"
        return
    fi

    local lock="$REGISTRY.lock"
    local waited=0
    until mkdir "$lock" 2>/dev/null; do
        sleep 0.2
        waited=$((waited + 1))
        [[ $waited -gt 50 ]] && { echo "error: registry lock stuck at $lock" >&2; exit 1; }
    done
    trap 'rmdir "$lock" 2>/dev/null || true' RETURN

    # Prune entries whose worktree no longer exists, then re-check and allocate.
    local tmp
    tmp="$(mktemp)"
    while IFS=$'\t' read -r idx path; do
        [[ -d "$path" ]] && printf '%s\t%s\n' "$idx" "$path" >> "$tmp"
    done < "$REGISTRY"
    mv "$tmp" "$REGISTRY"

    existing="$(registry_lookup)"
    if [[ -n "$existing" ]]; then
        echo "$existing"
        return
    fi

    local i
    i="$(awk -F'\t' '{ used[$1] } END { i = 1; while (i in used) i++; print i }' "$REGISTRY")"
    # Everything downstream assumes a single digit: the port block stays clear
    # of the fixed infra ports, the proxy's X-Worktree route matches ^[0-9]$,
    # and the celery broker uses Redis db = index (16 dbs by default).
    if [[ "$i" -gt 9 ]]; then
        echo "error: no free worktree index <= 9; remove stale entries from $REGISTRY" >&2
        exit 1
    fi
    printf '%s\t%s\n' "$i" "$WORKTREE_ROOT" >> "$REGISTRY"
    echo "$i"
}

IDX="$(allocate_index)"

# ---------------------------------------------------------------------------
# Port block. Index 0 reproduces the main stack's defaults exactly.
# Spacing of 100 keeps the derived ports clear of the fixed infra ports
# (5432 postgres, 6379 redis, 8123/9000 clickhouse, 9092 kafka, 7233 temporal).
# The scheme is mirrored by the proxy's X-Worktree route (docker-compose.dev.yml)
# and by devProxyPortForBackendPort (frontend/src/lib/utils/apiHost.ts).
# ---------------------------------------------------------------------------
export WORKTREE_STACK_INDEX=$IDX
export PROXY_PORT=$((8010 + 100 * IDX))
export BACKEND_PORT=$((8000 + 100 * IDX))
export VITE_PORT=$((8234 + 100 * IDX))
export DEBUGPY_PORT=$((5678 + IDX))
export PLUGIN_HTTP_PORT=$((6739 + 100 * IDX))
export INGESTION_HTTP_PORT=$((6740 + 100 * IDX))
export CAPTURE_PORT=$((3307 + 100 * IDX))
export SITE_URL="http://localhost:$PROXY_PORT"
export JS_URL="http://localhost:$VITE_PORT"
export PROXY_WEB_PORT="$BACKEND_PORT"
INGESTION_TOPIC="events_plugin_ingestion_wt$IDX"
INGESTION_GROUP="clickhouse-ingestion-wt$IDX"
CELERY_WT_BROKER_URL="redis://redis7:6379/$IDX"

COMPOSE_PROJECT="posthog-wt$IDX"

ENV_VARS=(WORKTREE_STACK_INDEX PROXY_PORT BACKEND_PORT VITE_PORT DEBUGPY_PORT
    PLUGIN_HTTP_PORT INGESTION_HTTP_PORT CAPTURE_PORT SITE_URL JS_URL)

print_env() {
    local v
    for v in "${ENV_VARS[@]}"; do
        echo "export $v=${!v}"
    done
}

# ---------------------------------------------------------------------------
# Dev environment. Shares bin/start's env sourcing (shell env > .env.local >
# .env.development > .env.services) and computed connection URLs via
# bin/helpers/dev-env.sh, so a service started here sees the same environment
# it would under the main stack. The port block above is exported first, so
# it wins over file values.
# ---------------------------------------------------------------------------
load_dev_env() {
    if [[ -f "$WORKTREE_ROOT/.env.local" ]]; then
        source_env_defaults "$WORKTREE_ROOT/.env.local"
    fi
    source_env_defaults "$WORKTREE_ROOT/.env.development"
    source_env_defaults "$WORKTREE_ROOT/.env.services"
    export_computed_connection_urls
}

check_infra() {
    if ! (echo > /dev/tcp/127.0.0.1/5432) 2>/dev/null; then
        cat >&2 <<EOF
error: shared infra is not reachable (Postgres :5432).
Start it once from the main checkout: cd $MAIN_ROOT && hogli start -d
EOF
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# phrocs resolution. The in-repo source build is canonical (it matches the
# checkout); worktrees usually don't build their own dist, so borrow the main
# checkout's before falling back to PATH.
# ---------------------------------------------------------------------------
resolve_phrocs() {
    local candidate
    for candidate in "$WORKTREE_ROOT/tools/phrocs/dist/phrocs" "$MAIN_ROOT/tools/phrocs/dist/phrocs"; do
        if [[ -x "$candidate" ]]; then
            echo "$candidate"
            return
        fi
    done
    # Inside flox the source build is the only accepted binary — do NOT fall
    # back to PATH, or a stray brew/curl phrocs would shadow the checkout
    # build (same rule as bin/start's resolution).
    if [[ -z "${FLOX_ENV_PROJECT:-}" ]] && candidate="$(command -v phrocs)"; then
        echo "$candidate"
        return
    fi
    cat >&2 <<EOF
error: phrocs not found. Build it in the main checkout (hogli phrocs:build)
or install it: brew tap posthog/tap && brew install phrocs
EOF
    exit 1
}

# ---------------------------------------------------------------------------
# phrocs config. One proc per service the worktree can override, same shells
# and ready patterns as the main stack's registry (bin/mprocs.yaml), so the
# TUI reads identically. Services not selected on `start` are defined with
# autostart: false — visible in phrocs and toggleable there, but off.
# ---------------------------------------------------------------------------
KNOWN_SERVICES=(proxy backend frontend celery-worker nodejs ingestion capture)

contains() {
    local needle=$1 item
    shift
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

has_service() {
    contains "$1" "${AUTOSTART_SERVICES[@]}"
}

autostart_flag() {
    if has_service "$1"; then echo true; else echo false; fi
}

write_phrocs_config() {
    mkdir -p "$STATE_DIR"
    cat > "$PHROCS_CONFIG" <<EOF
# Generated by bin/worktree-stack for worktree #$IDX — do not edit.
procs:
    info:
        shell: |
            echo ''
            echo "  worktree-stack #$IDX"
            echo "  App URL: $SITE_URL"
            echo ''
            echo '  Everything not listed here is served by the shared stack.'
            echo '  Stopped services can be started from the sidebar.'

    proxy:
        shell: 'docker compose -p $COMPOSE_PROJECT -f docker-compose.dev.yml up proxy'
        autostart: $(autostart_flag proxy)
        ready_pattern: 'serving initial configuration'

    backend:
        shell: './bin/start-backend'
        autostart: $(autostart_flag backend)
        autorestart: true
        ready_pattern: 'Listening at'

    frontend:
        shell: './bin/start-frontend'
        autostart: $(autostart_flag frontend)
        autorestart: true
        ready_pattern: 'VITE.*ready in'

    celery-worker:
        shell: './bin/start-celery worker'
        autostart: $(autostart_flag celery-worker)
        autorestart: true
        ready_pattern: 'celery@'

    nodejs:
        shell: './bin/posthog-node'
        autostart: $(autostart_flag nodejs)
        ready_pattern: 'All systems go'
        env:
            HTTP_SERVER_PORT: '$PLUGIN_HTTP_PORT'

    ingestion:
        shell: './bin/posthog-node'
        autostart: $(autostart_flag ingestion)
        ready_pattern: 'All systems go'
        env:
            PLUGIN_SERVER_MODE: 'ingestion-v2'
            HTTP_SERVER_PORT: '$INGESTION_HTTP_PORT'
            INGESTION_CONSUMER_CONSUME_TOPIC: '$INGESTION_TOPIC'
            INGESTION_CONSUMER_GROUP_ID: '$INGESTION_GROUP'

    capture:
        shell: './bin/start-rust-service capture'
        autostart: $(autostart_flag capture)
        ready_pattern: 'listening on'
        env:
            ADDRESS: '0.0.0.0:$CAPTURE_PORT'
            KAFKA_TOPIC: '$INGESTION_TOPIC'
            CAPTURE_V1_SINK_MSK_KAFKA_TOPIC_MAIN: '$INGESTION_TOPIC'
EOF
}

case "$COMMAND" in
    start|up)
        if [[ "$IDX" -eq 0 ]]; then
            echo "error: this is the main checkout; run the normal stack with hogli start" >&2
            exit 1
        fi
        DETACH_ARGS=()
        AUTOSTART_SERVICES=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--detach)
                    DETACH_ARGS=(--detach)
                    ;;
                celery-beat)
                    echo "error: celery-beat is a singleton scheduler; run it only in the main stack" >&2
                    exit 1
                    ;;
                *)
                    if ! contains "$1" "${KNOWN_SERVICES[@]}"; then
                        echo "error: unknown service '$1' (known: ${KNOWN_SERVICES[*]})" >&2
                        exit 1
                    fi
                    AUTOSTART_SERVICES+=("$1")
                    ;;
            esac
            shift
        done
        [[ ${#AUTOSTART_SERVICES[@]} -eq 0 ]] && AUTOSTART_SERVICES=(proxy backend frontend)
        # capture and ingestion form this worktree's isolated ingestion lane
        # (own Kafka topic + consumer group); one without the other either
        # produces to a topic nothing drains or consumes a topic nothing
        # fills, so selecting either brings both.
        if has_service capture || has_service ingestion; then
            has_service capture || AUTOSTART_SERVICES+=(capture)
            has_service ingestion || AUTOSTART_SERVICES+=(ingestion)
            export PROXY_CAPTURE_PORT=$CAPTURE_PORT
        fi
        if has_service celery-worker; then
            export CELERY_BROKER_URL=$CELERY_WT_BROKER_URL
        fi
        # A second phrocs for the same worktree steals the control socket and
        # leaves the first one's services running unmanaged, so their ports
        # collide with the new generation's. Same job as bin/start's flock.
        if pgrep -f -- "--config $PHROCS_CONFIG" >/dev/null 2>&1; then
            echo "error: this worktree's stack is already running; use worktree-stack stop or attach" >&2
            exit 1
        fi
        # Clean up orphaned dev processes left behind by an unclean shutdown,
        # same as bin/start — only orphans are killed, managed procs are left
        # alone, so other worktrees' stacks are safe.
        if [[ -z "${HOGLI_SKIP_ZOMBIE_CHECK:-}" ]] && command -v hogli &>/dev/null; then
            hogli doctor:zombies --yes || true
        fi
        check_infra
        load_dev_env
        PHROCS_BIN="$(resolve_phrocs)"
        write_phrocs_config
        echo "worktree-stack #$IDX ($WORKTREE_ROOT)"
        echo "App URL: $SITE_URL"
        if has_service capture; then
            echo "Ingestion lane: capture + ingestion on topic $INGESTION_TOPIC"
        fi
        if has_service celery-worker; then
            echo "Celery lane: broker $CELERY_WT_BROKER_URL"
        fi
        cd "$WORKTREE_ROOT"
        exec "$PHROCS_BIN" "${DETACH_ARGS[@]}" --config "$PHROCS_CONFIG"
        ;;
    wait)
        PHROCS_BIN="$(resolve_phrocs)"
        cd "$WORKTREE_ROOT"
        exec "$PHROCS_BIN" wait "$@"
        ;;
    stop|down)
        PHROCS_BIN="$(resolve_phrocs)"
        cd "$WORKTREE_ROOT"
        "$PHROCS_BIN" stop "$@" || true
        docker compose -p "$COMPOSE_PROJECT" -f "$WORKTREE_ROOT/docker-compose.dev.yml" down --remove-orphans 2>/dev/null || true
        echo "worktree-stack #$IDX stopped"
        ;;
    attach)
        PHROCS_BIN="$(resolve_phrocs)"
        cd "$WORKTREE_ROOT"
        exec "$PHROCS_BIN" attach
        ;;
    url)
        echo "$SITE_URL"
        ;;
    env)
        print_env
        ;;
    *)
        usage
        ;;
esac
