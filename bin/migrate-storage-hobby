#!/usr/bin/env bash

set -e
set -o pipefail

# Copies objects out of the legacy MinIO volume into the SeaweedFS services that replaced
# it. MinIO is no longer a service in docker-compose.hobby.yml, so the source is a
# temporary container mounted on the orphaned volume. Session recordings go to the
# seaweedfs service and everything else to objectstorage, because that is where the stack
# reads each of them.

MINIO_IMAGE="quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z"
SOURCE_CONTAINER="posthog-legacy-minio"
S3_KEY="object_storage_root_user"
S3_SECRET="object_storage_root_password"

# `service|destination endpoint`. query-cache is left out on purpose: PostHog rebuilds it.
ALL_SERVICES=(
    "exports|http://objectstorage:19000"
    "media-uploads|http://objectstorage:19000"
    "source-maps|http://objectstorage:19000"
    "session-recordings|http://seaweedfs:8333"
    "session-recordings-lts|http://seaweedfs:8333"
)

if command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
else
    COMPOSE=(docker compose)
fi

show_help() {
    cat <<'EOF'
Copy hobby object storage out of MinIO into SeaweedFS

PostHog replaced MinIO with SeaweedFS. SeaweedFS starts on a new volume and cannot read
the MinIO format, so your old objects sit in the `objectstorage` volume until this script
copies them across. Run it with the stack up, then check your data before you delete the
old volume.

It copies exports, uploaded media and error tracking symbol sets into objectstorage, and
session recordings into seaweedfs. Query cache is skipped because PostHog rebuilds it.

Usage:
  ./bin/migrate-storage-hobby                     Copy everything
  ./bin/migrate-storage-hobby exports             Copy one service
  ./bin/migrate-storage-hobby --dry-run           Show what would be copied
  ./bin/migrate-storage-hobby --volume <id>       Read a specific MinIO volume

Services:
  exports, media-uploads, source-maps, session-recordings, session-recordings-lts,
  query-cache

Options:
  --dry-run        List the objects instead of copying them
  --force          Overwrite objects that already exist in the destination
  --workers <n>    Number of concurrent workers (default: 5)
  --volume <id>    MinIO volume to read, if the script picks the wrong one
  --list           List the MinIO volumes on this host
EOF
}

# A MinIO data volume always has a .minio.sys directory at its root.
is_minio_volume() {
    docker run --rm -v "$1:/data:ro" alpine test -d /data/.minio.sys 2>/dev/null
}

list_minio_volumes() {
    echo "Scanning for MinIO volumes..."
    echo ""
    docker volume ls -q | while read -r vol; do
        if is_minio_volume "$vol"; then
            SIZE=$(docker run --rm -v "$vol:/data:ro" alpine du -sh /data 2>/dev/null | awk '{print $1}' || echo "unknown")
            echo "  $vol ($SIZE)"
        fi
    done
}

detect_minio_volume() {
    docker volume ls -q | while read -r vol; do
        if is_minio_volume "$vol"; then
            echo "$vol"
            return
        fi
    done
}

# The copy runs inside the plugins container, so both endpoints must be reachable on the
# stack's network. Read the network off a running service rather than guessing the compose
# project name.
compose_network() {
    local container
    container=$("${COMPOSE[@]}" ps -q objectstorage 2>/dev/null | head -1)
    if [ -z "$container" ]; then
        return 1
    fi
    docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' "$container" | head -1
}

stop_source() {
    docker rm -f "$SOURCE_CONTAINER" >/dev/null 2>&1 || true
}

start_source() {
    local volume="$1" network="$2"

    stop_source
    trap stop_source EXIT

    docker run -d \
        --name "$SOURCE_CONTAINER" \
        --network "$network" \
        -v "$volume:/data" \
        -e MINIO_ROOT_USER="$S3_KEY" \
        -e MINIO_ROOT_PASSWORD="$S3_SECRET" \
        "$MINIO_IMAGE" \
        server --address ":19000" /data >/dev/null

    for _ in $(seq 1 30); do
        if docker logs "$SOURCE_CONTAINER" 2>&1 | grep -q "API:"; then
            break
        fi
        sleep 1
    done
    sleep 2
}

# NODE_ENV=development clears the migration script's own guard against running outside a
# development environment. The plugins image ships NODE_ENV=production, and both endpoints
# here are inside the stack's network.
run_service() {
    local service="$1" endpoint="$2"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🔄 $service → $endpoint"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    "${COMPOSE[@]}" run --rm --no-deps \
        -e NODE_ENV=development \
        -e OBJECT_STORAGE_ENDPOINT="http://$SOURCE_CONTAINER:19000" \
        -e OBJECT_STORAGE_ACCESS_KEY_ID="$S3_KEY" \
        -e OBJECT_STORAGE_SECRET_ACCESS_KEY="$S3_SECRET" \
        -e SESSION_RECORDING_V2_S3_ENDPOINT="$endpoint" \
        -e SESSION_RECORDING_V2_S3_ACCESS_KEY_ID="$S3_KEY" \
        -e SESSION_RECORDING_V2_S3_SECRET_ACCESS_KEY="$S3_SECRET" \
        plugins \
        node nodejs/bin/migrate-minio-to-seaweedfs.js --service "$service" --mode migrate "${EXTRA_ARGS[@]}"
}

destination_for() {
    local service="$1" entry
    for entry in "${ALL_SERVICES[@]}"; do
        if [ "${entry%%|*}" = "$service" ]; then
            echo "${entry##*|}"
            return 0
        fi
    done
    # query-cache is a valid service that is not copied by default.
    if [ "$service" = "query-cache" ]; then
        echo "http://objectstorage:19000"
        return 0
    fi
    return 1
}

SERVICE=""
VOLUME=""
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help; exit 0 ;;
        --list)
            list_minio_volumes; exit 0 ;;
        --volume)
            VOLUME="$2"; shift 2 ;;
        --dry-run|--force)
            EXTRA_ARGS+=("$1"); shift ;;
        -n)
            EXTRA_ARGS+=("--dry-run"); shift ;;
        --workers)
            EXTRA_ARGS+=("$1" "$2"); shift 2 ;;
        *)
            if destination_for "$1" >/dev/null; then
                SERVICE="$1"; shift
            else
                echo "Unknown argument: $1"
                echo "Run with --help to see the services and options."
                exit 1
            fi ;;
    esac
done

if [ -z "$VOLUME" ]; then
    VOLUME=$(detect_minio_volume)
fi

if [ -z "$VOLUME" ]; then
    echo "No MinIO volume found on this host, so there is nothing to copy."
    echo "If you moved the data, pass the volume with --volume <id>."
    exit 0
fi

if ! is_minio_volume "$VOLUME"; then
    echo "❌ Volume $VOLUME holds no MinIO data (no .minio.sys directory)."
    exit 1
fi

NETWORK=$(compose_network || true)
if [ -z "$NETWORK" ]; then
    echo "❌ The objectstorage service is not running."
    echo "Start the stack with 'docker-compose up -d', then run this again."
    exit 1
fi

SIZE=$(docker run --rm -v "$VOLUME:/data:ro" alpine du -sh /data 2>/dev/null | awk '{print $1}' || echo "unknown")
echo ""
echo "MinIO volume: $VOLUME ($SIZE)"
echo "Stack network: $NETWORK"
echo ""
read -r -p "Copy these objects into SeaweedFS? [y/N] " confirm
if [[ ! "$confirm" =~ ^([yY][eE][sS]|[yY])+$ ]]; then
    echo "Cancelled."
    exit 0
fi

echo ""
echo "Starting a temporary MinIO container to read the old volume..."
start_source "$VOLUME" "$NETWORK"

if [ -n "$SERVICE" ]; then
    run_service "$SERVICE" "$(destination_for "$SERVICE")"
else
    for entry in "${ALL_SERVICES[@]}"; do
        run_service "${entry%%|*}" "${entry##*|}"
    done
fi

stop_source
trap - EXIT

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Copy finished"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Check your exports, media and recordings in PostHog. Once they look right,"
echo "free the disk space with:"
echo ""
echo "  docker volume rm $VOLUME"
echo ""
