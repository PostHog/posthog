#!/bin/bash
set -e

# Callers pass --skip-checks when the process does not serve the URLconf. Django's system checks
# resolve it, which imports every product's API module graph into a process that never uses it.
if [ -z "$POSTHOG_SKIP_MIGRATION_CHECKS" ]; then
	python manage.py migrate --check "$@"
	python manage.py migrate_clickhouse --check "$@"
	python manage.py run_async_migrations --check "$@"
fi
