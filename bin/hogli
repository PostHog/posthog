#!/bin/bash
# Wrapper that ensures venv is active before running hogli.
# Needed for git hooks / lint-staged which may run outside an activated shell.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_CMD="python"

if [ -z "${VIRTUAL_ENV:-}" ]; then
    # Only local venvs are considered here. Standalone hogli must never adopt
    # the main clone's venv: commands like `uv sync --active` would rewrite it
    # against this worktree. Hooks that need borrowing export VIRTUAL_ENV via
    # bin/helpers/worktree-borrow.sh before hogli runs.
    FOUND_VENV=""
    if [ -f "$REPO_ROOT/bin/helpers/worktree-borrow.sh" ]; then
        source "$REPO_ROOT/bin/helpers/worktree-borrow.sh"
        FOUND_VENV="$(posthog_find_venv "$REPO_ROOT")"
    fi

    if [ -n "$FOUND_VENV" ]; then
        source "$FOUND_VENV/bin/activate"
        PYTHON_CMD="$FOUND_VENV/bin/python"
    fi
else
    PYTHON_CMD="$VIRTUAL_ENV/bin/python"
fi

# Linked worktrees borrow the main clone's venv, whose editable .pth files name one
# checkout. A `uv sync` run inside any worktree repoints them at that worktree, after
# which every other checkout runs that worktree's hogli and fails on imports it does
# not have. Warn when a .pth names a checkout that is neither this one nor main.
HOGLI_TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# Resolved with git only: sourcing a helper from whatever checkout cwd is in would run its code.
HOGLI_MAIN="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo /)")"

# Migration aid: after the common/hogli/ -> tools/hogli/ + tools/hogli-commands/
# restructure, users with stale venvs see `ModuleNotFoundError: hogli`. Catch it
# early and point at `uv sync`. Safe to delete once everyone has re-activated.
# -P keeps the current directory off sys.path. Hooks run this from the worktree
# being checked out, whose branch could otherwise ship a `hogli` package that
# shadows the installed one.
HOGLI_PROBE="$("$PYTHON_CMD" -P -c '
import pathlib, site, sys, hogli
roots = [pathlib.Path(p).resolve() for p in sys.argv[1:] if p] + [pathlib.Path(sys.prefix).resolve()]
foreign = set()
for pth in (p for d in site.getsitepackages() for p in pathlib.Path(d).glob("*.pth")) if sys.argv[1] else ():
    for line in pth.read_text().splitlines():
        if line.startswith("/") and not any(pathlib.Path(line).resolve().is_relative_to(r) for r in roots):
            foreign.add(line)
print("\n".join(sorted(foreign)))
' "$HOGLI_TOPLEVEL" "$HOGLI_MAIN" 2>&1)" || true
case "$HOGLI_PROBE" in
    *"No module named 'hogli'"*)
        cat >&2 <<'EOF'
error: the `hogli` package is not importable from your active venv.

It recently moved to tools/hogli/ (framework) + tools/hogli-commands/ (commands).
Your venv has stale paths — re-sync it:

    flox activate            # recommended (flox auto-runs uv sync)
    uv sync --active         # or sync directly

Then rerun your hogli command.
EOF
        exit 127
        ;;
    /*)
        cat >&2 <<EOF
warning: this venv loads editable packages from another checkout:
$HOGLI_PROBE
A \`uv sync\` run inside that worktree repointed the shared venv. Sync from the main clone:

    flox activate -d ${HOGLI_MAIN:-$HOGLI_TOPLEVEL} -- uv sync

EOF
        ;;
esac

exec "$PYTHON_CMD" -P -m hogli "$@"
