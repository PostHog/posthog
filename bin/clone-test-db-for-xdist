#!/usr/bin/env bash
# Clone the migrated test databases into per-worker copies for pytest-xdist, so
# `pytest -n N --reuse-db` starts without re-running Django and sqlx migrations on
# every worker.
#
# The database list comes from the code that owns the names, not from whatever
# `test_posthog_*` rows happen to exist: posthog/conftest.py derives the persons
# database and one database per route in products/db_routing.yaml. Reading the live
# server instead would silently clone nothing when the sources are not built yet.
#
# Usage: bin/clone-test-db-for-xdist <num_workers> [source_db]
set -euo pipefail

WORKERS="${1:?usage: clone-test-db-for-xdist <num_workers> [source_db]}"
SOURCE_DB="${2:-test_posthog}"

PGHOST="${PGHOST:-localhost}"
PGPORT="${PGPORT:-5432}"
PGUSER="${PGUSER:-posthog}"
export PGPASSWORD="${PGPASSWORD:-posthog}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# "persons" plus every product route, matching posthog/conftest.py.
mapfile -t SUFFIXES < <(
    cd "$REPO_ROOT" && python -c "
from posthog.product_db_config import load_product_db_routes

print('persons')
for route in load_product_db_routes('.'):
    print(route.database)
" | sort -u
)

statements=""
for suffix in "" "${SUFFIXES[@]}"; do
    src="${SOURCE_DB}${suffix:+_$suffix}"
    for i in $(seq 0 $((WORKERS - 1))); do
        dest="${SOURCE_DB}_gw${i}${suffix:+_$suffix}"
        # TEMPLATE needs the source idle, and a missing source is not fatal: the worker
        # falls back to building that database itself.
        statements+="
DO \$\$ BEGIN PERFORM pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${src}' AND pid <> pg_backend_pid(); END \$\$;
DROP DATABASE IF EXISTS ${dest};
CREATE DATABASE ${dest} TEMPLATE ${src};
\\echo cloned ${src} -> ${dest}
"
    done
done

# One session for every statement, rather than a psql process per statement.
printf '%s' "$statements" | psql -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d postgres -qAt -f - 2>&1 |
    grep -v '^NOTICE:' || true
