#!/usr/bin/env bash
# Render a Jest test-speed report from a timings JSON file.
#
# The heavy lifting (JUnit parsing, in-band window reconstruction, shard metrics)
# lives in .github/scripts/report_test_timings.py; this script turns that JSON into
# a readable report: per-shard rollups, slowdown distribution, slowest tests, the
# serial suite's per-file launch+teardown table, and a scaling model that shows
# what adding more shards actually buys once the fixed per-shard setup cost is
# paid again.
#
# Inputs (pick one):
#   --timings PATH   timings JSON emitted by `report_test_timings.py --timings PATH`
#   --artifacts DIR  downloaded JUnit artifacts dir (junit-results-* subdirs, or flat);
#                    invokes the python script for you
#   --stdin          read timings JSON from stdin
#
# Options: --runner jest|pytest (default jest), --top N (default all), --suite NAME
# (filter to one suite), --markdown (GitHub-friendly output, no ANSI),
# --markdown-overview, --markdown-page N, --uv PATH.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TIMINGS_PY="$REPO_ROOT/.github/scripts/report_test_timings.py"

MODE=""
SOURCE=""
RUNNER="jest"
TOP=1000000
SUITE=""
MARKDOWN=0
MARKDOWN_OVERVIEW=0
MARKDOWN_PAGE=0
UV="${UV:-uv}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --timings) MODE="timings"; SOURCE="$2"; shift 2 ;;
        --artifacts) MODE="artifacts"; SOURCE="$2"; shift 2 ;;
        --stdin) MODE="stdin"; shift ;;
        --runner) RUNNER="$2"; shift 2 ;;
        --top) TOP="$2"; shift 2 ;;
        --suite) SUITE="$2"; shift 2 ;;
        --markdown) MARKDOWN=1; shift ;;
        --markdown-overview) MARKDOWN=1; MARKDOWN_OVERVIEW=1; shift ;;
        --markdown-page) MARKDOWN=1; MARKDOWN_PAGE="$2"; shift 2 ;;
        --uv) UV="$2"; shift 2 ;;
        -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

if [[ -z "$MODE" ]]; then
    echo "usage: report-jest-timings --timings PATH | --artifacts DIR | --stdin [--top N] [--suite NAME] [--markdown]" >&2
    exit 2
fi

TMP_JSON=""
cleanup() {
    if [[ -n "$TMP_JSON" ]]; then
        rm -f "$TMP_JSON"
    fi
}
trap cleanup EXIT

if [[ "$MODE" == "timings" ]]; then
    JSON_FILE="$SOURCE"
    [[ -f "$JSON_FILE" ]] || { echo "timings file not found: $JSON_FILE" >&2; exit 1; }
elif [[ "$MODE" == "artifacts" ]]; then
    TMP_JSON="$(mktemp -t jest-timings.XXXXXX.json)"
    "$UV" run --script "$TIMINGS_PY" --runner="$RUNNER" --timings "$TMP_JSON" "$SOURCE" 1>&2
    JSON_FILE="$TMP_JSON"
else
    TMP_JSON="$(mktemp -t jest-timings.XXXXXX.json)"
    cat > "$TMP_JSON"
    JSON_FILE="$TMP_JSON"
fi

export RT_JSON="$JSON_FILE" RT_TOP="$TOP" RT_SUITE="$SUITE" RT_MARKDOWN="$MARKDOWN" RT_MARKDOWN_OVERVIEW="$MARKDOWN_OVERVIEW" RT_MARKDOWN_PAGE="$MARKDOWN_PAGE"

python3 - <<'PY'
import json
import os
import sys

TOP = int(os.environ["RT_TOP"])
SUITE = os.environ["RT_SUITE"]
MARKDOWN = os.environ["RT_MARKDOWN"] == "1"
MARKDOWN_OVERVIEW = os.environ["RT_MARKDOWN_OVERVIEW"] == "1"
MARKDOWN_PAGE = int(os.environ["RT_MARKDOWN_PAGE"])
MARKDOWN_PAGE_SIZE = 1000
BOLD = "" if MARKDOWN else "\033[1m"
DIM = "" if MARKDOWN else "\033[2m"
RST = "" if MARKDOWN else "\033[0m"

with open(os.environ["RT_JSON"]) as fh:
    report = json.load(fh)

shards = [s for s in report.get("shards", []) if not SUITE or s.get("suite") == SUITE]
if not shards:
    print("No shard data in report.", file=sys.stderr)
    sys.exit(0)


def fmt(seconds: float) -> str:
    seconds = max(0.0, seconds)
    if seconds < 60:
        return f"{seconds:.2f}s".rstrip("0").rstrip(".")
    if seconds < 3600:
        minutes, remainder = divmod(round(seconds), 60)
        return f"{minutes}m{remainder:02d}s"
    hours, remainder = divmod(round(seconds), 3600)
    return f"{hours}h{remainder // 60:02d}m"


def name_width(entries, key, cap=68):
    return min(cap, max((len(str(e[key])) for e in entries), default=8))


total_wall = sum(s["wall_seconds"] for s in shards)
total_test = sum(s["testcase_seconds"] for s in shards)
total_launch = sum(s.get("launch_seconds", 0.0) for s in shards)
all_counts = sum(s["test_count"] for s in shards)
sum_median = sorted(s["median_test_seconds"] for s in shards)
sum_p90 = sorted(s["p90_test_seconds"] for s in shards)
sum_max = sorted(s["max_test_seconds"] for s in shards)
rows = []
for s in shards:
    for t in s.get("slowest_tests", []):
        rows.append({"shard": s["junit_filename"], "name": t["name"], "file": t["file"],
                     "d": t["duration_seconds"], "offset": t.get("start_offset_seconds")})
rows.sort(key=lambda r: r["d"], reverse=True)
launch_rows = []
for s in shards:
    for file, launch in (s.get("per_file_launch_overhead_seconds") or {}).items():
        launch_rows.append({"file": file, "launch": launch, "shard": s["junit_filename"]})
walls = [s["wall_seconds"] for s in shards]
mean_wall = total_wall / len(walls)
fixed = 240  # CI-observed per-shard fixed cost: services boot + schema restore + addon build.

def markdown_cell(value: object) -> str:
    return str(value).replace("\\", "\\\\").replace("|", "\\|").replace("\n", "<br>")


def markdown_table(headers: list[str], values: list[list[str]]) -> None:
    print("| " + " | ".join(headers) + " |")
    print("| " + " | ".join("---:" if index == 0 else "---" for index in range(len(headers))) + " |")
    for value in values:
        print("| " + " | ".join(value) + " |")


if MARKDOWN:
    if MARKDOWN_PAGE:
        start = (MARKDOWN_PAGE - 1) * MARKDOWN_PAGE_SIZE
        page_rows = rows[start : start + MARKDOWN_PAGE_SIZE]
        if not page_rows:
            sys.exit(0)
        end = start + len(page_rows)
        print(f"# Jest test-speed report — individual tests {start + 1:,}–{end:,}")
        print("Ordered by duration across the complete run.")
        print()
        markdown_table(
            ["Duration", "Test", "File", "Shard", "Started"],
            [
                [
                    fmt(row["d"]),
                    markdown_cell(row["name"]),
                    f"`{markdown_cell(row['file'])}`",
                    f"`{markdown_cell(row['shard'])}`",
                    f"+{fmt(row['offset'])}" if row["offset"] is not None else "—",
                ]
                for row in page_rows
            ],
        )
        sys.exit(0)

    slowest_shard = max(shards, key=lambda shard: shard["wall_seconds"])
    print("# Jest test-speed report")
    print(f"`{report.get('runner')}` · {len(shards)} shards · {all_counts} tests · suites: {', '.join(report.get('suites', []))}")
    print()
    print("## At a glance")
    markdown_table(
        ["Metric", "Time"],
        [
            ["Jest runner time (sum of shards)", fmt(total_wall)],
            ["Test-body time (sum)", fmt(total_test)],
            ["Startup + teardown (sum)", fmt(total_launch)],
            ["Slowest individual test", fmt(sum_max[-1])],
            ["Longest shard", f"{markdown_cell(slowest_shard['junit_filename'])} ({fmt(slowest_shard['wall_seconds'])})"],
        ],
    )
    print()
    if not MARKDOWN_OVERVIEW:
        print("## All individual tests — slowest first")
        print("Every Jest testcase from this run, ordered by duration.")
        markdown_table(
            ["Duration", "Test", "File", "Shard", "Started"],
            [
                [
                    fmt(row["d"]),
                    markdown_cell(row["name"]),
                    f"`{markdown_cell(row['file'])}`",
                    f"`{markdown_cell(row['shard'])}`",
                    f"+{fmt(row['offset'])}" if row["offset"] is not None else "—",
                ]
                for row in rows[:TOP]
            ],
        )
        print()
    print("## Shard balance")
    markdown_table(
        ["Shard", "Tests", "Jest runner", "Test bodies", "Startup + teardown"],
        [
            [
                f"`{markdown_cell(shard['junit_filename'])}`",
                str(shard["test_count"]),
                fmt(shard["wall_seconds"]),
                fmt(shard["testcase_seconds"]),
                fmt(shard.get("launch_seconds", 0.0)),
            ]
            for shard in sorted(shards, key=lambda shard: shard["wall_seconds"], reverse=True)
        ],
    )
    print()
    print("## Test-time distribution")
    markdown_table(
        ["Tests", "Shard median range", "Shard p90 range", "Slowest test"],
        [[str(all_counts), f"{fmt(sum_median[0])} – {fmt(sum_median[-1])}", f"{fmt(sum_p90[0])} – {fmt(sum_p90[-1])}", fmt(sum_max[-1])]],
    )
    print()
    if launch_rows:
        print("<details>")
        print("<summary><strong>Per-file startup + teardown</strong></summary>")
        print()
        print("Time not billed to an individual test: module imports, setup files, worker boot, and teardown.")
        print()
        markdown_table(
            ["Overhead", "File", "Shard"],
            [
                [fmt(row["launch"]), f"`{markdown_cell(row['file'])}`", f"`{markdown_cell(row['shard'])}`"]
                for row in sorted(launch_rows, key=lambda row: row["launch"], reverse=True)[:TOP]
            ],
        )
        print()
        print("</details>")
        print()
    print("<details>")
    print("<summary><strong>Shard scaling estimate</strong></summary>")
    print()
    print(f"Current shard spread: {fmt(min(walls))} – {fmt(max(walls))} (mean {fmt(mean_wall)}).")
    print()
    markdown_table(
        ["Shards", "Estimated CI time"],
        [[str(count), fmt(fixed + total_wall / count)] for count in range(len(shards), 11)],
    )
    print()
    print("Estimate includes the ~4 minute per-shard services, schema, and build cost.")
    print()
    print("</details>")
    print()
    if MARKDOWN_OVERVIEW:
        print("> Every individual test appears in the following summary pages, ordered slowest first.")
    else:
        print("> Full per-test history is also emitted to OTLP traces (`ci-nodejs` / `ci-frontend`) and the weekly slow-tests report.")
else:
    print(f"{BOLD}Jest test-speed report{RST}  runner={report.get('runner')}  suites={','.join(report.get('suites', []))}")
    print()
    print(f"{BOLD}Shards{RST}")
    print(f"  {len(shards)} shard(s) | runner {fmt(total_wall)} | test bodies {fmt(total_test)} | startup + teardown {fmt(total_launch)}")
    width = name_width(shards, "junit_filename")
    for shard in sorted(shards, key=lambda shard: shard["wall_seconds"], reverse=True):
        print(f"  {DIM}{shard['junit_filename']:<{width}}{RST}  runner {fmt(shard['wall_seconds']):>8}  tests {shard['test_count']:>4}  bodies {fmt(shard['testcase_seconds']):>8}")
    print()
    print(f"{BOLD}Individual tests, slowest first{RST}")
    width = name_width(rows, "name", cap=56)
    for row in rows[:TOP]:
        print(f"  {fmt(row['d']):>8}  {DIM}{row['name'][:width]:<{width}}{RST}  {DIM}{row['file']}{RST}")
PY
