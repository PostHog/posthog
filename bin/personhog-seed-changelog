#!/bin/sh
# Seeds config/changelog for local dev only when it is absent, so a local migration's config survives restarts.
set -e

ETCD_URL="${ETCD_URL:-http://localhost:2379}"
ETCD_PREFIX="${ETCD_PREFIX:-/personhog/}"
VALUE='{"topic":"personhog_updates","partitions":4,"epoch":1,"writer_group":"personhog-writer","draining":[]}'

b64() { printf %s "$1" | base64 | tr -d '\n'; }
KEY=$(b64 "${ETCD_PREFIX}config/changelog")
# The services still read the partition count from the legacy key.
LEGACY_KEY=$(b64 "${ETCD_PREFIX}config/total_partitions")

curl -sf -X POST "$ETCD_URL/v3/kv/put" -d "{\"key\": \"$LEGACY_KEY\", \"value\": \"$(b64 4)\"}"
echo
curl -sf -X POST "$ETCD_URL/v3/kv/txn" -d "{
  \"compare\": [{\"key\": \"$KEY\", \"target\": \"CREATE\", \"result\": \"EQUAL\", \"create_revision\": \"0\"}],
  \"success\": [{\"request_put\": {\"key\": \"$KEY\", \"value\": \"$(b64 "$VALUE")\"}}]
}"
echo
echo 'etcd init complete'
