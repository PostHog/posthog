#!/usr/bin/env python3
import os
import sys
import logging

from prometheus_client import CollectorRegistry, Gauge, push_to_gateway


def main() -> None:
    address = os.environ.get("PROM_PUSHGATEWAY_ADDRESS")
    job_name = os.environ.get("MIGRATION_JOB_NAME")
    namespace = os.environ.get("MIGRATION_NAMESPACE")
    if not address or not job_name or not namespace:
        return

    phase = sys.argv[1]
    registry = CollectorRegistry()
    outcome = Gauge(
        "django_migration_outcome",
        "Latest migration pod outcome (1 = failed or not yet complete)",
        ["phase", "job_name", "namespace"],
        registry=registry,
    )
    outcome.labels(phase=phase, job_name=job_name, namespace=namespace).set(int(phase != "none"))

    try:
        push_to_gateway(
            address,
            job="django_migrate_outcome",
            grouping_key={"instance": "posthog"},
            registry=registry,
            timeout=5,
        )
    except Exception as exc:
        logging.exception("Failed to push migration outcome: %s", exc)


if __name__ == "__main__":
    main()
