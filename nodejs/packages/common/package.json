{
    "name": "@posthog/node-common",
    "version": "0.0.0",
    "description": "PostHog's shared Node service library: logger, Postgres, Redis, Kafka client and outputs, team lookup, personhog client, and the domain types.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog.git",
        "directory": "nodejs/packages/common"
    },
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "exports": {
        "./types": {
            "types": "./dist/types.d.ts",
            "default": "./dist/types.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./plugin-scaffold": {
            "types": "./dist/plugin-scaffold.d.ts",
            "default": "./dist/plugin-scaffold.js"
        },
        "./lifecycle": {
            "types": "./dist/lifecycle.d.ts",
            "default": "./dist/lifecycle.js"
        },
        "./metrics": {
            "types": "./dist/metrics.d.ts",
            "default": "./dist/metrics.js"
        },
        "./clickhouse-config": {
            "types": "./dist/clickhouse-config.d.ts",
            "default": "./dist/clickhouse-config.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typescript:check": "tsc --noEmit -p .",
        "test": "jest --runInBand --forceExit",
        "prepublishOnly": "pnpm build",
        "generate:usage-ingestion-proto": "cd ../../../proto && buf generate --template ../nodejs/packages/common/buf.gen.usage-ingestion.yaml --path usage_ingestion . && cd ../nodejs/packages/common && prettier --write src/generated/usage-ingestion",
        "lint": "oxlint -c .oxlintrc.nodejs.json .",
        "lint:fix": "oxlint -c .oxlintrc.nodejs.json . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.11.0",
        "@clickhouse/client": "^1.12.0",
        "@connectrpc/connect": "^2.1.1",
        "@connectrpc/connect-node": "^2.1.1",
        "@maxmind/geoip2-node": "^3.4.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.76.0",
        "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
        "@opentelemetry/resources": "^2.12.0",
        "@opentelemetry/sdk-metrics": "^2.12.0",
        "@opentelemetry/sdk-node": "^0.218.0",
        "@opentelemetry/sdk-trace-node": "^2.0.1",
        "@opentelemetry/semantic-conventions": "^1.44.0",
        "@pyroscope/nodejs": "^0.7.0",
        "cors": "^2.8.6",
        "fastpriorityqueue": "^0.8.0",
        "generic-pool": "^3.7.1",
        "ioredis": "^4.31.0",
        "ipaddr.js": "^2.1.0",
        "lodash": "^4.18.1",
        "lru-cache": "^11.5.3",
        "luxon": "^3.4.4",
        "node-rdkafka": "^3.6.1",
        "node-schedule": "^2.1.2",
        "pg": "^8.23.0",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "posthog-node": "5.67.0",
        "prom-client": "^15.1.3",
        "re2": "^1.26.1",
        "snappy": "^7.2.2",
        "ultimate-express": "2.0.13",
        "undici": "^8.12.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.11.0",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/cors": "^2.8.19",
        "@types/ioredis": "^4.26.4",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.27",
        "@types/long": "4.x.x",
        "@types/luxon": "^3.4.2",
        "@types/node": "catalog:",
        "@types/node-schedule": "^2.1.8",
        "@types/pg": "~8.11.2",
        "@types/supertest": "^7.2.1",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "jest": "^30.0.0",
        "jest-junit": "^16.0.0",
        "node-fetch": "^2.6.1",
        "oxlint": "1.78.0",
        "oxlint-plugin-eslint": "1.78.0",
        "oxlint-tsgolint": "7.0.2005",
        "prettier": "~3.6.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.6",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.15",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
