{
    "name": "@posthog/hog-engine",
    "version": "0.0.0",
    "description": "The hog transformation engine: hog function execution, legacy plugins, inputs, monitoring and the types behind them.",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog.git",
        "directory": "nodejs/packages/hog-engine"
    },
    "license": "MIT",
    "files": [
        "dist",
        "assets"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        "./types": {
            "types": "./dist/types.d.ts",
            "default": "./dist/types.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typescript:check": "tsc --noEmit -p .",
        "test": "jest --runInBand --forceExit",
        "lint": "oxlint -c ../../.oxlintrc.nodejs.json .",
        "lint:fix": "oxlint -c ../../.oxlintrc.nodejs.json . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "pnpm build"
    },
    "engines": {
        "node": ">=26 <27"
    },
    "peerDependencies": {
        "@posthog/hogvm-node": "*",
        "@posthog/node-common": "*"
    },
    "dependencies": {
        "@google-cloud/pubsub": "6.3.2",
        "@google-cloud/storage": "^5.8.5",
        "@posthog/hogvm": "workspace:*",
        "detect-browser": "^5.3.0",
        "fernet-nodejs": "^1.0.6",
        "jsonwebtoken": "^9.0.3",
        "liquidjs": "^10.27.2",
        "lru-cache": "^11.5.3",
        "luxon": "^3.4.4",
        "prom-client": "^15.1.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@maxmind/geoip2-node": "^3.4.0",
        "@posthog/hogvm-node": "workspace:*",
        "@posthog/node-common": "workspace:*",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/long": "4.x.x",
        "@types/luxon": "^3.4.2",
        "@types/node": "catalog:",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "jest": "^30.0.0",
        "jest-junit": "^16.0.0",
        "node-fetch": "^2.6.1",
        "oxlint": "1.78.0",
        "oxlint-plugin-eslint": "1.78.0",
        "oxlint-tsgolint": "7.0.2005",
        "prettier": "~3.6.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.6",
        "tsconfig-paths": "^4.2.0",
        "typescript": "catalog:"
    }
}
