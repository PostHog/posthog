{
    "name": "@posthog/replay-storage",
    "version": "0.0.0",
    "description": "Session replay's storage library: the keystore, crypto, session metadata and feature stores, outputs and configuration shared by the replay ingestion pipeline and the recording API.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog.git",
        "directory": "nodejs/packages/replay-storage"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typescript:check": "tsc --noEmit -p .",
        "test": "jest --runInBand --forceExit",
        "lint": "oxlint -c .oxlintrc.json .",
        "lint:fix": "oxlint -c .oxlintrc.json . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.952.0",
        "@aws-sdk/client-kms": "^3.952.0",
        "@aws-sdk/client-s3": "^3.723.0",
        "@dsnp/parquetjs": "^1.8.7",
        "@posthog/ingestion-common": "workspace:*",
        "@posthog/node-common": "workspace:*",
        "libsodium-wrappers": "^0.8.4",
        "lru-cache": "^11.5.3",
        "luxon": "^3.4.4",
        "node-rdkafka": "^3.6.1",
        "prom-client": "^15.1.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.11.0",
        "@opentelemetry/sdk-trace-node": "^2.0.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/jest": "^30.0.0",
        "@types/long": "4.x.x",
        "@types/luxon": "^3.4.2",
        "@types/node": "catalog:",
        "@types/pg": "~8.11.2",
        "ioredis": "^4.31.0",
        "jest": "^30.0.0",
        "jest-junit": "^16.0.0",
        "node-fetch": "^2.6.1",
        "oxlint": "1.78.0",
        "oxlint-plugin-eslint": "1.78.0",
        "oxlint-tsgolint": "7.0.2005",
        "prettier": "~3.6.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.6",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.15",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
