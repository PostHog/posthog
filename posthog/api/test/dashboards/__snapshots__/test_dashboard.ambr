# ---
# name: TestDashboard.test_adding_insights_is_not_nplus1_for_gets.96
  '''
  SELECT 1 AS "a"
  FROM "posthog_sharingconfiguration"
  WHERE ("posthog_sharingconfiguration"."enabled"
         AND ("posthog_sharingconfiguration"."expires_at" IS NULL
              OR "posthog_sharingconfiguration"."expires_at" > 'SHARING-EXPIRY-TIMESTAMP'::timestamptz)
         AND "posthog_sharingconfiguration"."dashboard_id" = 99999
         AND "posthog_sharingconfiguration"."team_id" = 99999)
  LIMIT 1
  '''
# ---
# name: TestDashboard.test_adding_insights_is_not_nplus1_for_gets.97
  '''
  SELECT 1 AS "a"
  FROM "posthog_subscription"
  WHERE (NOT "posthog_subscription"."deleted"
         AND "posthog_subscription"."enabled"
         AND "posthog_subscription"."dashboard_id" = 99999
         AND NOT (EXISTS
                    (SELECT 1 AS "a"
                     FROM "posthog_subscription_dashboard_export_insights" "U1"
                     INNER JOIN "posthog_dashboarditem" "U2" ON ("U1"."insight_id" = "U2"."id")
                     WHERE (NOT "U2"."deleted"
                            AND "U1"."subscription_id" = ("posthog_subscription"."id"))
                     LIMIT 1)))
  LIMIT 1
  '''
