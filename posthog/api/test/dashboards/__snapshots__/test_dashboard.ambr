         "posthog_sharingconfiguration"."settings",
         "posthog_sharingconfiguration"."password_required"
  FROM "posthog_sharingconfiguration"
  WHERE "posthog_sharingconfiguration"."dashboard_id" IN (1,
                                                          2,
                                                          3,
                                                          4,
                                                          5 /* ... */)
  '''
