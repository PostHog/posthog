# ---
# name: TestDashboard.test_listing_dashboards_is_not_nplus1.41
  '''
  SELECT 1 AS "a"
  FROM "posthog_filesystemshortcut"
  INNER JOIN "posthog_team" ON ("posthog_filesystemshortcut"."team_id" = "posthog_team"."id")
  WHERE (("posthog_filesystemshortcut"."surface" IS NULL
          OR "posthog_filesystemshortcut"."surface" = 'web')
         AND "posthog_team"."project_id" = 99999
         AND "posthog_filesystemshortcut"."user_id" = 99999
         AND "posthog_filesystemshortcut"."ref" IS NULL
         AND NOT ("posthog_filesystemshortcut"."type" = 'folder'))
  LIMIT 1
  '''
# ---
# name: TestDashboard.test_listing_dashboards_is_not_nplus1.410
  '''
  SELECT "ee_accesscontrol"."id",
