          OR "posthog_filesystemshortcut"."surface" = 'web')
         AND "posthog_team"."project_id" = 99999
         AND "posthog_filesystemshortcut"."user_id" = 99999
         AND "posthog_filesystemshortcut"."ref" IS NULL
         AND NOT ("posthog_filesystemshortcut"."type" = 'folder'))
  LIMIT 1
