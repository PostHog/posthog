         "T11"."credentials_reviewed_at",
         "T11"."requested_password_reset_at",
         "T11"."requested_2fa_reset_at",
         "T11"."has_seen_product_intro_for",
         "T11"."strapi_id",
         "T11"."is_active",
         "T11"."role_at_organization",
