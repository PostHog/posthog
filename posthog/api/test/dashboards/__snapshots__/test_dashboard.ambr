  LEFT OUTER JOIN "posthog_text" ON ("posthog_dashboardtile"."text_id" = "posthog_text"."id")
  LEFT OUTER JOIN "posthog_buttontile" ON ("posthog_dashboardtile"."button_tile_id" = "posthog_buttontile"."id")
  LEFT OUTER JOIN "posthog_dashboardwidget" ON ("posthog_dashboardtile"."widget_id" = "posthog_dashboardwidget"."id")
  LEFT OUTER JOIN "posthog_user" "T10" ON ("posthog_dashboardwidget"."created_by_id" = "T10"."id")
  LEFT OUTER JOIN "posthog_user" "T11" ON ("posthog_dashboardwidget"."last_modified_by_id" = "T11"."id")
  WHERE (NOT ("posthog_dashboardtile"."deleted"
              AND "posthog_dashboardtile"."deleted" IS NOT NULL)
         AND NOT ("posthog_dashboard"."deleted")
         AND "posthog_dashboardtile"."dashboard_id" = 99999
         AND NOT ("posthog_dashboard"."deleted"
                  AND "posthog_dashboardtile"."deleted"
                  AND "posthog_dashboardtile"."deleted" IS NOT NULL)
         AND (NOT "posthog_dashboarditem"."deleted"
              OR "posthog_dashboardtile"."insight_id" IS NULL))
  ORDER BY "posthog_dashboarditem"."order" ASC
  '''
