         "T11"."partial_notification_settings",
         "T11"."anonymize_data",
         "T11"."allow_impersonation",
         "T11"."toolbar_mode",
         "T11"."hedgehog_config",
         "T11"."allow_sidebar_suggestions",
         "T11"."shortcut_position",
         "T11"."passkeys_enabled_for_2fa",
         "T11"."hide_mcp_hints",
         "T11"."ui_configuration",
         "T11"."onboarding_skipped_at",
         "T11"."onboarding_skipped_reason",
         "T11"."onboarding_skipped_organization_id",
         "T11"."onboarding_delegated_to_invite_id",
         "T11"."onboarding_delegated_to_organization_id",
         "T11"."onboarding_delegation_accepted_at",
         "T11"."events_column_config",
         "T11"."email_opt_in"
  FROM "posthog_dashboardtile"
  INNER JOIN "posthog_dashboard" ON ("posthog_dashboardtile"."dashboard_id" = "posthog_dashboard"."id")
  LEFT OUTER JOIN "posthog_dashboarditem" ON ("posthog_dashboardtile"."insight_id" = "posthog_dashboarditem"."id")
  LEFT OUTER JOIN "posthog_team" ON ("posthog_dashboarditem"."team_id" = "posthog_team"."id")
  LEFT OUTER JOIN "posthog_user" ON ("posthog_dashboarditem"."created_by_id" = "posthog_user"."id")
  LEFT OUTER JOIN "posthog_user" "T6" ON ("posthog_dashboarditem"."last_modified_by_id" = "T6"."id")
  LEFT OUTER JOIN "posthog_text" ON ("posthog_dashboardtile"."text_id" = "posthog_text"."id")
  LEFT OUTER JOIN "posthog_buttontile" ON ("posthog_dashboardtile"."button_tile_id" = "posthog_buttontile"."id")
  LEFT OUTER JOIN "posthog_dashboardwidget" ON ("posthog_dashboardtile"."widget_id" = "posthog_dashboardwidget"."id")
  LEFT OUTER JOIN "posthog_user" "T10" ON ("posthog_dashboardwidget"."created_by_id" = "T10"."id")
  LEFT OUTER JOIN "posthog_user" "T11" ON ("posthog_dashboardwidget"."last_modified_by_id" = "T11"."id")
  WHERE (NOT ("posthog_dashboardtile"."deleted"
              AND "posthog_dashboardtile"."deleted" IS NOT NULL)
         AND NOT ("posthog_dashboard"."deleted")
         AND "posthog_dashboardtile"."dashboard_id" = 99999
         AND NOT ("posthog_dashboard"."deleted"
                  AND "posthog_dashboardtile"."deleted"
                  AND "posthog_dashboardtile"."deleted" IS NOT NULL)
         AND (NOT "posthog_dashboarditem"."deleted"
              OR "posthog_dashboardtile"."insight_id" IS NULL))
  ORDER BY "posthog_dashboarditem"."order" ASC
  '''
