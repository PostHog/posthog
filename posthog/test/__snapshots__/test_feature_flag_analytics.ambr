# serializer version: 1
# name: TestFeatureFlagAnalytics.test_efficient_querying_of_team_decide_usage_data
  '''
  SELECT "posthog_team"."id",
         "posthog_team"."uuid"
  FROM "posthog_team"
  WHERE (NOT ("posthog_team"."is_demo")
         AND NOT ("posthog_team"."organization_id" IN
                    (SELECT U0."id" AS "id"
                     FROM "posthog_organization" U0
                     WHERE U0."for_internal_metrics")))
  '''
# ---
