# serializer version: 1
# name: TestClickhouseSessionRecordingsListFromQuery.test_effect_of_poe_settings_on_query_generated_0_test_poe_v1_still_falls_back_to_person_subquery[new_events_schema]
  '''
  SELECT s.session_id AS session_id,
         any(s.team_id) AS `any(s.team_id)`,
         any(s.distinct_id) AS `any(s.distinct_id)`,
         min(toTimeZone(s.min_first_timestamp, %(hogql_val_0)s)) AS start_time,
         max(toTimeZone(s.max_last_timestamp, %(hogql_val_1)s)) AS end_time,
         dateDiff(%(hogql_val_2)s, start_time, end_time) AS duration,
         argMinMerge(s.first_url) AS first_url,
         sum(s.click_count) AS click_count,
         sum(s.keypress_count) AS keypress_count,
         sum(s.mouse_activity_count) AS mouse_activity_count,
         divide(sum(s.active_milliseconds), 1000) AS active_seconds,
         minus(duration, active_seconds) AS inactive_seconds,
         sum(s.console_log_count) AS console_log_count,
         sum(s.console_warn_count) AS console_warn_count,
         sum(s.console_error_count) AS console_error_count,
         max(s.retention_period_days) AS retention_period_days,
         plus(dateTrunc(%(hogql_val_3)s, start_time), toIntervalDay(coalesce(retention_period_days, 30))) AS expiry_time,
         dateDiff(%(hogql_val_4)s, toDateTime64('today', 6, 'UTC'), expiry_time) AS recording_ttl,
         greaterOrEquals(max(toTimeZone(s._timestamp, %(hogql_val_5)s)), toDateTime64('today', 6, 'UTC')) AS ongoing,
         round(multiply(divide(plus(plus(plus(divide(sum(s.active_milliseconds), 1000), sum(s.click_count)), sum(s.keypress_count)), sum(s.console_error_count)), plus(plus(plus(plus(sum(s.mouse_activity_count), dateDiff(%(hogql_val_6)s, start_time, end_time)), sum(s.console_error_count)), sum(s.console_log_count)), sum(s.console_warn_count))), 100), 2) AS activity_score,
         coalesce(max(s.surfacing_score), 0.36) AS surfacing_score
  FROM session_replay_events AS s
  WHERE and(equals(s.team_id, 99999), greaterOrEquals(s.min_first_timestamp, toDateTime64('2020-12-29 00:00:00.000000', 6, 'UTC')), lessOrEquals(s.min_first_timestamp, toDateTime64('today', 6, 'UTC')), globalIn(s.session_id,
                                                                                                                                                                                                                     (SELECT events.properties.`$session_id` AS session_id
                                                                                                                                                                                                                      FROM events_json AS events
                                                                                                                                                                                                                      WHERE and(equals(events.team_id, 99999), notEmpty(events.properties.`$session_id`), lessOrEquals(events.timestamp, now64(6, %(hogql_val_7)s)), ifNull(equals(if(notEquals(toJSONString(events.person_properties.^rgInternal), '{}'), toJSONString(events.person_properties.^rgInternal), if(isNull(events.person_properties.rgInternal), NULL, if(startsWith(dynamicType(events.person_properties.rgInternal), 'DateTime'), replaceOne(toString(events.person_properties.rgInternal), ' ', 'T'), if(or(startsWith(dynamicType(events.person_properties.rgInternal), 'Array'), startsWith(dynamicType(events.person_properties.rgInternal), 'Map'), startsWith(dynamicType(events.person_properties.rgInternal), 'Tuple')), toJSONString(events.person_properties.rgInternal), toString(events.person_properties.rgInternal))))), %(hogql_val_8)s), 0), greaterOrEquals(events.timestamp, toDateTime64('2020-12-28 00:00:00.000000', 6, 'UTC')))
                                                                                                                                                                                                                      GROUP BY events.properties.`$session_id`
                                                                                                                                                                                                                      HAVING 1
                                                                                                                                                                                                                      ORDER BY min(toTimeZone(events.timestamp, %(hogql_val_9)s)) DESC
                                                                                                                                                                                                                      LIMIT 1000000)))
  GROUP BY s.session_id
  HAVING and(greaterOrEquals(expiry_time, toDateTime64('today', 6, 'UTC')), equals(max(s.is_deleted), 0))
  ORDER BY start_time DESC,
           s.session_id DESC
  LIMIT 50000
  '''
