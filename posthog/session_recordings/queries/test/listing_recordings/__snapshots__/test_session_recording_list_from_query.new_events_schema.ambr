                                                                                                                                                                                                                                                    WHERE and(equals(events.team_id, 99999), notEmpty(events.properties.`$session_id`), lessOrEquals(events.timestamp, now64(6, 'UTC')), ifNull(equals(events__person.properties___email, 'bla'), 0), greaterOrEquals(events.timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'UTC')))
                                                                                                                                                                                                                                                    GROUP BY events.properties.`$session_id`
                                                                                                                                                                                                                                                    HAVING 1
                                                                                                                                                                                                                                                    ORDER BY min(toTimeZone(events.timestamp, 'UTC')) DESC
                                                                                                                                                                                                                                                    LIMIT 1000000)))
  GROUP BY s.session_id
  HAVING and(greaterOrEquals(expiry_time, toDateTime64('today', 6, 'UTC')), equals(max(s.is_deleted), 0))
  ORDER BY start_time DESC,
           s.session_id DESC
  LIMIT 51 SETTINGS readonly=2,
