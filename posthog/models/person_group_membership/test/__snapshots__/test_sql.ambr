# serializer version: 1
# name: test_dictionary_sql
  '''
  
  CREATE DICTIONARY IF NOT EXISTS person_group_membership_config_dict
  (
      team_id Int64,
      group_type_index UInt8 DEFAULT 255,
      enabled UInt8 DEFAULT 0
  )
  PRIMARY KEY team_id
  SOURCE(CLICKHOUSE(QUERY 'SELECT team_id, config.1 AS group_type_index, config.2 AS enabled FROM (SELECT team_id, argMax(tuple(group_type_index, enabled), version) AS config FROM posthog.distributed_person_group_membership_config GROUP BY team_id) WHERE enabled = 1 AND group_type_index <= 4' USER 'dict_reader' PASSWORD 'fake\'password\\with_escape'))
  LIFETIME(MIN 60 MAX 120)
  LAYOUT(COMPLEX_KEY_HASHED())
  
  '''
# ---
# name: test_ingestion_sql[kafka_table]
  '''
  
  CREATE TABLE IF NOT EXISTS kafka_person_group_membership
  (
      team_id Int64,
      distinct_id String,
      properties String,
      timestamp DateTime64(6, 'UTC'),
      person_mode Enum8('full' = 0, 'propertyless' = 1, 'force_upgrade' = 2)
  )
  ENGINE = Kafka(warpstream_ingestion, kafka_topic_list = 'clickhouse_events_json_test', kafka_group_name = 'clickhouse_person_group_membership', kafka_format = 'JSONEachRow')
  SETTINGS
      kafka_max_block_size = 10000,
      kafka_poll_max_batch_size = 10000,
      kafka_poll_timeout_ms = 10000,
      kafka_flush_interval_ms = 7500,
      kafka_num_consumers = 1,
      kafka_thread_per_consumer = 1,
      kafka_skip_broken_messages = 100
  
  '''
# ---
# name: test_ingestion_sql[view]
  '''
  
  CREATE MATERIALIZED VIEW IF NOT EXISTS person_group_membership_mv
  TO writable_person_group_membership
  AS SELECT
      team_id,
      group_type_index,
      replaceRegexpAll(JSONExtractRaw(properties, concat('$group_', toString(group_type_index))), '^"|"$', '') AS group_key,
      distinct_id,
      min(timestamp) AS first_seen,
      max(timestamp) AS last_seen
  FROM (
      SELECT
          team_id,
          dictGet('posthog.person_group_membership_config_dict', 'group_type_index', tuple(team_id)) AS group_type_index,
          distinct_id,
          properties,
          timestamp
      FROM kafka_person_group_membership
      WHERE dictHas('posthog.person_group_membership_config_dict', tuple(team_id)) AND (person_mode != 'propertyless')
        AND JSONExtractRaw(properties, '$update_person_last_seen_at') != 'false'
  )
  WHERE notEmpty(group_key)
  GROUP BY team_id, group_type_index, group_key, distinct_id
  
  '''
# ---
