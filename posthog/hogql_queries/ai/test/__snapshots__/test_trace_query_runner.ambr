            if(greater(countIf(and(isNotNull(events.input_cost_usd), in(events.event, tuple('$ai_generation', '$ai_embedding')))), 0), round(sumIf(events.input_cost_usd, in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10), NULL) AS input_cost,
            if(greater(countIf(and(isNotNull(events.output_cost_usd), in(events.event, tuple('$ai_generation', '$ai_embedding')))), 0), round(sumIf(events.output_cost_usd, in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10), NULL) AS output_cost,
            if(greater(countIf(and(isNotNull(events.total_cost_usd), in(events.event, tuple('$ai_generation', '$ai_embedding')))), 0), round(sumIf(events.total_cost_usd, in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10), NULL) AS total_cost,
            arrayDistinct(arraySort(x -> x.3, groupArrayIf(tuple(events.uuid, events.event, events.timestamp, events.properties, events.input, events.output, events.output_choices, events.input_state, events.output_state, events.tools), notEquals(events.event, '$ai_trace')))) AS events,
            argMinIf(events.input_state, events.timestamp, equals(events.event, '$ai_trace')) AS input_state,
            argMinIf(events.output_state, events.timestamp, equals(events.event, '$ai_trace')) AS output_state,
            ifNull(argMinIf(ifNull(nullIf(events.span_name, ''), nullIf(events.trace_name, '')), events.timestamp, equals(events.event, '$ai_trace')), argMin(ifNull(nullIf(events.span_name, ''), nullIf(events.trace_name, '')), events.timestamp)) AS trace_name
     FROM
       (SELECT ai_events.uuid AS uuid,
               ai_events.event AS event,
               toTimeZone(ai_events.timestamp, 'UTC') AS timestamp,
               ai_events.distinct_id AS distinct_id,
               ai_events.properties AS properties,
               ai_events.trace_id AS trace_id,
               ai_events.session_id AS session_id,
               ai_events.parent_id AS parent_id,
               ai_events.span_id AS span_id,
               ai_events.generation_id AS generation_id,
               ai_events.span_name AS span_name,
