         round(coalesce(nullIf(aggregated.max_trace_latency, 0), if(and(equals(aggregated.non_generation_latency_count, 0), greater(aggregated.generation_latency_count, 0)), aggregated.generation_latency_sum, arraySum(x -> x.1, arrayFilter(x -> or(isNull(x.2), ifNull(equals(x.2, ''), 0), ifNull(equals(x.2, aggregated.trace_id), isNull(x.2)
                                                                                                                                                                                                                                                                                                        and isNull(aggregated.trace_id)), ifNull(equals(x.2, x.3), isNull(x.2)
                                                                                                                                                                                                                                                                                                                                                 and isNull(x.3)), not(has(aggregated.known_span_ids, x.2))), aggregated.latency_rows)))), 2) AS total_latency,
         aggregated.input_tokens AS input_tokens,
