         round(coalesce(nullIf(maxIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), and(equals(events.event, '$ai_trace'), ifNull(greater(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), 0), 0))), 0), if(and(equals(countIf(and(ifNull(greater(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), 0), 0), notEquals(events.event, '$ai_generation'))), 0), greater(countIf(and(ifNull(greater(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), 0), 0), equals(events.event, '$ai_generation'))), 0)), sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), and(equals(events.event, '$ai_generation'), ifNull(greater(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), 0), 0))), sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 'Float64'), or(isNull(events.properties.`$ai_parent_id`), equals(toString(CAST(events.properties.`$ai_parent_id`, 'Nullable(String)')), toString(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'))))))), 2) AS total_latency,
         sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_input_tokens`, 'Float64'), 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))) AS input_tokens,
         sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_output_tokens`, 'Float64'), 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))) AS output_tokens,
         round(sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_input_cost_usd`, 'Float64'), 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS input_cost,
         round(sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_output_cost_usd`, 'Float64'), 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS output_cost,
         round(sumIf(accurateCastOrNull(events.properties.`$ai_request_cost_usd`, 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS request_cost,
         round(sumIf(accurateCastOrNull(events.properties.`$ai_web_search_cost_usd`, 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS web_search_cost,
         round(sumIf(accurateCastOrNull(accurateCastOrNull(events.properties.`$ai_total_cost_usd`, 'Float64'), 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))), 10) AS total_cost,
         arrayDistinct(arraySort(x -> x.3, groupArrayIf(tuple(events.uuid, events.event, toTimeZone(events.timestamp, 'UTC'), concat('{', arrayStringConcat(arrayConcat(arrayMap(kv -> concat(toJSONString(kv.1), ':', if((startsWith(kv.2, '"[')
                                                                                                                                                                                                                           or startsWith(kv.2, '"{'))
                                                                                                                                                                                                                          and isValidJSON(JSONExtractString(kv.2)), JSONExtractString(kv.2), kv.2)), arrayFilter(kv -> not (kv.2 = '""'
                                                                                                                                                                                                                                                                                                                            and kv.1 in ('$browser', '$browser_language', '$browser_version', '$config_defaults', '$current_url', '$device_type', '$geoip_city_name', '$geoip_continent_code', '$geoip_continent_name', '$geoip_country_code', '$geoip_country_name', '$geoip_subdivision_1_name', '$geoip_time_zone', '$group_0', '$group_1', '$group_2', '$group_3', '$group_4', '$host', '$lib', '$lib_version', '$os', '$os_version', '$pathname', '$session_id', '$timezone', '$window_id'))
                                                                                                                                                                                                                                                                                                                 and kv.1 != '$feature_flags', JSONExtractKeysAndValuesRaw(toJSONString(events.properties)))), arrayConcat(arrayMap((key, value) -> concat(toJSONString(concat('$feature/', key)), ':', if(value in ('true', 'false'), value, toJSONString(multiIf(value = '$false', 'false', value = '$true', 'true', value)))), mapKeys(events.properties.`$feature_flags`), mapValues(events.properties.`$feature_flags`)), if(empty(events.properties.`$feature_flags`), [], [concat('"$active_feature_flags":', toJSONString(mapKeys(mapFilter((key, value) -> value not in ('', 'false'), events.properties.`$feature_flags`))))])), arrayMap(kv -> concat(toJSONString(kv.1), ':', if((startsWith(kv.2, '"[')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              or startsWith(kv.2, '"{'))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             and isValidJSON(JSONExtractString(kv.2)), JSONExtractString(kv.2), kv.2)), JSONExtractKeysAndValuesRaw(toJSONString(events.temporary_properties)))), ','), '}')), or(in(events.event, tuple('$ai_metric', '$ai_feedback')), equals(toString(CAST(events.properties.`$ai_parent_id`, 'Nullable(String)')), toString(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'))))))) AS events,
         argMinIf(CAST(events.properties.`$ai_input_state`, 'Nullable(String)'), toTimeZone(events.timestamp, 'UTC'), equals(events.event, '$ai_trace')) AS input_state,
         argMinIf(CAST(events.properties.`$ai_output_state`, 'Nullable(String)'), toTimeZone(events.timestamp, 'UTC'), equals(events.event, '$ai_trace')) AS output_state,
         ifNull(argMinIf(ifNull(CAST(events.properties.`$ai_span_name`, 'Nullable(String)'), CAST(events.properties.`$ai_trace_name`, 'Nullable(String)')), toTimeZone(events.timestamp, 'UTC'), equals(events.event, '$ai_trace')), argMin(ifNull(CAST(events.properties.`$ai_span_name`, 'Nullable(String)'), CAST(events.properties.`$ai_trace_name`, 'Nullable(String)')), toTimeZone(events.timestamp, 'UTC'))) AS trace_name,
         countIf(or(isNotNull(events.properties.`$ai_error`), equals(CAST(events.properties.`$ai_is_error`, 'Nullable(String)'), 'true'))) AS error_count,
         any(CAST(events.properties.ai_support_impersonated, 'Nullable(String)')) AS is_support_trace,
         arrayFilter(x -> ifNull(notEquals(x, ''), 1), arrayDistinct(splitByChar(',', arrayStringConcat(groupArrayIf(toString(CAST(events.properties.`$ai_tools_called`, 'Nullable(String)')), and(equals(events.event, '$ai_generation'), isNotNull(events.properties.`$ai_tools_called`), ifNull(notEquals(toString(CAST(events.properties.`$ai_tools_called`, 'Nullable(String)')), ''), 1))), ',')))) AS tools
  FROM events_json AS events
  WHERE and(equals(events.team_id, 99999), and(in(events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(greaterOrEquals(events.timestamp, assumeNotNull(toDateTime('2024-11-30 23:52:00', 'UTC'))), lessOrEquals(events.timestamp, assumeNotNull(toDateTime('2024-12-01 00:12:00', 'UTC'))))), in(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'), tuple('trace1')))
  GROUP BY CAST(events.properties.`$ai_trace_id`, 'Nullable(String)')
  ORDER BY first_timestamp DESC
  LIMIT 101
  OFFSET 0 SETTINGS readonly=2,
                    max_execution_time=60,
                    allow_experimental_object_type=1,
                    max_ast_elements=4000000,
                    max_expanded_ast_elements=4000000,
                    max_bytes_before_external_group_by=0,
                    transform_null_in=1,
                    optimize_min_equality_disjunction_chain_length=4294967295,
                    optimize_rewrite_aggregate_function_with_if=0,
                    optimize_min_inequality_conjunction_chain_length=4294967295,
                    allow_experimental_join_condition=1,
                    use_hive_partitioning=0,
                    json_type_escape_dots_in_keys=1,
                    output_format_json_escape_forward_slashes=0
  '''
