            min(toTimeZone(events.timestamp, 'UTC')) AS first_ts,
            max(toTimeZone(events.timestamp, 'UTC')) AS last_ts
     FROM events_json AS events
     WHERE and(equals(events.team_id, 99999), in(events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(isNotNull(if(notEquals(toJSONString(events.properties.^`$ai_trace_id`), '{}'), toJSONString(events.properties.^`$ai_trace_id`), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(and(in(ascii(toString(events.properties.`$ai_trace_id`)), tuple(91, 123)), in(ascii(toJSONString(events.properties.`$ai_trace_id`)), tuple(91, 123))), nullIf(nullIf(toJSONString(events.properties.`$ai_trace_id`), '[]'), '{}'), toString(events.properties.`$ai_trace_id`))))), notEquals(if(notEquals(toJSONString(events.properties.^`$ai_trace_id`), '{}'), toJSONString(events.properties.^`$ai_trace_id`), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(and(in(ascii(toString(events.properties.`$ai_trace_id`)), tuple(91, 123)), in(ascii(toJSONString(events.properties.`$ai_trace_id`)), tuple(91, 123))), nullIf(nullIf(toJSONString(events.properties.`$ai_trace_id`), '[]'), '{}'), toString(events.properties.`$ai_trace_id`)))), ''), and(greaterOrEquals(events.timestamp, assumeNotNull(toDateTime('2025-01-08 23:50:00', 'UTC'))), lessOrEquals(events.timestamp, assumeNotNull(toDateTime('2025-01-16 00:10:59', 'UTC'))))))
     GROUP BY trace_id
     HAVING and(lessOrEquals(min(toTimeZone(events.timestamp, 'UTC')), assumeNotNull(toDateTime64('today', 6, 'UTC'))), greaterOrEquals(max(toTimeZone(events.timestamp, 'UTC')), assumeNotNull(toDateTime('2025-01-09 00:00:00', 'UTC'))))
