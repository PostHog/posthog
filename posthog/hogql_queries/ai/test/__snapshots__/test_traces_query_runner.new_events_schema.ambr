# name: TestTracesQueryRunner.test_group_key_filter[new_events_schema]
  '''
  SELECT groupArray(trace_id) AS trace_ids,
         min(first_ts) AS min_timestamp,
         max(last_ts) AS max_timestamp
  FROM
    (SELECT if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$ai_trace_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$ai_trace_id`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$ai_trace_id`), '[]'), '{}'), toString(events.properties.`$ai_trace_id`))))) AS trace_id,
            min(toTimeZone(events.timestamp, 'UTC')) AS first_ts,
            max(toTimeZone(events.timestamp, 'UTC')) AS last_ts
     FROM events_json AS events
     WHERE and(equals(events.team_id, 99999), in(events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(isNotNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$ai_trace_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$ai_trace_id`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$ai_trace_id`), '[]'), '{}'), toString(events.properties.`$ai_trace_id`)))))), notEquals(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$ai_trace_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$ai_trace_id`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$ai_trace_id`), '[]'), '{}'), toString(events.properties.`$ai_trace_id`))))), ''), and(greaterOrEquals(events.timestamp, assumeNotNull(toDateTime('2025-01-08 23:50:00', 'UTC'))), lessOrEquals(events.timestamp, assumeNotNull(toDateTime('2025-01-16 00:10:59', 'UTC'))))))
     GROUP BY trace_id
     HAVING and(lessOrEquals(min(toTimeZone(events.timestamp, 'UTC')), assumeNotNull(toDateTime64('today', 6, 'UTC'))), greaterOrEquals(max(toTimeZone(events.timestamp, 'UTC')), assumeNotNull(toDateTime('2025-01-09 00:00:00', 'UTC'))))
     ORDER BY min(toTimeZone(events.timestamp, 'UTC')) DESC
     LIMIT 101)
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     optimize_rewrite_aggregate_function_with_if=0,
