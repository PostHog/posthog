     WHERE and(equals(events.team_id, 99999), in(events.event, tuple('$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback', '$ai_trace')), and(isNotNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$ai_trace_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$ai_trace_id`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$ai_trace_id`), '[]'), '{}'), toString(events.properties.`$ai_trace_id`)))))), notEquals(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$ai_trace_id`)), if(isNull(nullIf(toString(events.properties.`$ai_trace_id`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$ai_trace_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$ai_trace_id`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$ai_trace_id`, 'Dynamic')), 'Map'), startsWith(d