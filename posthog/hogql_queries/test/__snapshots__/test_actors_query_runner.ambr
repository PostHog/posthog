# name: TestActorsQueryRunner.test_persons_query_search_snapshot
  '''
  
  SELECT id, id, 1 
  FROM persons 
  WHERE or(ilike(toString(properties.email), '%SEARCHSTRING%'), ilike(toString(properties.name), '%SEARCHSTRING%'), ilike(toString(id), '%SEARCHSTRING%'), in(id, (
        SELECT argMax(person_id, version) 
        FROM raw_person_distinct_ids 
        WHERE ilike(distinct_id, '%SEARCHSTRING%') 
        GROUP BY distinct_id 
        HAVING equals(argMax(is_deleted, version), 0)))) 
  ORDER BY id ASC 
  LIMIT 50000
  '''
