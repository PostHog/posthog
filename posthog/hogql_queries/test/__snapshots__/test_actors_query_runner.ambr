# serializer version: 1
# name: TestActorsQueryRunner.test_persons_query_search_snapshot
  '''
  
  SELECT id, id, 1 
  FROM persons 
  WHERE or(ilike(nullIf(toString(properties.email), ''), '%SEARCHSTRING%'), ilike(nullIf(toString(properties.name), ''), '%SEARCHSTRING%'), ilike(nullIf(toString(properties.username), ''), '%SEARCHSTRING%'), ilike(toString(id), '%SEARCHSTRING%'), in(id, (
        SELECT person_id 
        FROM person_distinct_ids 
        WHERE ilike(distinct_id, '%SEARCHSTRING%')))) 
  ORDER BY id ASC 
  LIMIT 50000
  '''
# ---
