# serializer version: 1
# name: TestUpgradeQueriesWorkflow.test_get_insights_to_migrate_activity
  '''
  SELECT MAX("posthog_dashboarditem"."id") AS "id__max"
  FROM "posthog_dashboarditem"
  '''
# ---
# name: TestUpgradeQueriesWorkflow.test_get_insights_to_migrate_activity.1
  '''
  
  SELECT id
  FROM posthog_dashboarditem
  WHERE query IS NOT NULL
    AND (query @? '$.** ? (
      @.kind == "EventsNode" &&
      (!exists(@.version) || @.version == null || @.version < 8)
  )'
         OR query @? '$.** ? (
      @.kind == "InsightVizNode" &&
      (!exists(@.version) || @.version == null || @.version < 4)
  )'
         OR query @? '$.** ? (
      @.kind == "TrendsQuery" &&
      (!exists(@.version) || @.version == null || @.version < 6)
  )')
  ORDER BY id
  LIMIT 100;
  '''
# ---
