#!/bin/bash

# ClickHouse starts this script with copies of its open files, including client connections. A connection stays open
# while any copy of it is open, so a long-running UDF process keeps a connection open after the server closes it,
# and the next request on that connection never gets a response. Close every inherited descriptor except stdin,
# stdout and stderr. The script needs bash because sh cannot close a descriptor above 9.
for fd_path in /proc/$$/fd/*; do
    fd=${fd_path##*/}
    if [ "$fd" -gt 2 ]; then
        exec {fd}>&-
    fi
done

DIR_NAME=$(dirname "$0")
TEMP_DIR=$(mktemp -d -p /tmp "json_strip_empty_strings_and_nulls_udf_XXXXXXXXXX")
trap 'rm -rf "$TEMP_DIR"; exit' 0

case $(uname -m) in
aarch64)
    EXECUTABLE_NAME="json_strip_empty_strings_and_nulls_udf_aarch64"
    ;;
*)
    EXECUTABLE_NAME="json_strip_empty_strings_and_nulls_udf_x86_64"
    ;;
esac

cp "$DIR_NAME/$EXECUTABLE_NAME" "$TEMP_DIR/$EXECUTABLE_NAME"
chmod +x "$TEMP_DIR/$EXECUTABLE_NAME"
"$TEMP_DIR/$EXECUTABLE_NAME" "$@"
