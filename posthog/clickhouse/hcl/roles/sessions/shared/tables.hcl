    }
    column "autocapture_count" {
      type = "SimpleAggregateFunction(sum, Int64)"
    }
    engine "replicated_aggregating_merge_tree" {
      zoo_path     = "/clickhouse/tables/sessions/noshard/posthog.sessions"
      replica_name = "{shard}-{replica}"
    }
