SELECT
  team_id,
  metric_name,
  time_bucket,
  original_expiry_time_bucket,
  service_name,
  attribute_key,
  attribute_value,
  attribute_type,
  attribute_count
FROM
  (
    SELECT
      team_id AS team_id,
      metric_name AS metric_name,
      toStartOfInterval(timestamp, toIntervalHour(1)) AS time_bucket,
