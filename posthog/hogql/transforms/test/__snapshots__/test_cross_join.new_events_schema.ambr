# serializer version: 1
# name: TestCrossJoinResults.test_duplicates_and_merged_people_preserve_results[new_events_schema]
  '''
  SELECT l.distinct_id,
         r.distinct_id AS distinct_id
  FROM events_json AS l
  LEFT OUTER JOIN
    (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
            person_distinct_id_overrides.distinct_id AS distinct_id
     FROM person_distinct_id_overrides
     WHERE equals(person_distinct_id_overrides.team_id, 99999)
     GROUP BY person_distinct_id_overrides.distinct_id
     HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS l__override ON equals(l.distinct_id, l__override.distinct_id) ALL
  INNER JOIN
    (SELECT r.distinct_id AS distinct_id,
            r.event AS event,
            r.person_id AS event_person_id,
            if(not(empty(r__override.distinct_id)), r__override.person_id, r.person_id) AS person_id,
            toTimeZone(r.timestamp, %(hogql_val_0)s) AS timestamp
     FROM events_json AS r
     LEFT OUTER JOIN
       (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
               person_distinct_id_overrides.distinct_id AS distinct_id
        FROM person_distinct_id_overrides
        WHERE equals(person_distinct_id_overrides.team_id, 99999)
        GROUP BY person_distinct_id_overrides.distinct_id
        HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS r__override ON equals(r.distinct_id, r__override.distinct_id)
     WHERE and(equals(r.team_id, 99999), equals(r.event, %(hogql_val_1)s), greaterOrEquals(r.timestamp, toDateTime(%(hogql_val_2)s, %(hogql_val_3)s)), less(r.timestamp, toDateTime(%(hogql_val_4)s, %(hogql_val_5)s)))) AS r ON equals(if(not(empty(l__override.distinct_id)), l__override.person_id, l.person_id), r.person_id)
  WHERE and(equals(l.team_id, 99999), equals(l.event, %(hogql_val_6)s), equals(r.event, %(hogql_val_7)s), greaterOrEquals(l.timestamp, toDateTime64(toTimeZone(r.timestamp, %(hogql_val_8)s), 6, %(hogql_val_9)s)), greaterOrEquals(r.timestamp, toDateTime(%(hogql_val_10)s, %(hogql_val_11)s)), less(r.timestamp, toDateTime(%(hogql_val_12)s, %(hogql_val_13)s)))
  ORDER BY l.distinct_id ASC,
           r.distinct_id ASC
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     optimize_rewrite_aggregate_function_with_if=0,
                     optimize_min_inequality_conjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0,
                     json_type_escape_dots_in_keys=1
  '''
# ---
