# serializer version: 1
# name: TestFlagEvaluationsTable.test_flag_call_query_on_events_prints_a_read_of_flag_evaluations
  '''
  SELECT count() AS `count()`
  FROM flag_evaluations AS events
  WHERE and(equals(events.team_id, 99999), and(equals(events.event, %(hogql_val_0)s), ifNull(equals(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(events.properties, %(hogql_val_1)s), ''), 'null'), '^"|"$', ''), %(hogql_val_2)s), 0), greaterOrEquals(events.timestamp, toDateTime64(minus(now64(6, %(hogql_val_3)s), toIntervalDay(7)), 6, %(hogql_val_4)s))), in(events.flag_key, tuple(%(hogql_val_5)s)))
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     optimize_rewrite_aggregate_function_with_if=0,
                     optimize_min_inequality_conjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0
  '''
# ---
