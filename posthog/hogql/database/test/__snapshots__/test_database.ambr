                  "chain": null,
                  "description": "UUID of the table, view, or metric.",
                  "fields": null,
                  "hogql_value": "subject_uuid",
                  "id": null,
                  "name": "subject_uuid",
                  "schema_valid": true,
                  "table": null,
                  "type": "string"
              },
              "subject_name": {
                  "chain": null,
                  "description": "Name of the table, view, metric, or PostHog table. Table, view and PostHog table names are queryable in HogQL; a metric name is not.",
                  "fields": null,
                  "hogql_value": "subject_name",
                  "id": null,
                  "name": "subject_name",
                  "schema_valid": true,
                  "table": null,
                  "type": "string"
              },
              "health": {
                  "chain": null,
