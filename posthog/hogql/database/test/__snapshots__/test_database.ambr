      "system.information_schema.data_quality_health": {
          "certification": null,
          "description": "One row per warehouse table, view, or catalog metric that has data quality checks, rolled up to a single verdict. Check this before trusting a source in an analysis: 'failing' means an error-severity check found bad data, 'erroring' means a check could not run at all, 'warn' means only warn-severity checks failed, 'unknown' means nothing has run yet. Subjects with no checks do not appear.",
          "fields": {
              "subject_type": {
                  "chain": null,
                  "description": "'table' (synced source), 'view' (saved query), 'metric' (catalog metric), or 'posthog_table' (events, persons, groups).",
