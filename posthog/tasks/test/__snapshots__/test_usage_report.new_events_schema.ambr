         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 08:00:00'
  AND timestamp < '2022-01-10 10:00:00'
  WHERE (event LIKE 'helicone%'
         OR event LIKE 'langfuse%'
         OR event LIKE 'keywords_ai%'
         OR event LIKE 'traceloop%'
         OR ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
