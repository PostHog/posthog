                                                                                                                                                                                                                                                                                                                                                           AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_lib`), '\\/', '/'), toJSONString(properties.`$ai_lib`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_lib`), '\\/', '/'), toJSONString(properties.`$ai_lib`)), '[]'), '{}'), toString(properties.`$ai_lib`))), '') IN ('posthog-openclaw',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   'posthog-opencode',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   '@posthog/pi',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   'posthog-ai')
