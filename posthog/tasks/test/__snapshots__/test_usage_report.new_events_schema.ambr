                                                                                                                                                      AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-rs', 'rust_events', 'other') AS metric,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 04:00:00'
  AND timestamp < '2022-01-10 06:00:00'
  WHERE (event LIKE 'helicone%'
         OR event LIKE 'langfuse%'
         OR event LIKE 'keywords_ai%'
         OR event LIKE 'traceloop%'
         OR ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                   AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') IN ('web',
                                                                                                                                                                                                                                                                                                                                'js',
                                                                                                                                                                                                                                                                                                                                'posthog-node',
                                                                                                                                                                                                                                                                                                                                'posthog-node-mcp',
                                                                                                                                                                                                                                                                                                                                'posthog-python-mcp',
                                                                                                                                                                                                                                                                                                                                'posthog-edge',
                                                                                                                                                                                                                                                                                                                                'posthog-convex',
                                                                                                                                                                                                                                                                                                                                'posthog-android',
                                                                                                                                                                                                                                                                                                                                'posthog-kmp',
                                                                                                                                                                                                                                                                                                                                'posthog-flutter',
                                                                                                                                                                                                                                                                                                                                'posthog-ios',
                                                                                                                                                                                                                                                                                                                                'posthog-go',
                                                                                                                                                                                                                                                                                                                                'posthog-java',
                                                                                                                                                                                                                                                                                                                                'posthog-server',
                                                                                                                                                                                                                                                                                                                                'posthog-react-native',
                                                                                                                                                                                                                                                                                                                                'posthog-ruby',
                                                                                                                                                                                                                                                                                                                                'posthog-rails',
                                                                                                                                                                                                                                                                                                                                'posthog-python',
                                                                                                                                                                                                                                                                                                                                'posthog-php',
                                                                                                                                                                                                                                                                                                                                'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                                'posthog-aspnetcore',
                                                                                                                                                                                                                                                                                                                                'posthog-elixir',
                                                                                                                                                                                                                                                                                                                                'posthog-unity',
                                                                                                                                                                                                                                                                                                                                'posthog-rs'))
  GROUP BY team_id,
           metric
  '''
