# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.40]
  '''
  
  SELECT team_id,
         count(distinct toDate(timestamp), event, cityHash64(distinct_id), cityHash64(uuid)) as count
  FROM events_json
  WHERE timestamp >= '2022-01-10 06:00:00'
    AND timestamp < '2022-01-10 08:00:00'
    AND event NOT IN ['$feature_flag_called', '$experiment_exposure', 'survey sent', 'survey shown', 'survey dismissed', '$exception', '$llm_prompt_fetched', '$conversations_loaded', '$conversations_widget_loaded', '$conversations_message_sent', '$conversations_user_identified', '$conversations_restore_link_requested', '$conversations_widget_state_changed', '$conversations_back_to_tickets']
    AND NOT startsWith(event, '$ai_')
    AND person_mode IN ('full',
                        'force_upgrade')
  GROUP BY team_id
  '''
