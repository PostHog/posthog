                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Map')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$lib`), 20, 10), 'Z'), toString(properties.`$lib`)))), '') = 'posthog-rs', 'rust_events', 'other') AS metric,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 08:00:00'
  AND timestamp < '2022-01-10 10:00:00'
  WHERE (event LIKE 'helicone%'
         OR event LIKE 'langfuse%'
         OR event LIKE 'keywords_ai%'
         OR event LIKE 'traceloop%'
         OR ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Array')
                                                                                                                                                                   OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Map')
                                                                                                                                                                   OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$lib`), 20, 10), 'Z'), toString(properties.`$lib`)))), '') IN ('web',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'js',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-node',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-node-mcp',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-python-mcp',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-edge',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-convex',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-android',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-kmp',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-flutter',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-ios',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-go',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-java',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-server',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-react-native',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-ruby',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-rails',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-python',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-php',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-aspnetcore',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-elixir',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-unity',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'posthog-rs'))
  GROUP BY team_id,
           metric
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.50]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)), if(startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'Array')
                                                                                                                                                                                OR startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'Map')
                                                                                                                                                                                OR startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.count), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.count, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.count), 20, 10), 'Z'), toString(properties.count)))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='decide usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)), if(startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'Array')
                                                                                                                                                                              OR startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'Map')
                                                                                                                                                                              OR startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.token), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.token, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.token), 20, 10), 'Z'), toString(properties.token)))), ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.51]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)), if(startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'Array')
                                                                                                                                                                                OR startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'Map')
                                                                                                                                                                                OR startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.count), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.count, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.count, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.count), 20, 10), 'Z'), toString(properties.count)))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='local evaluation usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)), if(startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'Array')
                                                                                                                                                                              OR startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'Map')
                                                                                                                                                                              OR startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.token), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.token, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.token, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.token), 20, 10), 'Z'), toString(properties.token)))), ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.52]
  '''
  
  SELECT team_id,
         COUNT() as count
  FROM events_json
  WHERE event = 'survey sent'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND uuid IN
      (SELECT argMax(uuid, timestamp)
       FROM events_json
       WHERE timestamp >= '2022-01-10 00:00:00'
         AND timestamp < '2022-01-10 23:59:59'
         AND event = 'survey sent'
       GROUP BY team_id,
                ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_id`)), if(startsWith(dynamicType(accurateCast(properties.`$survey_id`, 'Dynamic')), 'Array')
                                                                                                                                                                                   OR startsWith(dynamicType(accurateCast(properties.`$survey_id`, 'Dynamic')), 'Map')
                                                                                                                                                                                   OR startsWith(dynamicType(accurateCast(properties.`$survey_id`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$survey_id`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$survey_id`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$survey_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$survey_id`), 20, 10), 'Z'), toString(properties.`$survey_id`)))), ''),
                CASE
                    WHEN COALESCE(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)), if(startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'Array')
                                                                                                                                                                                                                           OR startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'Map')
                                                                                                                                                                                                                           OR startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$survey_submission_id`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$survey_submission_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$survey_submission_id`), 20, 10), 'Z'), toString(properties.`$survey_submission_id`)))), ''), '') = '' THEN toString(uuid)
                    ELSE ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)), if(startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'Array')
                                                                                                                                                                                                                  OR startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'Map')
                                                                                                                                                                                                                  OR startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$survey_submission_id`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$survey_submission_id`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$survey_submission_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$survey_submission_id`), 20, 10), 'Z'), toString(properties.`$survey_submission_id`)))), '')
                END)
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.53]
  '''
  
  SELECT team_id,
         COUNT() - uniqExactIf(request_id, verified
                               AND NOT relay
                               AND request_id != '') AS count,
         max(relay) AS has_verified_relay
  FROM
    (SELECT team_id,
            ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_verified`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_verified`)), if(startsWith(dynamicType(accurateCast(properties.`$ai_gateway_verified`, 'Dynamic')), 'Array')
                                                                                                                                                                                                   OR startsWith(dynamicType(accurateCast(properties.`$ai_gateway_verified`, 'Dynamic')), 'Map')
                                                                                                                                                                                                   OR startsWith(dynamicType(accurateCast(properties.`$ai_gateway_verified`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$ai_gateway_verified`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$ai_gateway_verified`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$ai_gateway_verified`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$ai_gateway_verified`), 20, 10), 'Z'), toString(properties.`$ai_gateway_verified`)))), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             '1') AS verified,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if(verified, ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_request_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_request_id`)), if(startsWith(dynamicType(accurateCast(properties.`$ai_gateway_request_id`, 'Dynamic')), 'Array')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    OR startsWith(dynamicType(accurateCast(properties.`$ai_gateway_request_id`, 'Dynamic')), 'Map')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    OR startsWith(dynamicType(accurateCast(properties.`$ai_gateway_request_id`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$ai_gateway_request_id`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$ai_gateway_request_id`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$ai_gateway_request_id`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$ai_gateway_request_id`), 20, 10), 'Z'), toString(properties.`$ai_gateway_request_id`)))), ''), '') AS request_id,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if(verified, ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_relay`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_relay`)), if(startsWith(dynamicType(accurateCast(properties.`$ai_gateway_relay`, 'Dynamic')), 'Array')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          OR startsWith(dynamicType(accurateCast(properties.`$ai_gateway_relay`, 'Dynamic')), 'Map')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          OR startsWith(dynamicType(accurateCast(properties.`$ai_gateway_relay`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$ai_gateway_relay`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$ai_gateway_relay`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$ai_gateway_relay`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$ai_gateway_relay`), 20, 10), 'Z'), toString(properties.`$ai_gateway_relay`)))), ''), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       '1') AS relay
     FROM events_json
     WHERE startsWith(event, '$ai_')
       AND timestamp >= '2022-01-10 00:00:00'
       AND timestamp < '2022-01-10 23:59:59')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.54]
  '''
  
  SELECT team_id,
         COUNT() - uniqExactIf(request_id, verified
                               AND request_id != '') as count
  FROM
    (SELECT team_id,
            JSONExtractBool(toJSONString(properties), '$ai_gateway_verified') as verified,
            if(verified, JSONExtractString(toJSONString(properties), '$ai_gateway_request_id'), '') as request_id
     FROM events_json
     WHERE event IN ['$ai_generation', '$ai_embedding', '$ai_span', '$ai_trace', '$ai_metric', '$ai_feedback', '$ai_evaluation', '$ai_tag', '$ai_trace_summary', '$ai_generation_summary', '$ai_trace_clusters', '$ai_generation_clusters']
       AND timestamp >= '2022-01-10 00:00:00'
       AND timestamp < '2022-01-10 23:59:59')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.5]
  '''
  
  SELECT team_id,
         multiIf(event LIKE 'helicone%', 'helicone_events', event LIKE 'langfuse%', 'langfuse_events', event LIKE 'keywords_ai%', 'keywords_ai_events', event LIKE 'traceloop%', 'traceloop_events', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Array')
                                                                                                                                                                                                                                                                                                                                                            OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Map')
                                                                                                                                                                                                                                                                                                                                                            OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$lib`), 20, 10), 'Z'), toString(properties.`$lib`)))), '') = 'web', 'web_events', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Array')
