  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)), if(ascii(toString(properties.count)) IN (91, 123)
                                                                                                                                                                                AND ascii(toJSONString(properties.count)) IN (91, 123), nullIf(nullIf(toJSONString(properties.count), '[]'), '{}'), toString(properties.count))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='decide usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)), if(ascii(toString(properties.token)) IN (91, 123)
                                                                                                                                                                              AND ascii(toJSONString(properties.token)) IN (91, 123), nullIf(nullIf(toJSONString(properties.token), '[]'), '{}'), toString(properties.token))), ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.51]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)), if(ascii(toString(properties.count)) IN (91, 123)
                                                                                                                                                                                AND ascii(toJSONString(properties.count)) IN (91, 123), nullIf(nullIf(toJSONString(properties.count), '[]'), '{}'), toString(properties.count))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='local evaluation usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)), if(ascii(toString(properties.token)) IN (91, 123)
                                                                                                                                                                              AND ascii(toJSONString(properties.token)) IN (91, 123), nullIf(nullIf(toJSONString(properties.token), '[]'), '{}'), toString(properties.token))), ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.52]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^count)), if(ascii(toString(properties.count)) IN (91, 123)
                                                                                                                                                                                AND ascii(toJSONString(properties.count)) IN (91, 123), nullIf(nullIf(toJSONString(properties.count), '[]'), '{}'), toString(properties.count))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='local evaluation not modified usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^token)), if(ascii(toString(properties.token)) IN (91, 123)
                                                                                                                                                                              AND ascii(toJSONString(properties.token)) IN (91, 123), nullIf(nullIf(toJSONString(properties.token), '[]'), '{}'), toString(properties.token))), ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.53]
  '''
  
  SELECT team_id,
         COUNT() as count
  FROM events_json
  WHERE event = 'survey sent'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND uuid IN
      (SELECT argMax(uuid, timestamp)
       FROM events_json
       WHERE timestamp >= '2022-01-10 00:00:00'
         AND timestamp < '2022-01-10 23:59:59'
         AND event = 'survey sent'
       GROUP BY team_id,
                ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_id`)), if(ascii(toString(properties.`$survey_id`)) IN (91, 123)
                                                                                                                                                                                   AND ascii(toJSONString(properties.`$survey_id`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$survey_id`), '[]'), '{}'), toString(properties.`$survey_id`))), ''),
                CASE
                    WHEN COALESCE(ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)), if(ascii(toString(properties.`$survey_submission_id`)) IN (91, 123)
                                                                                                                                                                                                                           AND ascii(toJSONString(properties.`$survey_submission_id`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$survey_submission_id`), '[]'), '{}'), toString(properties.`$survey_submission_id`))), ''), '') = '' THEN toString(uuid)
                    ELSE ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$survey_submission_id`)), if(ascii(toString(properties.`$survey_submission_id`)) IN (91, 123)
                                                                                                                                                                                                                  AND ascii(toJSONString(properties.`$survey_submission_id`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$survey_submission_id`), '[]'), '{}'), toString(properties.`$survey_submission_id`))), '')
                END)
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.54]
  '''
  
  SELECT team_id,
         COUNT() - uniqExactIf(request_id, verified
                               AND NOT relay
                               AND request_id != '') AS count,
         max(relay) AS has_verified_relay
  FROM
    (SELECT team_id,
            ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_verified`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_verified`)), if(ascii(toString(properties.`$ai_gateway_verified`)) IN (91, 123)
                                                                                                                                                                                                   AND ascii(toJSONString(properties.`$ai_gateway_verified`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_gateway_verified`), '[]'), '{}'), toString(properties.`$ai_gateway_verified`))), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                '1') AS verified,
                                                                                                                                                                                                                                                                                                                                                                                                               if(verified, ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_request_id`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_request_id`)), if(ascii(toString(properties.`$ai_gateway_request_id`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       AND ascii(toJSONString(properties.`$ai_gateway_request_id`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_gateway_request_id`), '[]'), '{}'), toString(properties.`$ai_gateway_request_id`))), ''), '') AS request_id,
                                                                                                                                                                                                                                                                                                                                                                                                               if(verified, ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_relay`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_gateway_relay`)), if(ascii(toString(properties.`$ai_gateway_relay`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             AND ascii(toJSONString(properties.`$ai_gateway_relay`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_gateway_relay`), '[]'), '{}'), toString(properties.`$ai_gateway_relay`))), ''), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      '1') AS relay
     FROM events_json
     WHERE startsWith(event, '$ai_')
       AND timestamp >= '2022-01-10 00:00:00'
       AND timestamp < '2022-01-10 23:59:59')
  GROUP BY team_id
  '''
