                                                                                                                                                                                                                                                                                                                                'posthog-python',
                                                                                                                                                                                                                                                                                                                                'posthog-php',
                                                                                                                                                                                                                                                                                                                                'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                                'posthog-aspnetcore',
                                                                                                                                                                                                                                                                                                                                'posthog-elixir',
                                                                                                                                                                                                                                                                                                                                'posthog-unity',
                                                                                                                                                                                                                                                                                                                                'posthog-rs'))
  GROUP BY team_id,
           metric
  '''
