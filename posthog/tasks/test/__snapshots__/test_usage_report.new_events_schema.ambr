# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.42]
  '''
  
  SELECT team_id,
         CAST(ifNull(toString(properties.`$lib`), ''), 'String') AS sdk_lib,
         ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_lib`), '\\/', '/'), toJSONString(properties.^`$ai_lib`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_lib`), '\\/', '/'), toJSONString(properties.^`$ai_lib`)), if(ascii(toString(properties.`$ai_lib`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                            AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_lib`), '\\/', '/'), toJSONString(properties.`$ai_lib`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_lib`), '\\/', '/'), toJSONString(properties.`$ai_lib`)), '[]'), '{}'), toString(properties.`$ai_lib`))), '') AS ai_lib,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 00:00:00'
  AND timestamp < '2022-01-10 02:00:00'
  AND startsWith(event, '$ai_')
  WHERE CAST(ifNull(toString(properties.`$lib`), ''), 'String') IN ('posthog-node',
                                                                    'posthog-python',
                                                                    'posthog-dotnet',
                                                                    'posthog-aspnetcore')
