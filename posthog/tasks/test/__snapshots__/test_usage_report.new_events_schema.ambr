                                                                                 OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$lib`), 20, 10), 'Z'), toString(properties.`$lib`)))), '') = 'posthog-unity', 'unity_events', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Array')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                