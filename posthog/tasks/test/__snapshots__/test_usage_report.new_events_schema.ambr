                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-rs', 'rust_events', 'other') AS metric,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 22:00:00'
  AND timestamp < '2022-01-10 23:59:59'
  WHERE (event LIKE 'helicone%'
         OR event LIKE 'langfuse%'
         OR event LIKE 'keywords_ai%'
         OR event LIKE 'traceloop%'
         OR ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                   AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') IN ('web',
                                                                                                                                                                                                                                                                                                                                'js',
                                                                                                                                                                                                                                                                                                                                'posthog-node',
                                                                                                                                                                                                                                                                                                                                'posthog-node-mcp',
                                                                                                                                                                                                                                                                                                                                'posthog-python-mcp',
                                                                                                                                                                                                                                                                                                                                'posthog-edge',
                                                                                                                                                                                                                                                                                                                                'posthog-convex',
                                                                                                                                                                                                                                                                                                                                'posthog-android',
                                                                                                                                                                                                                                                                                                                                'posthog-kmp',
                                                                                                                                                                                                                                                                                                                                'posthog-flutter',
                                                                                                                                                                                                                                                                                                                                'posthog-ios',
                                                                                                                                                                                                                                                                                                                                'posthog-go',
                                                                                                                                                                                                                                                                                                                                'posthog-java',
                                                                                                                                                                                                                                                                                                                                'posthog-server',
                                                                                                                                                                                                                                                                                                                                'posthog-react-native',
                                                                                                                                                                                                                                                                                                                                'posthog-ruby',
                                                                                                                                                                                                                                                                                                                                'posthog-rails',
                                                                                                                                                                                                                                                                                                                                'posthog-python',
                                                                                                                                                                                                                                                                                                                                'posthog-php',
                                                                                                                                                                                                                                                                                                                                'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                                'posthog-aspnetcore',
                                                                                                                                                                                                                                                                                                                                'posthog-elixir',
                                                                                                                                                                                                                                                                                                                                'posthog-unity',
                                                                                                                                                                                                                                                                                                                                'posthog-rs'))
  GROUP BY team_id,
           metric
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.12]
  '''
  
  SELECT team_id,
         ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') AS sdk_lib,
         ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)), if(ascii(toString(properties.`$ai_lib`)) IN (91, 123)
                                                                                                                                                                      AND ascii(toJSONString(properties.`$ai_lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_lib`), '[]'), '{}'), toString(properties.`$ai_lib`))), '') AS ai_lib,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 00:00:00'
  AND timestamp < '2022-01-10 02:00:00'
  AND startsWith(event, '$ai_')
  WHERE ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                               AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') IN ('posthog-node',
                                                                                                                                                                                                                                                                                                                            'posthog-python',
                                                                                                                                                                                                                                                                                                                            'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                            'posthog-aspnetcore')
    AND ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)), if(ascii(toString(properties.`$ai_lib`)) IN (91, 123)
                                                                                                                                                                     AND ascii(toJSONString(properties.`$ai_lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_lib`), '[]'), '{}'), toString(properties.`$ai_lib`))), '') IN ('posthog-openclaw',
                                                                                                                                                                                                                                                                                                                                           'posthog-opencode',
                                                                                                                                                                                                                                                                                                                                           '@posthog/pi',
                                                                                                                                                                                                                                                                                                                                           'posthog-ai')
  GROUP BY team_id,
           sdk_lib,
           ai_lib
  '''
