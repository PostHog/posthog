                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-node', 'node', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-edge', 'node', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-android', 'android', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-flutter', 'flutter', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') = 'posthog-ios', 'ios', ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
