# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.23]
  '''
  
  SELECT team_id,
         count(distinct toDate(timestamp), event, cityHash64(distinct_id), cityHash64(uuid)) as count
  FROM events_json
  WHERE timestamp >= '2022-01-10 22:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND event NOT IN ['$feature_flag_called', '$experiment_exposure', 'survey sent', 'survey shown', 'survey dismissed', '$exception', '$llm_prompt_fetched', '$conversations_loaded', '$conversations_widget_loaded', '$conversations_message_sent', '$conversations_user_identified', '$conversations_restore_link_requested', '$conversations_widget_state_changed', '$conversations_back_to_tickets', '$anomaly_score', '$anomaly_score_shadow']
    AND NOT startsWith(event, '$ai_')
    AND person_mode IN ('full',
                        'force_upgrade')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.24]
  '''
  
  SELECT team_id,
         COUNT() as count
  FROM events_json
  WHERE event = 'survey sent'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND uuid IN
      (SELECT argMax(uuid, timestamp)
       FROM events_json
       WHERE timestamp >= '2022-01-10 00:00:00'
         AND timestamp < '2022-01-10 23:59:59'
         AND event = 'survey sent'
       GROUP BY team_id,
                ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$survey_id`), '\\/', '/'), toJSONString(properties.^`$survey_id`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$survey_id`), '\\/', '/'), toJSONString(properties.^`$survey_id`)), if(ascii(toString(properties.`$survey_id`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                               AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$survey_id`), '\\/', '/'), toJSONString(properties.`$survey_id`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$survey_id`), '\\/', '/'), toJSONString(properties.`$survey_id`)), '[]'), '{}'), toString(properties.`$survey_id`))), ''),
                CASE
                    WHEN COALESCE(ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$survey_submission_id`), '\\/', '/'), toJSONString(properties.^`$survey_submission_id`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$survey_submission_id`), '\\/', '/'), toJSONString(properties.^`$survey_submission_id`)), if(ascii(toString(properties.`$survey_submission_id`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                             AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$survey_submission_id`), '\\/', '/'), toJSONString(properties.`$survey_submission_id`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$survey_submission_id`), '\\/', '/'), toJSONString(properties.`$survey_submission_id`)), '[]'), '{}'), toString(properties.`$survey_submission_id`))), ''), '') = '' THEN toString(uuid)
                    ELSE ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$survey_submission_id`), '\\/', '/'), toJSONString(properties.^`$survey_submission_id`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$survey_submission_id`), '\\/', '/'), toJSONString(properties.^`$survey_submission_id`)), if(ascii(toString(properties.`$survey_submission_id`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                    AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$survey_submission_id`), '\\/', '/'), toJSONString(properties.`$survey_submission_id`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$survey_submission_id`), '\\/', '/'), toJSONString(properties.`$survey_submission_id`)), '[]'), '{}'), toString(properties.`$survey_submission_id`))), '')
                END)
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.25]
  '''
  
  SELECT team_id,
         COUNT() - uniqExactIf(request_id, verified
                               AND NOT relay
                               AND request_id != '') AS count,
         max(relay) AS has_verified_relay
  FROM
    (SELECT team_id,
            ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_gateway_verified`), '\\/', '/'), toJSONString(properties.^`$ai_gateway_verified`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_gateway_verified`), '\\/', '/'), toJSONString(properties.^`$ai_gateway_verified`)), if(ascii(toString(properties.`$ai_gateway_verified`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                   AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_gateway_verified`), '\\/', '/'), toJSONString(properties.`$ai_gateway_verified`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_gateway_verified`), '\\/', '/'), toJSONString(properties.`$ai_gateway_verified`)), '[]'), '{}'), toString(properties.`$ai_gateway_verified`))), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            '1') AS verified,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           if(verified, ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_gateway_request_id`), '\\/', '/'), toJSONString(properties.^`$ai_gateway_request_id`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_gateway_request_id`), '\\/', '/'), toJSONString(properties.^`$ai_gateway_request_id`)), if(ascii(toString(properties.`$ai_gateway_request_id`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_gateway_request_id`), '\\/', '/'), toJSONString(properties.`$ai_gateway_request_id`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_gateway_request_id`), '\\/', '/'), toJSONString(properties.`$ai_gateway_request_id`)), '[]'), '{}'), toString(properties.`$ai_gateway_request_id`))), ''), '') AS request_id,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           if(verified, ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_gateway_relay`), '\\/', '/'), toJSONString(properties.^`$ai_gateway_relay`)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^`$ai_gateway_relay`), '\\/', '/'), toJSONString(properties.^`$ai_gateway_relay`)), if(ascii(toString(properties.`$ai_gateway_relay`)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_gateway_relay`), '\\/', '/'), toJSONString(properties.`$ai_gateway_relay`))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.`$ai_gateway_relay`), '\\/', '/'), toJSONString(properties.`$ai_gateway_relay`)), '[]'), '{}'), toString(properties.`$ai_gateway_relay`))), ''), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  '1') AS relay
     FROM events_json
     WHERE startsWith(event, '$ai_')
       AND timestamp >= '2022-01-10 00:00:00'
       AND timestamp < '2022-01-10 23:59:59')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.26]
  '''
  
  SELECT team_id,
         multiIf(CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'web', 'web', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'js', 'web_lite', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-node', 'node', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-edge', 'node', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-android', 'android', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-flutter', 'flutter', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-ios', 'ios', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-go', 'go', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-java', 'java', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-server', 'java', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-react-native', 'react_native', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-ruby', 'ruby', CAST(ifNull(toString(properties.`$lib`), ''), 'String') = 'posthog-python', 'python', 'unknown') AS library,
         count(1) as total
  FROM events_json
  WHERE event = '$exception'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
  GROUP BY team_id,
           library
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.27]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^count), '\\/', '/'), toJSONString(properties.^count)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^count), '\\/', '/'), toJSONString(properties.^count)), if(ascii(toString(properties.count)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                              AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.count), '\\/', '/'), toJSONString(properties.count))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.count), '\\/', '/'), toJSONString(properties.count)), '[]'), '{}'), toString(properties.count))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='decide usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^token), '\\/', '/'), toJSONString(properties.^token)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^token), '\\/', '/'), toJSONString(properties.^token)), if(ascii(toString(properties.token)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                            AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.token), '\\/', '/'), toJSONString(properties.token))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.token), '\\/', '/'), toJSONString(properties.token)), '[]'), '{}'), toString(properties.token))), ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.28]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^count), '\\/', '/'), toJSONString(properties.^count)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^count), '\\/', '/'), toJSONString(properties.^count)), if(ascii(toString(properties.count)) IN (91, 123)
                                                                                                                                                                                                                                                                                                                                                              AND ascii(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.count), '\\/', '/'), toJSONString(properties.count))) IN (91, 123), nullIf(nullIf(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.count), '\\/', '/'), toJSONString(properties.count)), '[]'), '{}'), toString(properties.count))), ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='local evaluation usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], ifNull(if(if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^token), '\\/', '/'), toJSONString(properties.^token)) != '{}', if(getSetting('output_format_json_escape_forward_slashes'), replaceAll(toJSONString(properties.^token), '\\/', '/'), toJSONString(properties.^token)), if(ascii(toString(properties.token)) IN (91, 123)
