# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.20]
  '''
  
  SELECT team_id,
         ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                                AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') AS sdk_lib,
         ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)), if(ascii(toString(properties.`$ai_lib`)) IN (91, 123)
                                                                                                                                                                      AND ascii(toJSONString(properties.`$ai_lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_lib`), '[]'), '{}'), toString(properties.`$ai_lib`))), '') AS ai_lib,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 16:00:00'
  AND timestamp < '2022-01-10 18:00:00'
  AND startsWith(event, '$ai_')
  WHERE ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(ascii(toString(properties.`$lib`)) IN (91, 123)
                                                                                                                                                               AND ascii(toJSONString(properties.`$lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), toString(properties.`$lib`))), '') IN ('posthog-node',
                                                                                                                                                                                                                                                                                                                            'posthog-python',
                                                                                                                                                                                                                                                                                                                            'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                            'posthog-aspnetcore')
    AND ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)), if(ascii(toString(properties.`$ai_lib`)) IN (91, 123)
                                                                                                                                                                     AND ascii(toJSONString(properties.`$ai_lib`)) IN (91, 123), nullIf(nullIf(toJSONString(properties.`$ai_lib`), '[]'), '{}'), toString(properties.`$ai_lib`))), '') IN ('posthog-openclaw',
                                                                                                                                                                                                                                                                                                                                           'posthog-opencode',
                                                                                                                                                                                                                                                                                                                                           '@posthog/pi',
                                                                                                                                                                                                                                                                                                                                           'posthog-ai')
  GROUP BY team_id,
           sdk_lib,
           ai_lib
  '''
