# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.48]
  '''
  
  SELECT team_id,
         count(distinct toDate(timestamp), event, cityHash64(distinct_id), cityHash64(uuid)) as count
  FROM events_json
  WHERE timestamp >= '2022-01-10 22:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND event NOT IN ['$feature_flag_called', '$experiment_exposure', 'survey sent', 'survey shown', 'survey dismissed', '$exception', '$ai_generation', '$ai_embedding', '$ai_span', '$ai_trace', '$ai_metric', '$ai_feedback', '$ai_evaluation', '$ai_tag', '$ai_trace_summary', '$ai_generation_summary', '$ai_trace_clusters', '$ai_generation_clusters', '$conversations_loaded', '$conversations_widget_loaded', '$conversations_message_sent', '$conversations_user_identified', '$conversations_restore_link_requested', '$conversations_widget_state_changed', '$conversations_back_to_tickets']
    AND person_mode IN ('full',
                        'force_upgrade')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.49]
  '''
  
  SELECT team_id,
         count(1) as count
  FROM events_json
  WHERE timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND ($group_0 != ''
         OR $group_1 != ''
         OR $group_2 != ''
         OR $group_3 != ''
         OR $group_4 != '')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.4]
  '''
  
  SELECT team_id,
         multiIf(event LIKE 'helicone%', 'helicone_events', event LIKE 'langfuse%', 'langfuse_events', event LIKE 'keywords_ai%', 'keywords_ai_events', event LIKE 'traceloop%', 'traceloop_events', ifNull(properties.`$lib`, '') = 'web', 'web_events', ifNull(properties.`$lib`, '') = 'js', 'web_lite_events', ifNull(properties.`$lib`, '') = 'posthog-node', 'node_events', ifNull(properties.`$lib`, '') = 'posthog-edge', 'edge_events', ifNull(properties.`$lib`, '') = 'posthog-convex', 'convex_events', ifNull(properties.`$lib`, '') = 'posthog-android', 'android_events', ifNull(properties.`$lib`, '') = 'posthog-flutter', 'flutter_events', ifNull(properties.`$lib`, '') = 'posthog-ios', 'ios_events', ifNull(properties.`$lib`, '') = 'posthog-go', 'go_events', ifNull(properties.`$lib`, '') = 'posthog-java', 'java_events', ifNull(properties.`$lib`, '') = 'posthog-server', 'java_events', ifNull(properties.`$lib`, '') = 'posthog-react-native', 'react_native_events', ifNull(properties.`$lib`, '') = 'posthog-ruby', 'ruby_events', ifNull(properties.`$lib`, '') = 'posthog-python', 'python_events', ifNull(properties.`$lib`, '') = 'posthog-php', 'php_events', ifNull(properties.`$lib`, '') = 'posthog-dotnet', 'dotnet_events', ifNull(properties.`$lib`, '') = 'posthog-elixir', 'elixir_events', ifNull(properties.`$lib`, '') = 'posthog-unity', 'unity_events', ifNull(properties.`$lib`, '') = 'posthog-rs', 'rust_events', 'other') AS metric,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 08:00:00'
  AND timestamp < '2022-01-10 10:00:00'
  WHERE (event LIKE 'helicone%'
         OR event LIKE 'langfuse%'
         OR event LIKE 'keywords_ai%'
         OR event LIKE 'traceloop%'
         OR ifNull(properties.`$lib`, '') IN ('web',
                                              'js',
                                              'posthog-node',
                                              'posthog-edge',
                                              'posthog-convex',
                                              'posthog-android',
                                              'posthog-flutter',
                                              'posthog-ios',
                                              'posthog-go',
                                              'posthog-java',
                                              'posthog-server',
                                              'posthog-react-native',
                                              'posthog-ruby',
                                              'posthog-python',
                                              'posthog-php',
                                              'posthog-dotnet',
                                              'posthog-elixir',
                                              'posthog-unity',
                                              'posthog-rs'))
  GROUP BY team_id,
           metric
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.50]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(replaceRegexpAll(ifNull(if(toJSONString(properties.^count) != '{}', toJSONString(properties.^count), if(startsWith(dynamicType(properties.count), 'Array')
                                                                                                                                   OR startsWith(dynamicType(properties.count), 'Map')
                                                                                                                                   OR startsWith(dynamicType(properties.count), 'Tuple'), toJSONString(properties.count), if(startsWith(dynamicType(properties.count), 'DateTime'), replaceOne(toString(properties.count), ' ', 'T'), toString(properties.count)))), ''), '^"|"$', ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='decide usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], replaceRegexpAll(ifNull(if(toJSONString(properties.^token) != '{}', toJSONString(properties.^token), if(startsWith(dynamicType(properties.token), 'Array')
                                                                                                                                 OR startsWith(dynamicType(properties.token), 'Map')
                                                                                                                                 OR startsWith(dynamicType(properties.token), 'Tuple'), toJSONString(properties.token), if(startsWith(dynamicType(properties.token), 'DateTime'), replaceOne(toString(properties.token), ' ', 'T'), toString(properties.token)))), ''), '^"|"$', ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.51]
  '''
  
  SELECT distinct_id as team,
         sum(toInt64OrZero(replaceRegexpAll(ifNull(if(toJSONString(properties.^count) != '{}', toJSONString(properties.^count), if(startsWith(dynamicType(properties.count), 'Array')
                                                                                                                                   OR startsWith(dynamicType(properties.count), 'Map')
                                                                                                                                   OR startsWith(dynamicType(properties.count), 'Tuple'), toJSONString(properties.count), if(startsWith(dynamicType(properties.count), 'DateTime'), replaceOne(toString(properties.count), ' ', 'T'), toString(properties.count)))), ''), '^"|"$', ''))) as sum
  FROM events_json
  WHERE team_id = 99999
    AND event='local evaluation usage'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND has(['correct'], replaceRegexpAll(ifNull(if(toJSONString(properties.^token) != '{}', toJSONString(properties.^token), if(startsWith(dynamicType(properties.token), 'Array')
                                                                                                                                 OR startsWith(dynamicType(properties.token), 'Map')
                                                                                                                                 OR startsWith(dynamicType(properties.token), 'Tuple'), toJSONString(properties.token), if(startsWith(dynamicType(properties.token), 'DateTime'), replaceOne(toString(properties.token), ' ', 'T'), toString(properties.token)))), ''), '^"|"$', ''))
  GROUP BY team
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.52]
  '''
  
  SELECT team_id,
         COUNT() as count
  FROM events_json
  WHERE event = 'survey sent'
    AND timestamp >= '2022-01-10 00:00:00'
    AND timestamp < '2022-01-10 23:59:59'
    AND uuid IN
      (SELECT argMax(uuid, timestamp)
       FROM events_json
       WHERE timestamp >= '2022-01-10 00:00:00'
         AND timestamp < '2022-01-10 23:59:59'
         AND event = 'survey sent'
       GROUP BY team_id,
                ifNull(properties.`$survey_id`, ''),
                CASE
                    WHEN COALESCE(replaceRegexpAll(ifNull(if(toJSONString(properties.^`$survey_submission_id`) != '{}', toJSONString(properties.^`$survey_submission_id`), if(startsWith(dynamicType(properties.`$survey_submission_id`), 'Array')
                                                                                                                                                                              OR startsWith(dynamicType(properties.`$survey_submission_id`), 'Map')
                                                                                                                                                                              OR startsWith(dynamicType(properties.`$survey_submission_id`), 'Tuple'), toJSONString(properties.`$survey_submission_id`), if(startsWith(dynamicType(properties.`$survey_submission_id`), 'DateTime'), replaceOne(toString(properties.`$survey_submission_id`), ' ', 'T'), toString(properties.`$survey_submission_id`)))), ''), '^"|"$', ''), '') = '' THEN toString(uuid)
                    ELSE replaceRegexpAll(ifNull(if(toJSONString(properties.^`$survey_submission_id`) != '{}', toJSONString(properties.^`$survey_submission_id`), if(startsWith(dynamicType(properties.`$survey_submission_id`), 'Array')
                                                                                                                                                                     OR startsWith(dynamicType(properties.`$survey_submission_id`), 'Map')
                                                                                                                                                                     OR startsWith(dynamicType(properties.`$survey_submission_id`), 'Tuple'), toJSONString(properties.`$survey_submission_id`), if(startsWith(dynamicType(properties.`$survey_submission_id`), 'DateTime'), replaceOne(toString(properties.`$survey_submission_id`), ' ', 'T'), toString(properties.`$survey_submission_id`)))), ''), '^"|"$', '')
                END)
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.53]
  '''
  
  SELECT team_id,
         COUNT() - uniqExactIf(request_id, verified
                               AND NOT relay
                               AND request_id != '') AS count,
         max(relay) AS has_verified_relay
  FROM
    (SELECT team_id,
            replaceRegexpAll(ifNull(if(toJSONString(properties.^`$ai_gateway_verified`) != '{}', toJSONString(properties.^`$ai_gateway_verified`), if(startsWith(dynamicType(properties.`$ai_gateway_verified`), 'Array')
                                                                                                                                                      OR startsWith(dynamicType(properties.`$ai_gateway_verified`), 'Map')
                                                                                                                                                      OR startsWith(dynamicType(properties.`$ai_gateway_verified`), 'Tuple'), toJSONString(properties.`$ai_gateway_verified`), if(startsWith(dynamicType(properties.`$ai_gateway_verified`), 'DateTime'), replaceOne(toString(properties.`$ai_gateway_verified`), ' ', 'T'), toString(properties.`$ai_gateway_verified`)))), ''), '^"|"$', '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   '1') AS verified,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(verified, replaceRegexpAll(ifNull(if(toJSONString(properties.^`$ai_gateway_request_id`) != '{}', toJSONString(properties.^`$ai_gateway_request_id`), if(startsWith(dynamicType(properties.`$ai_gateway_request_id`), 'Array')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             OR startsWith(dynamicType(properties.`$ai_gateway_request_id`), 'Map')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             OR startsWith(dynamicType(properties.`$ai_gateway_request_id`), 'Tuple'), toJSONString(properties.`$ai_gateway_request_id`), if(startsWith(dynamicType(properties.`$ai_gateway_request_id`), 'DateTime'), replaceOne(toString(properties.`$ai_gateway_request_id`), ' ', 'T'), toString(properties.`$ai_gateway_request_id`)))), ''), '^"|"$', ''), '') AS request_id,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if(verified, replaceRegexpAll(ifNull(if(toJSONString(properties.^`$ai_gateway_relay`) != '{}', toJSONString(properties.^`$ai_gateway_relay`), if(startsWith(dynamicType(properties.`$ai_gateway_relay`), 'Array')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   OR startsWith(dynamicType(properties.`$ai_gateway_relay`), 'Map')
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   OR startsWith(dynamicType(properties.`$ai_gateway_relay`), 'Tuple'), toJSONString(properties.`$ai_gateway_relay`), if(startsWith(dynamicType(properties.`$ai_gateway_relay`), 'DateTime'), replaceOne(toString(properties.`$ai_gateway_relay`), ' ', 'T'), toString(properties.`$ai_gateway_relay`)))), ''), '^"|"$', ''), '') IN ('true',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      '1') AS relay
     FROM events_json
     WHERE event IN ['$ai_generation', '$ai_embedding', '$ai_span', '$ai_trace', '$ai_metric', '$ai_feedback', '$ai_evaluation', '$ai_tag', '$ai_trace_summary', '$ai_generation_summary', '$ai_trace_clusters', '$ai_generation_clusters']
       AND timestamp >= '2022-01-10 00:00:00'
       AND timestamp < '2022-01-10 23:59:59')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.54]
  '''
  
  SELECT team_id,
         COUNT() - uniqExactIf(request_id, verified
                               AND request_id != '') as count
  FROM
    (SELECT team_id,
            JSONExtractBool(toJSONString(properties), '$ai_gateway_verified') as verified,
            if(verified, JSONExtractString(toJSONString(properties), '$ai_gateway_request_id'), '') as request_id
     FROM events_json
     WHERE event IN ['$ai_generation', '$ai_embedding', '$ai_span', '$ai_trace', '$ai_metric', '$ai_feedback', '$ai_evaluation', '$ai_tag', '$ai_trace_summary', '$ai_generation_summary', '$ai_trace_clusters', '$ai_generation_clusters']
       AND timestamp >= '2022-01-10 00:00:00'
       AND timestamp < '2022-01-10 23:59:59')
  GROUP BY team_id
  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.5]
  '''
  
  SELECT team_id,
