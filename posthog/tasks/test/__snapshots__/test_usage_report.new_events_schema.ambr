  '''
# ---
# name: TestFeatureFlagsUsageReport.test_usage_report_decide_requests[new_events_schema.12]
  '''
  
  SELECT team_id,
         ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Array')
                                                                                                                                                                OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Map')
                                                                                                                                                                OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$lib`), 20, 10), 'Z'), toString(properties.`$lib`)))), '') AS sdk_lib,
         ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)), if(startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'Array')
                                                                                                                                                                      OR startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'Map')
                                                                                                                                                                      OR startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$ai_lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$ai_lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$ai_lib`), 20, 10), 'Z'), toString(properties.`$ai_lib`)))), '') AS ai_lib,
         count(1) as count
  FROM events_json PREWHERE timestamp >= '2022-01-10 00:00:00'
  AND timestamp < '2022-01-10 02:00:00'
  AND startsWith(event, '$ai_')
  WHERE ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$lib`)), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Array')
                                                                                                                                                               OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Map')
                                                                                                                                                               OR startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$lib`), 20, 10), 'Z'), toString(properties.`$lib`)))), '') IN ('posthog-node',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         'posthog-python',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         'posthog-dotnet',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         'posthog-aspnetcore')
    AND ifNull(if(JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)) != '{}', JSONStripEmptyStringsAndNulls(toJSONString(properties.^`$ai_lib`)), if(startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'Array')
                                                                                                                                                                     OR startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'Map')
                                                                                                                                                                     OR startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'Tuple'), nullIf(nullIf(toJSONString(properties.`$ai_lib`), '[]'), '{}'), if(startsWith(dynamicType(accurateCast(properties.`$ai_lib`, 'Dynamic')), 'DateTime'), concat(replaceOne(substring(toString(accurateCastOrNull(properties.`$ai_lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T'), substring(toString(properties.`$ai_lib`), 20, 10), 'Z'), toString(properties.`$ai_lib`)))), '') IN ('posthog-openclaw',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 'posthog-opencode',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 '@posthog/pi',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 'posthog-ai')
  GROUP BY team_id,
           sdk_lib,
           ai_lib
  '''
