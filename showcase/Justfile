# ==============================================================================
# showcase/Justfile
# PostHog DeveX Acceleration Showcase
# Runnables:
#   1. Container Build   (Cold multi-arch build via enve + 5-point slimming)
#   2. Merge Queue Gate  (5s static in-memory AST contract + DAG reachability)
#   3. Backend Shards    (Full test of ci-backend.yml, 5 shards x 4 workers)
# ==============================================================================

set dotenv-load := true

SHOWCASE_DIR := justfile_directory()
REPO_ROOT := clean(SHOWCASE_DIR + "/..")

# Default: List all available showcase recipes
default:
    @just --justfile {{SHOWCASE_DIR}}/Justfile --list

# ------------------------------------------------------------------------------
# ENVIRONMENT & PREREQUISITES
# ------------------------------------------------------------------------------

# Verify host platform (Linux/macOS) and strict enve 0.8.3 version
check-env:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{SHOWCASE_DIR}}/scripts/common_env.sh"
    echo "======================================================================="
    echo "  🔍 Checking Showcase Environment & Binary Prerequisites"
    echo "======================================================================="
    echo "• Operating System  : ${HOST_OS}"
    echo "• Architecture      : ${HOST_ARCH}"
    echo "• CPU Cores         : ${CPU_CORES}"
    echo "• Ephemeral Storage : ${SHOWCASE_TMPFS}"
    echo "• enve (Platform)   : $(enve --version)"
    echo "• PostgreSQL        : $(postgres --version 2>/dev/null || echo 'Available via enve')"
    echo "• Redis             : $(redis-server --version 2>/dev/null | head -n 1 || echo 'Available via enve')"
    echo "• ClickHouse        : $(clickhouse-server --version 2>/dev/null | head -n 1 || echo 'Available via enve')"
    echo "• Tansu (Kafka)     : $(tansu --version 2>/dev/null || echo 'Available via enve')"
    echo "• S3 (SeaweedFS)    : $(weed version 2>/dev/null || echo 'Available via enve')"
    verify_enve
    echo "======================================================================="
    echo "✅ Environment check passed cleanly!"
    echo "======================================================================="

# ------------------------------------------------------------------------------
# RUNNABLES
# ------------------------------------------------------------------------------

# Runnable 1: Full multi-arch cold container build with enve
build-container:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    "{{SHOWCASE_DIR}}/scripts/run_container_build.sh"

# Runnable 1b: Layered OCI Container Build for Typical PRs (sub-2s synthesis over cached layers)
build-container-layered:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    "{{SHOWCASE_DIR}}/scripts/run_layered_container_build.sh"

# Alias for layered PR container build
build-container-pr: build-container-layered

# Standard Docker build using optimized Dockerfile.v2
build-docker TAG="posthog:optimized":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    echo "======================================================================="
    echo "  🐳 Building Optimized Container via Dockerfile.v2 (Tag: {{TAG}})"
    echo "======================================================================="
    echo "• Multi-stage build with BUILDPLATFORM frontend acceleration"
    echo "• Default-stripped sourcemaps (*.map) avoiding 2.8GB layer bloat"
    echo "• Zero redundant collectstatic and unneeded CUDA GPU library exclusions"
    echo "-----------------------------------------------------------------------"
    # Real PR scenario: developer modified a shared frontend dependency (@posthog/quill-charts)
    echo "• PR diff detected on frontend dependency: updated packages/quill/packages/charts/src/index.ts"
    echo "// PR change on charts dep: $(date +%s)" >> packages/quill/packages/charts/src/index.ts
    trap 'git checkout packages/quill/packages/charts/src/index.ts 2>/dev/null || true' EXIT

    if command -v docker >/dev/null 2>&1; then
        docker build -f "{{SHOWCASE_DIR}}/Dockerfile.v2" -t "{{TAG}}" .
    else
        echo "⚠️ docker command not found on host."
        echo "   Command to execute with Docker daemon:"
        echo "   docker build -f showcase/Dockerfile.v2 -t {{TAG}} ."
    fi

# Runnable 2: Merge Queue Gate (In-memory AST contract + DAG reachability)
gate-migrations:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    uv run python "{{SHOWCASE_DIR}}/scripts/run_migration_gate.py"

# Runnable 3: Execute a single backend test shard with configurable workers (n, <=n, auto)
# Runnable 3: Execute a single backend test shard with configurable workers (n, <=n, auto)
test-shard SHARD="1" WORKERS="6" FAIL_FAST="true":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    FAIL_FLAG=""
    if [ "{{FAIL_FAST}}" = "true" ] || [ "{{FAIL_FAST}}" = "1" ]; then
        FAIL_FLAG="--fail-fast"
    fi
    "{{SHOWCASE_DIR}}/scripts/run_backend_shards.sh" --shard {{SHARD}} --total-shards 5 --workers "{{WORKERS}}" $FAIL_FLAG

# Runnable 3: Execute all 5 shards sequentially across the monorepo with configurable workers
test-all-shards WORKERS="6" FAIL_FAST="true":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    ACTUAL_WORKERS="{{WORKERS}}"
    FAIL_FLAG="--fail-fast"
    # If user passed shard index then worker count like `test-all-shards 1 6`:
    if [ "{{FAIL_FAST}}" != "true" ] && [ "{{FAIL_FAST}}" != "false" ] && [ "{{FAIL_FAST}}" != "0" ] && [ "{{FAIL_FAST}}" != "1" ]; then
        ACTUAL_WORKERS="{{FAIL_FAST}}"
    fi
    echo "======================================================================="
    echo "  🚀 Executing Full Test Matrix (5 Shards x ${ACTUAL_WORKERS} Workers = 100% Monorepo)"
    echo "======================================================================="
    for shard in 1 2 3 4 5; do
        echo ""
        echo "─── Starting Shard $shard of 5 ──────────────────────────────────────"
        "{{SHOWCASE_DIR}}/scripts/run_backend_shards.sh" --shard "$shard" --total-shards 5 --workers "${ACTUAL_WORKERS}" $FAIL_FLAG
    done
    echo ""
    echo "======================================================================="
    echo "✅ All 5 Backend CI Shards Passed Successfully!"
    echo "======================================================================="

# Compare upstream Docker Compose CI overhead with in-process enve services
compare-ci-overhead TARGET="posthog/api/test/test_user.py":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    "{{SHOWCASE_DIR}}/scripts/compare_ci_overhead.sh" "{{TARGET}}"


# ------------------------------------------------------------------------------
# MICROSERVICE CONTROLS (enve + SeaweedFS S3 on tmpfs)
# ------------------------------------------------------------------------------

# Start rootless microservices (Postgres, ClickHouse, Redis, Temporal, Tansu, S3)
services-up:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    source "{{SHOWCASE_DIR}}/scripts/common_env.sh"
    "{{SHOWCASE_DIR}}/scripts/manage_services.sh" start

# Stop running rootless microservices
services-down:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    source "{{SHOWCASE_DIR}}/scripts/common_env.sh"
    "{{SHOWCASE_DIR}}/scripts/manage_services.sh" stop

# Inspect real-time memory footprint (RSS) of running services
services-status:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{SHOWCASE_DIR}}/scripts/common_env.sh"
    "{{SHOWCASE_DIR}}/scripts/manage_services.sh" status

# ------------------------------------------------------------------------------
# EXECUTIVE SUITE: RUN ALL 3 RUNNABLES
# ------------------------------------------------------------------------------

# Execute all 3 runnables in sequence with an executive scorecard
showcase-all TARGETS="posthog/api/test/test_user.py":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    echo "======================================================================="
    echo "  🌟 PostHog DeveX Acceleration: Complete Showcase Suite"
    echo "======================================================================="
    START_ALL=$(date +%s%N)

    echo ""
    echo "▶ [1/3] Executing Runnable 2: 5s AST Contract & DAG Reachability..."
    uv run python "{{SHOWCASE_DIR}}/scripts/run_migration_gate.py"

    echo ""
    echo "▶ [2/3] Executing Runnable 1: Multi-Arch Cold Container Build with enve..."
    "{{SHOWCASE_DIR}}/scripts/run_container_build.sh"

    echo ""
    echo "▶ [3/3] Executing Runnable 3: Backend CI Shard Execution (4 Workers)..."
    if [ -n "{{TARGETS}}" ]; then
        "{{SHOWCASE_DIR}}/scripts/run_backend_shards.sh" --shard 1 --total-shards 5 --workers 4 {{TARGETS}}
    else
        "{{SHOWCASE_DIR}}/scripts/run_backend_shards.sh" --shard 1 --total-shards 5 --workers 4
    fi

    END_ALL=$(date +%s%N)
    ALL_MS=$(( (END_ALL - START_ALL) / 1000000 ))
    ALL_SEC=$(awk "BEGIN {printf \"%.2f\", $ALL_MS / 1000}")

    echo ""
    echo "======================================================================="
    echo "🏆 PostHog DeveX Showcase: All 3 Runnables Completed in ${ALL_SEC}s!"
    echo "======================================================================="
    echo "  1. Cold Container Build : Synthesized multi-arch OCI image with 1.87GB slimming"
    echo "  2. Merge Queue Gate     : In-memory AST contract (<5s vs 22m scratch replay)"
    echo "  3. Backend Test Shards  : 4 workers per shard on rootless enve tmpfs services"
    echo "======================================================================="
