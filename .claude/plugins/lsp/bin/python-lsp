#!/bin/bash
# Serves the ty build pinned in pyproject.toml.
set -euo pipefail

ROOT="$1"
. "$ROOT/bin/helpers/worktree-borrow.sh"

# ty resolves imports through VIRTUAL_ENV. An inherited value wins, because a
# borrowed worktree venv is still the right one.
VENV="${VIRTUAL_ENV:-}"
if [ ! -x "$VENV/bin/ty" ]; then
    VENV=$(posthog_find_venv "$ROOT")
fi

if [ ! -x "$VENV/bin/ty" ]; then
    echo "posthog-lsp: no venv with ty found, run 'uv sync' to get the Python LSP" >&2
    exit 1
fi

cd "$ROOT"
export VIRTUAL_ENV="$VENV"
exec "$VENV/bin/ty" server
