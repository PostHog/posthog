#!/bin/bash
# Serves the ty build pinned in pyproject.toml.
set -euo pipefail

cd "$1"
. bin/helpers/worktree-borrow.sh

# ty resolves imports through VIRTUAL_ENV. An inherited value can belong to another
# checkout, so only this checkout's venv or a lockfile-matched borrow counts.
unset VIRTUAL_ENV
posthog_worktree_borrow all
VENV="${VIRTUAL_ENV:-$(posthog_find_venv "$PWD")}"

if [ ! -x "$VENV/bin/ty" ]; then
    echo "posthog-lsp: no venv with ty found, run 'uv sync' to get the Python LSP" >&2
    exit 1
fi

export VIRTUAL_ENV="$VENV"
exec "$VENV/bin/ty" server
