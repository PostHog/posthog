#!/bin/bash
# Serves the tsgo build pinned in package.json, so navigation agrees with
# `pnpm --filter=@posthog/frontend typescript:check`.
set -euo pipefail

cd "$1"
. bin/helpers/worktree-borrow.sh

# A linked worktree without node_modules borrows the main clone's when pnpm-lock.yaml
# matches. Never fall back to a tsgo on PATH, which could be any version.
TSGO="$PWD/node_modules/.bin/tsgo"
unset POSTHOG_BORROW_NODE
posthog_worktree_borrow node
if [ -n "${POSTHOG_BORROW_NODE:-}" ]; then
    TSGO="$(posthog_main_repo "$PWD")/node_modules/.bin/tsgo"
fi

if [ ! -x "$TSGO" ]; then
    echo "posthog-lsp: $TSGO is missing, run 'pnpm install' to get the TypeScript LSP" >&2
    exit 1
fi

exec "$TSGO" --lsp --stdio
