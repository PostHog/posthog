{
    "name": "posthog-lsp",
    "description": "Language servers for this repo: tsgo for TypeScript/JavaScript and ty for Python, both taken from the pinned dev dependencies.",
    "version": "1.0.0",
    "author": {
        "name": "PostHog"
    },
    "lspServers": {
        "tsgo": {
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/typescript-lsp",
            "args": ["${CLAUDE_PROJECT_DIR}"],
            "extensionToLanguage": {
                ".ts": "typescript",
                ".tsx": "typescriptreact",
                ".mts": "typescript",
                ".cts": "typescript",
                ".js": "javascript",
                ".jsx": "javascriptreact",
                ".mjs": "javascript",
                ".cjs": "javascript"
            }
        },
        "ty": {
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/python-lsp",
            "args": ["${CLAUDE_PROJECT_DIR}"],
            "extensionToLanguage": {
                ".py": "python",
                ".pyi": "python"
            }
        }
    }
}
