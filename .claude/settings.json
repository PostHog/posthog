{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-cloud.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-code-signing.sh"
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-flox.sh"
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "posthog-lsp@posthog": true,
        "typescript-lsp@claude-plugins-official": false
    },
    "extraKnownMarketplaces": {
        "posthog": {
            "source": {
                "source": "directory",
                "path": "."
            }
        }
    }
}
