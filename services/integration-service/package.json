{
    "name": "@posthog/integration-service",
    "version": "1.0.0",
    "description": "PostHog integration service \u2014 serves platform integration credentials over HTTP",
    "license": "MIT",
    "author": "PostHog Inc.",
    "type": "module",
    "scripts": {
        "build": "tsx scripts/build-integration-service.ts",
        "dev": "tsx scripts/dev-integration-service.ts | pino-pretty --colorize --ignore pid,hostname --messageKey event --translateTime SYS:HH:MM:ss.l",
        "test": "vitest",
        "test:unit": "vitest run tests/unit",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --quiet",
        "lint:fix": "oxlint --fix --quiet",
        "format": "oxfmt \"./**/*.{js,mjs,ts,tsx,json,yaml,yml}\"",
        "format:check": "oxfmt --check \"./**/*.{js,mjs,ts,tsx,json,yaml,yml}\"",
        "fix": "pnpm lint:fix; s=$?; pnpm format && exit $s",
        "check:deps": "tsx scripts/check-deps-allowlist.ts",
        "check:boundary": "tsx scripts/check-import-boundary.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.975.0",
        "@aws-sdk/credential-provider-web-identity": "3.972.70",
        "@hono/node-server": "^2.0.2",
        "esbuild": "^0.25.11",
        "hono": "^4.12.18",
        "jose": "^6.0.10",
        "pg": "^8.13.1",
        "pino": "^8.6.0",
        "prom-client": "^14.2.0"
    },
    "devDependencies": {
        "@smithy/types": "^4.16.1",
        "@types/node": "^22.17.2",
        "@types/pg": "^8.11.10",
        "oxfmt": "catalog:",
        "oxlint": "^1.72.0",
        "pino-pretty": "^9.1.0",
        "tsx": "^4.20.5",
        "typescript": "catalog:",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    },
    "//aws-sdk-pin": "Exact pin, not a range. The AWS SDK ships its clients against a matching @smithy/* tree, and the repo pins @smithy/core fleet-wide; a floating range drifts past it and the bundle fails on missing exports."
}
