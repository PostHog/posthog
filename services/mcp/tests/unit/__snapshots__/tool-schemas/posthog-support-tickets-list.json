{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "limit": {
            "default": 20,
            "description": "Number of tickets to return.",
            "maximum": 100,
            "minimum": 1,
            "type": "number"
        },
        "offset": {
            "default": 0,
            "description": "Number of tickets to skip.",
            "minimum": 0,
            "type": "number"
        },
        "status": {
            "description": "Only return tickets with this status.\n\n* `new` - New\n* `open` - Open\n* `pending` - Pending\n* `on_hold` - On hold\n* `resolved` - Resolved",
            "enum": ["new", "open", "pending", "on_hold", "resolved"],
            "type": "string"
        }
    },
    "type": "object"
}
