{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "id": {
            "description": "Ticket ID from posthog-support-tickets-list or from posthog-support-ticket-create.",
            "pattern": "^[0-9a-f-]{36}$",
            "type": "string"
        }
    },
    "required": ["id"],
    "type": "object"
}
