{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "application_version": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Version of the application under evaluation."
        },
        "dataset_identifier": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Stable identifier for the external dataset."
        },
        "dataset_revision_id": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "UUID of a hosted dataset revision in this project."
        },
        "dataset_revision_identifier": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Pinned revision identifier of the external dataset."
        },
        "dataset_source": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Source of an external dataset. Hosted dataset provenance is derived from its revision."
        },
        "expected_item_count": {
            "anyOf": [
                {
                    "maximum": 2147483647,
                    "minimum": 0,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Expected number of distinct items. Completion must match this count when supplied."
        },
        "expected_result_count": {
            "anyOf": [
                {
                    "maximum": 2147483647,
                    "minimum": 0,
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Expected number of distinct item/scorer-version results, including non-success statuses."
        },
        "id": {
            "description": "Caller-generated experiment UUID. Reuse it for exact retries.",
            "type": "string"
        },
        "model_version": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Version of the model under evaluation."
        },
        "name": {
            "description": "Display name for this experiment execution.",
            "maxLength": 400,
            "type": "string"
        },
        "prompt_version": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Version of the prompt under evaluation."
        },
        "run_source": {
            "anyOf": [
                {
                    "description": "* `ci` - CI\n* `local` - Local\n* `scheduled` - Scheduled",
                    "enum": ["ci", "local", "scheduled"],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Where the execution started: ci, local, or scheduled. Omit or use null when unknown.\n\n* `ci` - CI\n* `local` - Local\n* `scheduled` - Scheduled"
        },
        "started_at": {
            "description": "Execution start time in ISO 8601 format, supplied by the caller.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
        },
        "suite_key": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Stable identifier for comparing executions of the same evaluation suite."
        }
    },
    "required": ["id", "name", "started_at"],
    "type": "object"
}
