{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "channel_id": {
            "description": "Id of the channel to create the canvas in (resolve it with channel-list).",
            "type": "string"
        },
        "name": {
            "description": "Display name for the canvas.",
            "maxLength": 400,
            "type": "string"
        },
        "template_id": {
            "default": "freeform",
            "description": "Canvas template identifier.",
            "maxLength": 64,
            "type": "string"
        }
    },
    "required": ["name", "channel_id"],
    "type": "object"
}
