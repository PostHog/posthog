{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "id": {
            "type": "string"
        },
        "review_state": {
            "anyOf": [
                {
                    "description": "* `known` - Known\n* `resolved` - Resolved\n* `not_an_issue` - Not an issue",
                    "enum": ["known", "resolved", "not_an_issue"],
                    "type": "string"
                },
                {
                    "enum": [""],
                    "type": "string"
                }
            ],
            "description": "`known` (the team is aware), `resolved` (fixed; new members reopen it as `regressed`), `not_an_issue`, or an empty string to clear the review.\n\n* `known` - Known\n* `resolved` - Resolved\n* `not_an_issue` - Not an issue"
        }
    },
    "required": ["id", "review_state"],
    "type": "object"
}
