{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "id": {
            "pattern": "^[0-9a-f-]{36}$",
            "type": "string"
        },
        "trigger_id": {
            "description": "ID of the trigger to delete.",
            "type": "string"
        }
    },
    "required": ["id", "trigger_id"],
    "type": "object"
}
