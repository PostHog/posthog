{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "active": {
            "description": "Whether the feature flag is active.",
            "type": "boolean"
        },
        "archived": {
            "description": "Whether the flag is archived. Archived flags are hidden from the flag list by default and must be disabled (`active: false`).",
            "type": "boolean"
        },
        "bucketing_identifier": {
            "anyOf": [
                {
                    "description": "* `distinct_id` - User ID (default)\n* `device_id` - Device ID",
                    "enum": ["distinct_id", "device_id"],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Identifier used to bucket users into rollout percentages and variants — `distinct_id` (user ID, the default) or `device_id`. Using `device_id` is incompatible with `ensure_experience_continuity=true`."
        },
        "ensure_experience_continuity": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Whether to persist the flag's value for a user across the anonymous-to-identified transition (the \"persist across authentication steps\" option in the UI). Keeps a user's evaluated value stable once they log in. Incompatible with `device_id` bucketing."
        },
        "evaluation_contexts": {
            "description": "Evaluation contexts that control where this flag evaluates at runtime.",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "evaluation_runtime": {
            "anyOf": [
                {
                    "description": "* `server` - Server\n* `client` - Client\n* `all` - All",
                    "enum": ["server", "client", "all"],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Where this flag is allowed to evaluate — `server` (server-side SDKs only), `client` (client-side SDKs only), or `all` (both). Defaults to `all`."
        },
        "filters": {
            "description": "Feature flag targeting configuration.",
            "properties": {
                "aggregation_group_type_index": {
                    "anyOf": [
                        {
                            "maximum": 2147483647,
                            "minimum": -2147483648,
                            "type": "number"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Group type index for group-based feature flags. Null means person-level aggregation."
                },
                "early_exit": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "When true, condition evaluation stops at the first matching condition set rather than continuing to evaluate subsequent groups."
                },
                "feature_enrollment": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Whether this flag has early access feature enrollment enabled. When true, the flag is evaluated against the person property $feature_enrollment/{flag_key}."
                },
                "groups": {
                    "description": "Release condition groups for the feature flag.",
                    "items": {
                        "description": "A release condition group: who the flag rolls out to, at what percentage.",
                        "properties": {
                            "aggregation_group_type_index": {
                                "anyOf": [
                                    {
                                        "maximum": 2147483647,
                                        "minimum": -2147483648,
                                        "type": "number"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Group type index for this condition set. Null means person-level aggregation; absent falls back to the flag-level value."
                            },
                            "description": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Display-only description for this condition group, shown in the UI."
                            },
                            "exposure_frozen": {
                                "anyOf": [
                                    {
                                        "type": "boolean"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Set when an experiment froze exposure by narrowing this group to a snapshot cohort."
                            },
                            "exposure_frozen_cohort": {
                                "anyOf": [
                                    {
                                        "maximum": 2147483647,
                                        "minimum": -2147483648,
                                        "type": "number"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "ID of the snapshot cohort this group was narrowed to when experiment exposure was frozen."
                            },
                            "properties": {
                                "anyOf": [
                                    {
                                        "items": {
                                            "description": "A property condition inside a release condition group.",
                                            "properties": {
                                                "cohort_name": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {
                                                            "type": "null"
                                                        }
                                                    ],
                                                    "description": "Display name of the referenced cohort. Injected on read and echoed back by clients."
                                                },
                                                "group_key_names": {
                                                    "description": "Display names for group keys, keyed by group key. Injected on read and echoed back by clients."
                                                },
                                                "group_type_index": {
                                                    "anyOf": [
                                                        {
                                                            "maximum": 2147483647,
                                                            "minimum": -2147483648,
                                                            "type": "number"
                                                        },
                                                        {
                                                            "type": "null"
                                                        }
                                                    ],
                                                    "description": "Group type index when using group-based filters."
                                                },
                                                "key": {
                                                    "description": "Property key used in this feature flag condition. Numbers are normalized to strings.",
                                                    "type": "string"
                                                },
                                                "label": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {
                                                            "type": "null"
                                                        }
                                                    ],
                                                    "description": "Display-only label for this property filter, shown in the UI."
                                                },
                                                "negation": {
                                                    "anyOf": [
                                                        {
                                                            "type": "boolean"
                                                        },
                                                        {
                                                            "type": "null"
                                                        }
                                                    ],
                                                    "description": "Whether the property condition is negated."
                                                },
                                                "operator": {
                                                    "anyOf": [
                                                        {
                                                            "description": "* `exact` - exact\n* `flag_evaluates_to` - flag_evaluates_to\n* `gt` - gt\n* `gte` - gte\n* `icontains` - icontains\n* `icontains_multi` - icontains_multi\n* `in` - in\n* `is_date_after` - is_date_after\n* `is_date_before` - is_date_before\n* `is_date_exact` - is_date_exact\n* `is_not` - is_not\n* `is_not_set` - is_not_set\n* `is_set` - is_set\n* `lt` - lt\n* `lte` - lte\n* `not_icontains` - not_icontains\n* `not_icontains_multi` - not_icontains_multi\n* `not_in` - not_in\n* `not_regex` - not_regex\n* `regex` - regex\n* `semver_caret` - semver_caret\n* `semver_eq` - semver_eq\n* `semver_gt` - semver_gt\n* `semver_gte` - semver_gte\n* `semver_lt` - semver_lt\n* `semver_lte` - semver_lte\n* `semver_neq` - semver_neq\n* `semver_tilde` - semver_tilde\n* `semver_wildcard` - semver_wildcard",
                                                            "enum": [
                                                                "exact",
                                                                "flag_evaluates_to",
                                                                "gt",
                                                                "gte",
                                                                "icontains",
                                                                "icontains_multi",
                                                                "in",
                                                                "is_date_after",
                                                                "is_date_before",
                                                                "is_date_exact",
                                                                "is_not",
                                                                "is_not_set",
                                                                "is_set",
                                                                "lt",
                                                                "lte",
                                                                "not_icontains",
                                                                "not_icontains_multi",
                                                                "not_in",
                                                                "not_regex",
                                                                "regex",
                                                                "semver_caret",
                                                                "semver_eq",
                                                                "semver_gt",
                                                                "semver_gte",
                                                                "semver_lt",
                                                                "semver_lte",
                                                                "semver_neq",
                                                                "semver_tilde",
                                                                "semver_wildcard"
                                                            ],
                                                            "type": "string"
                                                        },
                                                        {
                                                            "type": "null"
                                                        }
                                                    ],
                                                    "description": "Operator used to compare the property value. Null means exact match.\n\n* `exact` - exact\n* `flag_evaluates_to` - flag_evaluates_to\n* `gt` - gt\n* `gte` - gte\n* `icontains` - icontains\n* `icontains_multi` - icontains_multi\n* `in` - in\n* `is_date_after` - is_date_after\n* `is_date_before` - is_date_before\n* `is_date_exact` - is_date_exact\n* `is_not` - is_not\n* `is_not_set` - is_not_set\n* `is_set` - is_set\n* `lt` - lt\n* `lte` - lte\n* `not_icontains` - not_icontains\n* `not_icontains_multi` - not_icontains_multi\n* `not_in` - not_in\n* `not_regex` - not_regex\n* `regex` - regex\n* `semver_caret` - semver_caret\n* `semver_eq` - semver_eq\n* `semver_gt` - semver_gt\n* `semver_gte` - semver_gte\n* `semver_lt` - semver_lt\n* `semver_lte` - semver_lte\n* `semver_neq` - semver_neq\n* `semver_tilde` - semver_tilde\n* `semver_wildcard` - semver_wildcard"
                                                },
                                                "type": {
                                                    "description": "Property filter type. One of 'person', 'cohort', 'group', or 'flag'.\n\n* `person` - person\n* `cohort` - cohort\n* `group` - group\n* `flag` - flag",
                                                    "enum": ["person", "cohort", "group", "flag"],
                                                    "type": "string"
                                                },
                                                "value": {
                                                    "description": "Comparison value for the property filter. Valid shapes depend on the operator."
                                                }
                                            },
                                            "required": ["key", "type"],
                                            "type": "object"
                                        },
                                        "type": "array"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Property conditions for this release condition group."
                            },
                            "rollout_percentage": {
                                "anyOf": [
                                    {
                                        "maximum": 100,
                                        "minimum": 0,
                                        "type": "number"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Rollout percentage for this release condition group, between 0 and 100."
                            },
                            "sort_key": {
                                "description": "Opaque UI ordering key for this condition group (string or number). Preserved as-is."
                            },
                            "variant": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "Variant key override for multivariate flags."
                            }
                        },
                        "type": "object"
                    },
                    "type": "array"
                },
                "holdout": {
                    "anyOf": [
                        {
                            "description": "Experiment holdout configuration for a feature flag.",
                            "properties": {
                                "exclusion_percentage": {
                                    "description": "Percentage of users held out from the flag, between 0 and 100.",
                                    "maximum": 100,
                                    "minimum": 0,
                                    "type": "number"
                                },
                                "id": {
                                    "description": "ID of the experiment holdout this flag belongs to.",
                                    "maximum": 2147483647,
                                    "minimum": -2147483648,
                                    "type": "number"
                                }
                            },
                            "required": ["id", "exclusion_percentage"],
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Experiment holdout configuration for this flag."
                },
                "multivariate": {
                    "anyOf": [
                        {
                            "description": "Multivariate configuration for variant-based rollouts.",
                            "properties": {
                                "variants": {
                                    "description": "Variant definitions for multivariate feature flags.",
                                    "items": {
                                        "description": "A variant of a multivariate feature flag.",
                                        "properties": {
                                            "description": {
                                                "anyOf": [
                                                    {
                                                        "type": "string"
                                                    },
                                                    {
                                                        "type": "null"
                                                    }
                                                ],
                                                "description": "Display-only description for this variant, shown in the UI."
                                            },
                                            "key": {
                                                "description": "Unique key for this variant. Letters, numbers, hyphens, underscores, dots, and slashes; at most 400 characters.",
                                                "maxLength": 400,
                                                "pattern": "^[a-zA-Z0-9_./-]+$",
                                                "type": "string"
                                            },
                                            "name": {
                                                "anyOf": [
                                                    {
                                                        "type": "string"
                                                    },
                                                    {
                                                        "type": "null"
                                                    }
                                                ],
                                                "description": "Human-readable name for this variant."
                                            },
                                            "rollout_percentage": {
                                                "description": "Variant rollout percentage, between 0 and 100.",
                                                "maximum": 100,
                                                "minimum": 0,
                                                "type": "number"
                                            }
                                        },
                                        "required": ["key", "rollout_percentage"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                }
                            },
                            "required": ["variants"],
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Multivariate configuration for variant-based rollouts."
                },
                "payloads": {
                    "anyOf": [
                        {
                            "additionalProperties": {},
                            "propertyNames": {
                                "type": "string"
                            },
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Payloads keyed by variant key (multivariate flags) or 'true' (boolean flags). Values are stored as JSON-encoded strings; non-string JSON values are normalized on write."
                }
            },
            "type": "object"
        },
        "id": {
            "description": "A unique integer value identifying this feature flag.",
            "type": "number"
        },
        "is_remote_configuration": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Whether this flag delivers a payload instead of gating a feature (Remote Config mode). When true, set the delivered payload through the `filters` param under `filters.payloads.true` as a JSON-encoded string. There is no dedicated payload parameter."
        },
        "key": {
            "description": "Feature flag key.",
            "type": "string"
        },
        "name": {
            "description": "Feature flag description (stored in the `name` field for backwards compatibility).",
            "type": "string"
        },
        "tags": {
            "description": "Organizational tags for this feature flag.",
            "items": {
                "type": "string"
            },
            "type": "array"
        }
    },
    "required": ["id"],
    "type": "object"
}
