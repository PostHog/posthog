{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "content": {
            "additionalProperties": false,
            "description": "Template content keyed by channel. Replaced as a whole on update, not merged.",
            "properties": {
                "email": {
                    "anyOf": [
                        {
                            "additionalProperties": false,
                            "properties": {
                                "design": {
                                    "additionalProperties": false,
                                    "description": "Design JSON for PostHog's visual email editor — the authoring surface and source of truth. The server renders the sent email from it, and it opens as editable blocks in the editor. Full schema in the designing-email-templates skill.",
                                    "properties": {
                                        "body": {
                                            "additionalProperties": false,
                                            "properties": {
                                                "footers": {
                                                    "items": {
                                                        "additionalProperties": {},
                                                        "properties": {},
                                                        "type": "object"
                                                    },
                                                    "type": "array"
                                                },
                                                "headers": {
                                                    "items": {
                                                        "additionalProperties": {},
                                                        "properties": {},
                                                        "type": "object"
                                                    },
                                                    "type": "array"
                                                },
                                                "id": {
                                                    "description": "Any unique string.",
                                                    "type": "string"
                                                },
                                                "rows": {
                                                    "description": "Rows of {id, cells, columns[{id, contents[{id, type, values}], values}], values}.",
                                                    "items": {
                                                        "additionalProperties": {},
                                                        "properties": {},
                                                        "type": "object"
                                                    },
                                                    "type": "array"
                                                },
                                                "values": {
                                                    "additionalProperties": {},
                                                    "description": "Body-level settings: backgroundColor, contentWidth ('600px'), fontFamily, textColor.",
                                                    "properties": {},
                                                    "type": "object"
                                                }
                                            },
                                            "required": ["rows"],
                                            "type": "object"
                                        },
                                        "counters": {
                                            "additionalProperties": {},
                                            "description": "Highest htmlID suffix per element type, e.g. {\"u_row\": 1, \"u_content_text\": 2}.",
                                            "properties": {},
                                            "type": "object"
                                        },
                                        "schemaVersion": {
                                            "description": "Design schema version, e.g. 16.",
                                            "type": "number"
                                        }
                                    },
                                    "required": ["schemaVersion", "body"],
                                    "type": "object"
                                },
                                "from": {
                                    "additionalProperties": false,
                                    "description": "The sender a transactional template sends from. A template made transactional without one gets the sender it was made transactional with.",
                                    "properties": {
                                        "email": {
                                            "description": "Address to send from instead of the sender's own. Must be on the sender's verified domain. Supports Liquid templating. Leave out or empty to use the sender's address.",
                                            "maxLength": 254,
                                            "type": "string"
                                        },
                                        "integrationId": {
                                            "description": "ID of the project's email sender integration that sends this email. Transactional sends need a verified sender.",
                                            "type": "number"
                                        },
                                        "name": {
                                            "description": "Sender name shown in the inbox instead of the sender's own. Supports Liquid templating. Leave out or empty to use the sender's name.",
                                            "type": "string"
                                        }
                                    },
                                    "required": ["integrationId"],
                                    "type": "object"
                                },
                                "preheader": {
                                    "description": "Preview text that most inboxes show after the subject. Supports Liquid templating.",
                                    "type": "string"
                                },
                                "replyTo": {
                                    "description": "Reply-to address for a transactional template. Separate several addresses with commas. Supports Liquid templating. Leave empty to use the sender's default reply-to.",
                                    "type": "string"
                                },
                                "subject": {
                                    "description": "Email subject line. Supports Liquid templating. Required in `content` for email-type templates. A `draft_content` may leave it blank until it is published.",
                                    "type": "string"
                                },
                                "text": {
                                    "description": "Plain-text fallback body for clients that can't render the email.",
                                    "type": "string"
                                }
                            },
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Email message content. Replaced as a whole on update — send the complete object."
                },
                "templating": {
                    "default": "liquid",
                    "description": "Templating language for the email content. Always 'liquid' — Liquid tags pass through verbatim.\n\n* `liquid` - liquid",
                    "enum": ["liquid"],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "deleted": {
            "description": "Soft-delete flag. Set true to remove the template from the library.",
            "type": "boolean"
        },
        "description": {
            "description": "What the template is for and when to use it.",
            "type": "string"
        },
        "message_category": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Message category ID to file the template under. Must belong to the same project."
        },
        "name": {
            "description": "Human-readable template name shown in the library.",
            "maxLength": 400,
            "type": "string"
        },
        "sensitive": {
            "description": "For emails that carry login codes, reset links or other secrets. PostHog keeps no copy of each sent email's body or filled-in subject, and clicked links keep only the site address. Can change at any time.",
            "type": "boolean"
        },
        "tags": {
            "description": "Tags for organizing templates, for example by team or use case. Tags are shared with the rest of the project. Omit to keep the current tags, send an empty list to remove them all.",
            "items": {
                "maxLength": 255,
                "type": "string"
            },
            "maxItems": 10,
            "type": "array"
        },
        "type": {
            "description": "Message channel of the template. Currently 'email'.",
            "maxLength": 24,
            "type": "string"
        }
    },
    "required": ["name"],
    "type": "object"
}
