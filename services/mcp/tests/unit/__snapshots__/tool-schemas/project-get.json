{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "id": {
            "anyOf": [
                {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                },
                {
                    "const": "@current",
                    "type": "string"
                }
            ],
            "description": "Project ID. Omit it, or pass `@current`, to target the caller's active project."
        }
    },
    "type": "object"
}
