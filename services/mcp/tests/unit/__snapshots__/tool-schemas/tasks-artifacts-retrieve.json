{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "artifact_id": {
            "description": "Stable artifact id returned by tasks-artifacts-list.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
        },
        "content_offset": {
            "default": 0,
            "description": "UTF-8 byte offset for the next content chunk.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
        },
        "version_id": {
            "description": "Version id to read. Defaults to the current version.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
        }
    },
    "required": ["artifact_id"],
    "type": "object"
}
