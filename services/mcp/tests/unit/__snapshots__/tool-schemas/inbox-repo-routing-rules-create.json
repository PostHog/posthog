{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "repository": {
            "description": "Target repository as owner/repo, e.g. 'posthog/posthog.com'.",
            "maxLength": 255,
            "type": "string"
        },
        "rule_text": {
            "description": "Plain-text description of the requests that should route to the repository, e.g. 'anything about the internal dashboard'. At most 300 characters.",
            "maxLength": 300,
            "type": "string"
        }
    },
    "required": ["rule_text", "repository"],
    "type": "object"
}
