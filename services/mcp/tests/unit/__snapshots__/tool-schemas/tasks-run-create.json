{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "branch": {
            "anyOf": [
                {
                    "maxLength": 255,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Git branch to check out in the sandbox."
        },
        "id": {
            "description": "Task ID.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
        },
        "pending_user_message": {
            "description": "Initial or follow-up message for the run.",
            "type": "string"
        },
        "resume_from_run_id": {
            "description": "ID of a previous run to resume from.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
        }
    },
    "required": ["id"],
    "type": "object"
}
