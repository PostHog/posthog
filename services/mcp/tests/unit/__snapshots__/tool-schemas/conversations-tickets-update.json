{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "assignee": {
            "anyOf": [
                {
                    "anyOf": [
                        {
                            "properties": {
                                "id": {
                                    "description": "User ID.",
                                    "type": "number"
                                },
                                "type": {
                                    "description": "Assign the ticket to a user.",
                                    "enum": ["user"],
                                    "type": "string"
                                }
                            },
                            "required": ["type", "id"],
                            "type": "object"
                        },
                        {
                            "properties": {
                                "id": {
                                    "description": "Role ID.",
                                    "type": "string"
                                },
                                "type": {
                                    "description": "Assign the ticket to a role.",
                                    "enum": ["role"],
                                    "type": "string"
                                }
                            },
                            "required": ["type", "id"],
                            "type": "object"
                        }
                    ]
                },
                {
                    "type": "null"
                }
            ],
            "description": "User or role to assign. Pass null to remove the current assignee."
        },
        "id": {
            "description": "The ticket's UUID or its numeric ticket number.",
            "type": "string"
        },
        "priority": {
            "anyOf": [
                {
                    "description": "* `low` - Low\n* `medium` - Medium\n* `high` - High\n* `critical` - Critical",
                    "enum": ["low", "medium", "high", "critical"],
                    "type": "string"
                },
                {
                    "enum": [""],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Ticket priority: low, medium, high, or critical. Pass null to clear it.\n\n* `low` - Low\n* `medium` - Medium\n* `high` - High\n* `critical` - Critical"
        },
        "sla_due_at": {
            "anyOf": [
                {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "SLA deadline. Pass null to clear it."
        },
        "snoozed_until": {
            "anyOf": [
                {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Time to reopen the ticket. Pass null to reopen it now."
        },
        "status": {
            "description": "Ticket status: new, open, pending, on_hold, or resolved.\n\n* `new` - New\n* `open` - Open\n* `pending` - Pending\n* `on_hold` - On hold\n* `resolved` - Resolved",
            "enum": ["new", "open", "pending", "on_hold", "resolved"],
            "type": "string"
        },
        "tags": {
            "description": "Tag names to set on the ticket.",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "ticket_brief": {
            "description": "Structured summary of the ticket for the support engineer. Replaces the whole brief.",
            "properties": {
                "affected_items": {
                    "description": "The PostHog items the ticket is about, with a link to each one.",
                    "items": {
                        "properties": {
                            "kind": {
                                "description": "What the customer is asking about: dashboard, experiment, feature_flag, insight, project, replay, survey, or other.\n\n* `dashboard` - Dashboard\n* `experiment` - Experiment\n* `feature_flag` - Feature flag\n* `insight` - Insight\n* `project` - Project\n* `replay` - Replay\n* `survey` - Survey\n* `other` - Other",
                                "enum": [
                                    "dashboard",
                                    "experiment",
                                    "feature_flag",
                                    "insight",
                                    "project",
                                    "replay",
                                    "survey",
                                    "other"
                                ],
                                "type": "string"
                            },
                            "label": {
                                "description": "Name of the item as the customer would recognize it.",
                                "maxLength": 120,
                                "type": "string"
                            },
                            "url": {
                                "description": "Link to the item in PostHog, so the engineer can open it without a search.",
                                "format": "uri",
                                "maxLength": 2000,
                                "type": "string"
                            }
                        },
                        "required": ["kind", "url", "label"],
                        "type": "object"
                    },
                    "type": "array"
                },
                "area": {
                    "description": "Product area the ticket is about, such as 'Feature flags' or 'Session replay'.",
                    "maxLength": 80,
                    "type": "string"
                },
                "ask": {
                    "description": "What the customer needs from PostHog, in one or two sentences. The line to read first.",
                    "maxLength": 400,
                    "type": "string"
                },
                "facts": {
                    "description": "Details the engineer needs to act on, such as region, plan, versions, and ids. One per line.",
                    "items": {
                        "maxLength": 160,
                        "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array"
                },
                "questions": {
                    "description": "Each question the customer asks, as one short line. Empty when the customer asks nothing explicit.",
                    "items": {
                        "maxLength": 200,
                        "type": "string"
                    },
                    "maxItems": 6,
                    "type": "array"
                },
                "replay_url": {
                    "anyOf": [
                        {
                            "format": "uri",
                            "maxLength": 2000,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Replay of the session the ticket came from. Null when the ticket has no session."
                },
                "screenshot_urls": {
                    "description": "Images the customer attached, in the order they sent them.",
                    "items": {
                        "format": "uri",
                        "maxLength": 2000,
                        "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array"
                },
                "tried": {
                    "description": "What the customer says they already did to fix or diagnose the problem.",
                    "items": {
                        "maxLength": 160,
                        "type": "string"
                    },
                    "maxItems": 5,
                    "type": "array"
                }
            },
            "required": ["ask", "area", "questions"],
            "type": "object"
        }
    },
    "required": ["id"],
    "type": "object"
}
