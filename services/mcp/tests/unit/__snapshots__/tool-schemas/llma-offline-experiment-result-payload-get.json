{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "id": {
            "description": "Experiment UUID.",
            "type": "string"
        },
        "max_chars": {
            "default": 4000,
            "description": "Maximum UTF-16 code units in this JSON text page.",
            "maximum": 8000,
            "minimum": 2,
            "type": "integer"
        },
        "offset": {
            "default": 0,
            "description": "Text offset returned as next_offset by the previous page.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
        },
        "result_id": {
            "description": "Result UUID within the experiment.",
            "type": "string"
        }
    },
    "required": ["id", "result_id"],
    "type": "object"
}
