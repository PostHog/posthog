{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "cron_expression": {
            "anyOf": [
                {
                    "maxLength": 120,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Fire on a repeat: a 5-field cron expression in UTC, at most every 15 minutes."
        },
        "id": {
            "pattern": "^[0-9a-f-]{36}$",
            "type": "string"
        },
        "prompt": {
            "description": "A note to your future self: what to check or do when this fires.",
            "maxLength": 4000,
            "type": "string"
        },
        "run_at": {
            "anyOf": [
                {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Fire once at this ISO 8601 time."
        }
    },
    "required": ["id", "prompt"],
    "type": "object"
}
