        {
            "description": "Typed configuration for the hogql model.",
            "properties": {
                "data_interval_end": {
                    "description": "End of the export interval. Required for the events, persons, and sessions models. For HogQL, required only when the query references {data_interval_end}. A supplied end must not be in the future or precede a supplied start. Bounds replace HogQL placeholders; they do not add filters to the query.",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                },
                "data_interval_start": {
                    "description": "Start of the export interval. Required for the events, persons, and sessions models. For HogQL, required only when the query references {data_interval_start}. A supplied start must not be in the future. When both bounds are supplied, the interval must span at most seven days.",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                },
                "file": {
                    "description": "Typed configuration for a FileDownload batch-export destination.",
                    "properties": {
                        "compression": {
                            "anyOf": [
                                {
                                    "description": "* `brotli` - brotli\n* `gzip` - gzip\n* `lz4` - lz4\n* `snappy` - snappy\n* `zstd` - zstd",
                                    "enum": ["brotli", "gzip", "lz4", "snappy", "zstd"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Compress the file with a supported compression format\n\n* `zstd` - zstd\n* `gzip` - gzip\n* `brotli` - brotli\n* `lz4` - lz4\n* `snappy` - snappy"
                        },
                        "format": {
                            "default": "Parquet",
                            "description": "File format\n\n* `Parquet` - Parquet\n* `JSONLines` - JSONLines",
                            "enum": ["Parquet", "JSONLines"],
                            "type": "string"
                        },
                        "max_size_mb": {
                            "anyOf": [
                                {
                                    "minimum": 0,
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": 1024,
                            "description": "Split the download into files of about this size in MiB. A file can go a little over. Set it to null or 0 to write a single file of any size."
                        }
                    },
                    "type": "object"
                },
                "hogql_modifiers": {
                    "description": "HogQL modifiers to use when the query runs. Only supported when 'model' is 'hogql'. Each modifier set here overrides the project modifier with the same name, and the project modifiers apply to all others. For example, set convertToProjectTimezone to false to export timestamps in UTC instead of the project timezone.",
                    "properties": {
                        "bounceRateDurationSeconds": {
                            "anyOf": [
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "bounceRatePageViewMode": {
                            "anyOf": [
                                {
                                    "enum": ["count_pageviews", "uniq_urls", "uniq_page_screen_autocaptures"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "convertToProjectTimezone": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "cookielessTrafficIsRegular": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Do not treat a missing user agent as automation on cookieless events. Positive bot signals and custom project rules still apply. Resolved server-side; not intended to be set by clients."
                        },
                        "customBotDefinitions": {
                            "anyOf": [
                                {
                                    "items": {
                                        "properties": {
                                            "category": {
                                                "anyOf": [
                                                    {
                                                        "type": "string"
                                                    },
                                                    {
                                                        "type": "null"
                                                    }
                                                ],
                                                "description": "Reported by `$virt_traffic_category`. Defaults to `custom`."
                                            },
                                            "combiner": {
                                                "description": "Whether every condition must match (AND) or any one of them (OR).",
                                                "enum": ["AND", "OR"],
                                                "type": "string"
                                            },
                                            "id": {
                                                "type": "string"
                                            },
                                            "items": {
                                                "items": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "key": {
                                                            "description": "The event property this condition reads.",
                                                            "enum": [
                                                                "$raw_user_agent",
                                                                "$ip",
                                                                "$lib",
                                                                "$host",
                                                                "$pathname",
                                                                "$current_url",
                                                                "$browser",
                                                                "$os",
                                                                "$browser_language",
                                                                "$screen_width",
                                                                "$screen_height",
                                                                "$geoip_country_code",
                                                                "$referrer",
                                                                "$referring_domain"
                                                            ],
                                                            "type": "string"
                                                        },
                                                        "matcher": {
                                                            "enum": ["contains", "regex", "exact", "cidr"],
                                                            "type": "string"
                                                        },
                                                        "pattern": {
                                                            "description": "Matched against the property named by `key`.",
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": ["id", "key", "matcher", "pattern"],
                                                    "type": "object"
                                                },
                                                "type": "array"
                                            },
                                            "name": {
                                                "description": "Reported by `$virt_bot_name` and `$virt_bot_operator` when the rule matches.",
                                                "type": "string"
                                            }
                                        },
                                        "required": ["combiner", "id", "items", "name"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "customChannelTypeRules": {
                            "anyOf": [
                                {
                                    "items": {
                                        "properties": {
                                            "channel_type": {
                                                "type": "string"
                                            },
                                            "combiner": {
                                                "enum": ["AND", "OR"],
                                                "type": "string"
                                            },
                                            "id": {
                                                "type": "string"
                                            },
                                            "items": {
                                                "items": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "key": {
                                                            "enum": [
                                                                "utm_source",
                                                                "utm_medium",
                                                                "utm_campaign",
                                                                "referring_domain",
                                                                "url",
                                                                "pathname",
                                                                "hostname"
                                                            ],
                                                            "type": "string"
                                                        },
                                                        "op": {
                                                            "enum": [
                                                                "exact",
                                                                "is_not",
                                                                "is_set",
                                                                "is_not_set",
                                                                "icontains",
                                                                "not_icontains",
                                                                "regex",
                                                                "not_regex"
                                                            ],
                                                            "type": "string"
                                                        },
                                                        "value": {
                                                            "anyOf": [
                                                                {
                                                                    "type": "string"
                                                                },
                                                                {
                                                                    "items": {
                                                                        "type": "string"
                                                                    },
                                                                    "type": "array"
                                                                },
                                                                {
                                                                    "type": "null"
                                                                }
                                                            ]
                                                        }
                                                    },
                                                    "required": ["id", "key", "op"],
                                                    "type": "object"
                                                },
                                                "type": "array"
                                            }
                                        },
                                        "required": ["channel_type", "combiner", "id", "items"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "dataWarehouseEventsModifiers": {
                            "anyOf": [
                                {
                                    "items": {
                                        "properties": {
                                            "distinct_id_field": {
                                                "type": "string"
                                            },
                                            "id_field": {
                                                "type": "string"
                                            },
                                            "table_name": {
                                                "type": "string"
                                            },
                                            "timestamp_field": {
                                                "type": "string"
                                            }
                                        },
                                        "required": ["distinct_id_field", "id_field", "table_name", "timestamp_field"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "debug": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "forceClickhouseDataSkippingIndexes": {
                            "anyOf": [
                                {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "If these are provided, the query will fail if these skip indexes are not used"
                        },
                        "formatCsvAllowDoubleQuotes": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "inCohortVia": {
                            "anyOf": [
                                {
                                    "enum": ["auto", "leftjoin", "subquery", "leftjoin_conjoined"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "inlineCohortCalculation": {
                            "anyOf": [
                                {
                                    "enum": ["off", "auto", "always"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "materializationMode": {
                            "anyOf": [
                                {
                                    "enum": ["auto", "legacy_null_as_string", "legacy_null_as_null", "disabled"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "materializedColumnsOptimizationMode": {
                            "anyOf": [
                                {
                                    "enum": ["disabled", "optimized"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "mergeFederatedAggregateJoins": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Merge sibling aggregating LEFT JOINs over federated Postgres tables into one UNION ALL join, so their scans overlap"
                        },
                        "optimizeJoinedFilters": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "optimizeProjections": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "parserMode": {
                            "anyOf": [
                                {
                                    "enum": [
                                        "cpp_only",
                                        "cpp_with_rust_shadow",
                                        "cpp_with_rust_py_shadow",
                                        "rust_with_cpp_shadow",
                                        "rust_only",
                                        "rust_py_only",
                                        "rust_py_with_cpp_shadow"
                                    ],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "HogQL parser backend; absent → `rust_py_with_cpp_shadow` (rust-py is primary, cpp runs as a sampled shadow). `*_shadow` modes return the primary result and sample-compare against the other parser, reporting divergences without failing the request. The `rust_py_*` modes drive the same hand-rolled Rust parser as `rust_*` but build `posthog.hogql.ast` dataclass instances directly via PyO3, skipping the JSON round-trip."
                        },
                        "personsArgMaxVersion": {
                            "anyOf": [
                                {
                                    "enum": ["auto", "v1", "v2"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "personsJoinMode": {
                            "anyOf": [
                                {
                                    "enum": ["inner", "left"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "personsOnEventsMode": {
                            "anyOf": [
                                {
                                    "enum": [
                                        "disabled",
                                        "person_id_no_override_properties_on_events",
                                        "person_id_override_properties_on_events",
                                        "person_id_override_properties_joined"
                                    ],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "propertyGroupsMode": {
                            "anyOf": [
                                {
                                    "enum": ["enabled", "disabled", "optimized"],
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
