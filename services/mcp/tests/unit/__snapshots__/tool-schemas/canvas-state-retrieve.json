{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "id": {
            "description": "A UUID string identifying this canvas.",
            "type": "string"
        },
        "scope": {
            "description": "Only return entries in this scope.",
            "enum": ["shared", "user"],
            "type": "string"
        }
    },
    "required": ["id"],
    "type": "object"
}
