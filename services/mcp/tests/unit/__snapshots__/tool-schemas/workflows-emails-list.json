{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "date_from": {
            "description": "Only sends at or after this time. Defaults to 7 days ago.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
        },
        "date_to": {
            "description": "Only sends before this time. Defaults to now.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
        },
        "limit": {
            "default": 50,
            "description": "Page size.",
            "maximum": 200,
            "minimum": 1,
            "type": "number"
        },
        "offset": {
            "default": 0,
            "description": "Sends to skip.",
            "minimum": 0,
            "type": "number"
        },
        "workflow_id": {
            "description": "The workflow or broadcast whose sends to list.",
            "type": "string"
        }
    },
    "required": ["workflow_id"],
    "type": "object"
}
