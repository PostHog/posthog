{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "filters": {
            "additionalProperties": false,
            "properties": {
                "actions": {
                    "description": "Saved action entries combined with the event entries using OR. Example: [{\"id\": \"123\", \"type\": \"actions\"}].",
                    "items": {
                        "additionalProperties": {},
                        "propertyNames": {
                            "type": "string"
                        },
                        "type": "object"
                    },
                    "type": "array"
                },
                "events": {
                    "description": "Captured event entries combined with OR. Example: [{\"id\": \"survey sent\", \"type\": \"events\", \"properties\": [{\"key\": \"rating\", \"type\": \"event\", \"operator\": \"lt\", \"value\": 3}]}].",
                    "items": {
                        "additionalProperties": {},
                        "propertyNames": {
                            "type": "string"
                        },
                        "type": "object"
                    },
                    "type": "array"
                },
                "filter_test_accounts": {
                    "description": "Apply the project's existing test-account exclusions.",
                    "type": "boolean"
                },
                "properties": {
                    "description": "Property conditions applied to all selected events. Example: [{\"key\": \"plan\", \"type\": \"event\", \"operator\": \"exact\", \"value\": \"enterprise\"}].",
                    "items": {
                        "additionalProperties": {},
                        "propertyNames": {
                            "type": "string"
                        },
                        "type": "object"
                    },
                    "type": "array"
                },
                "source": {
                    "default": "events",
                    "description": "Captured PostHog events. Use events.\n\n* `events` - events",
                    "enum": ["events"],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "project_id": {
            "description": "Project whose captured events should be monitored.",
            "minimum": 1,
            "type": "number"
        }
    },
    "required": ["project_id", "filters"],
    "type": "object"
}
