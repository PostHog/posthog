                                                    "semver_gt",
                                                    "semver_gte",
                                                    "semver_lt",
                                                    "semver_lte",
                                                    "semver_tilde",
                                                    "semver_caret",
                                                    "semver_wildcard",
                                                    "icontains_multi",
                                                    "not_icontains_multi"
