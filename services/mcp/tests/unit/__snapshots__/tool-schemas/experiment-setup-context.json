                                                "type": "string"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ]
                                    },
                                    "operator": {
                                        "anyOf": [
                                            {
                                                "enum": [
                                                    "exact",
                                                    "is_not",
                                                    "icontains",
                                                    "not_icontains",
