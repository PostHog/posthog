                        ]
                    },
                    "maxItems": 10,
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Event or person property filters that narrow the metric event, for the metric that counts only some of its occurrences. At most 10 filters, and each needs type 'event' or 'person'. Needs metric_event."
        },
        "previous_experiments_limit": {
            "default": 10,
            "description": "How many experiments to return, most recently launched first, then drafts, 1 to 25.",
            "maximum": 25,
            "minimum": 1,
            "type": "number"
        },
        "shared_metrics_limit": {
            "default": 10,
            "description": "How many shared metrics to return, most reused first, 1 to 25.",
            "maximum": 25,
            "minimum": 1,
            "type": "number"
        },
        "target_event": {
            "anyOf": [
                {
                    "maxLength": 400,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Event that marks a visit to the surface under test, for example '$pageview' or '$screen'. Needed for target_surface and for the baseline in candidate_metric."
