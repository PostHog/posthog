            "anyOf": [
                {
                    "maxLength": 1000,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Only counts target events whose $current_url contains this text, ignoring case. Needs target_event to be '$pageview'."
