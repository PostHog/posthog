                                                            },
                                                            "source": {
                                                                "default": "events",
                                                                "description": "* `events` - events\n* `person-updates` - person-updates\n* `data-warehouse-table` - data-warehouse-table\n* `data-warehouse-view` - data-warehouse-view",
                                                                "enum": [
                                                                    "events",
                                                                    "person-updates",
                                                                    "data-warehouse-table",
                                                                    "data-warehouse-view"
                                                                ],
