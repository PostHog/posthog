                                                            "type": "null"
                                                        }
                                                    ],
                                                    "description": "Event/action filters; the workflow wakes when a matching event fires. Must target at least one event or action (entries targeting neither are dropped)."
                                                },
                                                "name": {
                                                    "description": "Optional display name.",
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
