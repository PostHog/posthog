{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "dashboards": {
            "description": "Dashboard IDs this insight should belong to. This is a full replacement — always include all existing dashboard IDs when adding a new one.",
            "items": {
                "type": "number"
            },
            "type": "array"
        },
        "description": {
            "anyOf": [
                {
                    "maxLength": 400,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Human-readable summary of what the insight shows. Max 400 characters (longer values are rejected)."
        },
        "favorited": {
            "type": "boolean"
        },
        "name": {
            "anyOf": [
                {
                    "maxLength": 400,
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ]
        },
        "query": {
            "anyOf": [
                {
                    "properties": {
                        "kind": {
                            "const": "InsightVizNode",
                            "default": "InsightVizNode",
                            "type": "string"
                        },
                        "source": {
                            "additionalProperties": {},
                            "description": "Product analtycs query objects like TrendsQuery, FunnelsQuery, RetentionQuery, PathsQuery, StickinessQuery, LifecycleQuery",
                            "propertyNames": {
                                "type": "string"
                            },
                            "type": "object"
                        }
                    },
                    "required": ["source"],
                    "type": "object"
                },
                {
                    "properties": {
                        "chartSettings": {
                            "description": "Chart configuration. Ignored when `display` is `ActionsTable` or `BoldNumber`.",
                            "properties": {
                                "boxPlot": {
                                    "description": "Column mappings for `BoxPlot`. The SQL must return one pre-aggregated row per X-axis and series pair.",
                                    "properties": {
                                        "excludeOutliers": {
                                            "description": "Clip whiskers to 1.5 times the interquartile range. Defaults to true.",
                                            "type": "boolean"
                                        },
                                        "maxColumn": {
                                            "description": "Numeric column containing the maximum for each box.",
                                            "type": "string"
                                        },
                                        "meanColumn": {
                                            "description": "Numeric column containing the mean for each box.",
                                            "type": "string"
                                        },
                                        "medianColumn": {
                                            "description": "Numeric column containing the median for each box.",
                                            "type": "string"
                                        },
                                        "minColumn": {
                                            "description": "Numeric column containing the minimum for each box.",
                                            "type": "string"
                                        },
                                        "p25Column": {
                                            "description": "Numeric column containing the 25th percentile for each box.",
                                            "type": "string"
                                        },
                                        "p75Column": {
                                            "description": "Numeric column containing the 75th percentile for each box.",
                                            "type": "string"
                                        },
                                        "seriesColumn": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "null"
                                                }
                                            ],
                                            "description": "Optional column that groups each X-axis value into separate colored series. Set to `null` for one series."
                                        },
                                        "xAxisColumn": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "null"
                                                }
                                            ],
                                            "description": "X-axis category column. Set to `null` for one overall distribution or one box per series."
                                        }
                                    },
                                    "required": [
                                        "maxColumn",
                                        "meanColumn",
                                        "medianColumn",
                                        "minColumn",
                                        "p25Column",
                                        "p75Column"
                                    ],
                                    "type": "object"
                                },
                                "goalLines": {
                                    "description": "Horizontal goal lines drawn across the chart.",
                                    "items": {
                                        "properties": {
                                            "label": {
                                                "description": "Label rendered next to the goal line.",
                                                "type": "string"
                                            },
                                            "value": {
                                                "description": "Y-axis value at which the goal line is drawn.",
                                                "type": "number"
                                            }
                                        },
                                        "required": ["label", "value"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                },
                                "leftYAxisSettings": {
                                    "description": "Settings for the left Y axis.",
                                    "properties": {
                                        "label": {
                                            "description": "Label rendered beside this Y axis.",
                                            "type": "string"
                                        },
                                        "scale": {
                                            "description": "Scale used for this Y axis.",
                                            "enum": ["linear", "logarithmic"],
                                            "type": "string"
                                        },
                                        "showGridLines": {
                                            "description": "Show grid lines for this Y axis.",
                                            "type": "boolean"
                                        },
                                        "showTicks": {
                                            "description": "Show tick labels on this Y axis.",
                                            "type": "boolean"
                                        },
                                        "startAtZero": {
                                            "description": "Whether this Y axis should start at zero.",
                                            "type": "boolean"
                                        }
                                    },
                                    "type": "object"
                                },
                                "rightYAxisSettings": {
                                    "description": "Settings for the right Y axis. Only applies when a Y series uses `settings.display.yAxisPosition: \"right\"`.",
                                    "properties": {
                                        "label": {
                                            "description": "Label rendered beside this Y axis.",
                                            "type": "string"
                                        },
                                        "scale": {
                                            "description": "Scale used for this Y axis.",
                                            "enum": ["linear", "logarithmic"],
                                            "type": "string"
                                        },
                                        "showGridLines": {
                                            "description": "Show grid lines for this Y axis.",
                                            "type": "boolean"
                                        },
                                        "showTicks": {
                                            "description": "Show tick labels on this Y axis.",
                                            "type": "boolean"
                                        },
                                        "startAtZero": {
                                            "description": "Whether this Y axis should start at zero.",
                                            "type": "boolean"
                                        }
                                    },
                                    "type": "object"
                                },
                                "seriesBreakdownColumn": {
                                    "anyOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ],
                                    "description": "Column that splits a single Y series into multiple colored series — e.g. breaking down a line chart by `country`. Set to `null` or omit to disable. A breakdown buckets rows by x value, so it is ignored when `display` is `ScatterPlot`."
                                },
                                "showLegend": {
                                    "description": "Show the chart legend.",
                                    "type": "boolean"
                                },
                                "showNullsAsZero": {
                                    "description": "Replace null aggregation results with zero.",
                                    "type": "boolean"
                                },
                                "showTotalRow": {
                                    "description": "Show a total summing all Y series. Applies to line, bar, and area charts.",
                                    "type": "boolean"
                                },
                                "showValuesOnSeries": {
                                    "description": "Render each data point's value as a label directly on the series.",
                                    "type": "boolean"
                                },
                                "stackBars100": {
                                    "description": "Stack bars to 100% of the total. Only meaningful with `ActionsStackedBar`.",
                                    "type": "boolean"
                                },
                                "xAxis": {
                                    "description": "Column used as the X axis. Typically a time bucket or categorical column, but `ScatterPlot` plots two measures against each other, so it needs a numeric column here too.",
                                    "properties": {
                                        "column": {
                                            "description": "Name of a column returned by the SQL query to map onto this axis.",
                                            "type": "string"
                                        },
                                        "settings": {
                                            "description": "Optional series settings. Only applies to Y-axis series.",
                                            "properties": {
                                                "display": {
                                                    "description": "Display settings for a plotted Y series.",
                                                    "properties": {
                                                        "color": {
                                                            "description": "Custom color for this series as a hex string (e.g. `#1d4aff`).",
                                                            "type": "string"
                                                        },
                                                        "displayType": {
                                                            "description": "Override how this individual series is rendered, independent of the chart-level `display` type. Use this to mix series types — e.g. plot one series as `bar` and overlay another as `line`. `auto` follows the chart-level display type.",
                                                            "enum": ["auto", "line", "bar", "area"],
                                                            "type": "string"
                                                        },
                                                        "label": {
                                                            "description": "Custom label for this series, shown in the legend and tooltips instead of the column name.",
                                                            "type": "string"
                                                        },
                                                        "trendLine": {
                                                            "description": "Draw a linear trend line for this series. Only meaningful for line, bar, and area charts.",
                                                            "type": "boolean"
                                                        },
                                                        "yAxisPosition": {
                                                            "description": "Which Y axis this numeric series should use. Use `right` for a secondary Y axis.",
                                                            "enum": ["left", "right"],
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "formatting": {
                                                    "description": "Number-formatting settings for the values on this axis or series.",
                                                    "properties": {
                                                        "decimalPlaces": {
                                                            "description": "Number of decimal places to display.",
                                                            "type": "number"
                                                        },
                                                        "prefix": {
                                                            "description": "Text prepended to each value (e.g. `$`).",
                                                            "type": "string"
                                                        },
                                                        "style": {
                                                            "description": "Number formatting style.\n- `none` — no formatting.\n- `number` — thousands separators (e.g. `1,234`).\n- `short` — abbreviated large numbers (e.g. `1.2k`, `3.4M`).\n- `percent` — multiply the value by 100 and append a `%` sign, so pass a 0-1 ratio (`a / b`, not `100.0 * a / b`). Never pair it with a `%` suffix, which renders `47.3%%`.",
                                                            "enum": ["none", "number", "short", "percent"],
                                                            "type": "string"
                                                        },
                                                        "suffix": {
                                                            "description": "Text appended to each value (e.g. ` ms`). Leave unset when `style` is `percent`, which already appends the `%` sign.",
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "required": ["column"],
                                    "type": "object"
                                },
                                "xAxisLabel": {
                                    "description": "Label rendered under the X axis.",
                                    "type": "string"
                                },
                                "yAxis": {
                                    "description": "One or more numeric columns plotted as Y series.",
                                    "items": {
                                        "properties": {
                                            "column": {
                                                "description": "Name of a column returned by the SQL query to map onto this axis.",
                                                "type": "string"
                                            },
                                            "settings": {
                                                "description": "Optional series settings. Only applies to Y-axis series.",
                                                "properties": {
                                                    "display": {
                                                        "description": "Display settings for a plotted Y series.",
                                                        "properties": {
                                                            "color": {
                                                                "description": "Custom color for this series as a hex string (e.g. `#1d4aff`).",
                                                                "type": "string"
                                                            },
                                                            "displayType": {
                                                                "description": "Override how this individual series is rendered, independent of the chart-level `display` type. Use this to mix series types — e.g. plot one series as `bar` and overlay another as `line`. `auto` follows the chart-level display type.",
                                                                "enum": ["auto", "line", "bar", "area"],
                                                                "type": "string"
                                                            },
                                                            "label": {
                                                                "description": "Custom label for this series, shown in the legend and tooltips instead of the column name.",
                                                                "type": "string"
                                                            },
                                                            "trendLine": {
                                                                "description": "Draw a linear trend line for this series. Only meaningful for line, bar, and area charts.",
                                                                "type": "boolean"
                                                            },
                                                            "yAxisPosition": {
                                                                "description": "Which Y axis this numeric series should use. Use `right` for a secondary Y axis.",
                                                                "enum": ["left", "right"],
                                                                "type": "string"
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "formatting": {
                                                        "description": "Number-formatting settings for the values on this axis or series.",
                                                        "properties": {
                                                            "decimalPlaces": {
                                                                "description": "Number of decimal places to display.",
                                                                "type": "number"
                                                            },
                                                            "prefix": {
                                                                "description": "Text prepended to each value (e.g. `$`).",
                                                                "type": "string"
                                                            },
                                                            "style": {
                                                                "description": "Number formatting style.\n- `none` — no formatting.\n- `number` — thousands separators (e.g. `1,234`).\n- `short` — abbreviated large numbers (e.g. `1.2k`, `3.4M`).\n- `percent` — multiply the value by 100 and append a `%` sign, so pass a 0-1 ratio (`a / b`, not `100.0 * a / b`). Never pair it with a `%` suffix, which renders `47.3%%`.",
                                                                "enum": ["none", "number", "short", "percent"],
                                                                "type": "string"
                                                            },
                                                            "suffix": {
                                                                "description": "Text appended to each value (e.g. ` ms`). Leave unset when `style` is `percent`, which already appends the `%` sign.",
                                                                "type": "string"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "required": ["column"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                }
                            },
                            "type": "object"
                        },
                        "display": {
                            "description": "Visualization type. Defaults to `ActionsTable` when omitted.\n\nGuidance:\n- Single-value result (one numeric column, one row) → `BoldNumber`.\n- Time series → `ActionsLineGraph` or `ActionsAreaGraph`.\n- Categorical proportions → `ActionsPie`.\n- Categorical comparison → `ActionsBar` or `ActionsStackedBar`.\n- Two-dimensional aggregation → `TwoDimensionalHeatmap`.\n- Relationship between two numeric measures, one point per row → `ScatterPlot`.\n- Distribution summaries from pre-aggregated SQL rows → `BoxPlot` with `chartSettings.boxPlot`.\n- Otherwise → `ActionsTable`.",
                            "enum": [
                                "ActionsTable",
                                "BoldNumber",
                                "ActionsLineGraph",
                                "ActionsBar",
                                "ActionsPie",
                                "ActionsStackedBar",
                                "ActionsAreaGraph",
                                "TwoDimensionalHeatmap",
                                "ScatterPlot",
                                "BoxPlot"
                            ],
                            "type": "string"
                        },
                        "kind": {
                            "const": "DataVisualizationNode",
                            "default": "DataVisualizationNode",
                            "type": "string"
                        },
                        "source": {
                            "additionalProperties": {},
                            "description": "HogQL query object that produces the rows to visualize.",
                            "propertyNames": {
                                "type": "string"
                            },
                            "type": "object"
                        },
                        "tableSettings": {
                            "description": "Table configuration. Only applies when `display` is `ActionsTable` or omitted.",
                            "properties": {
                                "columns": {
                                    "description": "Columns to display and their order. Omit to show every column returned by the query.",
                                    "items": {
                                        "properties": {
                                            "column": {
                                                "description": "Name of a column returned by the SQL query to map onto this axis.",
                                                "type": "string"
                                            },
                                            "settings": {
                                                "description": "Optional series settings. Only applies to Y-axis series.",
                                                "properties": {
                                                    "display": {
                                                        "description": "Display settings for a plotted Y series.",
                                                        "properties": {
                                                            "color": {
                                                                "description": "Custom color for this series as a hex string (e.g. `#1d4aff`).",
                                                                "type": "string"
                                                            },
                                                            "displayType": {
                                                                "description": "Override how this individual series is rendered, independent of the chart-level `display` type. Use this to mix series types — e.g. plot one series as `bar` and overlay another as `line`. `auto` follows the chart-level display type.",
                                                                "enum": ["auto", "line", "bar", "area"],
                                                                "type": "string"
                                                            },
                                                            "label": {
                                                                "description": "Custom label for this series, shown in the legend and tooltips instead of the column name.",
                                                                "type": "string"
                                                            },
                                                            "trendLine": {
                                                                "description": "Draw a linear trend line for this series. Only meaningful for line, bar, and area charts.",
                                                                "type": "boolean"
                                                            },
                                                            "yAxisPosition": {
                                                                "description": "Which Y axis this numeric series should use. Use `right` for a secondary Y axis.",
                                                                "enum": ["left", "right"],
                                                                "type": "string"
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "formatting": {
                                                        "description": "Number-formatting settings for the values on this axis or series.",
                                                        "properties": {
                                                            "decimalPlaces": {
                                                                "description": "Number of decimal places to display.",
                                                                "type": "number"
                                                            },
                                                            "prefix": {
                                                                "description": "Text prepended to each value (e.g. `$`).",
                                                                "type": "string"
                                                            },
                                                            "style": {
                                                                "description": "Number formatting style.\n- `none` — no formatting.\n- `number` — thousands separators (e.g. `1,234`).\n- `short` — abbreviated large numbers (e.g. `1.2k`, `3.4M`).\n- `percent` — multiply the value by 100 and append a `%` sign, so pass a 0-1 ratio (`a / b`, not `100.0 * a / b`). Never pair it with a `%` suffix, which renders `47.3%%`.",
                                                                "enum": ["none", "number", "short", "percent"],
                                                                "type": "string"
                                                            },
                                                            "suffix": {
                                                                "description": "Text appended to each value (e.g. ` ms`). Leave unset when `style` is `percent`, which already appends the `%` sign.",
                                                                "type": "string"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "required": ["column"],
                                        "type": "object"
                                    },
                                    "type": "array"
                                },
                                "pinnedColumns": {
                                    "description": "Column names to pin to the left of the table.",
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                },
                                "transpose": {
                                    "description": "Transpose rows and columns.",
                                    "type": "boolean"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "required": ["source"],
                    "type": "object"
                }
            ]
        },
        "tags": {
            "items": {},
            "type": "array"
        }
    },
    "required": ["query"],
    "type": "object"
}
