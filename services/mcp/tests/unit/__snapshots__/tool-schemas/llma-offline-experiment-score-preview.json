{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "composition": {
            "description": "Formula and pinned input versions to validate without saving.",
            "properties": {
                "expression": {
                    "description": "Formula using the declared input aliases. Supports +, -, *, /, comparisons, and/or/not, conditional expressions, and number(), min(), max(), abs(). Boolean inputs are raw values: number(True) is 1 and number(False) is 0, regardless of passing rules. Categorical inputs are lists of keys: use \"good\" in relevance. Examples: (2 * precision + recall) / 3; safe and correct; \"good\" if correct else \"bad\". Every input alias must appear. Line breaks are allowed. Arithmetic results use 12 significant digits. Up to 1,024 characters and 16 input scorers.",
                    "maxLength": 1024,
                    "type": "string"
                },
                "inputs": {
                    "description": "Named inputs. Item formulas use reported results from exact versions. Experiment formulas use statistics from item scorers.",
                    "items": {
                        "properties": {
                            "alias": {
                                "description": "Input name used in the formula. Start with a lowercase letter; use letters, digits, and underscores.",
                                "maxLength": 32,
                                "pattern": "^[a-z][a-z0-9_]{0,31}$",
                                "type": "string"
                            },
                            "category": {
                                "maxLength": 128,
                                "type": "string"
                            },
                            "scorer_version_id": {
                                "description": "Version of the input item scorer. Experiment formulas use its definition to find the run's results unless the version policy is exact.",
                                "type": "string"
                            },
                            "statistic": {
                                "description": "* `pass_rate` - pass_rate\n* `mean` - mean\n* `true_rate` - true_rate\n* `category_rate` - category_rate",
                                "enum": ["pass_rate", "mean", "true_rate", "category_rate"],
                                "type": "string"
                            },
                            "version_policy": {
                                "description": "* `run` - run\n* `exact` - exact\n* `combine` - combine",
                                "enum": ["run", "exact", "combine"],
                                "type": "string"
                            }
                        },
                        "required": ["alias", "scorer_version_id"],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": ["expression", "inputs"],
            "type": "object"
        },
        "config": {
            "anyOf": [
                {
                    "properties": {
                        "max_selections": {
                            "anyOf": [
                                {
                                    "minimum": 1,
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional maximum number of options that can be selected when `selection_mode` is `multiple`."
                        },
                        "min_selections": {
                            "anyOf": [
                                {
                                    "minimum": 1,
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional minimum number of options that can be selected when `selection_mode` is `multiple`."
                        },
                        "options": {
                            "description": "Ordered categorical options available to the scorer.",
                            "items": {
                                "properties": {
                                    "key": {
                                        "description": "Stable option key. Use lowercase letters, numbers, underscores, or hyphens.",
                                        "maxLength": 128,
                                        "type": "string"
                                    },
                                    "label": {
                                        "description": "Human-readable option label.",
                                        "maxLength": 256,
                                        "type": "string"
                                    }
                                },
                                "required": ["key", "label"],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        "passing_rule": {
                            "anyOf": [
                                {
                                    "properties": {
                                        "categories": {
                                            "description": "Passing category keys. Every returned category must be included. An empty list makes all accepted offline results fail.",
                                            "items": {
                                                "maxLength": 128,
                                                "type": "string"
                                            },
                                            "type": "array"
                                        }
                                    },
                                    "required": ["categories"],
                                    "type": "object"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional passing categories. Omit or set null for neutral scores. Each scorer version keeps its own rule."
                        },
                        "selection_mode": {
                            "description": "Whether reviewers can select one option or multiple options. Defaults to `single`.\n\n* `single` - single\n* `multiple` - multiple",
                            "enum": ["single", "multiple"],
                            "type": "string"
                        }
                    },
                    "required": ["options"],
                    "type": "object"
                },
                {
                    "properties": {
                        "max": {
                            "anyOf": [
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional inclusive maximum score."
                        },
                        "min": {
                            "anyOf": [
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional inclusive minimum score."
                        },
                        "passing_rule": {
                            "anyOf": [
                                {
                                    "properties": {
                                        "operator": {
                                            "description": "Pass at or above (gte), or at or below (lte), the threshold.\n\n* `gte` - At or above\n* `lte` - At or below",
                                            "enum": ["gte", "lte"],
                                            "type": "string"
                                        },
                                        "threshold": {
                                            "description": "Finite passing threshold within any configured score bounds.",
                                            "type": "number"
                                        }
                                    },
                                    "required": ["operator", "threshold"],
                                    "type": "object"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional passing rule. Omit or set null for neutral scores. Each scorer version keeps its own rule."
                        },
                        "step": {
                            "anyOf": [
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Optional increment step for numeric input, for example 1 or 0.5."
                        }
                    },
                    "type": "object"
                },
                {
                    "properties": {
                        "false_label": {
                            "description": "Optional label for a false value.",
                            "type": "string"
                        },
                        "true_is_failure": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Whether true means failure. False, omitted, or null means true passes in offline evaluations."
                        },
                        "true_label": {
                            "description": "Optional label for a true value.",
                            "type": "string"
                        }
                    },
                    "type": "object"
                }
            ],
            "description": "Output configuration to check literal categories and composite scoring rules."
        },
        "id": {
            "type": "string"
        },
        "kind": {
            "description": "Expected formula output kind.\n\n* `categorical` - categorical\n* `numeric` - numeric\n* `boolean` - boolean",
            "enum": ["categorical", "numeric", "boolean"],
            "type": "string"
        },
        "scope": {
            "default": "item",
            "description": "* `item` - Item\n* `experiment` - Experiment",
            "enum": ["item", "experiment"],
            "type": "string"
        }
    },
    "required": ["id", "kind", "composition"],
    "type": "object"
}
