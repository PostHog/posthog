    "compilerOptions": {
        "incremental": false,
        "types": ["jest", "node", "testing-library__jest-dom"],
        "typeRoots": ["./frontend/node_modules/@types"]
    },
    "files": [
        "frontend/src/lib/lemon-ui/LemonField/LemonField.stories.tsx",
        "frontend/src/lib/lemon-ui/LemonField/LemonField.test.tsx",
        "frontend/src/lib/logic/bindModalToUrl.test.ts",
