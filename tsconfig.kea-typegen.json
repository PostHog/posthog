    "include": ["frontend/src/**/*", "products/**/frontend/**/*", "products/**/manifest.tsx"],
    "exclude": [
        "frontend/dist/**/*",
        "frontend/src/generated/**/*",
        "products/**/frontend/generated/**/*",
