#!/usr/bin/env bash

set -euo pipefail

source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT

mkdir -p "$fixture"/{.codex,.flox/cache/venv/bin,.flox/env,bin,tools/phrocs}
cp "$source_root/.codex/with-flox" "$source_root/.codex/run-with-dotenv.py" "$fixture/.codex/"
printf '#!/bin/bash\nexec %q "$@"\n' "$(command -v python)" > "$fixture/.flox/cache/venv/bin/python"
chmod +x "$fixture/.flox/cache/venv/bin/python"
touch "$fixture/.flox/env/manifest.toml" "$fixture/.flox/env/on-activate.sh" \
    "$fixture/bin/dev-sandbox.sb" "$fixture/pnpm-lock.yaml" "$fixture/uv.lock"

cat > "$fixture/bin/flox" <<'SH'
#!/bin/bash
set -euo pipefail
export FLOX_ENV_CACHE="$3/.flox/cache"
export PATH="$3/bin:/usr/bin:/bin"
export DOTENV_FILE=.env
shift 4
exec "$@"
SH
cat > "$fixture/bin/dev-sandbox" <<'SH'
#!/bin/bash
exec /bin/bash -c "$1"
SH
cat > "$fixture/bin/uv" <<'SH'
#!/bin/bash
[[ -z "${OPENAI_API_KEY+x}" && -z "${SANDBOX_JWT_PRIVATE_KEY+x}" && -z "${UNRELATED_SECRET+x}" ]]
SH
chmod +x "$fixture/bin/"*

cd "$fixture"
export PATH="$fixture/bin:$PATH"
# The fixture substitutes Flox and the dependency sandbox; it never installs anything.
unset CODEX_SANDBOX CODEX_SANDBOX_NETWORK_DISABLED
export OPENAI_API_KEY='fake-shell-key'
export SANDBOX_JWT_PRIVATE_KEY=$'fake-key-line-1\nfake-key-line-2'
export UNRELATED_SECRET='fake-unrelated-key'

.codex/with-flox --prepare /bin/bash -s <<'SH'
[[ -z "${OPENAI_API_KEY+x}" && -z "${SANDBOX_JWT_PRIVATE_KEY+x}" && -z "${UNRELATED_SECRET+x}" ]]
SH
if LC_ALL=C grep -aqE 'API_KEY|PRIVATE_KEY|UNRELATED_SECRET' .flox/cache/codex-env; then
    echo 'FAIL: credentials entered the toolchain cache' >&2
    exit 1
fi
.codex/with-flox uv sync
echo 'ok: preparation, cache, and dependency installs exclude shell credentials'

for name in ANTHROPIC_API_KEY BRAINTRUST_API_KEY LLM_GATEWAY_ANTHROPIC_API_KEY \
    LLM_GATEWAY_OPENAI_API_KEY MODAL_TOKEN_ID MODAL_TOKEN_SECRET OPENAI_API_KEY \
    POSTHOG_OFFLINE_EVAL_API_KEY POSTHOG_OFFLINE_EVAL_HOST POSTHOG_OFFLINE_EVAL_LOCAL_CONFIG \
    SANDBOX_JWT_PRIVATE_KEY; do
    export "$name=fake-value with spaces = and \$literal"
    .codex/with-flox /bin/bash -s "$name" <<'SH'
[[ "${!1}" == 'fake-value with spaces = and $literal' && -z "${UNRELATED_SECRET+x}" ]]
SH
    unset "$name"
done
echo 'ok: each allowlisted variable passes through without unrelated secrets'

export SANDBOX_JWT_PRIVATE_KEY=$'fake-key-line-1\nfake-key-line-2'
.codex/with-flox /bin/bash -s <<'SH'
[[ "$SANDBOX_JWT_PRIVATE_KEY" == $'fake-key-line-1\nfake-key-line-2' ]]
SH
echo 'ok: multiline credentials survive'

cat > .env <<'ENV'
OPENAI_API_KEY=fake-dotenv-key
BRAINTRUST_API_KEY=fake-dotenv-braintrust
ENV
export OPENAI_API_KEY='fake-shell-key'
.codex/with-flox /bin/bash -s <<'SH'
[[ "$OPENAI_API_KEY" == fake-shell-key && "$BRAINTRUST_API_KEY" == fake-dotenv-braintrust ]]
SH
export OPENAI_API_KEY='fake-rotated-key'
.codex/with-flox /bin/bash -s <<'SH'
[[ "$OPENAI_API_KEY" == fake-rotated-key ]]
SH
export OPENAI_API_KEY=''
.codex/with-flox /bin/bash -s <<'SH'
[[ "${OPENAI_API_KEY+x}" && -z "$OPENAI_API_KEY" ]]
SH
unset OPENAI_API_KEY
.codex/with-flox /bin/bash -s <<'SH'
[[ "$OPENAI_API_KEY" == fake-dotenv-key ]]
SH
echo 'ok: shell values, rotation, explicit empty values, and dotenv fallback'

printf 'PATH=/another-checkout/bin\n' > .env
if .codex/with-flox /bin/true > "$fixture/output" 2>&1; then
    echo 'FAIL: dotenv replaced the protected toolchain path' >&2
    exit 1
fi
grep -q 'cannot override protected variables: PATH' "$fixture/output"
echo 'ok: dotenv still rejects protected toolchain overrides'
