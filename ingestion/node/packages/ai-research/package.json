{
    "name": "@posthog/ingestion-ai-research",
    "version": "0.0.0",
    "private": true,
    "description": "The AI research team's session replay pipelines and servers: the ML mirror, image fetch and scrub, the anonymizer and the v4 recorder sinks.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog.git",
        "directory": "ingestion/node/packages/ai-research"
    },
    "scripts": {
        "start": "node dist/index.js",
        "start:dev": "NODE_ENV=dev tsx watch src/index.ts",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typescript:check": "tsc --noEmit -p .",
        "test": "pnpm test:parallel; parallel_status=$?; pnpm test:serial; serial_status=$?; exit $((parallel_status || serial_status))",
        "test:parallel": "SHARD_IDX=${SHARD_INDEX:-1}; SHARD_TOTAL=${SHARD_COUNT:-1}; echo parallel $SHARD_IDX/$SHARD_TOTAL; JEST_JUNIT_OUTPUT_NAME=${JEST_JUNIT_OUTPUT_NAME%.xml}-parallel.xml jest --config jest.config.js --maxWorkers=4 --passWithNoTests --forceExit --shard=$SHARD_IDX/$SHARD_TOTAL --testPathIgnorePatterns='postgres-parity|service-e2e|<rootDir>/(src|tests)(/.*)?/dev/'",
        "test:serial": "SHARD_IDX=${SHARD_INDEX:-1}; SHARD_TOTAL=${SHARD_COUNT:-1}; echo serial $SHARD_IDX/$SHARD_TOTAL; JEST_JUNIT_OUTPUT_NAME=${JEST_JUNIT_OUTPUT_NAME%.xml}-serial.xml jest --config jest.serial.config.js --runInBand --forceExit --shard=$SHARD_IDX/$SHARD_TOTAL --testPathIgnorePatterns='postgres-parity|service-e2e|<rootDir>/(src|tests)(/.*)?/dev/'",
        "lint": "oxlint -c .oxlintrc.json .",
        "lint:fix": "oxlint -c .oxlintrc.json . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:replay-anonymizer": "pnpm --dir ../../../../rust/replay-anonymizer-node package",
        "build:replay-anonymizer:dev": "pnpm --dir ../../../../rust/replay-anonymizer-node run build:dev",
        "build:ai-research-v4-native": "pnpm --dir ../../../../rust/ai-research/replay-core-v4-node package",
        "build:ai-research-v4-native:dev": "pnpm --dir ../../../../rust/ai-research/replay-core-v4-node run build:dev"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "3.975.0",
        "@aws-sdk/client-kms": "3.975.0",
        "@aws-sdk/client-s3": "3.975.0",
        "@dsnp/parquetjs": "1.8.7",
        "@opentelemetry/api": "1.9.0",
        "@posthog/ai-research-v4-native": "workspace:*",
        "@posthog/ingestion": "workspace:*",
        "@posthog/ingestion-common": "workspace:*",
        "@posthog/node-common": "workspace:*",
        "@posthog/replay-anonymizer": "workspace:*",
        "@posthog/replay-storage": "workspace:*",
        "@smithy/node-http-handler": "4.4.9",
        "@trybyte/robotstxt-parser": "1.2.0",
        "libsodium-wrappers": "0.7.16",
        "lru-cache": "11.0.2",
        "luxon": "3.5.0",
        "node-rdkafka": "v3.6.1",
        "p-limit": "3.1.0",
        "prom-client": "14.2.0",
        "structured-headers": "2.0.3"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.11.0",
        "@opentelemetry/sdk-trace-node": "2.0.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/jest": "30.0.0",
        "@types/libsodium-wrappers": "0.7.14",
        "@types/long": "4.0.2",
        "@types/luxon": "3.4.2",
        "@types/node": "26.6.5",
        "@types/pg": "8.6.6",
        "jest": "30.0.5",
        "jest-junit": "16.0.0",
        "libsodium-wrappers": "0.7.16",
        "node-fetch": "2.6.9",
        "oxlint": "1.72.0",
        "oxlint-plugin-eslint": "1.72.0",
        "oxlint-tsgolint": "7.0.2001",
        "prettier": "~3.6.2",
        "snappy": "7.2.2",
        "ts-jest": "29.4.9",
        "ts-node": "10.9.1",
        "tsc-alias": "1.8.16",
        "tsconfig-paths": "4.2.0",
        "tsx": "4.20.5",
        "typescript": "6.0.3",
        "undici": "8.10.1"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
