{
    "name": "@posthog/ingestion",
    "version": "0.0.0",
    "description": "PostHog's ingestion services: the event, session replay, error tracking and metrics pipelines, and the framework they are built on.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog.git",
        "directory": "ingestion/node/packages/ingestion"
    },
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/ingestion/*.d.ts",
            "default": "./dist/ingestion/*.js"
        }
    },
    "scripts": {
        "start": "node dist/index.js",
        "start:dev": "NODE_ENV=dev tsx watch src/index.ts",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typescript:check": "tsc --noEmit -p .",
        "test": "pnpm test:parallel; parallel_status=$?; pnpm test:serial; serial_status=$?; exit $((parallel_status || serial_status))",
        "test:parallel": "SHARD_IDX=${SHARD_INDEX:-1}; SHARD_TOTAL=${SHARD_COUNT:-1}; echo parallel $SHARD_IDX/$SHARD_TOTAL; JEST_JUNIT_OUTPUT_NAME=${JEST_JUNIT_OUTPUT_NAME%.xml}-parallel.xml jest --config jest.config.js --maxWorkers=4 --passWithNoTests --forceExit --shard=$SHARD_IDX/$SHARD_TOTAL --testPathIgnorePatterns='postgres-parity|service-e2e|<rootDir>/(src|tests)(/.*)?/dev/'",
        "test:serial": "SHARD_IDX=${SHARD_INDEX:-1}; SHARD_TOTAL=${SHARD_COUNT:-1}; echo serial $SHARD_IDX/$SHARD_TOTAL; JEST_JUNIT_OUTPUT_NAME=${JEST_JUNIT_OUTPUT_NAME%.xml}-serial.xml jest --config jest.serial.config.js --runInBand --forceExit --shard=$SHARD_IDX/$SHARD_TOTAL --testPathIgnorePatterns='postgres-parity|service-e2e|<rootDir>/(src|tests)(/.*)?/dev/'",
        "lint": "oxlint -c .oxlintrc.json .",
        "lint:fix": "oxlint -c .oxlintrc.json . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "pnpm build",
        "test:rust-ingestion-e2e": "if [ -f tests/service-e2e/rust-ingestion-consumer.serial.test.ts ]; then jest --config jest.serial.config.js --runInBand --forceExit --testPathPatterns='service-e2e/rust-ingestion-consumer.serial.test.ts'; else jest --runInBand --forceExit --testPathPatterns='service-e2e/rust-ingestion-consumer.test.ts'; fi",
        "test:personhog-kafka-parity-e2e": "jest --config jest.serial.config.js --runInBand --forceExit --testPathPatterns='service-e2e/personhog-kafka-parity.serial.test.ts'",
        "test:postgres-parity": "jest --runInBand --forceExit --testPathPatterns='postgres-parity'",
        "setup:test:persons-parity": "PERSONS_DATABASE_NAME=test_persons_parity ../../../rust/bin/migrate-entry persons --fresh",
        "migrate:persons": "../../../rust/bin/migrate-entry persons",
        "update-ai-costs": "tsx src/ingestion/pipelines/ai/costs/scripts/update-ai-costs.ts",
        "build:replay-anonymizer": "pnpm --dir ../../../../rust/replay-anonymizer-node package",
        "build:replay-anonymizer:dev": "pnpm --dir ../../../../rust/replay-anonymizer-node run build:dev",
        "build:ai-research-v4-native": "pnpm --dir ../../../../rust/ai-research/replay-core-v4-node package",
        "build:ai-research-v4-native:dev": "pnpm --dir ../../../../rust/ai-research/replay-core-v4-node run build:dev"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "3.975.0",
        "@aws-sdk/client-kms": "3.975.0",
        "@aws-sdk/client-s3": "3.975.0",
        "@aws-sdk/lib-storage": "3.975.0",
        "@bufbuild/protobuf": "2.11.0",
        "@connectrpc/connect": "2.1.1",
        "@connectrpc/connect-node": "2.1.1",
        "@dsnp/parquetjs": "1.8.7",
        "@opentelemetry/api": "1.9.0",
        "@posthog/ai-research-v4-native": "workspace:*",
        "@posthog/hog-engine": "workspace:*",
        "@posthog/ingestion-common": "workspace:*",
        "@posthog/node-common": "workspace:*",
        "@posthog/replay-anonymizer": "workspace:*",
        "@posthog/siphash": "1.1.1",
        "@smithy/node-http-handler": "4.4.9",
        "@trybyte/robotstxt-parser": "1.2.0",
        "fast-equals": "6.0.1",
        "generic-pool": "3.9.0",
        "ioredis": "4.28.5",
        "ipaddr.js": "2.2.0",
        "js-big-decimal": "2.2.0",
        "libsodium-wrappers": "0.7.16",
        "lodash": "4.18.1",
        "lru-cache": "11.0.2",
        "luxon": "3.5.0",
        "lz4": "0.6.5",
        "node-fetch": "2.6.9",
        "node-rdkafka": "v3.6.1",
        "p-limit": "3.1.0",
        "prom-client": "14.2.0",
        "snappy": "7.2.2",
        "structured-headers": "2.0.3",
        "tldts": "6.1.57",
        "undici": "8.10.1",
        "uuid": "11.1.1",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@jest/test-sequencer": "30.0.5",
        "@opentelemetry/sdk-metrics": "2.7.1",
        "@opentelemetry/sdk-trace-node": "2.0.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/ioredis": "4.28.10",
        "@types/jest": "30.0.0",
        "@types/libsodium-wrappers": "0.7.14",
        "@types/lodash": "4.17.16",
        "@types/long": "4.0.2",
        "@types/luxon": "3.4.2",
        "@types/node": "26.6.5",
        "@types/node-fetch": "2.6.4",
        "@types/pg": "8.6.6",
        "@types/supertest": "6.0.2",
        "eslint-plugin-no-only-tests": "^3.1.0",
        "jest": "30.0.5",
        "jest-junit": "16.0.0",
        "node-fetch": "2.6.9",
        "oxlint": "1.72.0",
        "oxlint-plugin-eslint": "1.72.0",
        "oxlint-tsgolint": "7.0.2001",
        "pg": "8.10.0",
        "prettier": "~3.6.2",
        "supertest": "7.2.2",
        "ts-jest": "29.4.9",
        "ts-node": "10.9.1",
        "tsc-alias": "1.8.16",
        "tsconfig-paths": "4.2.0",
        "tsx": "4.20.5",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=26 <27"
    }
}
