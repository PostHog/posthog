#!/bin/bash
# Refreshes the pinned Django schemas from the monorepo at the current commit. Run from the repository root with
# the Django environment active (flox activate) and node-common built. Writes postgres-tables.txt, postgres.sql,
# clickhouse.sql and SOURCE.json.
#
# Both schemas are cut to what the Node packages reach, which node_schema_names.mjs reads from their sources and
# tests with node-common's schema-check derivation, so the pins cannot leave out a table Node uses.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
here=ingestion/pinned/schema
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The Postgres schema comes from the migrated-schema artifact CI publishes for every master commit; hogli
# writes it to .postgres-backups/schema-latest.sql.gz.
bin/hogli db:download-schema
gunzip -c .postgres-backups/schema-latest.sql.gz > "$work/postgres.sql"
node "$here/node_schema_names.mjs" postgres-tables > "$here/postgres-tables.txt"
python3 "$here/cut_postgres_schema.py" "$work/postgres.sql" "$here/postgres-tables.txt" > "$here/postgres.sql"

# The ClickHouse schema is the statement list setup_test_environment runs.
TEST=1 CLICKHOUSE_DATABASE=posthog_test uv run --no-sync python3 "$here/dump_clickhouse_schema.py" > "$work/clickhouse.sql"
node "$here/node_schema_names.mjs" identifiers > "$work/identifiers.txt"
python3 "$here/cut_clickhouse_schema.py" "$work/clickhouse.sql" "$work/identifiers.txt" > "$here/clickhouse.sql"

python3 - "$here" <<'PY'
import hashlib, json, pathlib, subprocess, sys
here = pathlib.Path(sys.argv[1])
commit = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
files = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(here.iterdir()) if p.name in ("postgres.sql", "clickhouse.sql")}
(here / "SOURCE.json").write_text(json.dumps({"repository": "PostHog/posthog", "path": "posthog/migrations, posthog/clickhouse/schema.py", "commits": {name: commit for name in files}, "files": files}, indent=4) + "\n")
PY
