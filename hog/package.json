{
    "name": "@posthog/hog",
    "version": "1.0.0-alpha.0",
    "private": true,
    "description": "hog, the PostHog command line. Successor to posthog-cli in cli/",
    "bin": {
        "hog": "./src/index.ts"
    },
    "type": "module",
    "scripts": {
        "hog": "bun src/index.ts",
        "compile": "bun build --compile src/index.ts --outfile dist/hog",
        "typecheck": "tsc --noEmit",
        "unit": "bun test"
    },
    "dependencies": {
        "commander": "15.0.0"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "typescript": "catalog:"
    }
}
