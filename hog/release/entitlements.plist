<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What a Bun executable needs under the hardened runtime, which notarization requires. Bun's JIT
     writes and runs machine code at run time, which the hardened runtime forbids without these.
     hog loads no native library that Apple didn't sign: no .node addon, no bun:ffi, and the keychain
     through Bun.secrets. So library validation stays on and DYLD_* variables stay ignored, which keeps
     other code out of the process that reads hog's keychain items. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
</dict>
</plist>
