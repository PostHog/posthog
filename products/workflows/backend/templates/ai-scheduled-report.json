                "inputs": {
                    "prompt": {
                        "value": "Write a short report on this project's PostHog data since the last report.\n\nCover:\n1. The key metrics on the project's most-used dashboard, compared with the previous period.\n2. Any large changes, and what most likely caused them.\n3. New or growing errors.\n\nKeep it under 200 words. Start with the most important change, and link to the insights you used."
                    },
                    "title": {
                        "value": "Scheduled report"
                    },
                    "posthog_mcp_scopes": {
                        "value": "read_only"
                    },
                    "reply_in_slack_thread": {
                        "value": false
                    },
                    "non_failure_status_codes": {
                        "value": [409]
                    }
                }
            }
        },
