{
    "id": "01a1352a-0c41-0000-e3b7-5f9a28c4d1e6",
    "name": "Ticket SLA: warn before a breach",
    "description": "Posts to Slack 1 hour before a ticket's SLA deadline, if the ticket is still open and the deadline hasn't moved. Each deadline is only warned about once. Works with any template that sets an SLA, such as Ticket SLA: set first response time.",
    "scope": "global",
    "tags": ["support", "support SLAs", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_created",
                    "name": "$conversation_ticket_created",
                    "type": "events",
                    "order": 0
                },
                {
                    "id": "$conversation_message_received",
                    "name": "$conversation_message_received",
                    "type": "events",
                    "order": 1
                },
                {
                    "id": "$conversation_message_sent",
                    "name": "$conversation_message_sent",
                    "type": "events",
                    "order": 2
                },
                {
                    "id": "$conversation_ticket_status_changed",
                    "name": "$conversation_ticket_status_changed",
                    "type": "events",
                    "order": 3
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": {
        "hash": "{event.properties.ticket_id}",
        "ttl": 600,
        "threshold": null
    },
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "wait_settle",
            "type": "continue"
        },
        {
            "from": "wait_settle",
            "to": "get_ticket",
            "type": "continue"
        },
        {
            "from": "get_ticket",
            "to": "has_sla",
            "type": "continue"
        },
        {
            "from": "has_sla",
            "to": "wait_warn",
            "type": "branch",
            "index": 0
        },
        {
            "from": "has_sla",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "wait_warn",
            "to": "recheck",
            "type": "continue"
        },
        {
            "from": "recheck",
            "to": "still_due",
            "type": "continue"
        },
        {
            "from": "still_due",
            "to": "slack_warn",
            "type": "branch",
            "index": 0
        },
        {
            "from": "still_due",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "slack_warn",
            "to": "mark_warned",
            "type": "continue"
        },
        {
            "from": "mark_warned",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Ticket activity",
            "description": "Runs whenever a ticket's SLA may have changed. Starts at most once per ticket every 10 minutes.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_created",
                            "name": "$conversation_ticket_created",
                            "type": "events",
                            "order": 0
                        },
                        {
                            "id": "$conversation_message_received",
                            "name": "$conversation_message_received",
                            "type": "events",
                            "order": 1
                        },
                        {
                            "id": "$conversation_message_sent",
                            "name": "$conversation_message_sent",
                            "type": "events",
                            "order": 2
                        },
                        {
                            "id": "$conversation_ticket_status_changed",
                            "name": "$conversation_ticket_status_changed",
                            "type": "events",
                            "order": 3
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "wait_settle",
            "name": "Wait 15 minutes",
            "description": "Gives your other SLA workflows time to update the deadline.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_duration": "15m"
            },
            "output_variable": null
        },
        {
            "id": "get_ticket",
            "name": "Get ticket",
            "description": "Load the ticket's deadline and status, and remember the deadline.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": [
                {
                    "key": "ticket"
                },
                {
                    "key": "sla_deadline",
                    "result_path": "sla"
                }
            ]
        },
        {
            "id": "has_sla",
            "name": "Open, and due in more than 1 hour?",
            "description": "Only tickets that are open and have a deadline more than 1 hour away get a warning.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Open with a deadline over 1 hour away",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket.sla is not null and variables.ticket.status not in ('pending', 'on_hold', 'resolved') and toUnixTimestamp(toDateTime(variables.ticket.sla)) - toUnixTimestamp(now()) > 3600",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "wait_warn",
            "name": "Wait until 1 hour before the deadline",
            "description": "Change the offset to warn earlier or later.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_until": {
                    "expression": "variables.sla_deadline",
                    "offset": "-1h"
                },
                "max_delay_duration": "30d"
            },
            "output_variable": null
        },
        {
            "id": "recheck",
            "name": "Re-check ticket",
            "description": "Load the ticket again, in case it was answered or the deadline moved.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": {
                "key": "ticket"
            }
        },
        {
            "id": "still_due",
            "name": "Same deadline, still open, not warned yet?",
            "description": "If the deadline changed, a newer run of this workflow handles it.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Same deadline, still open, not warned yet",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket.sla is not null and variables.ticket.sla = variables.sla_deadline and variables.ticket.status not in ('pending', 'on_hold', 'resolved') and not has(variables.ticket.tags, concat('sla_warned_', toString(toInt(toUnixTimestamp(toDateTime(variables.sla_deadline))))))",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "slack_warn",
            "name": "Post to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":hourglass_flowing_sand:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":hourglass_flowing_sand: Ticket *#{variables.ticket.number}* is due in 1 hour\nAssignee: {variables.ticket.assignee.user.email ?? variables.ticket.assignee.role.name ?? 'unassigned'}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{variables.ticket.number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{variables.ticket.number} is due in 1 hour",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "mark_warned",
            "name": "Mark the deadline as warned",
            "description": "Tags the ticket sla_warned_<deadline> once the Slack post has gone out, so the same deadline is only handled once even if several runs wait for it. To keep tags tidy, you can remove these when tickets are resolved.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "tags": {
                        "value": ["sla_warned_{toString(toInt(toUnixTimestamp(toDateTime(variables.sla_deadline))))}"],
                        "templating": "hog"
                    },
                    "tags_mode": {
                        "value": "add",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
