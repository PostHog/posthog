{
    "id": "01a1352a-0c41-0000-1f8d-9b3a5c7e2d14",
    "name": "Ticket: reopen when the customer replies",
    "description": "When a customer replies on a pending, on hold or resolved ticket, set it back to open so it shows up in your queue again. Optionally pings Slack when the customer is an important one.",
    "scope": "global",
    "tags": ["support", "support lifecycle", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_message_received",
                    "name": "$conversation_message_received",
                    "type": "events",
                    "order": 0,
                    "properties": [
                        {
                            "key": "status",
                            "type": "event",
                            "value": "^(pending|on_hold|resolved)$",
                            "operator": "regex"
                        }
                    ]
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": null,
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "reopen",
            "type": "continue"
        },
        {
            "from": "reopen",
            "to": "is_important",
            "type": "continue"
        },
        {
            "from": "is_important",
            "to": "slack_important",
            "type": "branch",
            "index": 0
        },
        {
            "from": "is_important",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "slack_important",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Customer replies on a closed or waiting ticket",
            "description": "Runs when a customer sends a message on a ticket that's pending, on hold or resolved.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_message_received",
                            "name": "$conversation_message_received",
                            "type": "events",
                            "order": 0,
                            "properties": [
                                {
                                    "key": "status",
                                    "type": "event",
                                    "value": "^(pending|on_hold|resolved)$",
                                    "operator": "regex"
                                }
                            ]
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "reopen",
            "name": "Reopen ticket",
            "description": "Sets the ticket back to open.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "status": {
                        "value": "open",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "is_important",
            "name": "Important customer?",
            "description": "Optional. Uses the same example property as the SLA templates. Delete this step and the Slack step if you don't need the ping.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Enterprise",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "plan",
                                    "type": "person",
                                    "value": ["enterprise"],
                                    "operator": "exact"
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "slack_important",
            "name": "Post to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":rotating_light:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":rotating_light: Ticket *#{toInt(event.properties.ticket_number)}* from an important customer has a new reply\nFrom: {replaceAll(replaceAll(replaceAll(toString(event.properties.customer_email), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{toInt(event.properties.ticket_number)}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{toInt(event.properties.ticket_number)} from an important customer has a new reply",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
