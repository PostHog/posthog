{
    "id": "01a1352a-0c41-0000-7c25-a91e4b6f8d30",
    "name": "Ticket SLA: escalate overdue tickets",
    "description": "If a ticket is still open a day after its SLA deadline, reassign it to a lead or team and post to Slack. If the reassignment fails, Slack is told instead. Each deadline is only escalated once. Works with any template that sets an SLA, such as Ticket SLA: set first response time.",
    "scope": "global",
    "tags": ["support", "support SLAs", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_created",
                    "name": "$conversation_ticket_created",
                    "type": "events",
                    "order": 0
                },
                {
                    "id": "$conversation_message_received",
                    "name": "$conversation_message_received",
                    "type": "events",
                    "order": 1
                },
                {
                    "id": "$conversation_message_sent",
                    "name": "$conversation_message_sent",
                    "type": "events",
                    "order": 2
                },
                {
                    "id": "$conversation_ticket_status_changed",
                    "name": "$conversation_ticket_status_changed",
                    "type": "events",
                    "order": 3
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": {
        "hash": "{event.properties.ticket_id}",
        "ttl": 600,
        "threshold": null
    },
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "wait_settle",
            "type": "continue"
        },
        {
            "from": "wait_settle",
            "to": "get_ticket",
            "type": "continue"
        },
        {
            "from": "get_ticket",
            "to": "has_sla",
            "type": "continue"
        },
        {
            "from": "has_sla",
            "to": "wait_overdue",
            "type": "branch",
            "index": 0
        },
        {
            "from": "has_sla",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "wait_overdue",
            "to": "recheck",
            "type": "continue"
        },
        {
            "from": "recheck",
            "to": "still_overdue",
            "type": "continue"
        },
        {
            "from": "still_overdue",
            "to": "reassign",
            "type": "branch",
            "index": 0
        },
        {
            "from": "still_overdue",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "reassign",
            "to": "check_assignee",
            "type": "continue"
        },
        {
            "from": "check_assignee",
            "to": "reassigned",
            "type": "continue"
        },
        {
            "from": "reassigned",
            "to": "slack_failed",
            "type": "branch",
            "index": 0
        },
        {
            "from": "reassigned",
            "to": "slack_escalate",
            "type": "continue"
        },
        {
            "from": "slack_failed",
            "to": "mark_escalated",
            "type": "continue"
        },
        {
            "from": "slack_escalate",
            "to": "mark_escalated",
            "type": "continue"
        },
        {
            "from": "mark_escalated",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Ticket activity",
            "description": "Runs whenever a ticket's SLA may have changed. Starts at most once per ticket every 10 minutes.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_created",
                            "name": "$conversation_ticket_created",
                            "type": "events",
                            "order": 0
                        },
                        {
                            "id": "$conversation_message_received",
                            "name": "$conversation_message_received",
                            "type": "events",
                            "order": 1
                        },
                        {
                            "id": "$conversation_message_sent",
                            "name": "$conversation_message_sent",
                            "type": "events",
                            "order": 2
                        },
                        {
                            "id": "$conversation_ticket_status_changed",
                            "name": "$conversation_ticket_status_changed",
                            "type": "events",
                            "order": 3
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "wait_settle",
            "name": "Wait 15 minutes",
            "description": "Gives your other SLA workflows time to update the deadline.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_duration": "15m"
            },
            "output_variable": null
        },
        {
            "id": "get_ticket",
            "name": "Get ticket",
            "description": "Load the ticket's deadline and status, and remember the deadline.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": [
                {
                    "key": "ticket"
                },
                {
                    "key": "sla_deadline",
                    "result_path": "sla"
                }
            ]
        },
        {
            "id": "has_sla",
            "name": "Open with a deadline?",
            "description": "Only open tickets with an SLA can become overdue.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Open with a deadline",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket.sla is not null and variables.ticket.status not in ('pending', 'on_hold', 'resolved')",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "wait_overdue",
            "name": "Wait until 1 day after the deadline",
            "description": "Change the offset to escalate sooner or later.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_until": {
                    "expression": "variables.sla_deadline",
                    "offset": "1d"
                },
                "max_delay_duration": "30d"
            },
            "output_variable": null
        },
        {
            "id": "recheck",
            "name": "Re-check ticket",
            "description": "Load the ticket again, in case it was answered or the deadline moved.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": {
                "key": "ticket"
            }
        },
        {
            "id": "still_overdue",
            "name": "Same deadline, still open, not escalated yet?",
            "description": "If the deadline changed, a newer run of this workflow handles it.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Same deadline, still open, not escalated yet",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket.sla is not null and variables.ticket.sla = variables.sla_deadline and variables.ticket.status not in ('pending', 'on_hold', 'resolved') and not has(variables.ticket.tags, concat('sla_escalated_', toString(toInt(toUnixTimestamp(toDateTime(variables.sla_deadline))))))",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "reassign",
            "name": "Reassign ticket",
            "description": "Pick the lead or team that takes over overdue tickets.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "check_assignee",
            "name": "Check the new assignee",
            "description": "Loads the ticket again to confirm the reassignment worked.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": [
                {
                    "key": "assignee_after",
                    "result_path": "assignee"
                }
            ]
        },
        {
            "id": "reassigned",
            "name": "Did the reassignment work?",
            "description": "If the assignee didn't change, someone is told instead of the ticket going quiet.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Assignee unchanged",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "toString(variables.assignee_after) = toString(variables.ticket.assignee)",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "slack_failed",
            "name": "Post to Slack: couldn't reassign",
            "description": "Tells your team the ticket is overdue and couldn't be reassigned.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":warning:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":warning: Ticket *#{variables.ticket.number}* is over a day past its SLA, but couldn't be reassigned. Check the assignee in the 'Reassign ticket' step.\nAssignee: {variables.ticket.assignee.user.email ?? variables.ticket.assignee.role.name ?? 'unassigned'}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{variables.ticket.number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{variables.ticket.number} is over a day past its SLA and couldn't be reassigned",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_escalate",
            "name": "Post to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":rotating_light:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":rotating_light: Ticket *#{variables.ticket.number}* is over a day past its SLA\nReassigned from {variables.ticket.assignee.user.email ?? variables.ticket.assignee.role.name ?? 'unassigned'} to *{variables.assignee_after.user.email ?? variables.assignee_after.role.name ?? 'unassigned'}*"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{variables.ticket.number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{variables.ticket.number} is over a day past its SLA and has been reassigned to {variables.assignee_after.user.email ?? variables.assignee_after.role.name ?? 'unassigned'}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "mark_escalated",
            "name": "Mark the deadline as escalated",
            "description": "Tags the ticket sla_escalated_<deadline> once the Slack post has gone out, so the same deadline is only handled once even if several runs wait for it. To keep tags tidy, you can remove these when tickets are resolved.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "tags": {
                        "value": [
                            "sla_escalated_{toString(toInt(toUnixTimestamp(toDateTime(variables.sla_deadline))))}"
                        ],
                        "templating": "hog"
                    },
                    "tags_mode": {
                        "value": "add",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
