{
    "id": "01a1352a-0c41-0000-7c25-a91e4b6f8d30",
    "name": "Ticket SLA: escalate overdue tickets",
    "description": "If a ticket is still open a day after its SLA deadline, reassign it to a lead or team and post to Slack.",
    "scope": "global",
    "tags": ["support", "support SLAs", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_created",
                    "name": "$conversation_ticket_created",
                    "type": "events",
                    "order": 0
                },
                {
                    "id": "$conversation_message_received",
                    "name": "$conversation_message_received",
                    "type": "events",
                    "order": 1
                },
                {
                    "id": "$conversation_message_sent",
                    "name": "$conversation_message_sent",
                    "type": "events",
                    "order": 2
                },
                {
                    "id": "$conversation_ticket_status_changed",
                    "name": "$conversation_ticket_status_changed",
                    "type": "events",
                    "order": 3
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": {
        "hash": "{event.properties.ticket_id}",
        "ttl": 600,
        "threshold": null
    },
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "wait_settle",
            "type": "continue"
        },
        {
            "from": "wait_settle",
            "to": "get_ticket",
            "type": "continue"
        },
        {
            "from": "get_ticket",
            "to": "has_sla",
            "type": "continue"
        },
        {
            "from": "has_sla",
            "to": "wait_overdue",
            "type": "branch",
            "index": 0
        },
        {
            "from": "has_sla",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "wait_overdue",
            "to": "recheck",
            "type": "continue"
        },
        {
            "from": "recheck",
            "to": "still_overdue",
            "type": "continue"
        },
        {
            "from": "still_overdue",
            "to": "reassign",
            "type": "branch",
            "index": 0
        },
        {
            "from": "still_overdue",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "reassign",
            "to": "slack_escalate",
            "type": "continue"
        },
        {
            "from": "slack_escalate",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Ticket activity",
            "description": "Runs whenever a ticket's SLA may have changed. Starts at most once per ticket every 10 minutes.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_created",
                            "name": "$conversation_ticket_created",
                            "type": "events",
                            "order": 0
                        },
                        {
                            "id": "$conversation_message_received",
                            "name": "$conversation_message_received",
                            "type": "events",
                            "order": 1
                        },
                        {
                            "id": "$conversation_message_sent",
                            "name": "$conversation_message_sent",
                            "type": "events",
                            "order": 2
                        },
                        {
                            "id": "$conversation_ticket_status_changed",
                            "name": "$conversation_ticket_status_changed",
                            "type": "events",
                            "order": 3
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "wait_settle",
            "name": "Wait 10 minutes",
            "description": "Gives your SLA workflows time to set the new deadline.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_duration": "10m"
            },
            "output_variable": null
        },
        {
            "id": "get_ticket",
            "name": "Get ticket",
            "description": "Load the ticket's deadline and status.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": {
                "key": "ticket"
            }
        },
        {
            "id": "has_sla",
            "name": "Open with a deadline?",
            "description": "Only open tickets with an SLA can become overdue.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Open with a deadline",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket.sla is not null and variables.ticket.status not in ('pending', 'on_hold', 'resolved')",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "wait_overdue",
            "name": "Wait until 1 day after the deadline",
            "description": "Change the offset to escalate sooner or later.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_until": {
                    "expression": "variables.ticket.sla",
                    "offset": "1d"
                },
                "max_delay_duration": "30d"
            },
            "output_variable": null
        },
        {
            "id": "recheck",
            "name": "Re-check ticket",
            "description": "Load the ticket again, in case it was answered or the deadline moved.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": {
                "key": "ticket_now"
            }
        },
        {
            "id": "still_overdue",
            "name": "Same deadline and still open?",
            "description": "If the deadline changed, a newer run of this workflow handles it.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Same deadline, still open",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket_now.sla is not null and variables.ticket_now.sla = variables.ticket.sla and variables.ticket_now.status not in ('pending', 'on_hold', 'resolved')",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "reassign",
            "name": "Reassign ticket",
            "description": "Pick the lead or team that takes over overdue tickets.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_escalate",
            "name": "Post to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":rotating_light:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":rotating_light: Ticket *#{variables.ticket_now.number}* is over a day past its SLA\nIt has been reassigned for escalation. Previous assignee: {variables.ticket_now.assignee.user.email ?? variables.ticket_now.assignee.role.name ?? 'unassigned'}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "https://app.posthog.com/support/tickets/{variables.ticket_now.number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{variables.ticket_now.number} is over a day past its SLA",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
