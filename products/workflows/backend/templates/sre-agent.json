    "name": "Investigate Slack alerts with an SRE agent",
    "description": "Start an AI investigation when an alerting app or bot posts a Slack message containing \"Alert\". The agent uses PostHog and your connected tools, then replies with evidence and next steps.",
    "version": 1,
    "created_at": "2026-09-02T00:00:00Z",
    "updated_at": "2026-09-02T00:00:00Z",
    "trigger": {
        "type": "internal-event",
        "filters": {
            "source": "internal-events",
            "events": [
                {
                    "id": "$slack_message_received",
                    "type": "events"
                }
            ],
            "properties": [
                {
                    "key": "bot_id",
                    "value": "is_set",
                    "operator": "is_set",
                    "type": "event"
                },
                {
                    "key": "thread_ts",
                    "value": "is_not_set",
                    "operator": "is_not_set",
                    "type": "event"
                },
                {
                    "key": "message_text",
                    "value": ["Alert"],
                    "operator": "icontains",
                    "type": "event"
                }
            ]
        }
    },
    "trigger_masking": null,
    "conversion": {
        "filters": [],
        "window_minutes": null
    },
