{
    "id": "01a12fb6-3cfe-0000-5d45-25a5b3a944e0",
    "name": "Ticket: AI triage and investigation",
    "description": "When a ticket comes in, an AI agent investigates it using the customer's PostHog data, and your docs or code if you connect them. It tags the ticket with a category, sets its priority, and saves its findings and a suggested reply as a private note for your team. It never replies to the customer.",
    "scope": "global",
    "tags": ["ai", "support", "support lifecycle", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_created",
                    "name": "$conversation_ticket_created",
                    "type": "events",
                    "order": 0
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": {
        "hash": "{event.properties.ticket_id}",
        "ttl": 86400,
        "threshold": null
    },
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "triage",
            "type": "continue"
        },
        {
            "from": "triage",
            "to": "did_triage",
            "type": "continue"
        },
        {
            "from": "did_triage",
            "to": "note_investigation",
            "type": "branch",
            "index": 0
        },
        {
            "from": "did_triage",
            "to": "tag_needs_triage",
            "type": "continue"
        },
        {
            "from": "note_investigation",
            "to": "slack_triage",
            "type": "continue"
        },
        {
            "from": "slack_triage",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "tag_needs_triage",
            "to": "slack_fallback",
            "type": "continue"
        },
        {
            "from": "slack_fallback",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Support ticket is created",
            "description": "A customer has created a new support ticket. Runs once per ticket per day.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_created",
                            "name": "$conversation_ticket_created",
                            "type": "events",
                            "order": 0
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "triage",
            "name": "Investigate and triage the ticket",
            "description": "An AI agent investigates the ticket, tags its category, sets its priority and drafts a reply for your team. It never replies to the customer. Edit the category list to match your team. To let it check your docs or code, add your GitHub repository under Repository, or a docs or knowledge base connector under Connectors. It needs full access to tag the ticket, and it's told not to change anything else.",
            "type": "function",
            "on_error": "continue",
            "filters": null,
            "config": {
                "template_id": "template-posthog-create-task",
                "inputs": {
                    "prompt": {
                        "value": "A customer just opened a support ticket. Read the ticket using the `ticket_id` property of the triggering event.\n\nThen investigate:\n- Look up this customer in PostHog: their recent activity, errors, and session recordings around the time of the ticket.\n- If you have access to the team's docs, code repository or other connectors, check them for known issues, relevant docs pages or recent changes that explain the problem.\n\nThen classify the ticket:\n- Pick one category and add it to the ticket as a tag: `category_bug`, `category_billing`, `category_how_to`, `category_feature_request`, `category_account_access` or `category_other`.\n- Set the ticket's priority to low, medium or high.\n\nReply with:\n1. A one-line summary of the problem.\n2. The category and priority you set, and why.\n3. What you found in their data, docs or code that explains the problem, with links.\n4. A suggested reply the support team can edit and send.\n\nOnly add the category tag and set the priority. Never reply to the customer, change the ticket's status or assignee, or change anything else. Your write-up is for the support team, who decide what to send.",
                        "templating": "hog"
                    },
                    "title": {
                        "value": "Support ticket triage and investigation",
                        "templating": "hog"
                    },
                    "posthog_mcp_scopes": {
                        "value": "full",
                        "templating": "hog"
                    },
                    "reply_in_slack_thread": {
                        "value": false,
                        "templating": "hog"
                    },
                    "non_failure_status_codes": {
                        "value": [409],
                        "templating": "hog"
                    }
                }
            },
            "output_variable": [
                {
                    "key": "task_final_message",
                    "result_path": "final_message"
                }
            ]
        },
        {
            "id": "did_triage",
            "name": "Did the agent finish?",
            "description": "The agent may not run if too many tasks are already running or the daily task limit is reached.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Agent replied",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "length(toString(ifNull(variables.task_final_message, ''))) > 0",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "note_investigation",
            "name": "Save investigation to the ticket",
            "description": "Adds the agent's write-up as a private note, so whoever picks up the ticket sees it there. Only your team can see private notes.",
            "type": "function",
            "on_error": "continue",
            "filters": null,
            "config": {
                "template_id": "template-posthog-send-ticket-message",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "message": {
                        "value": "AI investigation (not sent to the customer)\n\n{variables.task_final_message}",
                        "templating": "hog"
                    },
                    "is_private": {
                        "value": true,
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_triage",
            "name": "Post to Slack",
            "description": "Connect your support channel to see the investigation and the suggested reply.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":mag:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":mag: Ticket *#{event.properties.ticket_number}* investigated by AI. The write-up is also saved on the ticket as a private note."
                                }
                            },
                            {
                                "type": "markdown",
                                "text": "{variables.task_final_message}"
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "https://app.posthog.com/support/tickets/{event.properties.ticket_number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{event.properties.ticket_number} investigated by AI\n\n{variables.task_final_message}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "tag_needs_triage",
            "name": "Tag for manual triage",
            "description": "Adds a needs_triage tag, so a person can pick the ticket up.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "tags": {
                        "value": ["needs_triage"],
                        "templating": "hog"
                    },
                    "tags_mode": {
                        "value": "add",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_fallback",
            "name": "Post to Slack",
            "description": "Lets your team know this ticket needs a person to triage it.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":warning:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":warning: Ticket *#{event.properties.ticket_number}* needs manual triage\nThe AI investigation didn't run, so it's been tagged needs_triage."
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "https://app.posthog.com/support/tickets/{event.properties.ticket_number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Ticket #{event.properties.ticket_number} needs manual triage",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [
        {
            "key": "task_final_message",
            "type": "string",
            "default": ""
        }
    ],
    "billable_action_types": ["function"]
}
