{
    "id": "01a1352a-0c41-0000-3d7e-c2b9f05a1e68",
    "name": "Ticket CSAT: send survey after resolve",
    "description": "A day after a ticket is resolved, email the customer a one-click satisfaction survey, unless the ticket was reopened. Create a hosted CSAT survey first and paste its link into the csat_survey_url variable.",
    "scope": "global",
    "tags": ["support", "support CSAT", "email"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_status_changed",
                    "name": "$conversation_ticket_status_changed",
                    "type": "events",
                    "order": 0,
                    "properties": [
                        {
                            "key": "new_status",
                            "type": "event",
                            "value": ["resolved"],
                            "operator": "exact"
                        },
                        {
                            "key": "customer_email",
                            "type": "event",
                            "value": "is_set",
                            "operator": "is_set"
                        }
                    ]
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": {
        "hash": "{event.properties.ticket_id}",
        "ttl": 86400,
        "threshold": null
    },
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "wait_1d",
            "type": "continue"
        },
        {
            "from": "wait_1d",
            "to": "get_ticket",
            "type": "continue"
        },
        {
            "from": "get_ticket",
            "to": "still_resolved",
            "type": "continue"
        },
        {
            "from": "still_resolved",
            "to": "email_csat",
            "type": "branch",
            "index": 0
        },
        {
            "from": "still_resolved",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "email_csat",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Ticket resolved",
            "description": "Runs when a ticket is resolved. Starts at most once per ticket per day.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_status_changed",
                            "name": "$conversation_ticket_status_changed",
                            "type": "events",
                            "order": 0,
                            "properties": [
                                {
                                    "key": "new_status",
                                    "type": "event",
                                    "value": ["resolved"],
                                    "operator": "exact"
                                },
                                {
                                    "key": "customer_email",
                                    "type": "event",
                                    "value": "is_set",
                                    "operator": "is_set"
                                }
                            ]
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "wait_1d",
            "name": "Wait 1 day",
            "description": "Gives the customer a chance to reopen the ticket first.",
            "type": "delay",
            "on_error": null,
            "filters": null,
            "config": {
                "delay_duration": "1d"
            },
            "output_variable": null
        },
        {
            "id": "get_ticket",
            "name": "Get ticket",
            "description": "Load the ticket's current status.",
            "type": "function",
            "on_error": "abort",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": {
                "key": "ticket"
            }
        },
        {
            "id": "still_resolved",
            "name": "Still resolved?",
            "description": "Only ask for feedback if the ticket wasn't reopened.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Still resolved",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.ticket.status = 'resolved'",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "email_csat",
            "name": "Send CSAT survey",
            "description": "Each rating links to your survey with the score filled in. Pick your sender and edit the copy.",
            "type": "function_email",
            "on_error": "continue",
            "filters": null,
            "config": {
                "template_id": "template-email",
                "message_category_type": "transactional",
                "inputs": {
                    "email": {
                        "value": {
                            "to": {
                                "name": "",
                                "email": "{{ event.properties.customer_email }}"
                            },
                            "from": {
                                "name": "",
                                "email": ""
                            },
                            "replyTo": "",
                            "subject": "How did we do on ticket #{{ event.properties.ticket_number }}?",
                            "preheader": "One click to rate the help you got.",
                            "text": "Hi there,\n\nYour ticket #{{ event.properties.ticket_number }} has been resolved. How did we do? Rate us from 1 to 5 here:\n\n{{ variables.csat_survey_url }}?ticket_id={{ event.properties.ticket_id | url_encode }}&ticket_number={{ event.properties.ticket_number | url_encode }}&distinct_id={{ event.properties.customer_distinct_id | url_encode }}\n\nThanks,\nThe support team",
                            "html": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional //EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<!--[if gte mso 9]>\n<xml>\n  <o:OfficeDocumentSettings>\n    <o:AllowPNG/>\n    <o:PixelsPerInch>96</o:PixelsPerInch>\n  </o:OfficeDocumentSettings>\n</xml>\n<![endif]-->\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <!--[if !mso]><!--><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"><!--<![endif]-->\n\n\n    <style type=\"text/css\">\n\n      @media only screen and (min-width: 520px) {\n        .u-row {\n          width: 500px !important;\n        }\n\n        .u-row .u-col {\n          vertical-align: top;\n        }\n\n\n            .u-row .u-col-100 {\n              width: 500px !important;\n            }\n\n      }\n\n      @media only screen and (max-width: 520px) {\n        .u-row-container {\n          max-width: 100% !important;\n          padding-left: 0px !important;\n          padding-right: 0px !important;\n        }\n\n        .u-row {\n          width: 100% !important;\n        }\n\n        .u-row .u-col {\n          display: block !important;\n          width: 100% !important;\n          min-width: 320px !important;\n          max-width: 100% !important;\n        }\n\n        .u-row .u-col > div {\n          margin: 0 auto;\n        }\n\n}\n\nbody{margin:0;padding:0}table,td,tr{border-collapse:collapse;vertical-align:top}p{margin:0}.ie-container table,.mso-container table{table-layout:fixed}*{line-height:inherit}a[x-apple-data-detectors=true]{color:inherit!important;text-decoration:none!important}\n\n\ntable, td { color: #000000; } #u_body a { color: #0000ee; text-decoration: underline; }\n    </style>\n\n\n\n</head>\n\n<body class=\"clean-body u_body\" style=\"margin: 0;padding: 0;-webkit-text-size-adjust: 100%;background-color: #F7F8F9;color: #000000\">\n  <!--[if IE]><div class=\"ie-container\"><![endif]-->\n  <!--[if mso]><div class=\"mso-container\"><![endif]-->\n  <table role=\"presentation\" id=\"u_body\" style=\"border-collapse: collapse;table-layout: fixed;border-spacing: 0;mso-table-lspace: 0pt;mso-table-rspace: 0pt;vertical-align: top;min-width: 320px;Margin: 0 auto;background-color: #F7F8F9;width:100%\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n  <tr style=\"vertical-align: top\">\n    <td style=\"word-break: break-word;border-collapse: collapse !important;vertical-align: top\">\n    <!--[if (mso)|(IE)]><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"background-color: #F7F8F9;\" bgcolor=\"#F7F8F9\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"500\" align=\"center\" style=\"border-collapse: collapse;\"><tr><td style=\"padding:0;\"><![endif]-->\n\n\n\n<div class=\"u-row-container\" style=\"padding: 0px;background-color: transparent;\">\n  <div class=\"u-row\" style=\"margin: 0 auto;min-width: 320px;max-width: 500px;overflow-wrap: break-word;word-wrap: break-word;word-break: break-word;background-color: transparent;\">\n    <div style=\"border-collapse: collapse;display: table;width: 100%;height: 100%;background-color: transparent;\">\n      <!--[if (mso)|(IE)]><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;background-color: transparent;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr style=\"background-color: transparent;\"><![endif]-->\n\n<!--[if (mso)|(IE)]><td align=\"center\" width=\"500\" style=\"width: 500px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\" valign=\"top\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding: 0px;\"><![endif]-->\n<div class=\"u-col u-col-100\" style=\"max-width: 320px;min-width: 500px;display: table-cell;vertical-align: top;\">\n  <div style=\"height: 100%;width: 100% !important;\">\n  <!--[if (!mso)&(!IE)]><!--><div style=\"box-sizing: border-box; height: 100%; padding: 0px;border-top: 0px solid transparent;border-left: 0px solid transparent;border-right: 0px solid transparent;border-bottom: 0px solid transparent;\"><!--<![endif]-->\n\n<table style=\"font-family:arial,helvetica,sans-serif;\" role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" border=\"0\">\n  <tbody>\n    <tr>\n      <td style=\"overflow-wrap:break-word;word-break:break-word;padding:10px;font-family:arial,helvetica,sans-serif;\" align=\"left\">\n\n  <div style=\"font-size: 14px; line-height: 140%; text-align: left; word-wrap: break-word;\">\n    <p style=\"line-height: 140%;\">Hi there,<br><br>Your ticket <strong>#{{ event.properties.ticket_number }}</strong> has been resolved. How did we do?</p><p style=\"line-height: 160%; font-size: 28px;\"><a href=\"{{ variables.csat_survey_url }}?ticket_id={{ event.properties.ticket_id | url_encode }}&ticket_number={{ event.properties.ticket_number | url_encode }}&distinct_id={{ event.properties.customer_distinct_id | url_encode }}&q0=1\" style=\"text-decoration: none;\">😞</a>&nbsp; <a href=\"{{ variables.csat_survey_url }}?ticket_id={{ event.properties.ticket_id | url_encode }}&ticket_number={{ event.properties.ticket_number | url_encode }}&distinct_id={{ event.properties.customer_distinct_id | url_encode }}&q0=2\" style=\"text-decoration: none;\">🙁</a>&nbsp; <a href=\"{{ variables.csat_survey_url }}?ticket_id={{ event.properties.ticket_id | url_encode }}&ticket_number={{ event.properties.ticket_number | url_encode }}&distinct_id={{ event.properties.customer_distinct_id | url_encode }}&q0=3\" style=\"text-decoration: none;\">😐</a>&nbsp; <a href=\"{{ variables.csat_survey_url }}?ticket_id={{ event.properties.ticket_id | url_encode }}&ticket_number={{ event.properties.ticket_number | url_encode }}&distinct_id={{ event.properties.customer_distinct_id | url_encode }}&q0=4\" style=\"text-decoration: none;\">🙂</a>&nbsp; <a href=\"{{ variables.csat_survey_url }}?ticket_id={{ event.properties.ticket_id | url_encode }}&ticket_number={{ event.properties.ticket_number | url_encode }}&distinct_id={{ event.properties.customer_distinct_id | url_encode }}&q0=5\" style=\"text-decoration: none;\">😍</a></p><p style=\"line-height: 140%;\">Click a face to rate us. It only takes a few seconds, and you can add a comment if you'd like.<br><br>Thanks,<br>The support team</p>\n  </div>\n\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!--[if (!mso)&(!IE)]><!--></div><!--<![endif]-->\n  </div>\n</div>\n<!--[if (mso)|(IE)]></td></tr></table></td><![endif]-->\n      <!--[if (mso)|(IE)]></tr></table></td></tr></table><![endif]-->\n    </div>\n  </div>\n</div>\n\n\n\n    <!--[if (mso)|(IE)]></td></tr></table></td></tr></table><![endif]-->\n    </td>\n  </tr>\n  </tbody>\n  </table>\n  <!--[if mso]></div><![endif]-->\n  <!--[if IE]></div><![endif]-->\n</body>\n\n</html>\n",
                            "design": {
                                "body": {
