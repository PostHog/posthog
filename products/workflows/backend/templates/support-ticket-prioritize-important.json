{
    "id": "01a1352a-0c41-0000-f15b-82c6d9a3e047",
    "name": "Ticket routing: prioritize important customers",
    "description": "When an important customer opens a ticket, set it to high priority, assign it to your lead or on-call person, and post to Slack.",
    "scope": "global",
    "tags": ["support", "support routing", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_created",
                    "name": "$conversation_ticket_created",
                    "type": "events",
                    "order": 0
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": null,
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "is_important",
            "type": "continue"
        },
        {
            "from": "is_important",
            "to": "prioritize",
            "type": "branch",
            "index": 0
        },
        {
            "from": "is_important",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "prioritize",
            "to": "slack_vip",
            "type": "continue"
        },
        {
            "from": "slack_vip",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "New ticket",
            "description": "Runs when a customer opens a ticket.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_created",
                            "name": "$conversation_ticket_created",
                            "type": "events",
                            "order": 0
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "is_important",
            "name": "Important customer?",
            "description": "Example using the person property 'plan'. Change it to match how you mark important customers, such as a cohort or a group property.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Enterprise",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "plan",
                                    "type": "person",
                                    "value": ["enterprise"],
                                    "operator": "exact"
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "prioritize",
            "name": "Set high priority and assign",
            "description": "Pick the lead, on-call person or team who should take these tickets.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "priority": {
                        "value": "high",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_vip",
            "name": "Post to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":rotating_light:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":rotating_light: New ticket *#{event.properties.ticket_number}* from an important customer\nFrom: {replaceAll(replaceAll(replaceAll(toString(event.properties.customer_email), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{event.properties.ticket_number}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "New ticket #{event.properties.ticket_number} from an important customer",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
