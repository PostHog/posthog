{
    "id": "01a1352a-0c41-0000-0d3a-6f84e1b7c259",
    "name": "Ticket routing: notify the account owner",
    "description": "When a customer opens a ticket, look up their account in Customer analytics. If the account has a CSM, tag the ticket with their name and post to Slack so they know their customer needs help.",
    "scope": "global",
    "tags": ["support", "support routing", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "$conversation_ticket_created",
                    "name": "$conversation_ticket_created",
                    "type": "events",
                    "order": 0
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": null,
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "get_account",
            "type": "continue"
        },
        {
            "from": "get_account",
            "to": "has_owner",
            "type": "continue"
        },
        {
            "from": "has_owner",
            "to": "tag",
            "type": "branch",
            "index": 0
        },
        {
            "from": "has_owner",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "tag",
            "to": "slack_owner",
            "type": "continue"
        },
        {
            "from": "slack_owner",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "New ticket",
            "description": "Runs when a customer opens a ticket.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "$conversation_ticket_created",
                            "name": "$conversation_ticket_created",
                            "type": "events",
                            "order": 0
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "get_account",
            "name": "Get account",
            "description": "Looks up the customer's account. Change 'organization' to your group type if it's named differently. If there's no account, the workflow carries on and skips the next steps.",
            "type": "function",
            "on_error": "continue",
            "filters": null,
            "config": {
                "template_id": "template-posthog-get-account",
                "inputs": {
                    "external_id": {
                        "value": "{groups.organization.id}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": {
                "key": "account",
                "result_path": "relationships"
            }
        },
        {
            "id": "has_owner",
            "name": "Has a CSM?",
            "description": "Uses the Customer analytics relationship named 'CSM'. Change it to 'Account executive', or another relationship you've set up, to notify someone else.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "CSM set",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "variables.account.CSM[1].email is not null",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "tag",
            "name": "Tag ticket with CSM",
            "description": "Adds a CSM_ tag, so you can filter tickets by account owner.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-posthog-update-ticket",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "tags": {
                        "value": ["CSM_{splitByString('@', variables.account.CSM[1].email)[1]}"],
                        "templating": "hog"
                    },
                    "tags_mode": {
                        "value": "add",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_owner",
            "name": "Post to Slack",
            "description": "Connect Slack and pick the channel your account owners watch.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":ticket:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":ticket: New ticket *#{toInt(event.properties.ticket_number)}* from {replaceAll(replaceAll(replaceAll(toString(groups.organization.properties.name ?? event.properties.customer_email), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\nCSM: {variables.account.CSM[1].email}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{toInt(event.properties.ticket_number)}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "New ticket #{toInt(event.properties.ticket_number)} from an account you look after",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
