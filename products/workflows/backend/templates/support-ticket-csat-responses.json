{
    "id": "01a1352a-0c41-0000-8e51-47f2d6b09c3a",
    "name": "Ticket CSAT: post responses to Slack and the ticket",
    "description": "When a customer completes the CSAT survey sent by the ticket CSAT templates, save their answers as a private note on the ticket. Post to Slack when they leave a comment or a low score. Assumes the survey's first question is the rating and the second is the comment.",
    "scope": "global",
    "tags": ["support", "support CSAT", "slack"],
    "version": 1,
    "created_at": "2026-10-13T00:00:00Z",
    "created_by": null,
    "updated_at": "2026-10-13T00:00:00Z",
    "trigger": {
        "type": "event",
        "filters": {
            "source": "events",
            "events": [
                {
                    "id": "survey sent",
                    "name": "survey sent",
                    "type": "events",
                    "order": 0,
                    "properties": [
                        {
                            "key": "$survey_completed",
                            "type": "event",
                            "value": ["true"],
                            "operator": "exact"
                        },
                        {
                            "key": "ticket_id",
                            "type": "event",
                            "value": "is_set",
                            "operator": "is_set"
                        }
                    ]
                }
            ],
            "filter_test_accounts": false
        }
    },
    "trigger_masking": null,
    "conversion": null,
    "exit_condition": "exit_only_at_end",
    "edges": [
        {
            "from": "trigger_node",
            "to": "note",
            "type": "continue"
        },
        {
            "from": "note",
            "to": "route",
            "type": "continue"
        },
        {
            "from": "route",
            "to": "slack_comment",
            "type": "branch",
            "index": 0
        },
        {
            "from": "route",
            "to": "slack_low",
            "type": "branch",
            "index": 1
        },
        {
            "from": "route",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "slack_comment",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "slack_low",
            "to": "exit_node",
            "type": "continue"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "CSAT survey completed",
            "description": "Runs when a survey reached from a ticket CSAT email is completed. To limit it to one survey, add a filter on the survey.",
            "type": "trigger",
            "on_error": null,
            "filters": null,
            "config": {
                "type": "event",
                "filters": {
                    "source": "events",
                    "events": [
                        {
                            "id": "survey sent",
                            "name": "survey sent",
                            "type": "events",
                            "order": 0,
                            "properties": [
                                {
                                    "key": "$survey_completed",
                                    "type": "event",
                                    "value": ["true"],
                                    "operator": "exact"
                                },
                                {
                                    "key": "ticket_id",
                                    "type": "event",
                                    "value": "is_set",
                                    "operator": "is_set"
                                }
                            ]
                        }
                    ],
                    "filter_test_accounts": false
                }
            },
            "output_variable": null
        },
        {
            "id": "note",
            "name": "Save to ticket as a private note",
            "description": "Only your team can see private notes.",
            "type": "function",
            "on_error": "continue",
            "filters": null,
            "config": {
                "template_id": "template-posthog-send-ticket-message",
                "inputs": {
                    "ticket_id": {
                        "value": "{event.properties.ticket_id}",
                        "templating": "hog"
                    },
                    "message": {
                        "value": "CSAT response\nScore: {toInt(event.properties['$survey_questions'][1].response)}\nComment: {substring(toString(event.properties['$survey_questions'][2].response ?? ''), 1, 4000)}",
                        "templating": "hog"
                    },
                    "is_private": {
                        "value": true,
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "route",
            "name": "Comment or low score?",
            "description": "Comments always post. Scores of 2 or lower post even without a comment. Change the number to fit your rating scale.",
            "type": "conditional_branch",
            "on_error": null,
            "filters": null,
            "config": {
                "conditions": [
                    {
                        "name": "Left a comment",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "length(trim(toString(ifNull(properties.$survey_questions[2].response, '')))) > 0",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    },
                    {
                        "name": "Score of 2 or lower",
                        "filters": {
                            "source": "events",
                            "properties": [
                                {
                                    "key": "toFloat(properties.$survey_questions[1].response) <= 2",
                                    "type": "hogql",
                                    "value": null
                                }
                            ]
                        }
                    }
                ]
            },
            "output_variable": null
        },
        {
            "id": "slack_comment",
            "name": "Post comment to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":star:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":star: New CSAT comment\nFrom: {replaceAll(replaceAll(replaceAll(toString(person.properties.email ?? event.distinct_id), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\nTicket: #{toInt(event.properties.ticket_number)}\nScore: {toInt(event.properties['$survey_questions'][1].response)}\nComment: {replaceAll(replaceAll(replaceAll(toString(substring(toString(event.properties['$survey_questions'][2].response), 1, 2000)), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{toInt(event.properties.ticket_number)}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "New CSAT comment on ticket #{toInt(event.properties.ticket_number)}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "slack_low",
            "name": "Post low score to Slack",
            "description": "Connect Slack and pick the channel your team watches.",
            "type": "function",
            "on_error": null,
            "filters": null,
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "slack_workspace": {
                        "templating": "hog"
                    },
                    "channel": {
                        "templating": "hog"
                    },
                    "icon_emoji": {
                        "value": ":warning:",
                        "templating": "hog"
                    },
                    "username": {
                        "value": "Support",
                        "templating": "hog"
                    },
                    "blocks": {
                        "value": [
                            {
                                "type": "section",
                                "text": {
                                    "type": "mrkdwn",
                                    "text": ":warning: Low CSAT score\nFrom: {replaceAll(replaceAll(replaceAll(toString(person.properties.email ?? event.distinct_id), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}\nTicket: #{toInt(event.properties.ticket_number)}\nScore: {toInt(event.properties['$survey_questions'][1].response)}"
                                }
                            },
                            {
                                "type": "actions",
                                "elements": [
                                    {
                                        "type": "button",
                                        "text": {
                                            "type": "plain_text",
                                            "text": "View ticket"
                                        },
                                        "url": "{splitByString('/workflows/', source.url)[1]}/support/tickets/{toInt(event.properties.ticket_number)}"
                                    }
                                ]
                            }
                        ],
                        "templating": "hog"
                    },
                    "text": {
                        "value": "Low CSAT score on ticket #{toInt(event.properties.ticket_number)}",
                        "templating": "hog"
                    }
                }
            },
            "output_variable": null
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "type": "exit",
            "on_error": null,
            "filters": null,
            "config": {
                "reason": "Done"
            },
            "output_variable": null
        }
    ],
    "abort_action": null,
    "variables": [],
    "billable_action_types": ["function"]
}
