{
    "_about": "AI decision step configs, each marked with whether a strict workflow save accepts it. Both the Django serializer tests and the Node runtime tests run every case, so a mocked or live run rejects exactly what a save rejects. A case starts from one of the bases, sets the keys in 'set' and removes the keys in 'unset'.",
    "bases": {
        "yes_no": {
            "question": "Is this a work email address?",
            "answer_type": "yes_no",
            "inputs": {
                "context": {
                    "value": {
                        "email": "{person.properties.email}"
                    }
                }
            }
        },
        "pick_one": {
            "question": "Which onboarding track fits this signup?",
            "answer_type": "pick_one",
            "options": [
                {
                    "name": "Developer",
                    "description": "Writes code against our API"
                },
                {
                    "name": "Marketer"
                }
            ],
            "inputs": {
                "context": {
                    "value": {
                        "answer": "{event.properties.signup_answer}"
                    }
                }
            }
        }
    },
