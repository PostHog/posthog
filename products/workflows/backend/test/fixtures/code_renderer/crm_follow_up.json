{
    "id": "0198e2c6-9b41-7f02-9d3e-5c1a8b7e2f44",
    "key": "crm-follow-up",
    "name": "CRM follow up",
    "description": "",
    "version": 5,
    "status": "draft",
    "trigger": {
        "type": "event",
        "filters": {
            "events": [
                {
                    "id": "checkout completed",
                    "name": "checkout completed",
                    "type": "events",
                    "order": 0,
                    "properties": [
                        {
                            "key": "total",
                            "operator": "gt",
                            "value": [100],
                            "type": "event"
                        }
                    ]
                }
            ],
            "properties": [],
            "filter_test_accounts": false
        }
    },
    "exit_condition": "exit_only_at_end",
    "variables": [],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Trigger",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "trigger",
            "config": {
                "type": "event",
                "filters": {
                    "events": [
                        {
                            "id": "checkout completed",
                            "name": "checkout completed",
                            "type": "events",
                            "order": 0,
                            "properties": [
                                {
                                    "key": "total",
                                    "operator": "gt",
                                    "value": [100],
                                    "type": "event"
                                }
                            ]
                        }
                    ],
                    "properties": [],
                    "filter_test_accounts": false
                }
            }
        },
        {
            "id": "tell_the_crm",
            "name": "Tell the CRM",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "function",
            "config": {
                "template_id": "template-webhook",
                "inputs": {
                    "url": {
                        "value": "https://example.com/hooks/crm",
                        "bytecode": ["_H", 1, 32, "https://example.com/hooks/crm"],
                        "order": 0
                    },
                    "method": {
                        "value": "POST",
                        "order": 1
                    },
                    "body": {
                        "value": {
                            "distinct_id": "{event.distinct_id}",
                            "plan": "{person.properties.plan}"
                        },
                        "order": 2
                    },
                    "signing_secret": {
                        "secret": true
                    }
                }
            }
        },
        {
            "id": "which_plan",
            "name": "Which plan?",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "conditional_branch",
            "config": {
                "conditions": [
                    {
                        "name": "Paid plan",
                        "filters": {
                            "properties": [
                                {
                                    "key": "plan",
                                    "operator": "exact",
                                    "value": ["pro"],
                                    "type": "person"
                                }
                            ],
                            "bytecode": ["_H", 1, 32, "pro", 32, "plan", 32, "properties", 32, "person", 1, 3, 11]
                        }
                    },
                    {
                        "name": "Came from pricing",
                        "filters": {
                            "properties": [
                                {
                                    "key": "$current_url",
                                    "operator": "icontains",
                                    "value": ["/pricing"],
                                    "type": "event"
                                }
                            ],
                            "bytecode": ["_H", 1, 32, "%/pricing%", 32, "$current_url", 32, "properties", 1, 2, 17]
                        }
                    }
                ]
            }
        },
        {
            "id": "give_sales_a_day",
            "name": "Give sales a day",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "delay",
            "config": {
                "delay_duration": "1d"
            }
        },
        {
            "id": "tell_the_crm_2",
            "name": "Tell the CRM",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "function",
            "config": {
                "template_id": "template-webhook",
                "inputs": {
                    "url": {
                        "value": "https://example.com/hooks/crm",
                        "bytecode": ["_H", 1, 32, "https://example.com/hooks/crm"],
                        "order": 0
                    },
                    "method": {
                        "value": "POST",
                        "order": 1
                    },
                    "body": {
                        "value": {
                            "distinct_id": "{event.distinct_id}",
                            "plan": "{person.properties.plan}"
                        },
                        "order": 2
                    },
                    "signing_secret": {
                        "secret": true
                    }
                }
            }
        },
        {
            "id": "wait_a_week",
            "name": "Wait a week",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "delay",
            "config": {
                "delay_duration": "7d"
            }
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "exit",
            "config": {
                "reason": "Handed to sales"
            }
        }
    ],
    "edges": [
        {
            "from": "trigger_node",
            "to": "tell_the_crm",
            "type": "continue"
        },
        {
            "from": "tell_the_crm",
            "to": "which_plan",
            "type": "continue"
        },
        {
            "from": "which_plan",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "give_sales_a_day",
            "to": "tell_the_crm_2",
            "type": "continue"
        },
        {
            "from": "tell_the_crm_2",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "which_plan",
            "to": "give_sales_a_day",
            "type": "branch",
            "index": 0
        },
        {
            "from": "wait_a_week",
            "to": "exit_node",
            "type": "continue"
        },
        {
            "from": "which_plan",
            "to": "wait_a_week",
            "type": "branch",
            "index": 1
        }
    ]
}
