{
    "id": "0198e2c6-b7c3-7a19-8e0f-2d6b4a9c1e77",
    "key": "weekly-digest",
    "name": "Weekly digest",
    "description": "Posts the weekly numbers to Slack.",
    "version": 2,
    "status": "active",
    "trigger": {
        "type": "schedule"
    },
    "exit_condition": "exit_on_trigger_not_matched",
    "variables": [
        {
            "key": "team_name",
            "type": "string",
            "default": "Example"
        },
        {
            "key": "retries",
            "type": "number",
            "default": "3"
        }
    ],
    "actions": [
        {
            "id": "trigger_node",
            "name": "Trigger",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "trigger",
            "config": {
                "type": "schedule"
            }
        },
        {
            "id": "post_digest",
            "name": "Post the digest",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "function",
            "config": {
                "template_id": "template-slack",
                "inputs": {
                    "channel": {
                        "value": "#digest",
                        "bytecode": ["_H", 1, 32, "#digest"],
                        "order": 0
                    },
                    "text": {
                        "value": "Weekly digest for {variables.team_name}",
                        "bytecode": ["_H", 1, 32, "Weekly digest for ", 32, "team_name", 32, "variables", 1, 2, 2, "concat", 2],
                        "order": 1
                    }
                }
            }
        },
        {
            "id": "wait_a_day",
            "name": "Wait a day",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "delay",
            "config": {
                "delay_duration": "1d"
            }
        },
        {
            "id": "exit_node",
            "name": "Exit",
            "description": "",
            "on_error": null,
            "filters": null,
            "type": "exit",
            "config": {
                "reason": "Posted"
            }
        }
    ],
    "edges": [
        {
            "from": "trigger_node",
            "to": "post_digest",
            "type": "continue"
        },
        {
            "from": "post_digest",
            "to": "wait_a_day",
            "type": "continue"
        },
        {
            "from": "wait_a_day",
            "to": "exit_node",
            "type": "continue"
        }
    ]
}
