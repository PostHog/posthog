{
    "extends": ["//"],
    "tasks": {
        "backend:test": {
            "inputs": [
                "backend/**/*.py",
                "backend/templates/**",
                "!backend/**/__pycache__/**",
                "../../pyproject.toml",
                "../../uv.lock",
                "../../common/**/*.py",
                // The runner and its ignore list decide which tests every product runs, so a change to them
                // marks every product affected, also on a PR whose earlier full run already passed.
                "../../.github/scripts/run-product-tests.sh",
                "../../.github/scripts/product-tests-owned-elsewhere.txt"
            ]
        },
        "backend:contract-check": {
            "inputs": [
                "backend/facade/**",
                "backend/presentation/**",
                "backend/temporal/**",
                "backend/tasks/**",
                "backend/models.py",
                "backend/migrations/**",
                "backend/signals.py",
                "backend/apps.py",
                "backend/console.py",
                "backend/admin/**",
                "backend/common.py",
                "backend/duckgres_availability.py",
                "backend/logic/ducklake_copy.py",
                "backend/logic/sql_editor.py",
                "backend/logic/sql_editor_credentials.py",
                "backend/metrics.py",
                "backend/service_credentials.py",
                "dags/groups_backfill.py",
                "dags/trino_conversion.py"
            ],
            "outputs": [],
            "cache": true
        }
    }
}
