{
    "name": "Process metrics",
    "description": "CPU, memory, threads and context switches of services that send OpenTelemetry process metrics, with a section for each language runtime.",
    "panels": [
        {
            "key": "right_now",
            "title": "",
            "text": "## Right now\nCPU, memory and threads across all services.",
            "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 2
            }
        },
        {
            "key": "cpu_now",
            "title": "CPU cores used",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.cpu.time",
                        "aggregation": "rate"
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "cores",
                    "reduce": "last"
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 2
            }
        },
        {
            "key": "memory_now",
            "title": "Resident memory",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.memory.usage",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "By",
                    "reduce": "last"
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 4,
                "y": 2,
                "w": 4,
                "h": 2
            }
        },
        {
            "key": "threads_now",
            "title": "Threads",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.thread.count",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "last"
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 8,
                "y": 2,
                "w": 4,
                "h": 2
            }
        },
        {
            "key": "which_service",
            "title": "",
            "text": "## Which service?\nThe CPU, memory and threads each service and instance uses.",
            "layout": {
                "x": 0,
                "y": 4,
                "w": 12,
                "h": 2
            }
        },
        {
            "key": "cpu_by_service",
            "title": "CPU by service",
            "description": "CPU cores each service uses, split into user and system time.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.cpu.time",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "service_name"
                            },
                            {
                                "key": "cpu.mode"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "area",
                    "unit": "cores",
                    "legendCalcs": ["mean", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 0,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "cpu_share_by_service",
            "title": "CPU share of host by service",
            "description": "CPU each service uses as a share of all host CPUs. 100% means every core is busy.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.cpu.utilization",
                        "aggregation": "avg",
                        "groupBy": [
                            {
                                "key": "service_name"
                            },
                            {
                                "key": "cpu.mode"
                            }
                        ]
                    }
                ],
                "formula": "a * 100",
                "display": {
                    "type": "area",
                    "unit": "%",
                    "legendCalcs": ["mean", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 6,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "memory_by_instance",
            "title": "Resident memory by instance",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.memory.usage",
                        "aggregation": "sum",
                        "groupBy": [
                            {
                                "key": "service_name"
                            },
                            {
                                "key": "service.instance.id"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "By",
                    "legendCalcs": ["last", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 0,
                "y": 10,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "memory_share_by_service",
            "title": "Memory share of host by service",
            "description": "Resident memory of each service as a share of the host's physical memory.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.memory.utilization",
                        "aggregation": "max",
                        "groupBy": [
                            {
                                "key": "service_name"
                            }
                        ]
                    }
                ],
                "formula": "a * 100",
                "display": {
                    "type": "line",
                    "unit": "%",
                    "legendCalcs": ["last", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 6,
                "y": 10,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "threads_by_instance",
            "title": "Threads by instance",
            "description": "Native threads, including threads that native extensions start.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.thread.count",
                        "aggregation": "sum",
                        "groupBy": [
                            {
                                "key": "service_name"
                            },
                            {
                                "key": "service.instance.id"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "legendCalcs": ["last", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 0,
                "y": 14,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "context_switches_by_service",
            "title": "Context switches by service",
            "description": "How often each service was switched off the CPU. Involuntary switches mean it was waiting for a CPU.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.context_switches",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "service_name"
                            },
                            {
                                "key": "process.context_switch.type"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "legendCalcs": ["mean", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 6,
                "y": 14,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "python",
            "title": "",
            "text": "## Python\nGarbage collection of CPython services. Delete this section if you don't run Python.",
            "layout": {
                "x": 0,
                "y": 18,
                "w": 12,
                "h": 2
            }
        },
        {
            "key": "python_gc_collections",
            "title": "GC collections by generation",
            "description": "Garbage collections each second. A rise in generation 2 often means memory is growing.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "cpython.gc.collections",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "cpython.gc.generation"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "legendCalcs": ["mean", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 0,
                "y": 20,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "python_gc_collected",
            "title": "GC collected objects by generation",
            "description": "Objects the garbage collector frees each second. This is GC activity, not heap size.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "cpython.gc.collected_objects",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "cpython.gc.generation"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "legendCalcs": ["mean", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 6,
                "y": 20,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "python_gc_uncollectable",
            "title": "Uncollectable objects by service",
            "description": "Objects the garbage collector found but could not free. Any steady rise is a leak.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "cpython.gc.uncollectable_objects",
                        "aggregation": "increase",
                        "groupBy": [
                            {
                                "key": "service_name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "legendCalcs": ["last", "max"]
                },
                "dateRange": {
                    "date_from": "-1h"
                }
            },
            "layout": {
                "x": 0,
                "y": 24,
                "w": 12,
                "h": 4
            }
        }
    ]
}
