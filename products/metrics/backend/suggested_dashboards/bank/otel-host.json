{
    "name": "APM",
    "description": "CPU and memory of hosts and processes that export OpenTelemetry system and process metrics.",
    "panels": [
        {
            "key": "section_now",
            "title": "Right now",
            "text": "## Right now\nEach tile shows the worst host or service right now. The lists below rank every host by its peak in the selected range.",
            "layout": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 1
            }
        },
        {
            "key": "cpu_busy_now",
            "title": "CPU busy (worst host)",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "cpu.mode",
                                "op": "eq",
                                "value": "idle"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "(1 - a / b) * 100",
                "display": {
                    "type": "stat",
                    "unit": "%",
                    "reduce": "last",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 70
                        },
                        {
                            "color": "danger",
                            "value": 90
                        }
                    ],
                    "combineSeries": "max",
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 1,
                "w": 3,
                "h": 3
            },
            "description": "The busiest host right now."
        },
        {
            "key": "memory_used_now",
            "title": "Memory used (worst host)",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.memory.usage",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "system.memory.state",
                                "op": "eq",
                                "value": "used"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.memory.usage",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "system.memory.state",
                                "op": "not_regex",
                                "value": "slab_.*"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / b * 100",
                "display": {
                    "type": "stat",
                    "unit": "%",
                    "reduce": "last",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 75
                        },
                        {
                            "color": "danger",
                            "value": 90
                        }
                    ],
                    "combineSeries": "max",
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 3,
                "y": 1,
                "w": 3,
                "h": 3
            },
            "description": "The host closest to running out of memory."
        },
        {
            "key": "memory_pressure_now",
            "title": "Major page faults (worst host)",
            "description": "Pages read from disk each second because they were not in memory. The thresholds are starting points to tune for your hosts.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.paging.faults",
                        "aggregation": "avg",
                        "rangeFunction": "rate",
                        "filters": [
                            {
                                "key": "system.paging.fault.type",
                                "op": "eq",
                                "value": "major"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "{fault}/s",
                    "reduce": "last",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 10
                        },
                        {
                            "color": "danger",
                            "value": 100
                        }
                    ],
                    "combineSeries": "max",
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 6,
                "y": 1,
                "w": 3,
                "h": 3
            }
        },
        {
            "key": "shortest_uptime_now",
            "title": "Shortest uptime",
            "description": "The service that started most recently. Red means it restarted in the last 10 minutes.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.uptime",
                        "aggregation": "min",
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / 3600",
                "display": {
                    "type": "stat",
                    "unit": "h",
                    "reduce": "last",
                    "thresholds": [
                        {
                            "color": "danger",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 0.17
                        },
                        {
                            "color": "success",
                            "value": 1
                        }
                    ],
                    "combineSeries": "min",
                    "legendFormat": "{{service.name}} \u00b7 {{host.name}}"
                }
            },
            "layout": {
                "x": 9,
                "y": 1,
                "w": 3,
                "h": 3
            }
        },
        {
            "key": "cpu_busy_top",
            "title": "Peak CPU busy",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "cpu.mode",
                                "op": "eq",
                                "value": "idle"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "(1 - a / b) * 100",
                "display": {
                    "type": "bargauge",
                    "unit": "%",
                    "reduce": "max",
                    "yAxis": {
                        "min": 0,
                        "max": 100
                    },
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 70
                        },
                        {
                            "color": "danger",
                            "value": 90
                        }
                    ],
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4
            },
            "description": "Each host's highest value in the selected range."
        },
        {
            "key": "memory_used_top",
            "title": "Peak memory used",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.memory.usage",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "system.memory.state",
                                "op": "eq",
                                "value": "used"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.memory.usage",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "system.memory.state",
                                "op": "not_regex",
                                "value": "slab_.*"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / b * 100",
                "display": {
                    "type": "bargauge",
                    "unit": "%",
                    "reduce": "max",
                    "yAxis": {
                        "min": 0,
                        "max": 100
                    },
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 75
                        },
                        {
                            "color": "danger",
                            "value": 90
                        }
                    ],
                    "legendFormat": "{{host.name}}"
                },
                "interval": "minute"
            },
            "layout": {
                "x": 4,
                "y": 4,
                "w": 4,
                "h": 4
            },
            "description": "Each host's highest value in the selected range."
        },
        {
            "key": "major_faults_top",
            "title": "Peak major page faults",
            "description": "Each host's highest value in the selected range.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.paging.faults",
                        "aggregation": "avg",
                        "rangeFunction": "rate",
                        "filters": [
                            {
                                "key": "system.paging.fault.type",
                                "op": "eq",
                                "value": "major"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "bargauge",
                    "unit": "{fault}/s",
                    "reduce": "max",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 10
                        },
                        {
                            "color": "danger",
                            "value": 100
                        }
                    ],
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 8,
                "y": 4,
                "w": 4,
                "h": 4
            }
        },
        {
            "key": "section_waiting",
            "title": "Is anything waiting?",
            "text": "## Is anything waiting?\nSigns that work waits for a CPU, the disk or memory.",
            "layout": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 1
            }
        },
        {
            "key": "cpu_waiting_by_service",
            "title": "CPU waits by service",
            "description": "How often the system paused this service to run something else. A rise means it is competing for CPU.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.context_switches",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "process.context_switch.type",
                                "op": "eq",
                                "value": "involuntary"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "{switch}/s",
                    "legendCalcs": ["mean", "max"],
                    "legendFormat": "{{service.name}} \u00b7 {{host.name}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 9,
                "w": 4,
                "h": 4
            }
        },
        {
            "key": "runnable_per_core_by_host",
            "title": "Runnable processes per core",
            "description": "Processes ready to run, per CPU core. More than 1 means some of them wait for a CPU.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.process.count",
                        "aggregation": "avg",
                        "filters": [
                            {
                                "key": "process.state",
                                "op": "eq",
                                "value": "running"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.cpu.logical.count",
                        "aggregation": "avg",
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / b",
                "display": {
                    "type": "line",
                    "goalLines": [
                        {
                            "label": "1 runnable process per core",
                            "value": 1
                        }
                    ],
                    "legendCalcs": ["last", "max"],
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 4,
                "y": 9,
                "w": 4,
                "h": 4
            }
        },
        {
            "key": "cpu_wait_steal",
            "title": "CPU waiting (I/O + steal)",
            "description": "Share of each host's CPU time spent waiting on disk or on the hypervisor.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "cpu.mode",
                                "op": "regex",
                                "value": "iowait|steal"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / b * 100",
                "display": {
                    "type": "line",
                    "unit": "%",
                    "legendFormat": "{{host.name}}",
                    "legendCalcs": ["mean", "max"]
                }
            },
            "layout": {
                "x": 8,
                "y": 9,
                "w": 4,
                "h": 4
            }
        },
        {
            "key": "major_faults_by_service",
            "title": "Major page faults by service",
            "description": "Pages each service had to read from disk because they were not in memory. A spike means the host is short of memory.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.paging.faults",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "system.paging.fault.type",
                                "op": "eq",
                                "value": "major"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "{fault}/s",
                    "legendCalcs": ["last", "max"],
                    "legendFormat": "{{service.name}} \u00b7 {{host.name}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 13,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "swap_ins_by_host",
            "title": "Swap-ins by host",
            "description": "Pages read back from swap each second. A rate that stays high means the host is thrashing and spends its time moving memory to and from disk.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.paging.operations",
                        "aggregation": "avg",
                        "rangeFunction": "rate",
                        "filters": [
                            {
                                "key": "system.paging.direction",
                                "op": "eq",
                                "value": "in"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "{page}/s",
                    "legendCalcs": ["last", "max"],
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 6,
                "y": 13,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "section_service",
            "title": "Which service?",
            "text": "## Which service?\nWhich service uses the CPU and memory on each host, and when each one last restarted.",
            "layout": {
                "x": 0,
                "y": 17,
                "w": 12,
                "h": 1
            }
        },
        {
            "key": "process_cpu_by_service",
            "title": "Process CPU by service and host",
            "description": "CPU cores each service uses on each host.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.cpu.time",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "legendCalcs": ["mean", "max"],
                    "legendFormat": "{{service.name}} \u00b7 {{host.name}}",
                    "unit": "cores"
                }
            },
            "layout": {
                "x": 0,
                "y": 18,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "process_memory_by_service",
            "title": "Process memory by service and host",
            "description": "Resident memory of each service on each host.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.memory.usage",
                        "aggregation": "sum",
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "By",
                    "legendCalcs": ["last", "max"],
                    "legendFormat": "{{service.name}} \u00b7 {{host.name}}"
                }
            },
            "layout": {
                "x": 6,
                "y": 18,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "process_uptime_by_service",
            "title": "Process uptime by service and host",
            "description": "How long each service has run since it last started. A drop to zero is a restart. The collector's process scraper sends process.uptime only when you enable it.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.uptime",
                        "aggregation": "min",
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / 3600",
                "display": {
                    "type": "line",
                    "unit": "h",
                    "legendCalcs": ["last", "min"],
                    "legendFormat": "{{service.name}} \u00b7 {{host.name}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 22,
                "w": 12,
                "h": 3
            }
        },
        {
            "key": "section_worse",
            "title": "Is it getting worse?",
            "text": "## Is it getting worse?\nTrends over the selected range, and whether a new version changed them.",
            "layout": {
                "x": 0,
                "y": 25,
                "w": 12,
                "h": 1
            }
        },
        {
            "key": "memory_used_by_host",
            "title": "Memory used by host",
            "description": "One-minute buckets, so a peak shows at its real height.",
            "query": {
                "kind": "MetricsQuery",
                "interval": "minute",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.memory.usage",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "system.memory.state",
                                "op": "eq",
                                "value": "used"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.memory.usage",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "system.memory.state",
                                "op": "not_regex",
                                "value": "slab_.*"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "a / b * 100",
                "display": {
                    "type": "line",
                    "unit": "%",
                    "yAxis": {
                        "min": 0,
                        "max": 100,
                        "startAtZero": true
                    },
                    "goalLines": [
                        {
                            "label": "OOM risk",
                            "value": 90
                        }
                    ],
                    "legendCalcs": ["last", "max"],
                    "legendFormat": "{{host.name}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 26,
                "w": 12,
                "h": 4
            }
        },
        {
            "key": "process_memory_by_version",
            "title": "Process memory by version",
            "description": "Average resident memory of one process of each version. Compare a new version with the one before it.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.memory.usage",
                        "aggregation": "avg",
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "service.version"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "By",
                    "legendCalcs": ["last", "max"],
                    "legendFormat": "{{service.name}} {{service.version}}"
                }
            },
            "layout": {
                "x": 0,
                "y": 30,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "process_cpu_by_version",
            "title": "Process CPU by version",
            "description": "Average CPU cores used by one process of each version.",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process.cpu.time",
                        "aggregation": "avg",
                        "rangeFunction": "rate",
                        "groupBy": [
                            {
                                "key": "service.name"
                            },
                            {
                                "key": "service.version"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "cores",
                    "legendCalcs": ["mean", "max"],
                    "legendFormat": "{{service.name}} {{service.version}}"
                }
            },
            "layout": {
                "x": 6,
                "y": 30,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "section_host",
            "title": "Host detail",
            "text": "## Host detail\nThe per-host breakdown of CPU and memory.",
            "layout": {
                "x": 0,
                "y": 34,
                "w": 12,
                "h": 1
            }
        },
        {
            "key": "cpu_busy_by_host",
            "title": "CPU busy by host",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "cpu.mode",
                                "op": "eq",
                                "value": "idle"
                            }
                        ],
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "system.cpu.time",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "host.name"
                            }
                        ]
                    }
                ],
                "formula": "(1 - a / b) * 100",
                "display": {
                    "type": "line",
                    "unit": "%",
                    "yAxis": {
                        "min": 0,
                        "max": 100,
                        "startAtZero": true
                    },
                    "goalLines": [
