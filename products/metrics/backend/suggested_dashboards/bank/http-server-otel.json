        {
            "key": "latency_distribution",
            "title": "Latency distribution",
            "query": {
                "kind": "MetricsHistogramQuery",
                "metricName": "http.server.request.duration",
                "unit": "s"
            },
            "layout": {
                "x": 0,
                "y": 10,
                "w": 12,
                "h": 5
            }
        }
    ]
}
