{
    "name": "Kubernetes workloads",
    "description": "Pods, restarts, CPU, memory and network of Kubernetes workloads from cAdvisor and kube-state-metrics.",
    "panels": [
        {
            "key": "running_pods",
            "title": "Running pods",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "kube_pod_status_phase",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "phase",
                                "op": "eq",
                                "value": "Running"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "restarts",
            "title": "Container restarts",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "kube_pod_container_status_restarts_total",
                        "aggregation": "increase"
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "sum",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 1
                        },
                        {
                            "color": "danger",
                            "value": 10
                        }
                    ]
                }
            },
            "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "cpu",
            "title": "CPU cores used",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "container_cpu_usage_seconds_total",
                        "aggregation": "rate"
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 6,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "memory",
            "title": "Memory working set",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "container_memory_working_set_bytes",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "By",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 9,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "cpu_by_namespace",
            "title": "CPU by namespace",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "container_cpu_usage_seconds_total",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "namespace"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "area"
                }
            },
            "layout": {
                "x": 0,
                "y": 2,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "memory_by_namespace",
            "title": "Memory by namespace",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "container_memory_working_set_bytes",
                        "aggregation": "sum",
                        "groupBy": [
                            {
                                "key": "namespace"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "area",
                    "unit": "By"
                }
            },
            "layout": {
                "x": 6,
                "y": 2,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "restarts_by_pod",
            "title": "Restarts by pod",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "kube_pod_container_status_restarts_total",
                        "aggregation": "increase",
                        "groupBy": [
                            {
                                "key": "pod"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "bar"
                }
            },
            "layout": {
                "x": 0,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "network",
            "title": "Network traffic",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "received",
                        "metricName": "container_network_receive_bytes_total",
                        "aggregation": "rate"
                    },
                    {
                        "name": "sent",
                        "metricName": "container_network_transmit_bytes_total",
                        "aggregation": "rate"
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "By/s"
                }
            },
            "layout": {
                "x": 6,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "replicas",
            "title": "Deployment replicas",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "available",
                        "metricName": "kube_deployment_status_replicas_available",
                        "aggregation": "sum"
                    },
                    {
                        "name": "desired",
                        "metricName": "kube_deployment_spec_replicas",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "line"
                }
            },
            "layout": {
                "x": 0,
                "y": 10,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "pods_by_phase",
            "title": "Pods by phase",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "kube_pod_status_phase",
                        "aggregation": "sum",
                        "groupBy": [
                            {
                                "key": "phase"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "area"
                }
            },
            "layout": {
                "x": 6,
                "y": 10,
                "w": 6,
                "h": 4
            }
        }
    ]
}
