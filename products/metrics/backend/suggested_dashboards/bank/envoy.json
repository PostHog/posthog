{
    "name": "Envoy proxy",
    "description": "Upstream traffic, errors, latency and connections of Envoy clusters.",
    "variables": [
        {
            "name": "instance",
            "label": "Instance",
            "source": "sql",
            "query": "SELECT DISTINCT attribute_value FROM posthog.metric_attributes WHERE attribute_key = 'instance' AND time_bucket >= toStartOfHour($__from) AND time_bucket < $__to",
            "multi": false,
            "includeAll": true,
            "current": {
                "values": [],
                "all": true
            }
        }
    ],
    "panels": [
        {
            "key": "requests",
            "title": "Upstream requests",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_rq_total",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "{req}/s",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "error_ratio",
            "title": "Upstream 5xx ratio",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_rq_xx",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "envoy_response_code_class",
                                "op": "eq",
                                "value": "5"
                            },
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    },
                    {
                        "name": "b",
                        "metricName": "envoy_cluster_upstream_rq_total",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "%",
                    "reduce": "last",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 1
                        },
                        {
                            "color": "danger",
                            "value": 5
                        }
                    ]
                },
                "formula": "a / b * 100"
            },
            "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "active_connections",
            "title": "Active upstream connections",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_cx_active",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 6,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "healthy_hosts",
            "title": "Healthy upstream hosts",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_membership_healthy",
                        "aggregation": "sum",
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 9,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "requests_by_cluster",
            "title": "Requests by cluster",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_rq_total",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "envoy_cluster_name"
                            }
                        ],
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "{req}/s"
                }
            },
            "layout": {
                "x": 0,
                "y": 2,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "latency_p95",
            "title": "p95 upstream latency by cluster",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_rq_time",
                        "aggregation": "histogram_quantile",
                        "quantile": 0.95,
                        "groupBy": [
                            {
                                "key": "envoy_cluster_name"
                            }
                        ],
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "ms"
                }
            },
            "layout": {
                "x": 6,
                "y": 2,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "responses_by_class",
            "title": "Responses by status class",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_rq_xx",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "envoy_response_code_class"
                            }
                        ],
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "area",
                    "unit": "{req}/s"
                }
            },
            "layout": {
                "x": 0,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "retries_timeouts",
            "title": "Retries and timeouts",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "retries",
                        "metricName": "envoy_cluster_upstream_rq_retry",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    },
                    {
                        "name": "timeouts",
                        "metricName": "envoy_cluster_upstream_rq_timeout",
                        "aggregation": "rate",
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "{req}/s"
                }
            },
            "layout": {
                "x": 6,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "downstream_requests",
            "title": "Downstream requests by listener",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_http_downstream_rq_total",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "envoy_http_conn_manager_prefix"
                            }
                        ],
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "{req}/s"
                }
            },
            "layout": {
                "x": 0,
                "y": 10,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "connect_failures",
            "title": "Upstream connect failures",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "envoy_cluster_upstream_cx_connect_fail",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "envoy_cluster_name"
                            }
                        ],
                        "filters": [
                            {
                                "key": "instance",
                                "op": "eq",
                                "value": "$instance"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line"
                }
            },
            "layout": {
                "x": 6,
                "y": 10,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "latency_distribution",
            "title": "Upstream latency distribution",
            "query": {
                "kind": "MetricsHistogramQuery",
                "metricName": "envoy_cluster_upstream_rq_time",
                "unit": "ms",
                "filters": [
                    {
                        "key": "instance",
                        "op": "eq",
                        "value": "$instance"
                    }
                ]
            },
            "layout": {
                "x": 0,
                "y": 14,
                "w": 12,
                "h": 5
            }
        }
    ]
}
