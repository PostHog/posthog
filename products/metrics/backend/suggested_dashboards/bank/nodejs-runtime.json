{
    "name": "Node.js runtime",
    "description": "Event loop lag, heap, garbage collection and CPU of Node.js services that export prom-client metrics.",
    "panels": [
        {
            "key": "eventloop_p99",
            "title": "Event loop lag p99",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "nodejs_eventloop_lag_p99_seconds",
                        "aggregation": "max"
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "s",
                    "reduce": "last",
                    "thresholds": [
                        {
                            "color": "success",
                            "value": 0
                        },
                        {
                            "color": "warning",
                            "value": 0.1
                        },
                        {
                            "color": "danger",
                            "value": 0.5
                        }
                    ]
                }
            },
            "layout": {
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "heap_used",
            "title": "Heap used",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "nodejs_heap_size_used_bytes",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "By",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 3,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "rss",
            "title": "Resident memory",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process_resident_memory_bytes",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "stat",
                    "unit": "By",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 6,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "cpu",
            "title": "CPU cores used",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process_cpu_seconds_total",
                        "aggregation": "rate"
                    }
                ],
                "display": {
                    "type": "stat",
                    "reduce": "last"
                }
            },
            "layout": {
                "x": 9,
                "y": 0,
                "w": 3,
                "h": 2
            }
        },
        {
            "key": "eventloop_lag",
            "title": "Event loop lag",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "p50",
                        "metricName": "nodejs_eventloop_lag_p50_seconds",
                        "aggregation": "max"
                    },
                    {
                        "name": "p90",
                        "metricName": "nodejs_eventloop_lag_p90_seconds",
                        "aggregation": "max"
                    },
                    {
                        "name": "p99",
                        "metricName": "nodejs_eventloop_lag_p99_seconds",
                        "aggregation": "max"
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "s"
                }
            },
            "layout": {
                "x": 0,
                "y": 2,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "heap",
            "title": "Heap used and total",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "used",
                        "metricName": "nodejs_heap_size_used_bytes",
                        "aggregation": "sum"
                    },
                    {
                        "name": "total",
                        "metricName": "nodejs_heap_size_total_bytes",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "By"
                }
            },
            "layout": {
                "x": 6,
                "y": 2,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "heap_spaces",
            "title": "Heap used by space",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "nodejs_heap_space_size_used_bytes",
                        "aggregation": "sum",
                        "groupBy": [
                            {
                                "key": "space"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "area",
                    "unit": "By"
                }
            },
            "layout": {
                "x": 0,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "gc_p95",
            "title": "GC pause p95 by kind",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "nodejs_gc_duration_seconds",
                        "aggregation": "histogram_quantile",
                        "quantile": 0.95,
                        "groupBy": [
                            {
                                "key": "kind"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line",
                    "unit": "s"
                }
            },
            "layout": {
                "x": 6,
                "y": 6,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "handles",
            "title": "Active handles and requests",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "handles",
                        "metricName": "nodejs_active_handles_total",
                        "aggregation": "sum"
                    },
                    {
                        "name": "requests",
                        "metricName": "nodejs_active_requests_total",
                        "aggregation": "sum"
                    }
                ],
                "display": {
                    "type": "line"
                }
            },
            "layout": {
                "x": 0,
                "y": 10,
                "w": 6,
                "h": 4
            }
        },
        {
            "key": "cpu_by_service",
            "title": "CPU by service",
            "query": {
                "kind": "MetricsQuery",
                "clauses": [
                    {
                        "name": "a",
                        "metricName": "process_cpu_seconds_total",
                        "aggregation": "rate",
                        "groupBy": [
                            {
                                "key": "service_name"
                            }
                        ]
                    }
                ],
                "display": {
                    "type": "line"
                }
            },
            "layout": {
                "x": 6,
                "y": 10,
                "w": 6,
                "h": 4
            }
        }
    ]
}
