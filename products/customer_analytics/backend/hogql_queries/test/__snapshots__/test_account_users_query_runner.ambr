# serializer version: 1
# name: TestMembershipSchema.test_source_resolves_current_mappings_and_binds_account_key
  '''
  SELECT pdi.person_id AS person_id,
         groupUniqArray(101)(membership.distinct_id) AS distinct_ids,
         min(membership.first_seen) AS account_first_seen,
         max(membership.last_seen) AS account_last_seen
  FROM
    (SELECT person_group_membership.distinct_id AS distinct_id,
            toTimeZone(person_group_membership.first_seen, %(hogql_val_0)s) AS first_seen,
            toTimeZone(person_group_membership.last_seen, %(hogql_val_1)s) AS last_seen
     FROM person_group_membership
     WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_2)s))) AS membership
  INNER JOIN
    (SELECT argMax(person_distinct_id2.person_id, person_distinct_id2.version) AS person_id,
            person_distinct_id2.distinct_id AS distinct_id
     FROM person_distinct_id2
     WHERE and(equals(person_distinct_id2.team_id, 99999), globalIn(person_distinct_id2.distinct_id,
                                                                      (SELECT distinct_id AS distinct_id
                                                                       FROM
                                                                         (SELECT person_group_membership.distinct_id AS distinct_id, toTimeZone(person_group_membership.first_seen, %(hogql_val_3)s) AS first_seen, toTimeZone(person_group_membership.last_seen, %(hogql_val_4)s) AS last_seen
                                                                          FROM person_group_membership
                                                                          WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_5)s))))))
     GROUP BY person_distinct_id2.distinct_id
     HAVING equals(argMax(person_distinct_id2.is_deleted, person_distinct_id2.version), 0)) AS pdi ON equals(membership.distinct_id, pdi.distinct_id)
  GROUP BY pdi.person_id
  LIMIT 50000
  '''
# ---
