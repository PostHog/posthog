  '''
  SELECT pdi.person_id AS person_id,
         groupUniqArray(101)(membership.distinct_id) AS distinct_ids,
         min(toTimeZone(membership.first_seen, %(hogql_val_1)s)) AS account_first_seen,
         max(toTimeZone(membership.last_seen, %(hogql_val_2)s)) AS account_last_seen
  FROM person_group_membership AS membership GLOBAL
  INNER JOIN
    (SELECT argMax(person_distinct_id2.person_id, person_distinct_id2.version) AS person_id,
            person_distinct_id2.distinct_id AS distinct_id
     FROM person_distinct_id2
     WHERE and(equals(person_distinct_id2.team_id, 99999), in(person_distinct_id2.distinct_id,
                                                                (SELECT person_group_membership.distinct_id AS distinct_id
                                                                 FROM person_group_membership
                                                                 WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_0)s)))))
     GROUP BY person_distinct_id2.distinct_id
     HAVING equals(argMax(person_distinct_id2.is_deleted, person_distinct_id2.version), 0)) AS pdi ON equals(membership.distinct_id, pdi.distinct_id)
  WHERE and(equals(membership.team_id, 99999), equals(membership.group_type_index, 0), equals(membership.group_key, %(hogql_val_3)s))
