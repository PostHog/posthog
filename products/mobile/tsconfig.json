{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "types": ["jest"]
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "ios", "android", "dist"]
}
