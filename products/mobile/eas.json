{
    "cli": {
        "version": ">= 16.28.0",
        "appVersionSource": "remote"
    },
    "build": {
        "base": {
            "node": "24.13.0",
            "pnpm": "10.23.0"
        },
        "development": {
            "extends": "base",
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "environment": "development"
        },
        "preview": {
            "extends": "base",
            "distribution": "internal",
            "channel": "preview",
            "environment": "preview"
        },
        "production": {
            "extends": "base",
            "autoIncrement": true,
            "channel": "production",
            "environment": "production",
            "android": {
                "buildType": "app-bundle"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6762366098"
            },
            "android": {
                "track": "internal"
            }
        }
    }
}
