<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="SecureStore" />
    <exclude domain="sharedpref" path="chart_widget.xml" />
    <exclude domain="sharedpref" path="chart_widget_secure.xml" />
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="." />
