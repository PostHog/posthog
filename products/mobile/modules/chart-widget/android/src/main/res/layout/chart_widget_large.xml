<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/chart_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/chart_widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="@dimen/chart_widget_padding">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="5dp"
      android:layout_height="5dp"
      android:importantForAccessibility="no"
      android:src="@drawable/chart_widget_dot" />

    <TextView
      android:id="@+id/chart_title"
      style="@style/ChartWidgetText.Title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1" />
    <TextView android:id="@+id/chart_age_inline" style="@style/ChartWidgetText.Footer"
      android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/chart_value_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/chart_value"
      style="@style/ChartWidgetText.Value"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />

    <TextView
      android:id="@+id/chart_delta"
      style="@style/ChartWidgetText.Pill"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp" />

    <TextView
      android:id="@+id/chart_basis"
      style="@style/ChartWidgetText.Meta"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1" />
  </LinearLayout>

  <TextView
    android:id="@+id/chart_legend"
    style="@style/ChartWidgetText.Meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:visibility="gone" />

  <FrameLayout
    android:id="@+id/chart_frame"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1">
      <ImageView
        android:id="@+id/chart_image_light"
        style="@style/ChartWidgetChartImage"
        android:visibility="@integer/chart_widget_light_visibility" />
      <ImageView
        android:id="@+id/chart_image_dark"
        style="@style/ChartWidgetChartImage"
        android:visibility="@integer/chart_widget_dark_visibility" />
  </FrameLayout>

  <LinearLayout
    android:id="@+id/chart_axis"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/chart_axis_start"
      style="@style/ChartWidgetText.Footer"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/chart_axis_end"
      style="@style/ChartWidgetText.Footer"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/chart_tiles"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:id="@+id/chart_tile_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:background="@drawable/chart_widget_tile_background"
      android:orientation="vertical"
      android:padding="@dimen/chart_widget_tile_padding">

      <TextView
        android:id="@+id/chart_tile_1_title"
        style="@style/ChartWidgetText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <TextView
        android:id="@+id/chart_tile_1_range"
        style="@style/ChartWidgetText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/chart_tile_1_value"
          style="@style/ChartWidgetText.Value.Tile"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

        <TextView
          android:id="@+id/chart_tile_1_delta"
          style="@style/ChartWidgetText.Pill"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/chart_tile_1_frame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chart_widget_tile_sparkline_height"
        android:layout_marginTop="6dp">
        <ImageView
          android:id="@+id/chart_tile_1_image_light"
          style="@style/ChartWidgetChartImage"
          android:visibility="@integer/chart_widget_light_visibility" />
        <ImageView
          android:id="@+id/chart_tile_1_image_dark"
          style="@style/ChartWidgetChartImage"
          android:visibility="@integer/chart_widget_dark_visibility" />
      </FrameLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/chart_tile_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="@dimen/chart_widget_tile_gap"
      android:background="@drawable/chart_widget_tile_background"
      android:orientation="vertical"
      android:padding="@dimen/chart_widget_tile_padding">

      <TextView
        android:id="@+id/chart_tile_2_title"
        style="@style/ChartWidgetText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <TextView
        android:id="@+id/chart_tile_2_range"
        style="@style/ChartWidgetText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/chart_tile_2_value"
          style="@style/ChartWidgetText.Value.Tile"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

        <TextView
          android:id="@+id/chart_tile_2_delta"
          style="@style/ChartWidgetText.Pill"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/chart_tile_2_frame"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chart_widget_tile_sparkline_height"
        android:layout_marginTop="6dp">
        <ImageView
          android:id="@+id/chart_tile_2_image_light"
          style="@style/ChartWidgetChartImage"
          android:visibility="@integer/chart_widget_light_visibility" />
        <ImageView
          android:id="@+id/chart_tile_2_image_dark"
          style="@style/ChartWidgetChartImage"
          android:visibility="@integer/chart_widget_dark_visibility" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout android:id="@+id/chart_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/chart_range"
      style="@style/ChartWidgetText.Footer"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/chart_updated"
      style="@style/ChartWidgetText.Footer"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp" />
  </LinearLayout>
</LinearLayout>
