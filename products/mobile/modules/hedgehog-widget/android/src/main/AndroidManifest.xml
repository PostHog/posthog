<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name=".HedgehogWidgetProvider"
      android:exported="true"
      android:label="@string/hedgehog_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="com.posthog.code.mobile.HEDGEHOG_POKE" />
        <action android:name="com.posthog.code.mobile.HEDGEHOG_ADVANCE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/hedgehog_widget_info" />
    </receiver>
  </application>
</manifest>
