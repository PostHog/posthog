# EAS reads this file instead of .gitignore, so it repeats every entry there.
# Builds run prebuild from app.config.ts. A local ios/ or android/ folder in the
# archive would make EAS skip prebuild and build that stale native project.
# Anchored: modules/hedgehog-widget/ios and /android are source and must upload.
node_modules/
.expo/
/ios/
/android/
modules/*/android/build/
dist/
web-build/
coverage/
.turbo/
*.tsbuildinfo
expo-env.d.ts
.env
.env.local
google-services.json
.argent/*
!.argent/flows/
public/canvaskit.wasm
