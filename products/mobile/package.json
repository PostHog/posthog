{
    "name": "posthog-mobile",
    "version": "1.0.0",
    "private": true,
    "main": "expo-router/entry",
    "packageManager": "pnpm@10.29.3",
    "scripts": {
        "start": "expo start",
        "ios": "expo run:ios",
        "android": "expo run:android",
        "web": "setup-skia-web public && expo start --web",
        "check:expo": "node scripts/check-expo.mjs",
        "typecheck": "node scripts/check-expo.mjs && tsc --noEmit",
        "lint": "biome check .",
        "fix": "biome check --write .",
        "test": "jest",
        "prebuild": "expo prebuild",
        "build:dev": "sh scripts/eas-build.sh --profile development --platform ios",
        "build:dev:android": "sh scripts/eas-build.sh --profile development --platform android",
        "build:preview": "sh scripts/eas-build.sh --profile preview --platform ios",
        "build:preview:android": "sh scripts/eas-build.sh --profile preview --platform android",
        "build:production": "node scripts/releases/release.mjs hosted-only",
        "build:production:android": "node scripts/releases/release.mjs hosted-only",
        "submit:ios": "node scripts/releases/release.mjs hosted-only",
        "submit:android": "node scripts/releases/release.mjs hosted-only",
        "update:preview": "node scripts/releases/release.mjs hosted-only",
        "update:production": "node scripts/releases/release.mjs hosted-only",
        "release:request": "node scripts/releases/release.mjs request",
        "release:check": "node scripts/releases/release.mjs check",
        "release:fingerprint": "node scripts/releases/release.mjs fingerprint",
        "release:test": "node --test scripts/releases/*.test.mjs"
    },
    "expo": {
        "autolinking": {
            "buildFromSource": [
                "react-native-worklets"
            ]
        },
        "install": {
            "exclude": [
                "react",
                "react-dom",
                "typescript"
            ]
        }
    },
    "dependencies": {
        "@expo/metro-runtime": "~57.0.7",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/datetimepicker": "9.1.0",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@shopify/react-native-skia": "2.6.2",
        "@tanstack/react-query": "^5.90.12",
        "expo": "~57.0.8",
        "expo-application": "~57.0.3",
        "expo-auth-session": "~57.0.5",
        "expo-blur": "~57.0.3",
        "expo-clipboard": "~57.0.1",
        "expo-constants": "~57.0.7",
        "expo-crypto": "~57.0.1",
        "expo-dev-client": "~57.0.9",
        "expo-device": "~57.0.2",
        "expo-document-picker": "~57.0.3",
        "expo-file-system": "~57.0.7",
        "expo-font": "~57.0.1",
        "expo-haptics": "~57.0.1",
        "expo-image-picker": "~57.0.20",
        "expo-linking": "~57.0.4",
        "expo-localization": "~57.0.2",
        "expo-notifications": "~57.0.7",
        "expo-router": "~57.0.8",
        "expo-secure-store": "~57.0.1",
        "expo-splash-screen": "~57.0.5",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.4",
        "expo-updates": "~57.0.9",
        "expo-web-browser": "~57.0.2",
        "markdown-it": "10.0.0",
        "mermaid": "11.17.0",
        "posthog-react-native": "^4.78.0",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-keyboard-controller": "1.21.9",
        "react-native-markdown-display": "7.0.2",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.2",
        "react-native-svg": "15.15.4",
        "react-native-web": "~0.21.0",
        "react-native-webview": "13.16.1",
        "react-native-worklets": "0.10.1",
        "victory-native": "42.0.1",
        "zustand": "^4.5.7"
    },
    "devDependencies": {
        "@bacons/apple-targets": "5.0.0",
        "@biomejs/biome": "2.2.4",
        "@react-native/jest-preset": "0.86.3",
        "@react-native/metro-config": "0.86.3",
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "^29.5.14",
        "@types/markdown-it": "14.1.2",
        "@types/react": "~19.2.4",
        "jest": "^29.7.0",
        "jest-expo": "~57.0.2",
        "react-test-renderer": "19.2.6",
        "typescript": "~5.9.2"
    }
}
