{
    "name": "posthog-mobile",
    "version": "1.0.0",
    "private": true,
    "main": "expo-router/entry",
    "packageManager": "pnpm@10.29.3",
    "scripts": {
        "start": "expo start",
        "ios": "expo run:ios",
        "android": "expo run:android",
        "web": "setup-skia-web public && expo start --web",
        "check:expo": "node scripts/check-expo.mjs",
        "typecheck": "node scripts/check-expo.mjs && tsc --noEmit",
        "lint": "biome check .",
        "fix": "biome check --write .",
        "test": "jest",
        "prebuild": "expo prebuild",
        "build:dev": "sh scripts/eas-build.sh --profile development --platform ios",
        "build:dev:android": "sh scripts/eas-build.sh --profile development --platform android",
        "build:preview": "sh scripts/eas-build.sh --profile preview --platform ios",
        "build:preview:android": "sh scripts/eas-build.sh --profile preview --platform android",
        "build:production": "node scripts/releases/release.mjs hosted-only",
        "build:production:android": "node scripts/releases/release.mjs hosted-only",
        "submit:ios": "node scripts/releases/release.mjs hosted-only",
        "submit:android": "node scripts/releases/release.mjs hosted-only",
        "update:preview": "node scripts/releases/release.mjs hosted-only",
        "update:production": "node scripts/releases/release.mjs hosted-only",
        "release:request": "node scripts/releases/release.mjs request",
        "release:check": "node scripts/releases/release.mjs check",
        "release:fingerprint": "node scripts/releases/release.mjs fingerprint",
        "release:test": "node --test scripts/releases/*.test.mjs"
    },
    "expo": {
        "autolinking": {
            "buildFromSource": [
                "react-native-worklets",
                "expo-notifications"
            ]
        },
        "install": {
            "exclude": [
                "react",
                "react-dom",
                "typescript"
            ]
        }
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.15",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/datetimepicker": "9.2.1",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@shopify/react-native-skia": "2.14.0",
        "@tanstack/react-query": "^5.90.12",
        "expo": "~58.0.21",
        "expo-application": "~58.1.2",
        "expo-auth-session": "~58.0.16",
        "expo-blur": "~58.0.5",
        "expo-clipboard": "~58.0.4",
        "expo-constants": "~58.0.14",
        "expo-crypto": "~58.0.7",
        "expo-dev-client": "~58.0.17",
        "expo-device": "~58.0.5",
        "expo-document-picker": "~58.0.4",
        "expo-file-system": "~58.0.13",
        "expo-font": "~58.0.11",
        "expo-haptics": "~58.0.7",
        "expo-image-picker": "~58.0.10",
        "expo-linking": "~58.0.15",
        "expo-localization": "~58.0.5",
        "expo-network": "~58.0.4",
        "expo-notifications": "~58.1.7",
        "expo-router": "~58.0.28",
        "expo-secure-store": "~58.0.2",
        "expo-splash-screen": "~58.0.12",
        "expo-status-bar": "~58.0.4",
        "expo-system-ui": "~58.0.7",
        "expo-updates": "~58.0.19",
        "expo-web-browser": "~58.0.7",
        "markdown-it": "10.0.0",
        "mermaid": "11.17.0",
        "posthog-react-native": "^4.84.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-keyboard-controller": "1.22.7",
        "react-native-markdown-display": "7.0.2",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-web": "~0.21.4",
        "react-native-webview": "14.0.1",
        "react-native-worklets": "0.13.0",
        "victory-native": "42.0.1",
        "zustand": "^4.5.7",
        "react-native-reserved-regions": "0.2.0"
    },
    "devDependencies": {
        "@bacons/apple-targets": "5.0.0",
        "@biomejs/biome": "2.2.4",
        "@react-native/jest-preset": "0.88.1",
        "@react-native/metro-config": "0.88.1",
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "^29.5.14",
        "@types/markdown-it": "14.1.2",
        "@types/react": "~19.2.4",
        "jest": "^29.7.0",
        "jest-expo": "~58.0.13",
        "react-test-renderer": "19.3.0",
        "typescript": "~5.9.2"
    }
}
