          GROUP BY cohort_sizes.breakdown_value 
          ORDER BY sum(cohort_sizes.cohort_size) DESC, cohort_sizes.breakdown_value ASC 
          LIMIT 20)), matrix.breakdown_value, %(hogql_val_74)s) AS breakdown_value, matrix.cohort_index AS cohort_index, matrix.intervals_from_base AS intervals_from_base, sum(matrix.count) AS count 
    FROM matrix 
    GROUP BY breakdown_value, matrix.cohort_index, matrix.intervals_from_base), summary AS (
    SELECT uniqExact(cohort_sizes.breakdown_value) AS distinct_breakdowns 
    FROM cohort_sizes) 
  SELECT folded_sizes.breakdown_value AS breakdown_value, folded_sizes.cohort_index AS cohort_index, folded_sizes.cohort_size AS cohort_size, folded_matrix.intervals_from_base AS intervals_from_base, folded_matrix.count AS count, summary.distinct_breakdowns AS distinct_breakdowns 
  FROM folded_sizes LEFT JOIN folded_matrix ON and(equals(folded_matrix.breakdown_value, folded_sizes.breakdown_value), equals(folded_matrix.cohort_index, folded_sizes.cohort_index)) CROSS JOIN summary 
  ORDER BY breakdown_value ASC, cohort_index ASC, intervals_from_base ASC 
  LIMIT 421
  '''
# ---
