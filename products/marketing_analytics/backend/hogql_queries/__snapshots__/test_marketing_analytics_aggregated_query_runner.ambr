# serializer version: 1
# name: TestMarketingAnalyticsAggregatedQueryRunner.test_join_uses_match_key_not_or_condition
  '''
  WITH campaign_costs AS (
    SELECT campaign, id, source, any(match_key) AS match_key, sum(ifNull(toFloat(cost), 0)) AS total_cost, sum(ifNull(toFloat(clicks), 0)) AS total_clicks, sum(ifNull(toFloat(impressions), 0)) AS total_impressions, sum(ifNull(toFloat(reported_conversion), 0)) AS total_reported_conversions, sum(ifNull(toFloat(reported_conversion_value), 0)) AS total_reported_conversion_value 
    FROM (
      SELECT 'Campaign' AS campaign, 'id1' AS id, 'google' AS source, 100 AS impressions, 10 AS clicks, 50.0 AS cost, 5 AS reported_conversion, 'Campaign' AS match_key) 
    GROUP BY campaign, id, source), ucg AS (
    SELECT conv.campaign AS campaign, conv.id AS id, conv.source AS source, conv.campaign AS match_key, sum(conv.conversion_0) AS conversion_0 
    FROM (
      SELECT if(notEmpty(campaign_name), campaign_name, 'organic') AS campaign, if(notEmpty(campaign_id), campaign_id, '-') AS id, if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['microsoft', 'msads', 'bing_video']), 'bing', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['facebook', 'instagram', 'messenger', 'fb', 'whatsapp', 'audience_network', 'facebook_marketplace', 'threads', 'th']), 'meta', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['li']), 'linkedin', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['adwords', 'youtube', 'display', 'gmail', 'google_maps', 'google_play', 'google_discover', 'admob', 'waze']), 'google', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['x', 'twitter_ads', 'x_ads']), 'twitter', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['rokt_ads']), 'rokt', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['chatgpt', 'openai_ads']), 'openai', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['apple_search_ads', 'apple_ads', 'asa']), 'apple', if(in(lower(if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))), ['amazon_ads']), 'amazon', if(notEmpty(source_name), source_name, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))))))))))) AS source, count() AS conversion_0 
      FROM (
        SELECT person_id, if(notEmpty(conversion_campaign), conversion_campaign, if(notEmpty(fallback_campaign), fallback_campaign, '')) AS campaign_name, if(notEmpty(conversion_source), conversion_source, if(notEmpty(fallback_source), fallback_source, '')) AS source_name, if(notEmpty(conversion_medium), conversion_medium, if(notEmpty(fallback_medium), fallback_medium, '')) AS medium_name, if(notEmpty(conversion_content), conversion_content, if(notEmpty(fallback_content), fallback_content, '')) AS content_name, if(notEmpty(conversion_term), conversion_term, if(notEmpty(fallback_term), fallback_term, '')) AS term_name, if(notEmpty(conversion_referring_domain), conversion_referring_domain, if(notEmpty(fallback_referring_domain), fallback_referring_domain, '')) AS referring_domain_name, if(notEmpty(conversion_gclid), conversion_gclid, if(notEmpty(fallback_gclid), fallback_gclid, '')) AS gclid_name, if(notEmpty(conversion_fbclid), conversion_fbclid, if(notEmpty(fallback_fbclid), fallback_fbclid, '')) AS fbclid_name, if(notEmpty(conversion_gad_source), conversion_gad_source, if(notEmpty(fallback_gad_source), fallback_gad_source, '')) AS gad_source_name, '-' AS campaign_id, 1 AS conversion_value 
        FROM (
          SELECT person_id, conversion_timestamps[i] AS conversion_time, conversion_math_values[i] AS conversion_math_value, conversion_campaigns[i] AS conversion_campaign, conversion_sources[i] AS conversion_source, conversion_mediums[i] AS conversion_medium, conversion_contents[i] AS conversion_content, conversion_terms[i] AS conversion_term, conversion_referring_domains[i] AS conversion_referring_domain, conversion_gclids[i] AS conversion_gclid, conversion_fbclids[i] AS conversion_fbclid, conversion_gad_sources[i] AS conversion_gad_source, arrayMax(arrayFilter(x -> and(lessOrEquals(x, conversion_timestamps[i]), greaterOrEquals(x, minus(conversion_timestamps[i], 7776000))), utm_timestamps)) AS last_utm_timestamp, if(isNotNull(last_utm_timestamp), utm_campaigns[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_campaign, if(isNotNull(last_utm_timestamp), utm_sources[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_source, if(isNotNull(last_utm_timestamp), utm_mediums[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_medium, if(isNotNull(last_utm_timestamp), utm_contents[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_content, if(isNotNull(last_utm_timestamp), utm_terms[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_term, if(isNotNull(last_utm_timestamp), utm_referring_domains[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_referring_domain, if(isNotNull(last_utm_timestamp), utm_gclids[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_gclid, if(isNotNull(last_utm_timestamp), utm_fbclids[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_fbclid, if(isNotNull(last_utm_timestamp), utm_gad_sources[indexOf(utm_timestamps, last_utm_timestamp)], '') AS fallback_gad_source 
          FROM (
            SELECT events.person_id, groupArrayIf(if(equals(events.event, 'purchase'), toUnixTimestamp(events.timestamp), 0), greater(if(equals(events.event, 'purchase'), toUnixTimestamp(events.timestamp), 0), 0)) AS conversion_timestamps, groupArrayIf(if(equals(events.event, 'purchase'), toFloat(1), 0), greater(if(equals(events.event, 'purchase'), toFloat(1), 0), 0)) AS conversion_math_values, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_campaign, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_campaign, '')), ''))) AS conversion_campaigns, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_source, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_source, '')), ''))) AS conversion_sources, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_medium, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_medium, '')), ''))) AS conversion_mediums, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_content, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_content, '')), ''))) AS conversion_contents, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_term, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_term, '')), ''))) AS conversion_terms, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.$referring_domain, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.$referring_domain, '')), ''))) AS conversion_referring_domains, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gclid, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gclid, '')), ''))) AS conversion_gclids, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.fbclid, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.fbclid, '')), ''))) AS conversion_fbclids, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gad_source, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gad_source, '')), ''))) AS conversion_gad_sources, arraySlice(arraySort(groupArrayIf(tuple(toUnixTimestamp(events.timestamp), cityHash64(events.uuid), toString(ifNull(events.properties.utm_campaign, '')), toString(ifNull(events.properties.utm_source, '')), toString(ifNull(events.properties.utm_medium, '')), toString(ifNull(events.properties.utm_content, '')), toString(ifNull(events.properties.utm_term, '')), toString(ifNull(events.properties.$referring_domain, '')), toString(ifNull(events.properties.gclid, '')), toString(ifNull(events.properties.fbclid, '')), toString(ifNull(events.properties.gad_source, ''))), and(equals(events.event, '$pageview'), or(notEmpty(toString(ifNull(events.properties.utm_source, ''))), notEmpty(toString(ifNull(events.properties.gclid, ''))), notEmpty(toString(ifNull(events.properties.gad_source, ''))))))), -500) AS utm_touchpoints, arrayMap(_tp -> _tp.1, utm_touchpoints) AS utm_timestamps, arrayMap(_tp -> _tp.3, utm_touchpoints) AS utm_campaigns, arrayMap(_tp -> _tp.4, utm_touchpoints) AS utm_sources, arrayMap(_tp -> _tp.5, utm_touchpoints) AS utm_mediums, arrayMap(_tp -> _tp.6, utm_touchpoints) AS utm_contents, arrayMap(_tp -> _tp.7, utm_touchpoints) AS utm_terms, arrayMap(_tp -> _tp.8, utm_touchpoints) AS utm_referring_domains, arrayMap(_tp -> _tp.9, utm_touchpoints) AS utm_gclids, arrayMap(_tp -> _tp.10, utm_touchpoints) AS utm_fbclids, arrayMap(_tp -> _tp.11, utm_touchpoints) AS utm_gad_sources 
            FROM events 
            WHERE or(and(equals(events.event, 'purchase'), greaterOrEquals(events.timestamp, toDateTime('2023-01-01 00:00:00')), lessOrEquals(events.timestamp, toDateTime('2023-01-31 23:59:59'))), and(equals(events.event, '$pageview'), or(notEmpty(toString(ifNull(events.properties.utm_source, ''))), notEmpty(toString(ifNull(events.properties.gclid, ''))), notEmpty(toString(ifNull(events.properties.gad_source, '')))), greaterOrEquals(events.timestamp, minus(toDateTime('2023-01-01 00:00:00'), toIntervalSecond(7776000))), lessOrEquals(events.timestamp, toDateTime('2023-01-31 23:59:59')))) 
            GROUP BY events.person_id 
            HAVING greater(length(conversion_timestamps), 0)) ARRAY JOIN arrayEnumerate(conversion_timestamps) AS i)) AS attributed_conversions 
      GROUP BY campaign, id, source) AS conv 
    GROUP BY conv.campaign, conv.id, conv.source) 
  SELECT sum(round(campaign_costs.total_cost, 2)) AS Cost, sum(round(campaign_costs.total_clicks, 0)) AS Clicks, sum(round(campaign_costs.total_impressions, 0)) AS Impressions, sum(round(campaign_costs.total_reported_conversions, 2)) AS `Reported Conversions`, sum(round(campaign_costs.total_reported_conversion_value, 2)) AS `Reported Conversion Value`, sum(ucg.conversion_0) AS `Test Purchase` 
  FROM campaign_costs LEFT JOIN ucg AS ucg ON and(equals(campaign_costs.match_key, ucg.match_key), equals(campaign_costs.source, ucg.source))
  '''
# ---
