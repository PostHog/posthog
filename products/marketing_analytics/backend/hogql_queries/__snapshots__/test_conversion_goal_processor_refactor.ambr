e, if(notEmpty(gclid_name), 'google', if(notEmpty(gad_source_name), 'google', 'organic')))))))))))) AS source, coalesce(sum(conversion_value), 0) AS conversion_0 
  FROM (
    SELECT person_id, if(notEmpty(conversion_campaign), conversion_campaign, if(notEmpty(fallback_campaign), fallback_campaign, '')) AS campaign_name, if(notEmpty(conversion_source), conversion_source, if(notEmpty(fallback_source), fallback_source, '')) AS source_name, if(notEmpty(conversion_medium), conversion_medium, if(notEmpty(fallback_medium), fallback_medium, '')) AS medium_name, if(notEmpty(conversion_content), conversion_content, if(notEmpty(fallback_content), fallback_content, '')) AS content_name, if(notEmpty(conversion_term), conversion_term, if(notEmpty(fallback_term), fallback_term, '')) AS term_name, if(notEmpty(conversion_referring_domain), conversion_referring_domain, if(notEmpty(fallback_referring_domain), fallback_referring_domain, '')) AS referring_domain_name, if(notEmpty(conversion_gclid), conversion_gclid, if(notEmpty(fallback_gclid), fallback_gclid, '')) AS gclid_name, if(notEmpty(conversion_fbclid), conversion_fbclid, if(notEmpty(fallback_fbclid), fallback_fbclid, '')) AS fbclid_name, if(notEmpty(conversion_gad_source), conversion_gad_source, if(notEmpty(fallback_gad_source), fallback_gad_source, '')) AS gad_source_name, '-' AS campaign_id, multiply(1, attribution_weight) AS conversion_value, attribution_weight 
    FROM (
      SELECT person_id, conversion_math_value, conversion_campaign, conversion_source, conversion_medium, conversion_content, conversion_term, conversion_referring_domain, conversion_gclid, conversion_fbclid, conversion_gad_source, filtered_utm_campaigns[tp_idx] AS fallback_campaign, filtered_utm_sources[tp_idx] AS fallback_source, filtered_utm_mediums[tp_idx] AS fallback_medium, filtered_utm_contents[tp_idx] AS fallback_content, filtered_utm_terms[tp_idx] AS fallback_term, filtered_utm_referring_domains[tp_idx] AS fallback_referring_domain, filtered_utm_gclids[tp_idx] AS fallback_gclid, filtered_utm_fbclids[tp_idx] AS fallback_fbclid, filtered_utm_gad_sources[tp_idx] AS fallback_gad_source, attribution_weights[tp_idx] AS attribution_weight 
      FROM (
        SELECT person_id, conversion_timestamps[i] AS conversion_time, conversion_math_values[i] AS conversion_math_value, conversion_campaigns[i] AS conversion_campaign, conversion_sources[i] AS conversion_source, conversion_mediums[i] AS conversion_medium, conversion_contents[i] AS conversion_content, conversion_terms[i] AS conversion_term, conversion_referring_domains[i] AS conversion_referring_domain, conversion_gclids[i] AS conversion_gclid, conversion_fbclids[i] AS conversion_fbclid, conversion_gad_sources[i] AS conversion_gad_source, arrayFilter(x -> and(lessOrEquals(x, conversion_timestamps[i]), greaterOrEquals(x, minus(conversion_timestamps[i], 7776000))), utm_timestamps) AS filtered_utm_timestamps, arrayMap(idx -> utm_campaigns[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_campaigns, arrayMap(idx -> utm_sources[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_sources, arrayMap(idx -> utm_mediums[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_mediums, arrayMap(idx -> utm_contents[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_contents, arrayMap(idx -> utm_terms[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_terms, arrayMap(idx -> utm_referring_domains[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_referring_domains, arrayMap(idx -> utm_gclids[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_gclids, arrayMap(idx -> utm_fbclids[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_fbclids, arrayMap(idx -> utm_gad_sources[idx], arrayFilter(j -> and(lessOrEquals(utm_timestamps[j], conversion_timestamps[i]), greaterOrEquals(utm_timestamps[j], minus(conversion_timestamps[i], 7776000))), arrayEnumerate(utm_timestamps))) AS filtered_utm_gad_sources, arrayMap(_x -> divide(1.0, greatest(toFloat(length(filtered_utm_timestamps)), 1.0)), filtered_utm_timestamps) AS attribution_weights 
        FROM (
          SELECT events.person_id, groupArrayIf(if(equals(events.event, 'purchase'), toUnixTimestamp(events.timestamp), 0), greater(if(equals(events.event, 'purchase'), toUnixTimestamp(events.timestamp), 0), 0)) AS conversion_timestamps, groupArrayIf(if(equals(events.event, 'purchase'), toFloat(1), 0), greater(if(equals(events.event, 'purchase'), toFloat(1), 0), 0)) AS conversion_math_values, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_campaign, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_campaign, '')), ''))) AS conversion_campaigns, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_source, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_source, '')), ''))) AS conversion_sources, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_medium, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_medium, '')), ''))) AS conversion_mediums, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_content, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_content, '')), ''))) AS conversion_contents, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_term, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.utm_term, '')), ''))) AS conversion_terms, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.$referring_domain, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.$referring_domain, '')), ''))) AS conversion_referring_domains, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gclid, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gclid, '')), ''))) AS conversion_gclids, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.fbclid, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.fbclid, '')), ''))) AS conversion_fbclids, groupArrayIf(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gad_source, '')), ''), notEmpty(if(equals(events.event, 'purchase'), toString(ifNull(events.properties.gad_source, '')), ''))) AS conversion_gad_sources, arraySlice(arraySort(groupArrayIf(tuple(toUnixTimestamp(events.timestamp), cityHash64(events.uuid), toString(ifNull(events.properties.utm_campaign, '')), toString(ifNull(events.properties.utm_source, '')), toString(ifNull(events.properties.utm_medium, '')), toString(ifNull(events.properties.utm_content, '')), toString(ifNull(events.properties.utm_term, '')), toString(ifNull(events.properties.$referring_domain, '')), toString(ifNull(events.properties.gclid, '')), toString(ifNull(events.properties.fbclid, '')), toString(ifNull(events.properties.gad_source, ''))), and(equals(events.event, '$pageview'), or(notEmpty(toString(ifNull(events.properties.utm_source, ''))), notEmpty(toString(ifNull(events.properties.gclid, ''))), notEmpty(toString(ifNull(events.properties.gad_source, ''))))))), -500) AS utm_touchpoints, arrayMap(_tp -> _tp.1, utm_touchpoints) AS utm_timestamps, arrayMap(_tp -> _tp.3, utm_touchpoints) AS utm_campaigns, arrayMap(_tp -> _tp.4, utm_touchpoints) AS utm_sources, arrayMap(_tp -> _tp.5, utm_touchpoints) AS utm_mediums, arrayMap(_tp -> _tp.6, utm_touchpoints) AS utm_contents, arrayMap(_tp -> _tp.7, utm_touchpoints) AS utm_terms, arrayMap(_tp -> _tp.8, utm_touchpoints) AS utm_referring_domains, arrayMap(_tp -> _tp.9, utm_touchpoints) AS utm_gclids, arrayMap(_tp -> _tp.10, utm_touchpoints) AS utm_fbclids, arrayMap(_tp -> _tp.11, utm_touchpoints) AS utm_gad_sources 
          FROM events 
          WHERE or(equals(events.event, 'purchase'), and(equals(events.event, '$pageview'), or(notEmpty(toString(ifNull(events.properties.utm_source, ''))), notEmpty(toString(ifNull(events.properties.gclid, ''))), notEmpty(toString(ifNull(events.properties.gad_source, '')))))) 
          GROUP BY events.person_id 
          HAVING greater(length(conversion_timestamps), 0)) ARRAY JOIN arrayEnumerate(conversion_timestamps) AS i) ARRAY JOIN arrayEnumerate(attribution_weights) AS tp_idx)) AS attributed_conversions 
  GROUP BY campaign, id, source 
  LIMIT 50000
  '''
