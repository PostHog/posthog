 'GBP'), toDecimal128(currency_aware_amount, 10), if(dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)) = 0, toDecimal128(0, 10), multiplyDecimal(divideDecimal(toDecimal128(currency_aware_amount, 10), if(dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)) = 0, toDecimal128(1, 10), dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)))), dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', 'GBP', toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)))))) AS amount
           FROM events_json AS events
           LEFT OUTER JOIN
             (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
                     person_distinct_id_overrides.distinct_id AS distinct_id
              FROM person_distinct_id_overrides
              WHERE equals(person_distinct_id_overrides.team_id, 99999)
              GROUP BY person_distinct_id_overrides.distinct_id
              HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
           WHERE and(equals(events.team_id, 99999), and(equals(events.event, 'purchase'), 1, isNotNull(amount)))
           ORDER BY timestamp DESC) AS revenue_item
        WHERE and(revenue_item.is_recurring, isNotNull(revenue_item.subscription_id), ifNull(greaterOrEquals(timestamp, toStartOfMonth(addDays(toDateTime64('explicit_redacted_timestamp', 6, 'UTC'), -60))), 0), ifNull(lessOrEquals(timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'UTC')), 0))
        GROUP BY revenue_item.source_label,
                 revenue_item.customer_id,
                 revenue_item.subscription_id, timestamp
        ORDER BY timestamp DESC
        UNION ALL SELECT `revenue_analytics.events.purchase.subscription_events_revenue_view`.source_label AS source_label,
                         `revenue_analytics.events.purchase.subscription_events_revenue_view`.customer_id AS customer_id,
                         `revenue_analytics.events.purchase.subscription_events_revenue_view`.id AS subscription_id,
