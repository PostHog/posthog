                  accurateCastOrNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^revenue)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^revenue)), if(isNull(nullIf(toString(events.properties.revenue), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.revenue, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.revenue), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.revenue), '[]'), '{}'), toString(events.properties.revenue))))), 'Decimal64(10)') AS original_amount,
                  1 AS enable_currency_aware_divider,
