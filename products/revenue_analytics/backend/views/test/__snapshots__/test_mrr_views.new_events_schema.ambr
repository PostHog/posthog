                  accurateCastOrNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^revenue)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^revenue)), if(isNull(nullIf(toString(events.properties.revenue), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.revenue, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.revenue), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.revenue, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.revenue), '[]'), '{}'), toString(events.properties.revenue))))), 'Decimal64(10)') AS original_amount,
                  1 AS enable_currency_aware_divider,
                  if(enable_currency_aware_divider, accurateCastOrNull(1, 'Decimal64(10)'), accurateCastOrNull(100, 'Decimal64(10)')) AS currency_aware_divider,
                  divideDecimal(original_amount, currency_aware_divider) AS currency_aware_amount,
                  'GBP' AS currency,
                  if(isNull(upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency))))))), accurateCastOrNull(currency_aware_amount, 'Decimal64(10)'), if(equals(upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), 'GBP'), toDecimal128(currency_aware_amount, 10), if(dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)) = 0, toDecimal128(0, 10), multiplyDecimal(divideDecimal(toDecimal128(currency_aware_amount, 10), if(dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)) = 0, toDecimal128(1, 10), dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', upper(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^currency)), if(isNull(nullIf(toString(events.properties.currency), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.currency, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.currency), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.currency, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.currency), '[]'), '{}'), toString(events.properties.currency)))))), toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)))), dictGetOrDefault(`posthog_test`.`exchange_rate_dict`, 'rate', 'GBP', toDate(toTimeZone(events.timestamp, 'UTC')), toDecimal64(0, 10)))))) AS amount
           FROM events_json AS events
           LEFT OUTER JOIN
             (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
                     person_distinct_id_overrides.distinct_id AS distinct_id
              FROM person_distinct_id_overrides
              WHERE equals(person_distinct_id_overrides.team_id, 99999)
              GROUP BY person_distinct_id_overrides.distinct_id
              HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
           WHERE and(equals(events.team_id, 99999), and(equals(events.event, 'purchase'), 1, isNotNull(amount)))
           ORDER BY timestamp DESC) AS revenue_item
        WHERE and(revenue_item.is_recurring, isNotNull(revenue_item.subscription_id), ifNull(greaterOrEquals(timestamp, toStartOfMonth(addDays(toDateTime64('explicit_redacted_timestamp', 6, 'UTC'), -60))), 0), ifNull(lessOrEquals(timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'UTC')), 0))
        GROUP BY revenue_item.source_label,
                 revenue_item.customer_id,
                 revenue_item.subscription_id, timestamp
        ORDER BY timestamp DESC
        UNION ALL SELECT `revenue_analytics.events.purchase.subscription_events_revenue_view`.source_label AS source_label,
                         `revenue_analytics.events.purchase.subscription_events_revenue_view`.customer_id AS customer_id,
                         `revenue_analytics.events.purchase.subscription_events_revenue_view`.id AS subscription_id,
                         toTimeZone(`revenue_analytics.events.purchase.subscription_events_revenue_view`.ended_at, 'UTC') AS timestamp,
                         accurateCastOrNull(0, 'Decimal64(10)') AS amount
        FROM
          (SELECT subscription_id AS id,
                  'revenue_analytics.events.purchase' AS source_label,
                  NULL AS plan_id,
                  product_id AS product_id,
                  toString(person_id) AS customer_id,
                  NULL AS status,
                  min_timestamp AS started_at,
                  if(greater(max_timestamp_plus_dropoff_days, today()), NULL, max_timestamp_plus_dropoff_days) AS ended_at,
                  NULL AS metadata
           FROM
             (SELECT if(not(empty(events__override.distinct_id)), events__override.person_id, events.person_id) AS person_id,
                     if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^subscription)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^subscription)), if(isNull(nullIf(toString(events.properties.subscription), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.subscription, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.subscription), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.subscription), '[]'), '{}'), toString(events.properties.subscription))))) AS subscription_id,
                     min(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^product)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^product)), if(isNull(nullIf(toString(events.properties.product), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.product, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.product), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.product), '[]'), '{}'), toString(events.properties.product)))))) AS product_id,
                     min(toTimeZone(events.timestamp, 'UTC')) AS min_timestamp,
                     max(toTimeZone(events.timestamp, 'UTC')) AS max_timestamp,
                     addDays(max_timestamp, 45.0) AS max_timestamp_plus_dropoff_days
              FROM events_json AS events
              LEFT OUTER JOIN
                (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
                        person_distinct_id_overrides.distinct_id AS distinct_id
                 FROM person_distinct_id_overrides
                 WHERE equals(person_distinct_id_overrides.team_id, 99999)
                 GROUP BY person_distinct_id_overrides.distinct_id
                 HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
              WHERE and(equals(events.team_id, 99999), and(1, isNotNull(subscription_id)))
              GROUP BY subscription_id,
                       person_id)
           ORDER BY started_at DESC) AS `revenue_analytics.events.purchase.subscription_events_revenue_view`
        WHERE and(ifNull(greaterOrEquals(timestamp, toStartOfMonth(addDays(toDateTime64('explicit_redacted_timestamp', 6, 'UTC'), -60))), 0), ifNull(lessOrEquals(timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'UTC')), 0))
        ORDER BY timestamp DESC) AS
     union
     GROUP BY source_label,
              customer_id,
              subscription_id
     ORDER BY customer_id ASC,
              subscription_id ASC) AS `revenue_analytics.events.purchase.mrr_events_revenue_view`
  LIMIT 100 SETTINGS format_csv_allow_double_quotes=1,
                     readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     optimize_rewrite_aggregate_function_with_if=0,
                     optimize_min_inequality_conjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0
  '''
