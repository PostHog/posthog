                  toString(person_id) AS customer_id,
                  NULL AS status,
                  min_timestamp AS started_at,
                  if(greater(max_timestamp_plus_dropoff_days, today()), NULL, max_timestamp_plus_dropoff_days) AS ended_at,
                  NULL AS metadata
