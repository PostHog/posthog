             (SELECT if(not(empty(events__override.distinct_id)), events__override.person_id, events.person_id) AS person_id,
                     if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^subscription)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^subscription)), if(isNull(nullIf(toString(events.properties.subscription), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.subscription, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.subscription), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.subscription, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.subscription), '[]'), '{}'), toString(events.properties.subscription))))) AS subscription_id,
                     min(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^product)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^product)), if(isNull(nullIf(toString(events.properties.product), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.product, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.product), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.product, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.product), '[]'), '{}'), toString(events.properties.product)))))) AS product_id,
                     min(toTimeZone(events.timestamp, 'UTC')) AS min_timestamp,
                     max(toTimeZone(events.timestamp, 'UTC')) AS max_timestamp,
                     addDays(max_timestamp, 45.0) AS max_timestamp_plus_dropoff_days
              FROM events_json AS events
              LEFT OUTER JOIN
                (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
                        person_distinct_id_overrides.distinct_id AS distinct_id
                 FROM person_distinct_id_overrides
                 WHERE equals(person_distinct_id_overrides.team_id, 99999)
                 GROUP BY person_distinct_id_overrides.distinct_id
                 HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
              WHERE and(equals(events.team_id, 99999), and(1, isNotNull(subscription_id)))
              GROUP BY subscription_id,
                       person_id)
           ORDER BY started_at DESC) AS `revenue_analytics.events.purchase.subscription_events_revenue_view`
        WHERE and(ifNull(greaterOrEquals(timestamp, toStartOfMonth(addDays(toDateTime64('explicit_redacted_timestamp', 6, 'UTC'), -60))), 0), ifNull(lessOrEquals(timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'UTC')), 0))
        ORDER BY timestamp DESC) AS
     union
     GROUP BY source_label,
              customer_id,
              subscription_id
     ORDER BY customer_id ASC,
              subscription_id ASC) AS `revenue_analytics.events.purchase.mrr_events_revenue_view`
  LIMIT 100 SETTINGS format_csv_allow_double_quotes=1,
