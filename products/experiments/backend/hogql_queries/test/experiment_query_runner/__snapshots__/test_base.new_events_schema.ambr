# name: TestExperimentQueryRunner.test_query_runner_with_custom_exposure_without_properties[new_events_schema]
  '''
  WITH exposures AS
    (SELECT if(not(empty(events__override.distinct_id)), events__override.person_id, events.person_id) AS entity_id,
            if(greater(uniqExact(if(has(events.properties.`$feature_flags`, 'test-experiment'), if(ifNull(equals(events.properties.`$feature_flags`['test-experiment'], '$false'), 0), 'false', events.properties.`$feature_flags`['test-experiment']), NULL)), 1), '$multiple', any(if(has(events.properties.`$feature_flags`, 'test-experiment'), if(ifNull(equals(events.properties.`$feature_flags`['test-experiment'], '$false'), 0), 'false', events.properties.`$feature_flags`['test-experiment']), NULL))) AS variant,
