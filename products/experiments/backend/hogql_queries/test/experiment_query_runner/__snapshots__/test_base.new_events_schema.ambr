            min(toTimeZone(events.timestamp, 'UTC')) AS first_exposure_time,
            max(toTimeZone(events.timestamp, 'UTC')) AS last_exposure_time,
            argMin(events.uuid, toTimeZone(events.timestamp, 'UTC')) AS exposure_event_uuid,
