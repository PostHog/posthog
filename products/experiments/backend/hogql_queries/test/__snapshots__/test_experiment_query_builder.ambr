# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_funnel_precompute_write
  '''
  SELECT person_id AS entity_id,
         timestamp AS timestamp,
         uuid AS event_uuid,
                 $session_id AS session_id,
                 [_toUInt8(if(and(and(in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test'])), 1, 0)),
                  _toUInt8(if(equals(event, '$pageview'), 1, 0)),
                  _toUInt8(if(equals(event, 'purchase'), 1, 0))] AS steps
  FROM events
  WHERE and(greaterOrEquals(timestamp, '__TIME_WINDOW_MIN__'), less(timestamp, '__TIME_WINDOW_MAX__'), or(and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, '__EXPERIMENT_DATE_TO__'), and(in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test'])), and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, plus('__EXPERIMENT_DATE_TO__', toIntervalSecond(604800))), or(equals(event, '$pageview'), equals(event, 'purchase')))))
  '''
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_funnel_precompute_write.1
  'e3401f5b5536c49e54822c1d831cdf92fc81e82fd36773b30cb96c3a7eff84c9'
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_funnel_precomputed
  '''
  WITH exposures AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            if(greater(uniqExact(t.variant), 1), '$multiple', argMin(t.variant, t.first_exposure_time)) AS variant,
            min(t.first_exposure_time) AS first_exposure_time,
            max(t.last_exposure_time) AS last_exposure_time,
            argMin(t.exposure_event_uuid, t.first_exposure_time) AS exposure_event_uuid,
            argMin(t.exposure_session_id, t.first_exposure_time) AS exposure_session_id
     FROM experiment_exposures_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000e1', '00000000-0000-0000-0000-0000000000e2']), equals(t.team_id, 99999), greaterOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-20 12:00:00'))))
     GROUP BY entity_id),
       metric_events AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            t.timestamp AS timestamp,
            t.event_uuid AS uuid,
            if(and(equals(arrayElement(t.steps, 1), 1), greaterOrEquals(t.timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(t.timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00')))), 1, 0) AS step_0,
            arrayElement(t.steps, 2) AS step_1,
            arrayElement(t.steps, 3) AS step_2
     FROM experiment_metric_events_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000a1']), equals(t.team_id, 99999), greaterOrEquals(t.timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(t.timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(604800))))),
       entity_metrics AS
    (SELECT exposures.entity_id AS entity_id,
            exposures.variant AS variant,
            arraySort(x -> minus(0, x.1), arrayMap(result -> tuple(result.1, if(and(greaterOrEquals(result.1, 0), greater(length(result.4), result.1)), if(greater(length(arrayElement(result.4, plus(result.1, 1))), 0), toString(arrayElement(result.4, plus(result.1, 1))[1]), ''), '')), aggregate_funnel_array(3, 604800, 'first_touch', 'ordered', array(array('')), [], arraySort(t -> t.1, arrayFilter(t -> and(isNotNull(t.1), isNotNull(t.2)), groupArray(tuple(toFloat(metric_events.timestamp), metric_events.uuid, array(''), arrayFilter(x -> greater(x, 0), [multiply(1, metric_events.step_0), multiply(2, metric_events.step_1), multiply(3, metric_events.step_2)]))))))))[1] AS value
     FROM exposures
     LEFT JOIN metric_events ON equals(exposures.entity_id, metric_events.entity_id)
     GROUP BY exposures.entity_id,
              exposures.variant)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         countIf(equals(entity_metrics.value.1, 2)) AS total_sum,
         countIf(equals(entity_metrics.value.1, 2)) AS total_sum_of_squares,
         tuple(countIf(greaterOrEquals(entity_metrics.value.1, 1)), countIf(greaterOrEquals(entity_metrics.value.1, 2))) AS step_counts
  FROM entity_metrics
  WHERE notEmpty(variant)
  GROUP BY entity_metrics.variant
  LIMIT 50000
  '''
