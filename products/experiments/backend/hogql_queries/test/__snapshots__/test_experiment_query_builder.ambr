  FROM events
  WHERE and(greaterOrEquals(timestamp, '__TIME_WINDOW_MIN__'), less(timestamp, '__TIME_WINDOW_MAX__'), greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(timestamp, plus('__EXPERIMENT_DATE_TO__', toIntervalSecond(604800))), equals(event, 'purchase'))
  '''
