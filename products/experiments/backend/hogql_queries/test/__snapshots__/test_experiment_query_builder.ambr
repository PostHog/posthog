# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_retention_maturity
  '''
  WITH exposures AS
    (SELECT person_id AS entity_id,
            if(greater(uniqExact(properties.$feature_flag_response), 1), '$multiple', any(properties.$feature_flag_response)) AS variant,
            min(timestamp) AS first_exposure_time,
            max(timestamp) AS last_exposure_time,
            argMin(uuid, timestamp) AS exposure_event_uuid,
            argMin($session_id, timestamp) AS exposure_session_id
     FROM events
     WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), and(in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test']))
     GROUP BY entity_id),
       start_events AS
    (SELECT exposures.entity_id AS entity_id,
            min(timestamp) AS start_timestamp,
            argMin(uuid, timestamp) AS start_uuid
     FROM events
     INNER JOIN exposures ON equals(person_id, exposures.entity_id)
     WHERE and(and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(604800))), equals(event, '$pageview')), and(greaterOrEquals(timestamp, exposures.first_exposure_time), lessOrEquals(timestamp, plus(exposures.first_exposure_time, toIntervalSecond(604800)))))
     GROUP BY exposures.entity_id
     HAVING lessOrEquals(plus(min(timestamp), toIntervalSecond(604800)), toDateTime('2024-01-20 12:00:00', 'UTC'))),
       completion_events AS
    (SELECT person_id AS entity_id,
            uuid AS completion_uuid,
                    timestamp AS completion_timestamp
     FROM events
     WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(1209600))), equals(event, 'purchase'))),
       entity_metrics AS
    (SELECT exposures.entity_id AS entity_id,
            exposures.variant AS variant,
            MAX(if(and(notEquals(completion_events.completion_timestamp, NULL), greaterOrEquals(toStartOfDay(completion_events.completion_timestamp), plus(toStartOfDay(start_events.start_timestamp), toIntervalDay(1))), lessOrEquals(toStartOfDay(completion_events.completion_timestamp), plus(toStartOfDay(start_events.start_timestamp), toIntervalDay(7)))), 1, 0)) AS value
     FROM exposures
     INNER JOIN start_events ON equals(exposures.entity_id, start_events.entity_id)
     LEFT JOIN completion_events ON and(equals(exposures.entity_id, completion_events.entity_id), and(greaterOrEquals(completion_events.completion_timestamp, start_events.start_timestamp), lessOrEquals(completion_events.completion_timestamp, plus(start_events.start_timestamp, toIntervalSecond(691200)))), notEquals(completion_events.completion_uuid, start_events.start_uuid))
     GROUP BY exposures.entity_id,
              exposures.variant)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         sum(entity_metrics.value) AS total_sum,
         sum(power(entity_metrics.value, 2)) AS total_sum_of_squares,
         count(entity_metrics.entity_id) AS denominator_sum,
         count(entity_metrics.entity_id) AS denominator_sum_squares,
         sum(entity_metrics.value) AS numerator_denominator_sum_product
  FROM entity_metrics
  WHERE notEmpty(variant)
  GROUP BY entity_metrics.variant
  LIMIT 50000
  '''
