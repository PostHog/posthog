# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_retention_precompute_write.1
  '8e613e029fb5165c9f2b0cb575e1b31f575a1efbbbcc16dee53102f09ff98e05'
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_retention_precomputed
  '''
  WITH exposures AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            if(greater(uniqExact(t.variant), 1), '$multiple', argMin(t.variant, t.first_exposure_time)) AS variant,
            min(t.first_exposure_time) AS first_exposure_time,
            max(t.last_exposure_time) AS last_exposure_time,
            argMin(t.exposure_event_uuid, t.first_exposure_time) AS exposure_event_uuid,
            argMin(t.exposure_session_id, t.first_exposure_time) AS exposure_session_id
     FROM experiment_exposures_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000e1', '00000000-0000-0000-0000-0000000000e2']), equals(t.team_id, 99999), greaterOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-20 12:00:00'))))
     GROUP BY entity_id),
       start_events AS
    (SELECT exposures.entity_id AS entity_id,
            min(timestamp) AS start_timestamp,
            argMin(uuid, timestamp) AS start_uuid
     FROM
       (SELECT toUUID(t.entity_id) AS entity_id,
               t.timestamp AS timestamp,
               t.event_uuid AS uuid
        FROM experiment_metric_events_preaggregated AS t
        WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000a1']), equals(t.team_id, 99999), equals(arrayElement(t.steps, 1), 1), greaterOrEquals(t.timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(t.timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(604800))))) AS events
     INNER JOIN exposures ON equals(events.entity_id, exposures.entity_id)
     WHERE and(greaterOrEquals(timestamp, exposures.first_exposure_time), lessOrEquals(timestamp, plus(exposures.first_exposure_time, toIntervalSecond(604800))))
     GROUP BY exposures.entity_id),
       completion_events AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            t.event_uuid AS completion_uuid,
            t.timestamp AS completion_timestamp
     FROM experiment_metric_events_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000a1']), equals(t.team_id, 99999), equals(arrayElement(t.steps, 2), 1), greaterOrEquals(t.timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(t.timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(1209600))))),
       entity_metrics AS
    (SELECT exposures.entity_id AS entity_id,
            exposures.variant AS variant,
            MAX(if(and(notEquals(completion_events.completion_timestamp, NULL), greaterOrEquals(toStartOfDay(completion_events.completion_timestamp), plus(toStartOfDay(start_events.start_timestamp), toIntervalDay(1))), lessOrEquals(toStartOfDay(completion_events.completion_timestamp), plus(toStartOfDay(start_events.start_timestamp), toIntervalDay(7)))), 1, 0)) AS value
     FROM exposures
     INNER JOIN start_events ON equals(exposures.entity_id, start_events.entity_id)
     LEFT JOIN completion_events ON and(equals(exposures.entity_id, completion_events.entity_id), and(greaterOrEquals(completion_events.completion_timestamp, start_events.start_timestamp), lessOrEquals(completion_events.completion_timestamp, plus(start_events.start_timestamp, toIntervalSecond(691200)))), notEquals(completion_events.completion_uuid, start_events.start_uuid))
     GROUP BY exposures.entity_id,
              exposures.variant)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         sum(entity_metrics.value) AS total_sum,
         sum(power(entity_metrics.value, 2)) AS total_sum_of_squares,
         count(entity_metrics.entity_id) AS denominator_sum,
         count(entity_metrics.entity_id) AS denominator_sum_squares,
         sum(entity_metrics.value) AS numerator_denominator_sum_product
  FROM entity_metrics
  WHERE notEmpty(variant)
  GROUP BY entity_metrics.variant
  LIMIT 50000
  '''
