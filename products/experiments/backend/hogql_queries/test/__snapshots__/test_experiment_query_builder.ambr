            sum(coalesce(toFloat(if(and(greaterOrEquals(metric_events.timestamp, exposures.first_exposure_time), less(metric_events.timestamp, plus(exposures.first_exposure_time, toIntervalSecond(604800)))), metric_events.value, NULL)), 0)) AS value,
            sum(coalesce(toFloat(if(and(greaterOrEquals(metric_events.timestamp, minus(exposures.first_exposure_time, toIntervalDay(14))), less(metric_events.timestamp, exposures.first_exposure_time)), metric_events.value, NULL)), 0)) AS covariate_value
     FROM exposures
     LEFT JOIN metric_events ON and(equals(exposures.entity_id, metric_events.entity_id), or(and(greaterOrEquals(metric_events.timestamp, exposures.first_exposure_time), less(metric_events.timestamp, plus(exposures.first_exposure_time, toIntervalSecond(604800)))), and(greaterOrEquals(metric_events.timestamp, minus(exposures.first_exposure_time, toIntervalDay(14))), less(metric_events.timestamp, exposures.first_exposure_time))))
     GROUP BY exposures.entity_id,
              exposures.variant)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         sum(entity_metrics.value) AS total_sum,
         sum(power(entity_metrics.value, 2)) AS total_sum_of_squares,
         sum(entity_metrics.covariate_value) AS covariate_sum,
         sum(power(entity_metrics.covariate_value, 2)) AS covariate_sum_squares,
         sum(multiply(entity_metrics.value, entity_metrics.covariate_value)) AS covariate_sum_product
  FROM entity_metrics
  GROUP BY entity_metrics.variant
  LIMIT 50000
  '''
