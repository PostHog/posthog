# serializer version: 1
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_daily_exposures_from_precomputed
  '''
  WITH deduplicated AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            if(greater(uniqExact(t.variant), 1), '$multiple', argMin(t.variant, t.first_exposure_time)) AS variant,
            min(t.first_exposure_time) AS first_exposure_time
     FROM experiment_exposures_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000e1', '00000000-0000-0000-0000-0000000000e2']), equals(t.team_id, 99999), greaterOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-20 12:00:00'))))
     GROUP BY entity_id)
  SELECT toDate(toString(first_exposure_time)) AS day,
         variant AS variant,
         count(entity_id) AS exposed_count
  FROM deduplicated
  WHERE notEmpty(variant)
  GROUP BY day, variant
  ORDER BY day ASC
  '''
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_exposure_timeseries
  '''
  WITH first_exposures AS
    (SELECT person_id AS entity_id,
            if(greater(uniqExact(properties.$feature_flag_response), 1), '$multiple', any(properties.$feature_flag_response)) AS variant,
            toDate(toString(min(timestamp))) AS day
     FROM events
     WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), and(in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test']))
     GROUP BY entity_id)
  SELECT first_exposures.day AS day,
         first_exposures.variant AS variant,
         count(first_exposures.entity_id) AS exposed_count
  FROM first_exposures
  WHERE notEmpty(variant)
  GROUP BY first_exposures.day,
           first_exposures.variant
  ORDER BY first_exposures.day ASC
  '''
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_exposure_timeseries_activation
  '''
  WITH first_exposures AS
    (SELECT person_id AS entity_id,
            any(flag_exposures.variant) AS variant,
            toDate(toString(min(timestamp))) AS day
     FROM events
     INNER JOIN
       (SELECT person_id AS entity_id,
               if(greater(uniqExact(properties.$feature_flag_response), 1), '$multiple', any(properties.$feature_flag_response)) AS variant,
               min(timestamp) AS first_flag_exposure_time
        FROM events
        WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), and(in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test']))
        GROUP BY entity_id) AS flag_exposures ON equals(person_id, flag_exposures.entity_id)
     WHERE and(and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), equals(event, 'signed_up'), notILike(toString(person.properties.email), '%@posthog.com%')), greaterOrEquals(timestamp, flag_exposures.first_flag_exposure_time))
     GROUP BY entity_id)
  SELECT first_exposures.day AS day,
         first_exposures.variant AS variant,
         count(first_exposures.entity_id) AS exposed_count
  FROM first_exposures
  WHERE notEmpty(variant)
  GROUP BY first_exposures.day,
           first_exposures.variant
  ORDER BY first_exposures.day ASC
  '''
