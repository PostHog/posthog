     WHERE or(and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), and(in(event, ['$feature_flag_called', '$experiment_exposure']), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test'])), and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), or(equals(event, '$pageview'), equals(event, 'purchase'))))),
       first_exposures AS
    (SELECT entity_id,
            min(timestamp) AS first_exposure_time
     FROM base_events
     WHERE equals(step_0, 1)
     GROUP BY entity_id),
       entity_metrics AS
    (SELECT base_events.entity_id AS entity_id,
            if(greater(uniqExactIf(variant_value, equals(step_0, 1)), 1), '$multiple', anyIf(variant_value, equals(step_0, 1))) AS variant,
            arraySort(x -> minus(0, x.1), arrayMap(result -> tuple(result.1, if(and(greaterOrEquals(result.1, 0), greater(length(result.4), result.1)), if(greater(length(arrayElement(result.4, plus(result.1, 1))), 0), toString(arrayElement(result.4, plus(result.1, 1))[1]), ''), '')), aggregate_funnel_array(3, 94608000, 'first_touch', 'unordered', array(array('')), [], arraySort(t -> t.1, arrayFilter(t -> and(isNotNull(t.1), isNotNull(t.2)), groupArray(tuple(toFloat(base_events.timestamp), base_events.uuid, array(''), arrayFilter(x -> greater(x, 0), [multiply(1, base_events.step_0), multiply(2, base_events.step_1), multiply(3, base_events.step_2)]))))))))[1] AS value
     FROM base_events
     INNER JOIN first_exposures ON equals(base_events.entity_id, first_exposures.entity_id)
     WHERE greaterOrEquals(base_events.timestamp, first_exposures.first_exposure_time)
     GROUP BY base_events.entity_id)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         countIf(equals(entity_metrics.value.1, 2)) AS total_sum,
         countIf(equals(entity_metrics.value.1, 2)) AS total_sum_of_squares,
