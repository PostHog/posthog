            coalesce(maxIf(1, and(equals(base_events.step_2, 1), and(greaterOrEquals(base_events.timestamp, minus(first_exposures.first_exposure_time, toIntervalDay(14))), less(base_events.timestamp, first_exposures.first_exposure_time)))), 0) AS covariate_value
