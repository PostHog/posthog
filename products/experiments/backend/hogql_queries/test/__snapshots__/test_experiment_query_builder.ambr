# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_mean_precompute_write
  '''
  SELECT person_id AS entity_id,
         timestamp AS timestamp,
         uuid AS event_uuid,
                 $session_id AS session_id,
                 coalesce(toFloat(properties.amount), 0) AS numeric_value
  FROM events
  WHERE and(greaterOrEquals(timestamp, '__TIME_WINDOW_MIN__'), less(timestamp, '__TIME_WINDOW_MAX__'), greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(timestamp, plus('__EXPERIMENT_DATE_TO__', toIntervalSecond(604800))), equals(event, 'purchase'))
  '''
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_mean_precompute_write.1
  '7943f0cc2626c567a5bdfec5c7d9edcab47714f2b71b073441d23d2a4df5fbc8'
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_mean_precomputed
  '''
  WITH exposures AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            if(greater(uniqExact(t.variant), 1), '$multiple', argMin(t.variant, t.first_exposure_time)) AS variant,
            min(t.first_exposure_time) AS first_exposure_time,
            max(t.last_exposure_time) AS last_exposure_time,
            argMin(t.exposure_event_uuid, t.first_exposure_time) AS exposure_event_uuid,
            argMin(t.exposure_session_id, t.first_exposure_time) AS exposure_session_id
     FROM experiment_exposures_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000e1', '00000000-0000-0000-0000-0000000000e2']), equals(t.team_id, 99999), greaterOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(t.first_exposure_time, assumeNotNull(toDateTime('2024-01-20 12:00:00'))))
     GROUP BY entity_id),
       metric_events AS
    (SELECT toUUID(t.entity_id) AS entity_id,
            t.timestamp AS timestamp,
            any(t.numeric_value) AS value
     FROM experiment_metric_events_preaggregated AS t
     WHERE and(in(t.job_id, ['00000000-0000-0000-0000-0000000000a1']), equals(t.team_id, 99999), greaterOrEquals(t.timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(t.timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(604800))))
     GROUP BY t.entity_id,
              t.timestamp,
              t.event_uuid),
       entity_metrics AS
    (SELECT exposures.entity_id AS entity_id,
            exposures.variant AS variant,
            sum(coalesce(toFloat(metric_events.value), 0)) AS value
     FROM exposures
     LEFT JOIN metric_events ON and(equals(exposures.entity_id, metric_events.entity_id), and(greaterOrEquals(metric_events.timestamp, exposures.first_exposure_time), less(metric_events.timestamp, plus(exposures.first_exposure_time, toIntervalSecond(604800)))))
     GROUP BY exposures.entity_id,
              exposures.variant)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         sum(entity_metrics.value) AS total_sum,
         sum(power(entity_metrics.value, 2)) AS total_sum_of_squares
  FROM entity_metrics
  GROUP BY entity_metrics.variant
  LIMIT 50000
  '''
# ---
# name: TestExperimentQueryBuilderSnapshots.test_built_query_matches_snapshot_mean_session_property
  '''
  WITH exposures AS
    (SELECT person_id AS entity_id,
            if(greater(uniqExact(properties.$feature_flag_response), 1), '$multiple', any(properties.$feature_flag_response)) AS variant,
            min(timestamp) AS first_exposure_time,
            max(timestamp) AS last_exposure_time,
            argMin(uuid, timestamp) AS exposure_event_uuid,
            argMin($session_id, timestamp) AS exposure_session_id
     FROM events
     WHERE and(greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-20 12:00:00'))), and(equals(event, '$feature_flag_called'), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test']))
     GROUP BY entity_id),
       metric_events_by_session AS
    (SELECT person_id AS entity_id,
            $session_id AS session_id,
            any(session.$session_duration) AS session_value,
            min(timestamp) AS first_event_timestamp
     FROM events
     WHERE and(and(greaterOrEquals(events.timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), less(events.timestamp, plus(assumeNotNull(toDateTime('2024-01-20 12:00:00')), toIntervalSecond(0))), equals(event, '$pageview')), notEquals($session_id, NULL), notEquals($session_id, ''))
     GROUP BY person_id,
              $session_id),
       metric_events AS
    (SELECT exposures.entity_id AS entity_id,
            exposures.variant AS variant,
            toFloat(coalesce(metric_events_by_session.session_value, 0)) AS value,
            metric_events_by_session.session_id AS session_id
     FROM exposures
     INNER JOIN metric_events_by_session ON and(equals(exposures.entity_id, metric_events_by_session.entity_id), greaterOrEquals(metric_events_by_session.first_event_timestamp, exposures.first_exposure_time), true)),
       entity_metrics AS
    (SELECT entity_id, variant, sum(coalesce(toFloat(metric_events.value), 0)) AS value
     FROM metric_events
     GROUP BY entity_id, variant)
  SELECT entity_metrics.variant AS variant,
         count(entity_metrics.entity_id) AS num_users,
         sum(entity_metrics.value) AS total_sum,
         sum(power(entity_metrics.value, 2)) AS total_sum_of_squares
  FROM entity_metrics
  GROUP BY entity_metrics.variant
  LIMIT 50000
  '''
