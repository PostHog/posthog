         max(timestamp) AS last_exposure_time,
         argMin(uuid, timestamp) AS exposure_event_uuid,
         argMin($session_id, timestamp) AS exposure_session_id,
         [] AS breakdown_value
  FROM events
  WHERE and(greaterOrEquals(timestamp, '__TIME_WINDOW_MIN__'), less(timestamp, '__TIME_WINDOW_MAX__'), greaterOrEquals(timestamp, assumeNotNull(toDateTime('2024-01-01 00:00:00'))), lessOrEquals(timestamp, '__EXPERIMENT_DATE_TO__'), and(equals(event, '$feature_flag_called'), equals(properties.$feature_flag, 'checkout-redesign')), notILike(toString(person.properties.email), '%@posthog.com%'), in(properties.$feature_flag_response, ['control', 'test']))
  GROUP BY entity_id
  '''
