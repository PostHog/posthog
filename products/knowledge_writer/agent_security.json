            "id": "merge-judge",
            "at": "products/knowledge_writer/merge_check/judge.py",
            "call": "parse_structured_output",
            "inputs": [
                {
                    "name": "merged diff, cut to MAX_DIFF_CHARACTERS",
                    "writtenBy": "trusted-author"
                },
                {
                    "name": "pull request title",
                    "writtenBy": "trusted-author"
                },
                {
                    "name": "docs page texts",
                    "writtenBy": "org-member"
                }
            ],
            "capabilities": ["ai-gateway"]
        },
        {
            "id": "merge-facts",
            "at": "products/knowledge_writer/merge_check/facts.py",
            "call": "parse_structured_output",
            "inputs": [
                {
                    "name": "merged diff, cut to MAX_FACTS_DIFF_CHARACTERS",
                    "writtenBy": "trusted-author"
                },
                {
                    "name": "pull request title and body, only from a trusted author",
                    "writtenBy": "trusted-author"
                }
            ],
            "capabilities": ["ai-gateway"]
        },
        {
            "id": "draft-grounding",
            "at": "products/knowledge_writer/backend/logic/grounding.py",
