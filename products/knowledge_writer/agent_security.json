                }
            ],
            "capabilities": ["ai-gateway"]
        },
        {
            "id": "writer-task",
            "at": "products/knowledge_writer/backend/logic/launch.py",
            "call": "create_and_run_task",
            "inputs": [
                {
                    "name": "merge check evidence, including the judge reason",
                    "writtenBy": "model-output"
                },
                {
                    "name": "note from the teammate who ran the docs command",
                    "writtenBy": "org-member"
                },
                {
                    "name": "merged source diff, attached as a file",
                    "writtenBy": "trusted-author"
                }
            ],
            "capabilities": [
                "github:clone-only token on the docs repository, used by provisioning and never in the sandbox",
                "network:allowlist",
                "wake:180min"
            ]
        }
