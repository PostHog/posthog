                  ifNull(nullIf(leftUTF8(toString(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^location)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^location)), if(isNull(nullIf(toString(e.properties.location), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.location, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.location, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.location), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.location, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.location, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.location, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.location), '[]'), '{}'), toString(e.properties.location)))))), 400), ''), '$$_posthog_breakdown_null_$$') AS breakdown_value
