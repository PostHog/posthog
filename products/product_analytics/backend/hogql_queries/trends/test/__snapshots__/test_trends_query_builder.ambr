# serializer version: 1
# name: TestTrendsQueryBuilder.test_rank_before_arrays_sql
  '''
  SELECT arrayMap(number -> plus(toStartOfInterval(assumeNotNull(toDateTime(%(hogql_val_14)s, %(hogql_val_15)s)), toIntervalDay(1)), toIntervalDay(number)), range(0, plus(coalesce(dateDiff(%(hogql_val_16)s, toStartOfInterval(assumeNotNull(toDateTime(%(hogql_val_17)s, %(hogql_val_18)s)), toIntervalDay(1)), toStartOfInterval(assumeNotNull(toDateTime(%(hogql_val_19)s, %(hogql_val_20)s)), toIntervalDay(1)))), 1))) AS date,
         arrayMap(d -> arraySum(arrayMap((v, dd) -> if(ifNull(equals(dd, d), isNull(dd)
                                                              and isNull(d)), v, 0), vals, days)), date) AS total,
         breakdown_value AS breakdown_value
  FROM
    (SELECT groupArray(day_start) AS days,
            groupArray(value) AS vals,
            breakdown_value AS breakdown_value
     FROM
       (SELECT day_start AS day_start,
               sum(accurateCastOrNull(count, %(hogql_val_12)s)) AS value,
               if(ifNull(greaterOrEquals(row_number, 2), 0), %(hogql_val_13)s, breakdown_value) AS breakdown_value
        FROM
          (SELECT count AS count,
                           day_start AS day_start,
                           breakdown_value AS breakdown_value,
                           minus(dense_rank() OVER (
                                                    ORDER BY if(ifNull(equals(breakdown_value, %(hogql_val_10)s), 0), 2, if(ifNull(equals(breakdown_value, %(hogql_val_11)s), 0), 1, 0)) ASC, breakdown_total DESC, breakdown_value ASC), 1) AS row_number
           FROM
             (SELECT count AS count,
                              day_start AS day_start,
                              breakdown_value AS breakdown_value,
                              sum(count) OVER (PARTITION BY breakdown_value) AS breakdown_total
              FROM
                (SELECT sum(total) AS count,
                        day_start AS day_start,
                        breakdown_value AS breakdown_value
                 FROM
                   (SELECT count() AS total,
                           toStartOfDay(toTimeZone(e.timestamp, %(hogql_val_0)s)) AS day_start,
                           ifNull(nullIf(leftUTF8(toString(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(e.properties, %(hogql_val_1)s), ''), 'null'), '^"|"$', '')), 400), %(hogql_val_2)s), %(hogql_val_3)s) AS breakdown_value
                    FROM events AS e
                    WHERE and(equals(e.team_id, 99999), greaterOrEquals(e.timestamp, toDateTime64(toStartOfInterval(assumeNotNull(toDateTime(%(hogql_val_4)s, %(hogql_val_5)s)), toIntervalDay(1)), 6, %(hogql_val_6)s)), lessOrEquals(e.timestamp, assumeNotNull(toDateTime(%(hogql_val_7)s, %(hogql_val_8)s))), equals(e.event, %(hogql_val_9)s))
                    GROUP BY day_start,
                             breakdown_value)
                 GROUP BY day_start,
                          breakdown_value
                 ORDER BY day_start ASC,
                          breakdown_value ASC)))
        WHERE isNotNull(breakdown_value)
        GROUP BY day_start,
                 breakdown_value)
     GROUP BY breakdown_value)
  ORDER BY if(ifNull(equals(breakdown_value, %(hogql_val_21)s), 0), 2, if(ifNull(equals(breakdown_value, %(hogql_val_22)s), 0), 1, 0)) ASC, arraySum(total) DESC, breakdown_value ASC
  LIMIT 100 SETTINGS readonly=2,
                     max_execution_time=60,
                     allow_experimental_object_type=1,
                     max_ast_elements=4000000,
                     max_expanded_ast_elements=4000000,
                     max_bytes_before_external_group_by=0,
                     transform_null_in=1,
                     optimize_min_equality_disjunction_chain_length=4294967295,
                     optimize_rewrite_aggregate_function_with_if=0,
                     optimize_min_inequality_conjunction_chain_length=4294967295,
                     allow_experimental_join_condition=1,
                     use_hive_partitioning=0
  '''
# ---
