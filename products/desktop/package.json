{
  "name": "posthog-code",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the PostHog desktop app and agent framework",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "postinstall": "bash scripts/ensure-phrocs.sh --update",
    "bootstrap:cloud-task": "pnpm install --frozen-lockfile --prefer-offline --ignore-scripts && pnpm build:deps",
    "dev": "node scripts/dev-with-skills.mjs pnpm dev:app",
    "dev:app": "pnpm build:deps && bash scripts/ensure-phrocs.sh && bin/phrocs --config mprocs.yaml",
    "dev:mprocs": "node scripts/dev-with-skills.mjs pnpm dev:app:mprocs",
    "dev:app:mprocs": "pnpm build:deps && mprocs",
    "dev:agent": "pnpm --filter agent dev",
    "dev:git": "pnpm --filter @posthog/git dev",
    "dev:code": "node scripts/dev-with-skills.mjs pnpm --filter code start",
    "app:cdp": "node scripts/electron-cdp.mjs",
    "build": "turbo build",
    "build:deps": "turbo build --filter=@posthog/code^...",
    "package": "turbo build && pnpm --filter code package",
    "test": "turbo test --concurrency=2",
    "test:bun": "turbo test --filter=@posthog/core --filter=@posthog/cli",
    "test:vitest": "pnpm --filter code --filter @posthog/electron-trpc test",
    "test:e2e": "pnpm --filter code test:e2e",
    "test:e2e:headed": "pnpm --filter code test:e2e:headed",
    "test:e2e:web": "pnpm --filter @posthog/web test:e2e",
    "test:e2e:web:ui": "pnpm --filter @posthog/web test:e2e:ui",
    "rebuild:sqlite-node": "node scripts/rebuild-better-sqlite3-node.mjs",
    "rebuild:sqlite-electron": "node scripts/rebuild-better-sqlite3-electron.mjs",
    "typecheck": "turbo typecheck",
    "boundaries": "node scripts/check-host-boundaries.mjs",
    "lint": "biome check --write --unsafe",
    "format": "biome format --write",
    "clean": "pnpm -r clean",
    "knip": "knip",
    "benjamin:sync": "node scripts/sync-benjamin.mts",
    "skills:pull": "node scripts/pull-skills.mjs",
    "hosthog:build": "pnpm install --frozen-lockfile --ignore-scripts --filter @posthog/web... && SKIP_PRODUCT_ENGINEER_SKILLS_DOWNLOAD=1 pnpm exec turbo build --filter=@posthog/web && ln -sfn apps/web/dist dist"
  },
  "keywords": [
    "posthog",
    "code",
    "tasks",
    "developer-tools",
    "agent"
  ],
  "author": "PostHog",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@posthog/shared": "workspace:*",
    "fflate": "^0.8.2",
    "knip": "^5.66.3",
    "mprocs": "^0.7.1",
    "turbo": "^2.9.16"
  },
  "lint-staged": {
    "*.{mjs,json,jsonc,css}": "biome check --write --unsafe --files-ignore-unknown=true --no-errors-on-unmatched",
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --unsafe --files-ignore-unknown=true --no-errors-on-unmatched",
      "bash -c 'pnpm typecheck'"
    ]
  }
}
