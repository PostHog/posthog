{
  "name": "@posthog/harness",
  "version": "0.0.0-dev",
  "description": "Spawn the pi.dev coding agent (CLI + SDK) against the PostHog LLM gateway with PostHog OAuth",
  "type": "module",
  "bin": {
    "harness": "dist/cli.js",
    "hog": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./project-trust": {
      "types": "./dist/project-trust.d.ts",
      "import": "./dist/project-trust.js"
    },
    "./extensions": {
      "types": "./dist/extensions/registry.d.ts",
      "import": "./dist/extensions/registry.js"
    },
    "./extensions/auto-publish": {
      "types": "./dist/extensions/auto-publish/index.d.ts",
      "import": "./dist/extensions/auto-publish/index.js"
    },
    "./extensions/hog-branding": {
      "types": "./dist/extensions/hog-branding/index.d.ts",
      "import": "./dist/extensions/hog-branding/index.js"
    },
    "./extensions/posthog-provider": {
      "types": "./dist/extensions/posthog-provider/index.d.ts",
      "import": "./dist/extensions/posthog-provider/index.js"
    },
    "./extensions/posthog-provider/model-catalog": {
      "types": "./dist/extensions/posthog-provider/model-catalog.d.ts",
      "import": "./dist/extensions/posthog-provider/model-catalog.js"
    },
    "./extensions/product-engineer": {
      "types": "./dist/extensions/product-engineer/index.d.ts",
      "import": "./dist/extensions/product-engineer/index.js"
    },
    "./extensions/web-access": {
      "types": "./dist/extensions/web-access/index.d.ts",
      "import": "./dist/extensions/web-access/index.js"
    },
    "./extensions/orchestration": {
      "types": "./dist/extensions/orchestration/index.d.ts",
      "import": "./dist/extensions/orchestration/index.js"
    },
    "./extensions/mcp": {
      "types": "./dist/extensions/mcp/index.d.ts",
      "import": "./dist/extensions/mcp/index.js"
    },
    "./extensions/mcp/config": {
      "types": "./dist/extensions/mcp/config.d.ts",
      "import": "./dist/extensions/mcp/config.js"
    },
    "./extensions/mcp/schema": {
      "types": "./dist/extensions/mcp/schema.d.ts",
      "import": "./dist/extensions/mcp/schema.js"
    },
    "./extensions/footer-focus-demo": {
      "types": "./dist/extensions/footer-focus-demo/index.d.ts",
      "import": "./dist/extensions/footer-focus-demo/index.js"
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist --rootDir src",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rimraf.mjs dist .turbo"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/shared": "workspace:*",
    "fflate": "^0.8.2",
    "lru-cache": "^11.1.0",
    "turndown": "^7.2.4",
    "typebox": "1.3.7",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}
