/**
 * Build-boundary loader for desktop preview configuration.
 *
 * `POSTHOG_DESKTOP_PREVIEW_CONFIG` names a JSON file generated by the preview
 * provisioning job (a validated `DesktopPreviewManifest`). This script reads
 * and validates it once at build time, so electron-vite can inline it into the
 * main and renderer bundles and electron-builder can derive the packaging
 * identity from it. Runtime code never touches the file or the environment:
 * it consumes the inlined constant (see `src/main/preview.ts`).
 *
 * An unset variable means an ordinary build. Dev and test builds refuse a
 * manifest, so a release build can never bake preview configuration.
 */

import { readFileSync } from "node:fs";
import {
  type DesktopPreviewManifest,
  parseDesktopPreviewManifest,
} from "@posthog/shared";

export function loadPreviewManifest(): DesktopPreviewManifest | null {
  const path = process.env.POSTHOG_DESKTOP_PREVIEW_CONFIG;
  if (!path) {
    return null;
  }
  let raw: unknown;
  try {
    raw = JSON.parse(readFileSync(path, "utf8"));
  } catch (error) {
    throw new Error(
      `POSTHOG_DESKTOP_PREVIEW_CONFIG: cannot read ${path}: ${error instanceof Error ? error.message : String(error)}`,
    );
  }
  const manifest = parseDesktopPreviewManifest(raw);
  if (
    manifest.repository !== "PostHog/posthog" ||
    manifest.prNumber !== Number(process.env.POSTHOG_DESKTOP_PREVIEW_PR) ||
    manifest.commitSha !== process.env.POSTHOG_DESKTOP_PREVIEW_SHA
  ) {
    throw new Error(
      "Preview manifest does not match the requested repository, PR, and commit.",
    );
  }
  return manifest;
}
