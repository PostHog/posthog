/**
 * Build-boundary loader for desktop preview configuration.
 *
 * `POSTHOG_DESKTOP_PREVIEW_CONFIG` names a JSON file generated by the preview
 * provisioning job (a validated `DesktopPreviewManifest`). This script reads
 * and validates it once at build time and returns the typed manifest plus the
 * derived application identity, so electron-vite can inline the same values
 * into the main and renderer bundles and electron-builder can stamp them into
 * packaging metadata. Runtime code never touches the file or the environment:
 * it consumes the inlined constants (see `src/main/preview.ts`).
 *
 * An unset variable means an ordinary build; the caller must pass the result
 * through `assertNoPreviewConfig` on the ordinary path so a release build
 * fails closed when preview configuration is present.
 */

import { readFileSync } from "node:fs";
import {
  assertNoPreviewConfig,
  type DesktopPreviewIdentity,
  type DesktopPreviewManifest,
  desktopPreviewIdentity,
  parseDesktopPreviewManifest,
} from "@posthog/shared";

export interface PreviewBuildConfig {
  manifest: DesktopPreviewManifest;
  identity: DesktopPreviewIdentity;
}

export function loadPreviewBuildConfig(): PreviewBuildConfig | null {
  const path = process.env.POSTHOG_DESKTOP_PREVIEW_CONFIG;
  if (!path) {
    return null;
  }
  let raw: unknown;
  try {
    raw = JSON.parse(readFileSync(path, "utf8"));
  } catch (error) {
    throw new Error(
      `POSTHOG_DESKTOP_PREVIEW_CONFIG: cannot read ${path}: ${error instanceof Error ? error.message : String(error)}`,
    );
  }
  const manifest = parseDesktopPreviewManifest(raw);
  return { manifest, identity: desktopPreviewIdentity(manifest) };
}

/** The ordinary-build guard: preview input on a release build is a packaging bug. */
export function assertOrdinaryBuild(preview: PreviewBuildConfig | null): void {
  assertNoPreviewConfig(preview ? preview.manifest : null);
}
