{
  "name": "@posthog/code",
  "version": "0.0.0-dev",
  "description": "PostHog - the agentic workspace for product builders",
  "homepage": "https://posthog.com/desktop",
  "main": ".vite/build/bootstrap.js",
  "versionHash": "dynamic",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "bash bin/setup",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite dev --watch",
    "start:debug": "electron-vite dev --watch --inspect=5858",
    "compile": "electron-vite build",
    "package": "bash scripts/compile-glass-icon.sh && electron-vite build && electron-builder build --dir --config electron-builder.ts",
    "package:dev": "bash scripts/compile-glass-icon.sh && FORCE_DEV_MODE=1 SKIP_NOTARIZE=1 electron-vite build && electron-builder build --dir --config electron-builder.ts",
    "make": "bash scripts/compile-glass-icon.sh && electron-vite build && electron-builder build --config electron-builder.ts",
    "make:linux": "bash scripts/build-linux-docker.sh",
    "publish": "bash scripts/compile-glass-icon.sh && electron-vite build && electron-builder build --publish always --config electron-builder.ts",
    "build": "pnpm package",
    "build-icons": "bash scripts/generate-icns.sh",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "generate-client": "pnpm --filter @posthog/api-client generate-client",
    "test": "vitest run",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=tests/e2e/playwright.config.ts --headed",
    "postinstall": "bash scripts/postinstall.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "test-storybook --ci --browsers chromium --no-index-json",
    "test:visual:update": "test-storybook -u --browsers chromium --no-index-json",
    "test:visual:ci:update": "test-storybook -u --junit --browsers chromium --no-index-json --maxWorkers=2",
    "clean": "node ../../scripts/rimraf.mjs .vite .turbo out node_modules/.vite"
  },
  "keywords": [
    "posthog",
    "posthog-code",
    "tasks",
    "developer-tools"
  ],
  "author": "PostHog <eng@posthog.com>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@posthog/rollup-plugin": "^1.6.4",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.12",
    "adm-zip": "^0.6.1",
    "electron": "^42.11.18",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "jest-image-snapshot": "^6.5.2",
    "jimp": "^1.6.1",
    "jsdom": "^26.0.0",
    "mockdate": "^3.0.5",
    "playwright": "^1.64.1",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@inversifyjs/strongly-typed": "2.2.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@parcel/watcher": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.2.11",
    "@posthog/agent": "link:../../../../packages/agent/packages/agent",
    "@posthog/api-client": "workspace:*",
    "@posthog/core": "workspace:*",
    "@posthog/di": "workspace:*",
    "@posthog/electron-trpc": "workspace:*",
    "@posthog/enricher": "link:../../../../packages/agent/packages/enricher",
    "@posthog/git": "link:../../../../packages/agent/packages/git",
    "@posthog/hedgehog-mode": "^0.0.63",
    "@posthog/host-router": "workspace:*",
    "@posthog/host-trpc": "workspace:*",
    "@posthog/platform": "workspace:*",
    "@posthog/quill": "catalog:",
    "@posthog/shared": "workspace:*",
    "@posthog/ui": "workspace:*",
    "@posthog/workspace-client": "workspace:*",
    "@posthog/workspace-server": "workspace:*",
    "@radix-ui/themes": "^3.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-plugin": "^1.168.48",
    "@trpc/client": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@trpc/tanstack-react-query": "^11.22.1",
    "better-sqlite3": "^12.11.1",
    "bplist-parser": "^0.5.0",
    "chokidar": "^5.0.0",
    "detect-libc": "^2.1.2",
    "dotenv": "^18.0.9",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "file-icon": "^6.0.0",
    "inversify": "^7.10.6",
    "is-glob": "^4.0.3",
    "koffi": "^3.3.5",
    "lucide-react": "^1.7.0",
    "micromatch": "^4.0.5",
    "node-addon-api": "^8.9.2",
    "node-machine-id": "^1.1.12",
    "node-pty": "1.1.0",
    "posthog-node": "^5.69.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-grab": "^0.2.0",
    "react-hotkeys-hook": "^4.4.4",
    "react-scan": "^0.5.6",
    "reflect-metadata": "^0.2.2",
    "superjson": "catalog:",
    "zod": "^4.4.3",
    "zustand": "^4.5.0"
  }
}
