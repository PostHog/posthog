  "automations": [
    {
      "object": "automation",
      "id": "a0000000-0000-4000-8000-000000000001",
      "name": "Welcome series",
      "status": "enabled",
      "created_at": "2026-10-01 12:00:00.000000+00",
      "updated_at": "2026-10-01 12:00:00.000000+00",
      "steps": [
        {
          "key": "start",
          "type": "trigger",
          "config": {
            "event_name": "user.created"
          }
        },
        {
          "key": "welcome",
          "type": "send_email",
          "config": {
            "template": {
              "id": "70000000-0000-4000-8000-000000000001",
              "variables": {
                "NAME": {
                  "var": "event.name"
                },
                "PLAN": "free"
              }
            }
          }
        },
        {
          "key": "wait",
          "type": "delay",
          "config": {
            "duration": "2 days"
          }
        },
        {
          "key": "is_pro",
          "type": "condition",
          "config": {
            "type": "rule",
            "field": "contact.plan",
            "operator": "eq",
            "value": "pro"
          }
        },
        {
          "key": "wait_upgrade",
          "type": "wait_for_event",
          "config": {
            "event_name": "plan.upgraded",
            "timeout": "3 days"
          }
        },
        {
          "key": "receipt",
          "type": "send_email",
          "config": {
            "template": {
              "id": "receipt"
            },
            "subject": "Thanks for upgrading"
          }
        },
        {
          "key": "tag",
          "type": "add_to_segment",
          "config": {
            "segment_id": "seg-1"
          }
        },
        {
          "key": "update",
          "type": "contact_update",
          "config": {
            "first_name": {
              "var": "event.first_name"
            }
          }
        }
      ],
      "connections": [
        {
          "from": "start",
          "to": "welcome",
          "type": "default"
        },
        {
          "from": "welcome",
          "to": "wait",
          "type": "default"
        },
        {
          "from": "wait",
          "to": "is_pro",
          "type": "default"
        },
        {
          "from": "is_pro",
          "to": "tag",
          "type": "condition_met"
        },
        {
          "from": "is_pro",
          "to": "wait_upgrade",
          "type": "condition_not_met"
        },
        {
          "from": "wait_upgrade",
          "to": "receipt",
          "type": "event_received"
        },
        {
          "from": "wait_upgrade",
          "to": "update",
          "type": "timeout"
        }
      ]
    },
    {
      "object": "automation",
      "id": "a0000000-0000-4000-8000-000000000002",
      "name": "Re-engagement",
      "status": "disabled",
      "created_at": "2026-10-01 12:00:00.000000+00",
      "updated_at": "2026-10-01 12:00:00.000000+00",
      "steps": [
        {
