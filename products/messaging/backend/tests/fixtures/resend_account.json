          "type": "trigger",
          "config": {
            "event_name": "user.inactive"
          }
        },
        {
          "key": "send",
          "type": "send_email",
          "config": {
            "template": {
              "id": "70000000-0000-4000-8000-000000000099"
            }
          }
        },
        {
          "key": "bye",
          "type": "contact_delete",
          "config": {}
        }
      ],
      "connections": [
        {
          "from": "start",
          "to": "send",
          "type": "default"
        },
        {
          "from": "send",
          "to": "bye",
          "type": "default"
        }
      ]
    }
  ]
