# name: TestWebVitalsPathBreakdownQueryRunner.test_data_correctly_split_between_bands[new_events_schema]
  '''
  SELECT band AS band,
         path AS path,
                 value AS value
  FROM
    (SELECT multiIf(ifNull(lessOrEquals(value, 100.0), 0), 'good', ifNull(lessOrEquals(value, 200.0), 0), 'needs_improvements', 'poor') AS band,
            path AS path,
                    value AS value
     FROM
       (SELECT if(notEquals(toJSONString(events.properties.^`$pathname`), '{}'), toJSONString(events.properties.^`$pathname`), if(isNull(events.properties.`$pathname`), NULL, if(and(in(ascii(toString(events.properties.`$pathname`)), tuple(91, 123)), in(ascii(toJSONString(events.properties.`$pathname`)), tuple(91, 123))), toJSONString(events.properties.`$pathname`), toString(events.properties.`$pathname`)))) AS path,
               quantile(0.75)(accurateCastOrNull(events.properties.`$web_vitals_INP_value`, 'Float64')) AS value
