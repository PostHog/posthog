  '''
  SELECT url AS `context.columns.url`,
         tuple(uniqIf(filtered_person_id, and(greaterOrEquals(start_timestamp, assumeNotNull(toDateTime('2023-12-01 00:00:00', 'UTC'))), lessOrEquals(start_timestamp, assumeNotNull(toDateTime('2023-12-11 23:59:59', 'UTC'))))), uniqIf(filtered_person_id, 0)) AS `context.columns.visitors`,
