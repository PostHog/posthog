icType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$prev_pageview_duration`), '[]'), '{}'), toString(events.properties.`$prev_pageview_duration`)))))), or(and(greaterOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-02 12:00:00', 'UTC'))), lessOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-15 23:59:59', 'UTC')))), 0), 1, 1))
