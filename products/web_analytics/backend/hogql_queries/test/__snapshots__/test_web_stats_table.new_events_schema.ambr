           GROUP BY raw_sessions.session_id_v7) AS events__session ON equals(toUInt128(toUUIDOrNull(events.properties.`$session_id`)), events__session.session_id_v7)
        LEFT OUTER JOIN
          (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
                  person_distinct_id_overrides.distinct_id AS distinct_id
           FROM person_distinct_id_overrides
           WHERE equals(person_distinct_id_overrides.team_id, 99999)
           GROUP BY person_distinct_id_overrides.distinct_id
           HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
        WHERE and(equals(events.team_id, 99999), and(or(equals(events.event, '$pageview'), equals(events.event, '$screen')), or(and(greaterOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-06 00:00:00', 'UTC'))), lessOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-13 23:59:59', 'UTC')))), and(greaterOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-11-28 00:00:00', 'UTC'))), lessOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-05 23:59:59', 'UTC'))))), 1, 1))
        GROUP BY session_id,
                 breakdown_value)
     GROUP BY breakdown_value) AS counts
  LEFT JOIN
    (SELECT if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$prev_pageview_pathname`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$prev_pageview_pathname`)), if(isNull(nullIf(toString(events.properties.`$prev_pageview_pathname`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$prev_pageview_pathname`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$prev_pageview_pathname`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$prev_pageview_pathname`), '[]'), '{}'), toString(events.properties.`$prev_pageview_pathname`))))) AS breakdown_value,
            quantileIf(0.9)(least(accurateCastOrNull(events.properties.`$prev_pageview_duration`, 'Float64'), 86400),
