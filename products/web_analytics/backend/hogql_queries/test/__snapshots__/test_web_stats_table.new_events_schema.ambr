     FROM events_json AS events
     WHERE and(equals(events.team_id, 99999), and(or(equals(events.event, '$pageview'), equals(events.event, '$pageleave'), equals(events.event, '$screen')), isNotNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$prev_pageview_pathname`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$prev_pageview_pathname`)), if(isNull(nullIf(toString(events.properties.`$prev_pageview_pathname`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$prev_pageview_pathname`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$prev_pageview_pathname`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_pathname`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$prev_pageview_pathname`), '[]'), '{}'), toString(events.properties.`$prev_pageview_pathname`)))))), isNotNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$prev_pageview_duration`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^`$prev_pageview_duration`)), if(isNull(nullIf(toString(events.properties.`$prev_pageview_duration`), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.`$prev_pageview_duration`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.`$prev_pageview_duration`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.`$prev_pageview_duration`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.`$prev_pageview_duration`), '[]'), '{}'), toString(events.properties.`$prev_pageview_duration`)))))), or(and(greaterOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-06 00:00:00', 'UTC'))), lessOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-13 23:59:59', 'UTC')))), and(greaterOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-11-28 00:00:00', 'UTC'))), lessOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2023-12-05 23:59:59', 'UTC'))))), 1, 1))
     GROUP BY breakdown_value) AS time_on_page ON equals(counts.breakdown_value, time_on_page.breakdown_value)
  LEFT JOIN
    (SELECT breakdown_value AS breakdown_value,
            avgIf(is_bounce, and(greaterOrEquals(start_timestamp, assumeNotNull(toDateTime('2023-12-06 00:00:00', 'UTC'))), lessOrEquals(start_timestamp, assumeNotNull(toDateTime('2023-12-13 23:59:59', 'UTC'))))) AS bounce_rate,
            avgIf(is_bounce, and(greaterOrEquals(start_timestamp, assumeNotNull(toDateTime('2023-11-28 00:00:00', 'UTC'))), lessOrEquals(start_timestamp, assumeNotNull(toDateTime('2023-12-05 23:59:59', 'UTC'))))) AS previous_bounce_rate
     FROM
