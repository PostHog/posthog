        GROUP BY person_distinct_id_overrides.distinct_id
        HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
     WHERE and(equals(events.team_id, 99999), and(or(and(greaterOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2024-06-26 00:00:00', 'UTC'))), lessOrEquals(toTimeZone(events.timestamp, 'UTC'), assumeNotNull(toDateTime('2024-06-27 23:59:59', 'UTC')))), 0), or(equals(events.event, '$pageview'), equals(events.event, '$screen')), isNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^utm_source)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^utm_source)), if(isNull(nullIf(toString(events.properties.utm_source), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.utm_source, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.utm_source, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.utm_source), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.utm_source, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.utm_source, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.utm_source, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.utm_source), '[]'), '{}'), toString(events.properties.utm_source))))))))
     GROUP BY session_id,
              breakdown_value)
  GROUP BY `context.columns.breakdown_value`
