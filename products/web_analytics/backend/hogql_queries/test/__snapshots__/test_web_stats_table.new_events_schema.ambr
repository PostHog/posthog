roperties.^fbclid)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^fbclid)), if(isNull(nullIf(toString(events.properties.fbclid), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.fbclid, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.fbclid, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.fbclid), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.fbclid, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.fbclid, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.fbclid, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.fbclid), '[]'), '{}'), toString(events.properties.fbclid))))), if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^gad_source)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(events.properties.^gad_source)), if(isNull(nullIf(toString(events.properties.gad_source), '')), NULL, if(startsWith(dynamicType(accurateCast(events.properties.gad_source, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(events.properties.gad_source, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(events.properties.gad_source), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(events.properties.gad_source, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(events.properties.gad_source, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(events.properties.gad_source, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(events.properties.gad_source), '[]'), '{}'), toString(events.properties.gad_source)))))), toTimeZone(events.timestamp, 'UTC'), in(events.event, tuple('$pageview', '$screen'))) AS first_pageview_properties,
               if(ifNull(equals(bitAnd(bitShiftRight(toUInt128(toUUIDOrNull(events.properties.`$session_id`)), 76), 15), 7), 0), events.properties.`$session_id`, NULL) AS session_id,
