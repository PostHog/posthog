# name: TestErrorTrackingQueryRunner.test_issue_grouping[new_events_schema]
  '''
  SELECT fp_state.issue_id AS id,
         any(fp_state.issue_status) AS status,
         any(fp_state.issue_severity) AS severity,
         any(fp_state.issue_name) AS name,
         any(fp_state.issue_description) AS description,
         any(fp_state.assigned_user_id) AS assignee_user_id,
         any(fp_state.assigned_role_id) AS assignee_role_id,
         min(fp_state.first_seen) AS first_seen,
         max(ev.last_seen_fp) AS last_seen,
         argMaxMerge(ev.function_state) AS function,
         argMaxMerge(ev.source_state) AS source,
         sum(ev.occ) AS occurrences,
         least(uniqMerge(ev.sessions_state), sum(ev.occ)) AS sessions,
         least(uniqMerge(ev.users_state), sum(ev.occ)) AS users,
         sumForEach(arrayMap(i -> if(ifNull(equals(ev.bin_idx, i), isNull(ev.bin_idx)
                                            and isNull(i)), ev.occ, toUInt64(0)), range(0, 1))) AS volumeRange,
         argMaxMerge(ev.library_state) AS library
  FROM
    (SELECT cityHash64(JSONExtractString(ifNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$exception_fingerprint`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$exception_fingerprint`)), if(isNull(nullIf(toString(e.properties.`$exception_fingerprint`), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'DateTime'), concat('"', ifNull(toString(concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$exception_fingerprint`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$exception_fingerprint`), 20, 10)), ''), 'Z')), ''), '"'), nullIf(nullIf(toJSONString(e.properties.`$exception_fingerprint`), '[]'), '{}')))), ''))) AS fp_hash,
            max(toTimeZone(e.timestamp, 'UTC')) AS last_seen_fp,
            argMaxState(if(isNull(nullIf(toString(e.properties.`$exception_functions`[-1]), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$exception_functions`[-1], 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$exception_functions`[-1], 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$exception_functions`[-1]), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$exception_functions`[-1], 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$exception_functions`[-1], 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$exception_functions`[-1], 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$exception_functions`[-1]), '[]'), '{}'), toString(e.properties.`$exception_functions`[-1])))), toTimeZone(e.timestamp, 'UTC')) AS function_state,
            argMaxState(if(isNull(nullIf(toString(e.properties.`$exception_sources`[-1]), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$exception_sources`[-1], 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$exception_sources`[-1]), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$exception_sources`[-1]), '[]'), '{}'), toString(e.properties.`$exception_sources`[-1])))), toTimeZone(e.timestamp, 'UTC')) AS source_state,
            argMaxState(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$lib`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$lib`)), if(isNull(nullIf(toString(e.properties.`$lib`), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$lib`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$lib`), '[]'), '{}'), toString(e.properties.`$lib`))))), toTimeZone(e.timestamp, 'UTC')) AS library_state,
            least(0, intDiv(dateDiff('seconds', toDateTime(toDateTime64('2018-01-11 12:11:00.000000', 6, 'UTC'), 'UTC'), toTimeZone(e.timestamp, 'UTC')), greatest(1, intDiv(dateDiff('seconds', toDateTime(toDateTime64('2018-01-11 12:11:00.000000', 6, 'UTC'), 'UTC'), toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')), 1)))) AS bin_idx,
            count() AS occ,
            uniqState(nullIf(e.properties.`$session_id`, '')) AS sessions_state,
            uniqState(coalesce(nullIf(toString(e.person_id), '00000000-0000-0000-0000-000000000000'), e.distinct_id)) AS users_state
     FROM events_json AS e
     WHERE and(equals(e.team_id, 99999), equals(e.event, '$exception'), isNotNull(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$exception_fingerprint`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$exception_fingerprint`)), if(isNull(nullIf(toString(e.properties.`$exception_fingerprint`), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$exception_fingerprint`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$exception_fingerprint`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$exception_fingerprint`), '[]'), '{}'), toString(e.properties.`$exception_fingerprint`)))))), greaterOrEquals(e.timestamp, toDateTime(toDateTime64('2018-01-11 12:11:00.000000', 6, 'UTC'), 'UTC')), lessOrEquals(e.timestamp, toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')))
     GROUP BY fp_hash,
              bin_idx) AS ev
  INNER JOIN
    (SELECT cityHash64(error_tracking_fingerprint_issue_state.fingerprint) AS fp_hash,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_id), error_tracking_fingerprint_issue_state.version), 1)) AS issue_id,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_status), error_tracking_fingerprint_issue_state.version), 1)) AS issue_status,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_severity), error_tracking_fingerprint_issue_state.version), 1)) AS issue_severity,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_name), error_tracking_fingerprint_issue_state.version), 1)) AS issue_name,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_description), error_tracking_fingerprint_issue_state.version), 1)) AS issue_description,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.assigned_user_id), error_tracking_fingerprint_issue_state.version), 1)) AS assigned_user_id,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.assigned_role_id), error_tracking_fingerprint_issue_state.version), 1)) AS assigned_role_id,
            toNullable(tupleElement(argMax(tuple(toTimeZone(error_tracking_fingerprint_issue_state.first_seen, 'UTC')), error_tracking_fingerprint_issue_state.version), 1)) AS first_seen
     FROM error_tracking_fingerprint_issue_state
     WHERE equals(error_tracking_fingerprint_issue_state.team_id, 99999)
     GROUP BY fp_hash
     HAVING equals(argMax(error_tracking_fingerprint_issue_state.is_deleted, error_tracking_fingerprint_issue_state.version), 0) SETTINGS optimize_aggregation_in_order=1) AS fp_state ON equals(ev.fp_hash, fp_state.fp_hash)
  WHERE and(isNotNull(fp_state.issue_id), ifNull(equals(fp_state.issue_id, '01936e7f-d7ff-7314-b2d4-7627981e34f0'), 0))
  GROUP BY id
  ORDER BY last_seen DESC
  LIMIT 101
  OFFSET 0 SETTINGS readonly=2,
                    max_execution_time=60,
                    allow_experimental_object_type=1,
                    max_ast_elements=4000000,
                    max_expanded_ast_elements=4000000,
                    max_bytes_before_external_group_by=0,
                    transform_null_in=1,
                    optimize_min_equality_disjunction_chain_length=4294967295,
                    optimize_rewrite_aggregate_function_with_if=0,
                    optimize_min_inequality_conjunction_chain_length=4294967295,
                    allow_experimental_join_condition=1,
                    use_hive_partitioning=0
  '''
