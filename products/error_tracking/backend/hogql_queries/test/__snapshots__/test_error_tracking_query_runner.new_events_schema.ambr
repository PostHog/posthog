         argMax(if(isNull(nullIf(toString(e.properties.`$exception_sources`[-1]), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$exception_sources`[-1], 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$exception_sources`[-1]), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$exception_sources`[-1], 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$exception_sources`[-1]), '[]'), '{}'), toString(e.properties.`$exception_sources`[-1])))), toTimeZone(e.timestamp, 'UTC')) AS source,
         argMax(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$lib`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$lib`)), if(isNull(nullIf(toString(e.properties.`$lib`), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$lib`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$lib`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$lib`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$lib`), '[]'), '{}'), toString(e.properties.`$lib`))))), toTimeZone(e.timestamp, 'UTC')) AS library
  FROM events_json AS e
  LEFT OUTER JOIN
    (SELECT cityHash64(error_tracking_fingerprint_issue_state.fingerprint) AS fp_hash,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_id), error_tracking_fingerprint_issue_state.version), 1)) AS issue_id,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_status), error_tracking_fingerprint_issue_state.version), 1)) AS issue_status,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_severity), error_tracking_fingerprint_issue_state.version), 1)) AS issue_severity,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_name), error_tracking_fingerprint_issue_state.version), 1)) AS issue_name,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.issue_description), error_tracking_fingerprint_issue_state.version), 1)) AS issue_description,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.assigned_user_id), error_tracking_fingerprint_issue_state.version), 1)) AS assigned_user_id,
            toNullable(tupleElement(argMax(tuple(error_tracking_fingerprint_issue_state.assigned_role_id), error_tracking_fingerprint_issue_state.version), 1)) AS assigned_role_id,
            toNullable(tupleElement(argMax(tuple(toTimeZone(error_tracking_fingerprint_issue_state.first_seen, 'UTC')), error_tracking_fingerprint_issue_state.version), 1)) AS first_seen
     FROM error_tracking_fingerprint_issue_state
     WHERE equals(error_tracking_fingerprint_issue_state.team_id, 99999)
     GROUP BY fp_hash
     HAVING equals(argMax(error_tracking_fingerprint_issue_state.is_deleted, error_tracking_fingerprint_issue_state.version), 0) SETTINGS optimize_aggregation_in_order=1) AS e__fingerprint_issue_state ON equals(cityHash64(if(notEquals(JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$exception_fingerprint`)), '{}'), JSONStripEmptyStringsAndNulls(toJSONString(e.properties.^`$exception_fingerprint`)), if(isNull(nullIf(toString(e.properties.`$exception_fingerprint`), '')), NULL, if(startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'DateTime'), concat(ifNull(toString(replaceOne(substring(toString(accurateCastOrNull(e.properties.`$exception_fingerprint`, 'DateTime64(9, \'UTC\')')), 1, 19), ' ', 'T')), ''), ifNull(toString(substring(toString(e.properties.`$exception_fingerprint`), 20, 10)), ''), 'Z'), if(or(startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'Array'), startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'Map'), startsWith(dynamicType(accurateCast(e.properties.`$exception_fingerprint`, 'Dynamic')), 'Tuple')), nullIf(nullIf(toJSONString(e.properties.`$exception_fingerprint`), '[]'), '{}'), toString(e.properties.`$exception_fingerprint`)))))), e__fingerprint_issue_state.fp_hash)
  WHERE and(equals(e.team_id, 99999), equals(e.event, '$exception'), isNotNull(e__fingerprint_issue_state.issue_id), greaterOrEquals(e.timestamp, toDateTime(toDateTime64('2018-01-11 12:11:00.000000', 6, 'UTC'), 'UTC')), lessOrEquals(e.timestamp, toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')), ifNull(equals(e__fingerprint_issue_state.issue_name, 'TypeError'), 0))
  GROUP BY id
  ORDER BY last_seen DESC
  LIMIT 101
  OFFSET 0 SETTINGS readonly=2,
                    max_execution_time=60,
                    allow_experimental_object_type=1,
                    max_ast_elements=4000000,
