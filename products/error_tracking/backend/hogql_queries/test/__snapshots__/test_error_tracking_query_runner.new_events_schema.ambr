            argMaxState(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(CAST(e.properties.`$exception_sources`, 'Nullable(String)'), -1), ''), 'null'), '^"|"$', ''), toTimeZone(e.timestamp, 'UTC')) AS source_state,
            argMaxState(CAST(nullIf(toString(e.properties.`$lib`), ''), 'Nullable(String)'), toTimeZone(e.timestamp, 'UTC')) AS library_state,
            least(2, intDiv(dateDiff('seconds', toDateTime(toDateTime64('2020-01-10 00:00:00.000000', 6, 'UTC'), 'UTC'), toTimeZone(e.timestamp, 'UTC')), greatest(1, intDiv(dateDiff('seconds', toDateTime(toDateTime64('2020-01-10 00:00:00.000000', 6, 'UTC'), 'UTC'), toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')), 3)))) AS bin_idx,
            count() AS occ,
