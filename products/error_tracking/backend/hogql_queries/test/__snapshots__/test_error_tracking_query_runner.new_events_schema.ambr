         argMaxMerge(ev.function_state) AS function,
         argMaxMerge(ev.source_state) AS source,
         sum(ev.occ) AS occurrences,
         least(uniqMerge(ev.sessions_state), sum(ev.occ)) AS sessions,
         least(uniqMerge(ev.users_state), sum(ev.occ)) AS users,
         sumForEach(arrayMap(i -> if(ifNull(equals(ev.bin_idx, i), isNull(ev.bin_idx)
                                            and isNull(i)), ev.occ, toUInt64(0)), range(0, 1))) AS volumeRange,
         argMaxMerge(ev.library_state) AS library
  FROM
    (SELECT cityHash64(JSONExtractString(ifNull(toJSONString(CAST(e.properties.`$exception_fingerprint`, 'Nullable(String)')), ''))) AS fp_hash,
            max(toTimeZone(e.timestamp, 'UTC')) AS last_seen_fp,
            argMaxState(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(CAST(e.properties.`$exception_functions`, 'Nullable(String)'), -1), ''), 'null'), '^"|"$', ''), toTimeZone(e.timestamp, 'UTC')) AS function_state,
            argMaxState(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(CAST(e.properties.`$exception_sources`, 'Nullable(String)'), -1), ''), 'null'), '^"|"$', ''), toTimeZone(e.timestamp, 'UTC')) AS source_state,
            argMaxState(CAST(nullIf(toString(e.properties.`$lib`), ''), 'Nullable(String)'), toTimeZone(e.timestamp, 'UTC')) AS library_state,
            least(0, intDiv(dateDiff('seconds', toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC'), toTimeZone(e.timestamp, 'UTC')), greatest(1, intDiv(dateDiff('seconds', toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC'), toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')), 1)))) AS bin_idx,
            count() AS occ,
            uniqState(nullIf(e.properties.`$session_id`, '')) AS sessions_state,
            uniqState(coalesce(nullIf(toString(e.person_id), '00000000-0000-0000-0000-000000000000'), e.distinct_id)) AS users_state
     FROM events_json AS e
     WHERE and(equals(e.team_id, 99999), equals(e.event, '$exception'), isNotNull(e.properties.`$exception_fingerprint`), ifNull(notILike(toString(CAST(e.person_properties.email, 'Nullable(String)')), '%@posthog.com%'), 1), greaterOrEquals(e.timestamp, toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')), lessOrEquals(e.timestamp, toDateTime(toDateTime64('today', 6, 'UTC'), 'UTC')), or(ifNull(greater(multiSearchAnyCaseInsensitive(toString(CAST(e.properties.`$exception_types`, 'Nullable(String)')), ['databasenot']), 0), 0), ifNull(greater(multiSearchAnyCaseInsensitive(toString(CAST(e.properties.`$exception_values`, 'Nullable(String)')), ['databasenot']), 0), 0), ifNull(greater(multiSearchAnyCaseInsensitive(toString(CAST(e.properties.`$exception_sources`, 'Nullable(String)')), ['databasenot']), 0), 0), ifNull(greater(multiSearchAnyCaseInsensitive(toString(CAST(e.properties.`$exception_functions`, 'Nullable(String)')), ['databasenot']), 0), 0), ifNull(greater(multiSearchAnyCaseInsensitive(toString(CAST(e.properties.email, 'Nullable(String)')), ['databasenot']), 0), 0), ifNull(greater(multiSearchAnyCaseInsensitive(toString(CAST(e.person_properties.email, 'Nullable(String)')), ['databasenot']), 0), 0)))
     GROUP BY fp_hash,
