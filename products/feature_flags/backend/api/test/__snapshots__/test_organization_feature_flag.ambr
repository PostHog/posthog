  '''
  SELECT "posthog_team"."parent_team_id" AS "parent_team_id"
  FROM "posthog_team"
  WHERE "posthog_team"."id" = 99999
  ORDER BY "posthog_team"."id" ASC
  LIMIT 1
  '''
