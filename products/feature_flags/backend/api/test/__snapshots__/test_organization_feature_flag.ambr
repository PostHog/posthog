  '''
  SELECT "feature_flags_teamfeatureflagsconfig"."max_feature_flags_override" AS "max_feature_flags_override"
  FROM "feature_flags_teamfeatureflagsconfig"
  WHERE "feature_flags_teamfeatureflagsconfig"."team_id" = 99999
  ORDER BY "feature_flags_teamfeatureflagsconfig"."team_id" ASC
  LIMIT 1
  '''
# ---
# name: TestOrganizationFeatureFlagCopy.test_copy_feature_flag_create_new.15
  '''
  SELECT COUNT(*) AS "__count"
  FROM "posthog_featureflag"
  INNER JOIN "posthog_team" ON ("posthog_featureflag"."team_id" = "posthog_team"."id")
  WHERE (NOT ("posthog_featureflag"."deleted")
         AND ("posthog_featureflag"."team_id" =
                (SELECT U0."parent_team_id" AS "parent_team_id"
                 FROM "posthog_team" U0
                 WHERE U0."id" = 99999
                 LIMIT 1)
              OR ("posthog_team"."parent_team_id" IS NULL
                  AND "posthog_featureflag"."team_id" = 99999)))
  '''
