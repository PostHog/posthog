# serializer version: 1
# name: TestTraceMetricsQueries.test_the_read_is_one_tagged_grouping_sets_query[new_events_schema]
  '''
  SELECT in_current AS in_current,
         toStartOfHour(greatest(first_timestamp, if(in_current, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata'), toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')))) AS bucket,
         grouping(bucket) AS is_period_total,
         count() AS traces,
         countIf(has_error) AS errored,
         sum(ifNull(trace_cost, 0)) AS cost,
         uniqIf(session_id, isNotNull(session_id)) AS sessions,
         uniq(trace_person_id) AS users,
         quantile(0.95)(trace_latency_s) AS p95_latency_s,
         countIf(isNotNull(trace_cost)) AS traces_with_cost,
         countIf(isNotNull(trace_latency_s)) AS traces_with_latency,
         countIf(isNotNull(session_id)) AS traces_with_session,
         sum(trace_identified_events) AS identified_events,
         sum(trace_non_otel_generations) AS non_otel_generations
  FROM
    (SELECT CAST(events.properties.`$ai_trace_id`, 'Nullable(String)') AS trace_id,
            min(toTimeZone(events.timestamp, 'Asia/Kolkata')) AS first_timestamp,
            max(toTimeZone(events.timestamp, 'Asia/Kolkata')) AS last_timestamp,
            1 AS in_current,
            round(if(equals(countIf(ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0)), 0), NULL, if(ifNull(greater(maxIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), and(equals(events.event, '$ai_trace'), ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0))), 0), 0), maxIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), and(equals(events.event, '$ai_trace'), ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0))), if(equals(countIf(and(ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0), notEquals(events.event, '$ai_generation'))), 0), sumIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), equals(events.event, '$ai_generation')), sumIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), in(ifNull(CAST(events.properties.`$ai_parent_id`, 'Nullable(String)'), ''), tuple('', CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'))))))), 2) AS trace_latency_s,
            sumIf(accurateCastOrNull(events.properties.`$ai_total_cost_usd`, 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))) AS trace_cost,
            greater(countIf(equals(CAST(events.properties.`$ai_is_error`, 'Nullable(String)'), 'true')), 0) AS has_error,
            any(CAST(events.properties.`$ai_session_id`, 'Nullable(String)')) AS session_id,
            argMinIf(if(not(empty(events__override.distinct_id)), events__override.person_id, events.person_id), toTimeZone(events.timestamp, 'Asia/Kolkata'), notEquals(events.distinct_id, '')) AS trace_person_id,
            countIf(and(notEquals(events.distinct_id, ifNull(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'), '')), ifNull(notEquals(ifNull(CAST(events.properties.`$ai_ingestion_source`, 'Nullable(String)'), ''), 'otel'), 1))) AS trace_identified_events,
            countIf(and(equals(events.event, '$ai_generation'), ifNull(notEquals(ifNull(CAST(events.properties.`$ai_ingestion_source`, 'Nullable(String)'), ''), 'otel'), 1))) AS trace_non_otel_generations
     FROM events_json AS events
     LEFT OUTER JOIN
       (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
               person_distinct_id_overrides.distinct_id AS distinct_id
        FROM person_distinct_id_overrides
        WHERE equals(person_distinct_id_overrides.team_id, 99999)
        GROUP BY person_distinct_id_overrides.distinct_id
        HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
     WHERE and(equals(events.team_id, 99999), and(in(events.event, tuple('$ai_trace', '$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback')), greaterOrEquals(events.timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')), lessOrEquals(events.timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')), isNotNull(events.properties.`$ai_trace_id`), notEquals(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'), '')), or(isNull(events.properties.ai_support_impersonated), ifNull(notEquals(CAST(events.properties.ai_support_impersonated, 'Nullable(String)'), 'true'), 1)))
     GROUP BY trace_id
     HAVING and(greater(countIf(in(events.event, tuple('$ai_trace', '$ai_span', '$ai_generation', '$ai_embedding'))), 0), greater(countIf(1), 0), lessOrEquals(first_timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')), greaterOrEquals(last_timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')))
     UNION ALL SELECT CAST(events.properties.`$ai_trace_id`, 'Nullable(String)') AS trace_id,
                      min(toTimeZone(events.timestamp, 'Asia/Kolkata')) AS first_timestamp,
                      max(toTimeZone(events.timestamp, 'Asia/Kolkata')) AS last_timestamp,
                      0 AS in_current,
                      round(if(equals(countIf(ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0)), 0), NULL, if(ifNull(greater(maxIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), and(equals(events.event, '$ai_trace'), ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0))), 0), 0), maxIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), and(equals(events.event, '$ai_trace'), ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0))), if(equals(countIf(and(ifNull(greater(ifNull(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), 0), 0), 0), notEquals(events.event, '$ai_generation'))), 0), sumIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), equals(events.event, '$ai_generation')), sumIf(accurateCastOrNull(events.properties.`$ai_latency`, 'Float64'), in(ifNull(CAST(events.properties.`$ai_parent_id`, 'Nullable(String)'), ''), tuple('', CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'))))))), 2) AS trace_latency_s,
                      sumIf(accurateCastOrNull(events.properties.`$ai_total_cost_usd`, 'Float64'), in(events.event, tuple('$ai_generation', '$ai_embedding'))) AS trace_cost,
                      greater(countIf(equals(CAST(events.properties.`$ai_is_error`, 'Nullable(String)'), 'true')), 0) AS has_error,
                      any(CAST(events.properties.`$ai_session_id`, 'Nullable(String)')) AS session_id,
                      argMinIf(if(not(empty(events__override.distinct_id)), events__override.person_id, events.person_id), toTimeZone(events.timestamp, 'Asia/Kolkata'), notEquals(events.distinct_id, '')) AS trace_person_id,
                      countIf(and(notEquals(events.distinct_id, ifNull(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'), '')), ifNull(notEquals(ifNull(CAST(events.properties.`$ai_ingestion_source`, 'Nullable(String)'), ''), 'otel'), 1))) AS trace_identified_events,
                      countIf(and(equals(events.event, '$ai_generation'), ifNull(notEquals(ifNull(CAST(events.properties.`$ai_ingestion_source`, 'Nullable(String)'), ''), 'otel'), 1))) AS trace_non_otel_generations
     FROM events_json AS events
     LEFT OUTER JOIN
       (SELECT argMax(person_distinct_id_overrides.person_id, person_distinct_id_overrides.version) AS person_id,
               person_distinct_id_overrides.distinct_id AS distinct_id
        FROM person_distinct_id_overrides
        WHERE equals(person_distinct_id_overrides.team_id, 99999)
        GROUP BY person_distinct_id_overrides.distinct_id
        HAVING equals(argMax(person_distinct_id_overrides.is_deleted, person_distinct_id_overrides.version), 0) SETTINGS optimize_aggregation_in_order=1) AS events__override ON equals(events.distinct_id, events__override.distinct_id)
     WHERE and(equals(events.team_id, 99999), and(in(events.event, tuple('$ai_trace', '$ai_span', '$ai_generation', '$ai_embedding', '$ai_metric', '$ai_feedback')), greaterOrEquals(events.timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')), lessOrEquals(events.timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')), isNotNull(events.properties.`$ai_trace_id`), notEquals(CAST(events.properties.`$ai_trace_id`, 'Nullable(String)'), '')), or(isNull(events.properties.ai_support_impersonated), ifNull(notEquals(CAST(events.properties.ai_support_impersonated, 'Nullable(String)'), 'true'), 1)))
     GROUP BY trace_id
     HAVING and(greater(countIf(in(events.event, tuple('$ai_trace', '$ai_span', '$ai_generation', '$ai_embedding'))), 0), greater(countIf(1), 0), lessOrEquals(first_timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')), greaterOrEquals(last_timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata'))))
  WHERE or(in_current, less(last_timestamp, toDateTime64('explicit_redacted_timestamp', 6, 'Asia/Kolkata')))
  GROUP BY GROUPING
  SETS ((in_current), (in_current,
                       bucket))
  LIMIT 8 SETTINGS readonly=2,
                   max_execution_time=30,
                   timeout_overflow_mode='throw',
                   allow_experimental_object_type=1,
                   max_ast_elements=4000000,
                   max_expanded_ast_elements=4000000,
                   max_bytes_before_external_group_by=0,
                   transform_null_in=1,
                   optimize_min_equality_disjunction_chain_length=4294967295,
                   optimize_rewrite_aggregate_function_with_if=0,
                   optimize_min_inequality_conjunction_chain_length=4294967295,
                   allow_experimental_join_condition=1,
                   use_hive_partitioning=0,
                   json_type_escape_dots_in_keys=1,
                   output_format_json_escape_forward_slashes=0
  '''
# ---
