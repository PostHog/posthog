    "variables": [
        {
            "id": "KEY_ELEMENT",
            "name": "Key element",
            "type": "element",
            "default": {
                "id": "$autocapture",
                "math": "dau",
                "name": "$autocapture",
                "type": "events",
                "order": 0
            },
            "required": false,
            "description": "The interaction that matters most to you, such as a click on your main call to action. Leave it as it is to count every interaction."
        }
    ]
}
