        {
            "name": "People interacting with your key element",
            "type": "INSIGHT",
            "color": "blue",
            "query": {
                "kind": "InsightVizNode",
                "source": {
                    "kind": "TrendsQuery",
                    "series": ["{KEY_ELEMENT}"],
                    "interval": "week",
                    "dateRange": {
                        "date_from": "-90d",
                        "explicitDate": false
