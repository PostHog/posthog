    define can_invite_member: admin or (member and members_can_invite)
    define can_invite_admin: admin
    define can_invite_owner: owner
    define can_list_members: member

type organization_member
  relations
    define user: [user]
    define organization: [organization]
    define project: [project]
    define is_owner: [user:*]
    define can_view: user or admin from organization or ((member from organization) and (members_can_see_members from organization or member from project)) or ((member from organization) but not access_control_enabled from organization)
    define can_edit: user or can_change_level
    define can_change_level: ((owner from organization) or ((admin from organization) but not is_owner)) but not user
    define can_make_owner: (owner from organization) but not user
    define can_delete: (user but not is_owner) or can_change_level

