# The shared shape of every access-controlled resource type.
# The model build copies this type once for each entry in resources.toml and replaces "resource" with the entry name.
# An entry can add relations and replace a permission (can_*), but it cannot change the relations below that store or resolve access.
type resource
  relations
    define project: [project]
    define category: [resource_category]
    define policy: [access_policy]
    define creator: [organization_member#user]
    define has_rule: has_rule from policy
    define viewer: (member from project) and (creator or org_admin from project or viewer from policy or ((viewer from category) but not has_rule))
    define editor: (member from project) and (creator or org_admin from project or editor from policy or ((editor from category) but not has_rule))
    define manager: (member from project) and (creator or org_admin from project or manager from policy or ((manager from category) but not has_rule))
    define can_view: viewer
    define can_edit: editor
    define can_delete: can_edit
    define can_manage_access: manager or can_manage_access from project
