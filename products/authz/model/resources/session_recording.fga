type session_recording extends shareable_object
  relations
    # A notebook that embeds the recording lets the notebook's guests view it.
    define notebook: [notebook]
    # Guests view the recordings in the notebooks they can view, unless a member rule on the recording decides.
    define guest_embed_viewer: (guest from project) and ((guest_viewer from notebook) but not has_member_rule)
    # Members keep the base rule. Only guests view a recording through its notebooks.
    override can_view: viewer or shared_viewer or guest_viewer or guest_embed_viewer
