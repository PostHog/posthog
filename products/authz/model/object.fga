# Bases for object types. Each file in resources/ holds the object type of one resource type and extends one of these bases.
# The model build copies the base into each object type and does not write the bases into model.fga.
# An object type can define new relations, and override or remove inherited permissions (can_*).
# The stored relations and the viewer, editor and manager levels below stay the same in every object type.
type object
  relations
    define project: [project]
    define resource: [resource]
    define policy: [access_policy]
    define creator: [organization_member#user]
    # The object policy is resolved before falling back to the resource policy.
    # A configured none blocks fallback just like any other object level.
    define has_rule: has_rule from policy
    define viewer: (member from project) and (creator or org_admin from project or viewer from policy or ((viewer from resource) but not has_rule))
    define editor: (member from project) and (creator or org_admin from project or editor from policy or ((editor from resource) but not has_rule))
    define manager: (member from project) and (creator or org_admin from project or manager from policy or ((manager from resource) but not has_rule))
    # Guests never hold a level. A member rule on the object, or on its resource when the object has none, lets them view.
    define has_member_rule: has_member_rule from policy
    define policy_guest_viewer: guest_viewer from policy
    define guest_viewer: (guest from project) and (policy_guest_viewer or ((guest_viewer from resource) but not has_member_rule))
    define can_view: viewer or guest_viewer
    define can_edit: editor
    define can_delete: can_edit
    define can_manage_access: manager or can_manage_access from project

# An object that share links can expose. Anyone who can edit it can share it.
type shareable_object extends object
  relations
    # Share credentials grant reads independently of organization membership and never grant an access level.
    define shared_viewer: [share_link]
    override can_view: viewer or shared_viewer or guest_viewer
    define can_share: can_edit
