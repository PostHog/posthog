OPENFGA_DATASTORE_ENGINE=postgres
OPENFGA_DATASTORE_URI=postgres://posthog:posthog@db:5432/posthog?sslmode=disable
OPENFGA_HTTP_ADDR=0.0.0.0:8080
OPENFGA_GRPC_ADDR=0.0.0.0:8081
OPENFGA_PLAYGROUND_ENABLED=false
OPENFGA_AUTHN_METHOD=none
OPENFGA_CHECK_QUERY_CACHE_ENABLED=true
OPENFGA_CHECK_QUERY_CACHE_TTL=10s
OPENFGA_CHECK_ITERATOR_CACHE_ENABLED=true
OPENFGA_CHECK_ITERATOR_CACHE_TTL=10s
OPENFGA_DATASTORE_MIN_OPEN_CONNS=5
OPENFGA_DATASTORE_MIN_IDLE_CONNS=5