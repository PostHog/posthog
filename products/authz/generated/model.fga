type user
  relations
    # FGA requires an explicit self-link; matching user IDs do not imply identity.
    define identity: [user]
    define organization: [organization]
    define can_view: identity
    define can_edit: identity
    define can_delete: identity but not member from organization

type organization
  relations
    define member: [organization_member#user] or admin
    define admin: [organization_member#user] or owner
    define owner: [organization_member#user]
    define access_control_enabled: [user:*]
    define role_based_access_enabled: [user:*]
    define members_can_invite: [user:*]
    define members_can_create_projects: [user:*]
    define members_can_see_members: [user:*]
    define can_view: member
    define can_edit: admin
    define can_delete: owner
    define can_manage_access: admin
    define can_manage_owners: owner
    define can_manage_billing: admin
    define can_create_role: admin
    define can_create_project: admin or (member and members_can_create_projects)
    define can_invite_member: admin or (member and members_can_invite)
    define can_invite_admin: admin
    define can_invite_owner: owner
    define can_list_members: member

type organization_member
  relations
    define user: [user]
    define organization: [organization]
    define project: [project]
    # The wildcard marks the target membership as an owner, regardless of who checks it.
    define is_owner: [user:*]
    define org_member: member from organization
    define org_admin: admin from organization
    # When the full member list is hidden, members can still see people with a project in common.
    define same_project_member: member from project
    define can_view: user or org_admin or (org_member and (members_can_see_members from organization or same_project_member)) or (org_member but not access_control_enabled from organization)
    define can_edit: user or can_change_level
    define can_change_level: ((owner from organization) or (org_admin but not is_owner)) but not user
    define can_make_owner: (owner from organization) but not user
    define can_delete: (user but not is_owner) or can_change_level

type role
  relations
    define organization: [organization]
    define assignee: [organization_member#user]
    define member: assignee and member from organization
    define can_view: member from organization
    define can_edit: admin from organization
    define can_delete: admin from organization
    define can_manage_access: admin from organization

type project
  relations
    define organization: [organization]
    define creator: [organization_member#user]
    # user_* assigns a level to one organization member; role_* and default_* are the other policy sources.
    define user_none: [organization_member#user]
    define user_member: [organization_member#user]
    define user_admin: [organization_member#user]
    define user_owner: [organization_member#user]
    define role_none: [role#member] and role_based_access_enabled from organization
    define role_member: [role#member] and role_based_access_enabled from organization
    define role_admin: [role#member] and role_based_access_enabled from organization
    define role_owner: [role#member] and role_based_access_enabled from organization
    define default_none: [user:*]
    define default_member: [user:*]
    define default_admin: [user:*]
    define default_owner: [user:*]
    # Presence includes none: a lower user level still replaces every role/default grant.
    define user_override: user_none or user_member or user_admin or user_owner
    define role_override: role_none or role_member or role_admin or role_owner
    define default_level: default_none or default_member or default_admin or default_owner
    define user_or_role_override: user_override or role_override
    define has_rule: user_or_role_override or default_level
    # Policy levels exclude the implicit project default and the organization-admin bypass.
    define policy_owner: user_owner or (role_owner but not user_override) or (default_owner but not user_or_role_override)
    define policy_admin: policy_owner or user_admin or (role_admin but not user_override) or (default_admin but not user_or_role_override)
    define policy_member: policy_admin or user_member or (role_member but not user_override) or (default_member but not user_or_role_override)
    define org_member: member from organization
    define org_admin: admin from organization
    define access_control_enabled: access_control_enabled from organization
    define member: org_admin or (org_member and ((policy_member and access_control_enabled) or (org_member but not access_control_enabled) or (org_member but not has_rule)))
    define admin: org_admin or (org_member and access_control_enabled and (policy_admin or (org_member but not has_rule)))
    define owner: org_admin or (org_member and access_control_enabled and policy_owner)
    # The implicit project-admin default must not grant access-management rights.
    define can_manage_access: org_admin or (member and (creator or (policy_admin and access_control_enabled)))
    define can_view: member
    define can_edit: admin
    define can_delete: admin
# A rule's presence blocks inheritance even if it grants none or a lower level.
type access_policy
  relations
    define organization: [organization]
    define user_none: [organization_member#user]
    define user_viewer: [organization_member#user]
    define user_editor: [organization_member#user]
    define user_manager: [organization_member#user]
    define role_none: [role#member] and role_based_access_enabled from organization
    define role_viewer: [role#member] and role_based_access_enabled from organization
    define role_editor: [role#member] and role_based_access_enabled from organization
    define role_manager: [role#member] and role_based_access_enabled from organization
    define default_none: [user:*]
    define default_viewer: [user:*]
    define default_editor: [user:*]
    define default_manager: [user:*]
    # These sets track whether a level is configured, including an explicit none.
    define user_override: user_none or user_viewer or user_editor or user_manager
    define role_override: role_none or role_viewer or role_editor or role_manager
    define default_level: default_none or default_viewer or default_editor or default_manager
    define user_or_role_override: user_override or role_override
    define has_rule: (user_or_role_override or default_level) and access_control_enabled from organization
    # Only resolved levels inherit: a user viewer must not inherit a role manager grant.
    define manager: (user_manager or (role_manager but not user_override) or (default_manager but not user_or_role_override)) and has_rule
    define editor: manager or ((user_editor or (role_editor but not user_override) or (default_editor but not user_or_role_override)) and has_rule)
    define viewer: editor or ((user_viewer or (role_viewer but not user_override) or (default_viewer but not user_or_role_override)) and has_rule)
type resource
  relations
    define project: [project]
    define policy: [access_policy]
    define has_rule: has_rule from policy
    define viewer: (member from project) and (org_admin from project or viewer from policy or ((member from project) but not has_rule))
    define editor: (member from project) and (org_admin from project or editor from policy or ((member from project) but not has_rule))
    define manager: (member from project) and (org_admin from project or manager from policy)
    define can_view: viewer
    define can_list: viewer
    define can_create: editor
    define can_manage_access: manager or can_manage_access from project

type dashboard
  relations
    define project: [project]
    define resource: [resource]
    define policy: [access_policy]
    define creator: [organization_member#user]
    define has_rule: has_rule from policy
    define viewer: (member from project) and (creator or org_admin from project or viewer from policy or ((viewer from resource) but not has_rule))
    define editor: (member from project) and (creator or org_admin from project or editor from policy or ((editor from resource) but not has_rule))
    define manager: (member from project) and (creator or org_admin from project or manager from policy or ((manager from resource) but not has_rule))
    # Legacy collaborator restrictions remain an independent write gate.
    define restricted: [user:*] and access_control_enabled from project
    # Members with a legacy collaborator privilege can edit a restricted dashboard.
    define collaborator: [organization_member#user]
    # The legacy rule: anyone in the project can edit, except on a restricted dashboard.
    define legacy_editor: creator or admin from project or collaborator or ((member from project) but not restricted)
    define can_view: viewer
    # An edit must pass both the access rules and the legacy collaborator rule.
    define can_edit: editor and legacy_editor
    define can_delete: can_edit
    define can_manage_access: manager or can_manage_access from project
    define can_share: can_edit

type insight
  relations
    define project: [project]
    define resource: [resource]
    define policy: [access_policy]
    define creator: [organization_member#user]
    define has_rule: has_rule from policy
    define viewer: (member from project) and (creator or org_admin from project or viewer from policy or ((viewer from resource) but not has_rule))
    define editor: (member from project) and (creator or org_admin from project or editor from policy or ((editor from resource) but not has_rule))
    define manager: (member from project) and (creator or org_admin from project or manager from policy or ((manager from resource) but not has_rule))
    # An insight takes the legacy edit rule from the dashboards that show it.
    define dashboard: [dashboard]
    # This marker distinguishes an unattached insight from one with no editable dashboards.
    define has_dashboard: [user:*]
    # An attached insight follows the dashboard's full edit decision; an unattached insight follows project membership.
    define dashboard_editor: can_edit from dashboard or ((member from project) but not has_dashboard)
    define can_view: viewer
    # An edit must pass both the insight access rules and its dashboard's edit decision.
    define can_edit: editor and dashboard_editor
    define can_delete: can_edit
    define can_manage_access: manager or can_manage_access from project
    define can_share: can_edit
