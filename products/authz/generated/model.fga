    define role_based_access_enabled: [user:*]
    define members_can_invite: [user:*]
    define members_can_create_projects: [user:*]
    define members_can_see_members: [user:*]
    define can_view: member
    define can_edit: admin
    define can_delete: owner
    define can_manage_access: admin
    define can_manage_owners: owner
    define can_manage_billing: admin
    define can_create_role: admin
    define can_create_project: admin or (member and members_can_create_projects)
    define can_invite_member: admin or (member and members_can_invite)
    define can_invite_admin: admin
    define can_invite_owner: owner
    define can_list_members: member

type organization_member
  relations
    define user: [user]
    define organization: [organization]
    define project: [project]
    # The wildcard marks the target membership as an owner, regardless of who checks it.
    define is_owner: [user:*]
    define org_member: member from organization
    define org_admin: admin from organization
    # When the full member list is hidden, members can still see people with a project in common.
    define same_project_member: member from project
    define can_view: user or org_admin or (org_member and (members_can_see_members from organization or same_project_member)) or (org_member but not access_control_enabled from organization)
    define can_edit: user or can_change_level
    define can_change_level: ((owner from organization) or (org_admin but not is_owner)) but not user
    define can_make_owner: (owner from organization) but not user
    define can_delete: (user but not is_owner) or can_change_level

type role
