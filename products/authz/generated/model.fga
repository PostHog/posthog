    define organization: [organization]
    define assignee: [organization_member#user]
    define member: assignee and member from organization
    define can_view: member from organization
    define can_edit: admin from organization
    define can_delete: admin from organization
    define can_manage_access: admin from organization

type project
  relations
    define organization: [organization]
    define creator: [organization_member#user]
    # member_* assigns a level to one organization member; role_* and default_* are the other policy sources.
    define member_none: [organization_member#user]
    define member_member: [organization_member#user]
    define member_admin: [organization_member#user]
    define member_owner: [organization_member#user]
    define role_none: [role#member] and role_based_access_enabled from organization
    define role_member: [role#member] and role_based_access_enabled from organization
    define role_admin: [role#member] and role_based_access_enabled from organization
    define role_owner: [role#member] and role_based_access_enabled from organization
    define default_none: [user:*]
    define default_member: [user:*]
    define default_admin: [user:*]
    define default_owner: [user:*]
    # Presence includes none: a lower member level still replaces every role/default grant.
    define has_member_rule: member_none or member_member or member_admin or member_owner
    define has_role_rule: role_none or role_member or role_admin or role_owner
    define default_level: default_none or default_member or default_admin or default_owner
    define has_member_or_role_rule: has_member_rule or has_role_rule
    define has_rule: has_member_or_role_rule or default_level
    # Policy levels exclude the implicit project default and the organization-admin bypass.
    define policy_owner: member_owner or (role_owner but not has_member_rule) or (default_owner but not has_member_or_role_rule)
    define policy_admin: policy_owner or member_admin or (role_admin but not has_member_rule) or (default_admin but not has_member_or_role_rule)
    define policy_member: policy_admin or member_member or (role_member but not has_member_rule) or (default_member but not has_member_or_role_rule)
    define org_member: member from organization
    define org_admin: admin from organization
    define access_control_enabled: access_control_enabled from organization
    define member: org_admin or (org_member and ((policy_member and access_control_enabled) or (org_member but not access_control_enabled) or (org_member but not has_rule)))
    define admin: org_admin or (org_member and access_control_enabled and (policy_admin or (org_member but not has_rule)))
    define owner: org_admin or (org_member and access_control_enabled and policy_owner)
    # The implicit project-admin default must not grant access-management rights.
    define can_manage_access: org_admin or (member and (creator or (policy_admin and access_control_enabled)))
    # A share may read project-scoped rendering metadata without gaining project membership.
    define shared_viewer: [share_link]
    define can_view: member or shared_viewer
    define can_edit: admin
    define can_delete: admin
# A rule's presence blocks inheritance even if it grants none or a lower level.
type access_policy
  relations
    define organization: [organization]
    define member_none: [organization_member#user]
    define member_viewer: [organization_member#user]
