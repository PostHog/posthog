    define role_none: [role#member] and role_based_access_enabled from organization
    define role_viewer: [role#member] and role_based_access_enabled from organization
    define role_editor: [role#member] and role_based_access_enabled from organization
    define role_manager: [role#member] and role_based_access_enabled from organization
    define default_none: [user:*]
    define default_viewer: [user:*]
    define default_editor: [user:*]
    define default_manager: [user:*]
    # These sets track whether a level is configured, including an explicit none.
    define has_member_rule: member_none or member_viewer or member_editor or member_manager
    define has_role_rule: role_none or role_viewer or role_editor or role_manager
    define default_level: default_none or default_viewer or default_editor or default_manager
    define has_member_or_role_rule: has_member_rule or has_role_rule
    define has_rule: (has_member_or_role_rule or default_level) and access_control_enabled from organization
    # Only resolved levels inherit: a member viewer must not inherit a role manager grant.
    define manager: (member_manager or (role_manager but not has_member_rule) or (default_manager but not has_member_or_role_rule)) and has_rule
    define editor: manager or ((member_editor or (role_editor but not has_member_rule) or (default_editor but not has_member_or_role_rule)) and has_rule)
    define viewer: editor or ((member_viewer or (role_viewer but not has_member_rule) or (default_viewer but not has_member_or_role_rule)) and has_rule)
