# /etc/kev-vllm/env, mode 0600, root-owned: read by kev-vllm.service and passed to the Caddy container.
INSTANCE_HOST=kev-1.example.com
ACME_EMAIL=ops@example.com
ROUTE53_ZONE_ID=Z0000000000000000000
# A credential that can write only _acme-challenge.<INSTANCE_HOST> in that zone; see the runbook.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
KEV_BEARER=replace-with-the-output-of-openssl-rand-hex-32
# Pin the exact build: the sha- tag from the CD run plus its digest, never a moving tag.
IMAGE=ghcr.io/posthog/posthog-ml-inference-decision:sha-<commit>@sha256:<digest>
MODEL_DIR=/srv/models/kev-4b
KEV_DATE_FACTS=0
