# One file per environment for lambda-host.sh. Copy to envs/prod-us.env (gitignored), fill in, then:
#   deploy/phase1/lambda-host.sh prod-us all
# The script re-runs itself under `op run --env-file`, so 1Password prompts once and no secret touches a disk.
# A new environment is a new file: envs/prod-eu.env with its own box, bucket, region and 1Password items.

# The instance, and the SSH key it was launched with, straight from 1Password into a throwaway agent.
TARGET=ubuntu@<ip>
LAMBDA_SSH_KEY="op://ML/Lambda Prod US/private key?ssh-format=openssh"

# Where the checkpoint comes from: a published version in the base-models bucket, read with this AWS profile.
BASE_MODELS_BUCKET=posthog-ml-training-prod-us-east-1-base-models
AWS_READ_PROFILE=ml-prod-us
AWS_REGION=us-east-1
MODEL_NAME=kev-4b
MODEL_VERSION=<kev hub revision>

# What the instance serves as, and the exact image build.
INSTANCE_HOST=kev-1.inference.posthog.dev
IMAGE=ghcr.io/posthog/posthog-ml-inference-decision:sha-<commit>@sha256:<digest>
KEV_DATE_FACTS=0

# Certificate: Caddy on the instance issues it through a DNS-01 challenge with the ACME user's key.
ACME_EMAIL=<contact>
ROUTE53_ZONE_ID=<zone id from the dns unit output>
AWS_ACCESS_KEY_ID="op://ML/ml-inference-acme/access key id"
AWS_SECRET_ACCESS_KEY="op://ML/ml-inference-acme/secret access key"

# Per-instance bearer; the same value goes to the gateway as AI_GATEWAY_KEV_API_KEY.
KEV_BEARER="op://ML/kev-1 bearer/password"
