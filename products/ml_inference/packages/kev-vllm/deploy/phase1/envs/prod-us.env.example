# One file per environment for lambda-host.sh. Copy to envs/prod-us.env (gitignored), fill in, then:
#   deploy/phase1/lambda-host.sh prod-us all
# The script re-runs itself under `op run --env-file`, so 1Password prompts once for the SSH key and the CA key; the
# bearer comes from Secrets Manager through the AWS profile below, and no secret touches a disk.
# A new environment is a new file: envs/prod-eu.env with its own box, bucket, region, profiles and 1Password items.

# The instance, and the SSH key it was launched with, straight from 1Password into a throwaway agent. The public IP
# in TARGET is what the certificate is issued for and what the gateway's base_url names.
TARGET=ubuntu@<ip>
LAMBDA_SSH_KEY="op://ML/Lambda Prod US/private key?ssh-format=openssh"

# Where the checkpoint comes from: a published version in the base-models bucket, read with this AWS profile.
BASE_MODELS_BUCKET=posthog-ml-training-prod-us-east-1-base-models
AWS_READ_PROFILE=ml-prod-us
AWS_REGION=us-east-1
MODEL_NAME=kev-4b
MODEL_VERSION=<kev hub revision>

# The exact image build.
IMAGE=ghcr.io/posthog/posthog-ml-inference-decision:sha-<commit>@sha256:<digest>
KEV_DATE_FACTS=0

# The ML inference CA signs the instance's certificate; its certificate is ca.pem next to this file and in the
# gateway's AI_GATEWAY_KEV_CA_PEM. The key never leaves 1Password except into the signing step.
KEV_CA_KEY="op://ML/ML inference CA/private key"

# The bearer is AI_GATEWAY_KEV_API_KEY in the gateway's ai-gateway-secrets bag, read with a profile that holds the
# secrets-editor role in that environment's account; the gateway reads the same key.
GATEWAY_SECRETS_PROFILE=prod-us
