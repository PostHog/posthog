# One file per environment for lambda-host.sh. Copy to envs/prod-us.env (gitignored), fill in, then:
#   deploy/phase1/lambda-host.sh prod-us all
# The script re-runs itself under `op run --env-file`, so 1Password prompts once for the SSH key; the ACME key and the
# bearer come from Secrets Manager through the AWS profiles below, and no secret touches a disk.
# A new environment is a new file: envs/prod-eu.env with its own box, bucket, region, profiles and 1Password item.

# The instance, and the SSH key it was launched with, straight from 1Password into a throwaway agent.
TARGET=ubuntu@<ip>
LAMBDA_SSH_KEY="op://ML/Lambda Prod US/private key?ssh-format=openssh"

# Where the checkpoint comes from: a published version in the base-models bucket, read with this AWS profile. The
# same profile reads the ACME secret below, so it needs secretsmanager:GetSecretValue on it.
BASE_MODELS_BUCKET=posthog-ml-training-prod-us-east-1-base-models
AWS_READ_PROFILE=ml-prod-us
AWS_REGION=us-east-1
MODEL_NAME=kev-4b
MODEL_VERSION=<kev hub revision>

# What the instance serves as, and the exact image build.
INSTANCE_HOST=kev-1.inference.posthog.dev
IMAGE=ghcr.io/posthog/posthog-ml-inference-decision:sha-<commit>@sha256:<digest>
KEV_DATE_FACTS=0

# Certificate: Caddy on the instance issues it through a DNS-01 challenge with the ACME user's key, which the dns unit's
# Terraform keeps in Secrets Manager (its acme_credentials_secret_name output).
ACME_EMAIL=<contact>
ROUTE53_ZONE_ID=<zone id from the dns unit output>
ACME_SECRET_ID=ml-inference-acme-credentials

# The bearer is AI_GATEWAY_KEV_API_KEY in the gateway's ai-gateway-secrets bag, read with a profile that holds the
# secrets-editor role in that environment's account; the gateway reads the same key.
GATEWAY_SECRETS_PROFILE=prod-us
