# The proxy in front of vLLM on a decision instance: a Let's Encrypt certificate obtained and renewed through a
# DNS-01 challenge, the per-instance bearer on every request, and only the decision endpoint, health and metrics
# exposed. vLLM itself binds loopback (see bin/serve.sh).
#
# Environment (from /etc/kev-vllm/env): INSTANCE_HOST is the instance's DNS name, ACME_EMAIL the certificate contact,
# ROUTE53_ZONE_ID the zone the name lives in, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY a credential that can write
# only the _acme-challenge TXT record for this name, KEV_BEARER the per-instance bearer. Nothing listens on port 80:
# the challenge is a DNS record, so there is no ACME responder and no redirect.
{
	email {$ACME_EMAIL}
	auto_https disable_redirects
}

{$INSTANCE_HOST} {
	tls {
		dns route53 {
			hosted_zone_id {$ROUTE53_ZONE_ID}
		}
	}

	@unauthorized {
		not header Authorization "Bearer {$KEV_BEARER}"
	}
	@served path /pooling /health /metrics

	# A route keeps the written order; Caddy's default order would put the 404 before the proxy.
	route {
		respond @unauthorized 401
		reverse_proxy @served 127.0.0.1:8000
		respond 404
	}
}
