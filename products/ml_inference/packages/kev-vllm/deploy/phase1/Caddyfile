# The proxy in front of vLLM on a decision instance: the instance's own certificate, issued by the ML inference CA
# through lambda-host.sh, the per-instance bearer on every request, and only the decision endpoint, health and
# metrics exposed. vLLM itself binds loopback (see bin/serve.sh). Only the AI gateway talks to this box, and it
# trusts that CA, so there is no public CA, no ACME and nothing to renew for years.
#
# Environment (from /etc/kev-vllm/env): KEV_BEARER, the per-instance bearer. Nothing listens on port 80.
{
	auto_https off
}

:443 {
	tls /etc/kev-vllm/tls/instance.crt /etc/kev-vllm/tls/instance.key

	@unauthorized {
		not header Authorization "Bearer {$KEV_BEARER}"
	}
	@served path /pooling /health /metrics

	# A route keeps the written order; Caddy's default order would put the 404 before the proxy.
	route {
		respond @unauthorized 401
		reverse_proxy @served 127.0.0.1:8000
		respond 404
	}
}
