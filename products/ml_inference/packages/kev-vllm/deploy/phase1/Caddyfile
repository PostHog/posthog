# The proxy in front of vLLM on a decision instance: a certificate issued off the box, the per-instance bearer on
# every request, and only the decision endpoint, health and metrics exposed. vLLM itself binds loopback (see
# bin/serve.sh).
#
# Environment (from /etc/kev-vllm/env): INSTANCE_HOST is the instance's DNS name, TLS_CERT and TLS_KEY the
# certificate chain and key that the runbook issues with a DNS-01 challenge, KEV_BEARER the per-instance bearer.
# The certificate never comes from this host, so nothing listens on port 80: no ACME responder and no redirect.
{
	auto_https disable_redirects
}

{$INSTANCE_HOST} {
	tls {$TLS_CERT} {$TLS_KEY}

	@unauthorized {
		not header Authorization "Bearer {$KEV_BEARER}"
	}
	@served path /pooling /health /metrics

	# A route keeps the written order; Caddy's default order would put the 404 before the proxy.
	route {
		respond @unauthorized 401
		reverse_proxy @served 127.0.0.1:8000
		respond 404
	}
}
