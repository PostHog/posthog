{
  "tool": "list_pull_requests",
  "arguments": {
    "owner": "OWNER",
    "repo": "REPOSITORY",
    "state": "all",
    "sort": "updated",
    "direction": "desc"
  },
  "pagination": {
    "kind": "numbered",
    "argument": "page",
    "size_argument": "perPage",
    "size": 50,
    "newest_first": true
  },
  "mapping": {
    "id": "/html_url",
    "author": "/user/login",
    "text": "/title",
    "timestamp": "/updated_at",
    "thread": "/html_url",
    "versioned_id": true
  }
}
