{
  "tool": "slack_conversations_history",
  "arguments": {
    "channel": "CHANNEL_ID",
    "inclusive": true
  },
  "cursor_argument": "oldest",
  "initial_cursor_format": "unix_seconds",
  "pagination": {
    "kind": "cursor",
    "argument": "cursor",
    "next": "/response_metadata/next_cursor"
  },
  "mapping": {
    "items": "/messages",
    "id": "/ts",
    "author": [
      "/user",
      "/bot_id",
      "/username"
    ],
    "text": "/text",
    "timestamp": "/ts",
    "thread": [
      "/thread_ts",
      "/ts"
    ]
  }
}
