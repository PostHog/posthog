{
    "template-discord": {
        "allowedMentions": ["none"],
        "content": [
            "**Alert '{event.properties.alert_name}' firing** for insight '{event.properties.insight_name}'\n{event.properties.breaches}\n{project.url}/insights/{event.properties.insight_id}/alerts?alert_id={event.properties.alert_id}",
            "**{person.name}** triggered event: '{event.event}'"
        ]
    },
    "template-microsoft-teams": {
        "text": [
            "**Alert '{event.properties.alert_name}' firing** for insight '{event.properties.insight_name}'\n\n{event.properties.breaches}\n\n[View alert]({project.url}/insights/{event.properties.insight_id}/alerts?alert_id={event.properties.alert_id})",
            "**{person.name}** triggered event: '{event.event}'"
        ]
    },
    "template-slack": {
        "blocks": [
            [
                {
                    "text": {
                        "text": "*{person.name}* triggered event: '{event.event}'",
                        "type": "mrkdwn"
                    },
                    "type": "section"
                },
                {
                    "elements": [
                        {
                            "text": {
                                "text": "View Person in PostHog",
                                "type": "plain_text"
                            },
                            "type": "button",
                            "url": "{person.url}"
                        },
                        {
                            "text": {
                                "text": "Message source",
                                "type": "plain_text"
                            },
                            "type": "button",
                            "url": "{source.url}"
                        }
                    ],
                    "type": "actions"
                }
            ],
            [
                {
                    "text": {
