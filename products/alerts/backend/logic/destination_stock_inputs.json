                                    "text": {
                                        "type": "plain_text",
                                        "text": "Pick a date & time…"
                                    },
                                    "value": "{event.properties.alert_id}|custom"
                                }
                            ]
                        }
                    ]
                }
            ]
        ],
        "body": [
            {
                "blocks": [
                    {
                        "text": {
                            "text": "*{person.name}* triggered event: '{event.name}'",
                            "type": "mrkdwn"
                        },
                        "type": "section"
                    },
                    {
                        "elements": [
                            {
                                "text": {
                                    "text": "View Person in PostHog",
                                    "type": "plain_text"
                                },
                                "type": "button",
                                "url": "{person.url}"
                            },
                            {
                                "text": {
                                    "text": "Message source",
                                    "type": "plain_text"
                                },
                                "type": "button",
                                "url": "{source.url}"
                            }
                        ],
                        "type": "actions"
                    }
                ]
            }
        ],
        "icon_emoji": [":hedgehog:"],
        "text": [
            "*{person.name}* triggered event: '{event.event}'",
            "Alert triggered: {event.properties.insight_name}"
        ],
        "username": ["PostHog"]
    },
    "template-webhook": {
        "body": [
            {
                "alert_name": "{event.properties.alert_name}",
                "alert_url": "{project.url}/insights/{event.properties.insight_id}/alerts?alert_id={event.properties.alert_id}",
                "breaches": "{event.properties.breaches}",
                "insight_name": "{event.properties.insight_name}",
                "insight_url": "{project.url}/insights/{event.properties.insight_id}"
            },
            {
                "event": "{event}",
                "person": "{person}"
            }
        ],
        "headers": [
            {
                "Content-Type": "application/json"
            }
        ],
        "method": ["POST"]
    }
}
