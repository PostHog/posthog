          "mrr_usd": "number",
          "plan": "string"
        },
        "description": "Monthly recurring revenue per account, from confirmed checkouts.",
        "is_materialized": true,
        "name": "mrr",
        "query": {
          "kind": "HogQLQuery",
          "query": "select properties.account_id as account_id,\n       toStartOfMonth(timestamp) as month,\n       sum(toFloat(properties.total_usd)) as mrr_usd,\n       any(properties.plan) as plan\nfrom events\nwhere event = 'checkout_completed'\ngroup by account_id, month"
        },
        "sync_frequency": "1hour"
      },
