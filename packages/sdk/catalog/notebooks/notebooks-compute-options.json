{
    "method": "notebooks.notebooksComputeOptions",
    "toolName": "notebooks-compute-options",
    "operationId": "notebooks_kernel_compute_options_retrieve",
    "title": "Get notebook compute options",
    "category": "Notebooks",
    "description": "The rates a notebook's sandbox is priced at, the sized presets a user can pick from, and the cpu_cores and memory_gb values notebooks-configure-compute accepts. The rates are the same for every notebook in the region, so fetch this once per session rather than per notebook. Use it to quote a price before you start or resize a sandbox: a shape costs cpu_cores x cpu_rate_per_core_hour + memory_gb x memory_rate_per_gb_hour per hour, rounded to four decimal places, and each preset carries that total as hourly_price.",
    "requiredScopes": ["notebook:read"],
