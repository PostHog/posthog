    "methodDocumentation": [
        {
            "role": "original",
            "text": "The API for interacting with Notebooks. This feature is in early access and the API can have breaking changes without announcement.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1notebooks~1{short_id}~1widgets~1{node_id}~1attach~1/post"
            }
        },
        {
            "role": "override",
            "text": "Attach a reusable widget to an existing Widget node in a notebook. First save a `<Widget nodeId=\"...\" />` element in the notebook markdown, then pass that node_id here. Map every logical input slot from the widget contract to a dataframe in this notebook with `{source: \"dataframe_name\"}`. When source columns do not match the contract, add a pure Hog expression in `hog` that receives `rows`, `columns`, and `frame` and returns a list of objects with the contract's columns. Omit version_id or pass null to follow the latest shared version; pass a version UUID to pin this placement.",
            "source": {
                "kind": "mcp_yaml",
                "file": "products/notebooks/mcp/tools.yaml"
            }
        }
    ],
