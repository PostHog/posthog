{
    "method": "engineeringAnalytics.engineeringAnalyticsRunFailureLogs",
    "toolName": "engineering-analytics-run-failure-logs",
    "operationId": "engineering_analytics_run_failure_logs",
    "title": "CI failure logs for a run",
    "category": "Engineering analytics",
    "description": "The thinned CI failure logs of one workflow run, grouped by failed job: the run-scoped twin of ci-failure-logs, for when you have a run id rather than a PR (default-branch failures, the broken-tests panel's latest_run_id, the run page). Each failed job returns its failure region (error lines plus surrounding context, with \"... N lines omitted ...\" markers) as ordered lines, every line carrying its original 1-based line number in the full pre-thinning log. logs_available is false when the run didn't fail or its logs aged out of the short Logs retention. Use ci-failure-logs instead when you have a PR number and want all its runs' failures. Pass ci_engine with run_id (latest_ci_engine for a triage row). Ambiguous integer IDs return 400. Null engine means unknown historical provenance.",
    "requiredScopes": ["engineering_analytics:read"],
    "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
    },
    "availability": ["feature_flag: engineering-analytics"],
