    "toolName": "stamphog-pull-requests-get",
    "operationId": "stamphog_pull_requests_retrieve",
    "title": "Get stamphog pull request",
    "category": "Stamphog",
    "description": "Get one pull request record from stamphog (PostHog's automated PR review and merged-PR digest) by its internal UUID — the `id` returned by `stamphog-pull-requests-list`, not the GitHub PR number. Returns the repository, title, author, head branch, and merge details. To look a PR up by its GitHub number, use `stamphog-pull-requests-list` with `pr_number`. For CI status or merge-timing analytics on a PR, use the engineering analytics `pull-requests` or `pr-lifecycle` tools instead.",
    "requiredScopes": ["stamphog:read"],
