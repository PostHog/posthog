{
    "method": "canvas.canvasBuildsRetrieve",
    "toolName": "canvas-builds-retrieve",
    "operationId": "canvases_builds_retrieve",
    "title": "Read canvas build status",
    "category": "Canvas",
    "description": "Read a canvas's build lifecycle: `published_build_id` (the live build), `current_version_id`, and the most recent builds with their status (queued/building/ready/failed) and structured diagnostics. A publish queues a build; poll this until the build you queued is terminal — `ready` (the live pointer advances) or `failed` (fix the error diagnostics and publish again; the last good build stays live). Do not finish a canvas task while its build is still queued or building. A publish or edit response already carries its build status, so call this only when that status was `queued` or `building`.",
    "requiredScopes": ["canvas:read"],
    "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
    },
    "availability": [],
