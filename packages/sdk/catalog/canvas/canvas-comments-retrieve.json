{
    "method": "canvas.canvasCommentsRetrieve",
    "toolName": "canvas-comments-retrieve",
    "operationId": "canvases_comments_retrieve",
    "title": "Read a canvas comment thread",
    "category": "Canvas",
    "description": "Read one comment thread on a canvas: the root comment and its replies, oldest first, with the text or region anchor and the canvas version each comment was written on. Read the full thread before you act on a root comment, because a later reply can change the request. If `next` is not null, call again with `cursor`. If an entry has `content_truncated: true`, call again with `comment_id` set to that entry's id and `content_offset` set to its `content_next_offset`.",
    "requiredScopes": ["canvas:read", "comment:read"],
    "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
    },
