    "methodDocumentation": [
        {
            "role": "original",
            "text": "One published version's series. Every hog flow metric is mirrored under\n`hog_flow_version` with the version appended to the id, which is what makes \"before and\nafter this change\" answerable at all. The unversioned read keys batch and broadcast runs on\nthe run instead, so it is not the sum of the versions.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1hog_flows~1{id}~1metrics~1version~1/get"
            }
        },
        {
            "role": "override",
            "text": "Execution stats for a single published version of a workflow, in the same shape as workflows-stats. That is how you tell whether a change helped: compare the version before it with the version after it. The unversioned read in workflows-stats keys batch and broadcast runs on the run rather than the workflow, so it is not the sum of the versions - compare versions with each other, not with it. Set instance_id to the step you are reading, or several steps share one denominator.",
            "source": {
                "kind": "mcp_yaml",
                "file": "products/workflows/mcp/tools.yaml"
            }
        }
    ],
