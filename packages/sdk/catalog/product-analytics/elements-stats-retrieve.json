{
    "method": "productAnalytics.elementsStatsRetrieve",
    "toolName": "elements-stats-retrieve",
    "operationId": "elements_stats_retrieve",
    "title": "Get element click stats",
    "category": "Product analytics",
    "description": "Counts of autocapture clicks, rage clicks, and dead clicks grouped by page element, ordered by count. Each result carries the parsed element chain (tag, text, href, attributes) of the clicked element. Filter by date range, event types, URL or other event/person properties, and the project's internal-test-account filters. This powers heatmap/clickmap views; use it to answer \"what do users click most\" and \"which elements get rage or dead clicks\". Responses can be very large on busy projects — always pass a small `limit` (e.g. 100) and paginate with `offset` if you need more results.",
    "requiredScopes": ["element:read"],
    "annotations": {
