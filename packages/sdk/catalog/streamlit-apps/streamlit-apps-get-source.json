    "method": "streamlitApps.streamlitAppsGetSource",
    "toolName": "streamlit-apps-get-source",
    "operationId": "streamlit_apps_source_retrieve",
    "title": "Get Streamlit app source",
    "category": "Streamlit apps",
    "description": "Read the code of a Streamlit app version. Defaults to the active version; pass version_number for an older one. Returns version_number and a manifest of every file (path, size, sha256, content_type) with the full text of each text file. Binary files are listed without content. Pass `paths` to get the content of only some files, which keeps the response small for a large app. Always read the source here before you change an app, then use streamlit-apps-edit-source with the returned version_number, so you do not overwrite a newer version with an old local copy.",
    "requiredScopes": ["streamlit_app:read"],
    "annotations": {
