    "methodDocumentation": [
        {
            "role": "original",
            "text": "Applies exact text edits, file creations, and file deletions to base_version, then stores the result as a new active version. Files that no change touches stay byte-for-byte the same.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1streamlit_apps~1{short_id}~1edit_source~1/post"
            }
        },
        {
            "role": "override",
            "text": "Change an existing Streamlit app without resending its whole source. Read the files first with streamlit-apps-get-source, then send exact text edits, new files, and deletions against that version number as base_version. The edits create a new active version; every file you do not touch stays byte-for-byte the same. If base_version is not the active version, the call fails with 409 and returns current_version: read that version again and redo the edits, do not fall back to set-source. If an edit's `old` text matches zero or many times, the call fails with 400 and names the file and edit index. If the app is running, its sandbox is stopped; call streamlit-apps-start afterwards.",
            "source": {
