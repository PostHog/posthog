{
    "method": "proxyRecords.proxyDiagnose",
    "toolName": "proxy-diagnose",
    "operationId": "proxy_records_diagnose_create",
    "title": "Diagnose reverse proxy",
    "category": "Reverse proxy",
    "description": "Run a deep diagnostic on a reverse proxy that's stuck or erroring. Inspects the customer's CNAME, the certificate provider's hostname state, CAA records walked up the DNS tree (the most common stuck-validation cause), HTTP-01 challenge reachability, a live event probe, and certificate expiry. Returns a structured report with each check's status and concrete remediation steps — including the exact DNS records the customer should add when CAA blocks issuance. Use this when proxy-get returns an erroring or timed_out status, or whenever a user asks why their proxy isn't working.",
    "requiredScopes": ["organization:write"],
