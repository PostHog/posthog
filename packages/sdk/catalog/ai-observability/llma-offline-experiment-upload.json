    "method": "aiObservability.llmaOfflineExperimentUpload",
    "toolName": "llma-offline-experiment-upload",
    "operationId": "ai_observability_offline_experiments_upload_create",
    "title": "Upload offline results",
    "category": "AI observability",
    "description": "Persist externally computed scores and their shared items in one atomic request. Submit 1–1,000 results, keyed by item_id and exact scorer_version_id, with up to 1,000 item declarations. Reuse caller-generated item IDs and unchanged content for retries; a result is unique per item/scorer version. Existing items can be referenced without repeating their declaration or payload. This tool does not execute evaluators. Item payloads allow 1 MiB and result payloads 256 KiB; use small batches through MCP and the API for bulk uploads. Correct validation errors before retrying; never generate new IDs merely to retry an uncertain response.",
    "requiredScopes": ["offline_evaluation_ingestion:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": true
    },
