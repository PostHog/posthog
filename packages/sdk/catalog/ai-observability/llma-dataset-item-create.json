{
    "method": "aiObservability.llmaDatasetItemCreate",
    "toolName": "llma-dataset-item-create",
    "operationId": "dataset_items_create",
    "title": "Create dataset item",
    "category": "AI observability",
    "description": "Add an item to a dataset and create its first immutable version. `input` accepts any non-null JSON value. Use `expected_output` for the user-authored target and `source_output` for an actual output copied from a trace. Supply a case-sensitive `client_item_id` for safe retries. An identical retry returns the existing item. A different payload or an archived matching item returns a conflict. Restore archived items explicitly. For trace provenance, provide `source_trace_id` and `source_timestamp` together; `source_event_id` is optional.",
    "requiredScopes": ["dataset:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
    },
