    "method": "aiObservability.llmaScoreDefinitionNewVersion",
    "toolName": "llma-score-definition-new-version",
    "operationId": "llm_analytics_score_definitions_new_version_create",
    "title": "Bump scorer to a new version",
    "category": "AI observability",
    "description": "Publish a new immutable `config` version for an existing scorer. Use this whenever the scoring rules change (add/remove categorical options, tweak numeric bounds or passing rules, change boolean polarity or labels). Existing trace reviews keep their snapshot of the previous version, so historical scores remain stable. The `config` shape must match the scorer's `kind`. Each call increments `current_version` by one. Pass `base_version` (the version number you observed before bumping) for optimistic concurrency — the request returns 409 if another writer already advanced the scorer. Optional `name` and `description` updates are saved atomically with the version.",
    "requiredScopes": ["llm_analytics:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
    },
