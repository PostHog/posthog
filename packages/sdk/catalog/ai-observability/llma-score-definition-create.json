    "method": "aiObservability.llmaScoreDefinitionCreate",
    "toolName": "llma-score-definition-create",
    "operationId": "llm_analytics_score_definitions_create",
    "title": "Create scorer",
    "category": "AI observability",
    "description": "Create a new scorer (a.k.a. score definition) used by trace reviews. Pass `name`, `kind` (`categorical`, `numeric`, or `boolean`), and `config` matching the kind. `kind` is immutable after creation. Categorical scorers need an `options` array with unique keys and optional `selection_mode`/`min_selections`/`max_selections` (for `multiple`). Numeric scorers can set `min`, `max`, `step`, and an optional `passing_rule` with `operator` (`gte`/`lte`) and a finite `threshold` within those bounds. Boolean scorers can override `true_label`/`false_label` and set `true_is_failure` (`false`: true passes; `true`: false passes). Omitted or null boolean polarity defaults to true passing in offline evaluations. Numeric scores without a passing rule remain neutral. Scorers always start active (not archived) and at version 1.",
    "requiredScopes": ["llm_analytics:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
    },
