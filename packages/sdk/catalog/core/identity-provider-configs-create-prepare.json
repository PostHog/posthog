    "methodDocumentation": [
        {
            "role": "override",
            "text": "Create an organization identity provider configuration for SAML, OIDC, SCIM, or XAA (ID-JAG). Set `config_scope` to `saml`, `oidc`, `scim`, or `xaa`. Use `domain_scope: selected` with `organization_domain_ids` to link specific organization domains, or `domain_scope: all` to cover all verified organization domains. SAML uses `saml_entity_id`, `saml_acs_url`, and `saml_x509_cert`; OIDC uses `oidc_issuer_url`, `oidc_client_id`, and `oidc_client_secret`; SCIM can be enabled with `scim_enabled`; XAA uses `id_jag_issuer_url` with optional JWKS and allowed-client settings. The create call requires explicit user confirmation before execution.",
            "source": {
                "kind": "mcp_yaml",
                "file": "services/mcp/definitions/core.yaml"
            }
        },
