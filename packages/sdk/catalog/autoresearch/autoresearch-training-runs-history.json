    "methodDocumentation": [
        {
            "role": "original",
            "text": "Return recent completed training runs and their iteration trails so a new run can learn from what was already tried. Scoped to this pipeline first, then same-target sibling pipelines on the team. Read this before iterating to reuse winning features and avoid repeating discarded approaches.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1autoresearch~1{pipeline_id}~1training_runs~1history~1/get"
            }
        },
