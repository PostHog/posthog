        {
            "role": "original",
            "text": "List and retrieve champion/challenger models for a pipeline.\n\nModels are the persisted artifacts produced by training runs. Each model\nholds a portable recipe (feature SQL, transforms, model class, params) that\nthe daily inference workflow compiles to score users.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1autoresearch~1{pipeline_id}~1models~1/get"
            }
        },
        {
