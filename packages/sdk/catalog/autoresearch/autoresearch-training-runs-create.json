    "method": "autoresearch.autoresearchTrainingRunsCreate",
    "toolName": "autoresearch-training-runs-create",
    "operationId": "autoresearch_training_runs_create",
    "title": "Open a training run",
    "category": "Autoresearch",
    "description": "Open a new training run for a pipeline and return its id, for a bring-your-own agent that trains outside PostHog. The agent then records iterations against this run with autoresearch-training-runs-iterations-create and finalizes it with autoresearch-training-runs-complete-create. The run starts in 'running'. Optionally override the iteration_budget for this run. Refused from inside a sandbox: the in-house training agent works in the run that autoresearch-train-create opened for it. A pipeline with an action target also needs the action:read scope.",
    "requiredScopes": ["autoresearch:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
    },
