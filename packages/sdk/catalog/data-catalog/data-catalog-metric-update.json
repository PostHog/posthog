{
    "method": "dataCatalog.dataCatalogMetricUpdate",
    "toolName": "data-catalog-metric-update",
    "operationId": "data_catalog_metrics_partial_update",
    "title": "Update a catalog metric",
    "category": "Data catalog",
    "description": "Update a metric's fields. 'name' picks the metric to update. Editing an approved metric's definition, description, unit, or name resets it to 'proposed' (it must be re-approved by a human). Pass 'new_name' to rename the metric: the old name is freed for reuse, and anything that referenced it (saved SQL, run URLs, later tool calls) must switch to the new name. When editing 'description', keep it to 1-2 short sentences under 300 characters: what the number is and its grain. Leave out source tables or views, lineage, column lists, and comparisons with other metrics; rationale for the definition belongs in 'reasoning'.",
    "requiredScopes": ["data_catalog:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": true
    },
