    "method": "logs.logsAlertsDestinationsCreate",
    "toolName": "logs-alerts-destinations-create",
    "operationId": "logs_alerts_destinations_create",
    "title": "Attach alert destination",
    "category": "Logs",
    "description": "Attach a Slack, webhook, Microsoft Teams, or PagerDuty notification destination to a log alert. Without a destination an alert evaluates silently and never notifies. One HogFunction is created per event kind (firing, resolved, broken, errored) atomically. A PagerDuty destination gets the incident opened and incident closed kinds instead. They follow every start and end of a firing, cooldown included, so each incident it opens is resolved. The returned hog_function_ids identify the destination group.",
    "requiredScopes": ["logs:write"],
    "annotations": {
        "readOnly": false,
        "destructive": false,
        "idempotent": false
    },
