    "methodDocumentation": [
        {
            "role": "original",
            "text": "Create a notification destination for this alert. One HogFunction is created per alert event kind (firing, resolved, ...) atomically. A PagerDuty destination gets the incident opened and incident closed kinds instead. They follow every start and end of a firing, cooldown included, so each incident it opens is resolved.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1logs~1alerts~1{id}~1destinations~1/post"
            }
        },
        {
            "role": "override",
            "text": "Attach a Slack, webhook, Microsoft Teams, or PagerDuty notification destination to a log alert. Without a destination an alert evaluates silently and never notifies. One HogFunction is created per event kind (firing, resolved, broken, errored) atomically. A PagerDuty destination gets the incident opened and incident closed kinds instead. They follow every start and end of a firing, cooldown included, so each incident it opens is resolved. The returned hog_function_ids identify the destination group.",
            "source": {
                "kind": "mcp_yaml",
                "file": "products/logs/mcp/tools.yaml"
            }
        }
    ],
