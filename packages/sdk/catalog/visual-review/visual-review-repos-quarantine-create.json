    "method": "visualReview.visualReviewReposQuarantineCreate",
    "toolName": "visual-review-repos-quarantine-create",
    "operationId": "visual_review_repos_quarantine_create",
    "title": "Quarantine a visual review snapshot",
    "category": "Visual review",
    "description": "Stop one identifier of one run type from failing any run in the repo until the quarantine expires. It is still captured and diffed. Use it only for a story that flakes on the default branch (`unstable` in `visual-review-repos-flakiness-retrieve`, `hard_count` of 5 or more, and a failure in the last 7 days), never for a `broken` entry (its baseline needs a fix) or a diff your own change caused. Pass the failing run as `source_run_id` and a `reason` with the evidence. An omitted or later `expires_at` becomes 30 days. A repeat call replaces the quarantine. Then call `visual-review-runs-recompute-create` to update the open pull request's gate.",
    "requiredScopes": ["visual_review:write"],
