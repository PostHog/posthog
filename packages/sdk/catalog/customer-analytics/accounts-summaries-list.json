{
    "method": "customerAnalytics.accountsSummariesList",
    "toolName": "accounts-summaries-list",
    "operationId": "accounts_summaries_list",
    "title": "List account channel summaries",
    "category": "Customer analytics",
    "description": "List the stored AI summaries of a Customer Analytics account's bound Slack channel, newest period first. Each summary covers one closed calendar period — the `cadence` (daily, weekly, or monthly) follows the account's `slack_summary_cadence` setting — and includes `period_start`/`period_end`, Markdown `content` citing the original Slack messages with permalinks, `message_count`, and `generated_at`. The summarized channel is the account's `slack_channel_id` property; each summary keeps the `slack_channel_id` it actually covered, even if the account is later rebound to another channel. Returns an empty list when the account has no bound channel, summaries are off (`slack_summary_cadence` is null), or nothing has been generated yet.",
    "requiredScopes": ["account:read"],
    "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
    },
    "availability": ["feature_flag: customer-analytics-csp"],
