    "methodDocumentation": [
        {
            "role": "original",
            "text": "Test feature flag evaluation against a specific user at an optional point in time.\n\nThis endpoint allows testing how a feature flag would evaluate for a specific user,\noptionally at a historical timestamp. When a timestamp is provided, both the flag\nconditions and person properties are evaluated as they existed at that time.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1feature_flags~1{id}~1test_evaluation~1/post"
            }
        },
        {
            "role": "override",
            "text": "Simulate how one feature flag (by numeric ID) would evaluate for a specific user, optionally at a past point in time (`timestamp` reconstructs flag conditions and person properties as they existed then). Provide `distinct_id` or `person_id` (mutually exclusive) and optionally `groups`. Returns the evaluated value with detailed reasoning: which condition matched and the person properties used. Use this to debug or dry-run a single flag; use `feature-flags-evaluation-reasons-retrieve` to see live evaluations across many flags for a user, and `feature-flags-user-blast-radius-create` to size a release condition before applying it.",
            "source": {
                "kind": "mcp_yaml",
                "file": "products/feature_flags/mcp/tools.yaml"
            }
        }
    ],
