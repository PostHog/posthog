{
    "method": "featureFlags.featureFlagsTestEvaluationCreate",
    "toolName": "feature-flags-test-evaluation-create",
    "operationId": "feature_flags_test_evaluation_create",
    "title": "Test feature flag evaluation",
    "category": "Feature flags",
    "description": "Simulate how one feature flag (by numeric ID) would evaluate for a specific user, optionally at a past point in time (`timestamp` reconstructs flag conditions and person properties as they existed then). Provide `distinct_id` or `person_id` (mutually exclusive) and optionally `groups`. Returns the evaluated value with detailed reasoning: which condition matched and the person properties used. Use this to debug or dry-run a single flag; use `feature-flags-evaluation-reasons-retrieve` to see live evaluations across many flags for a user, and `feature-flags-user-blast-radius-create` to size a release condition before applying it.",
    "requiredScopes": ["feature_flag:read"],
    "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
    },
