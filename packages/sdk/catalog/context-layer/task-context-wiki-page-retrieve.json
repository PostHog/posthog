    "methodDocumentation": [
        {
            "role": "original",
            "text": "The same organization wiki, reached by an agent run inside a sandbox.\n\nThis exists as a second, project-nested route because a sandbox run token\ncarries `scoped_teams`, and `APIScopePermission` accepts those only on a\nproject-nested view — on the organization-scoped route above, every sandbox\ntoken is refused before it reaches any of this. The wiki is still one repo\nper organization; the project in the path is how a run token proves which\norganization it may act for, and is not a scope on the wiki itself.",
            "source": {
                "kind": "openapi",
                "file": "openapi.json",
                "pointer": "#/paths/~1api~1projects~1{project_id}~1context_layer~1agent~1pages~1/get"
            }
        },
        {
            "role": "override",
            "text": "Read a bounded context wiki page chunk and its head_sha for an unattended task run. Follow next_offset with the same head_sha and limit until complete is true. Join all content chunks before editing. On 409, discard the chunks and restart at offset zero.",
