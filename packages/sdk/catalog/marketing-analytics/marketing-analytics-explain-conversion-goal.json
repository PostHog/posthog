{
    "method": "marketingAnalytics.marketingAnalyticsExplainConversionGoal",
    "toolName": "marketing-analytics-explain-conversion-goal",
    "operationId": "marketing_analytics_explain_conversion_goal_retrieve",
    "title": "Explain a conversion goal",
    "category": "Marketing analytics",
    "description": "Break down the events that COUNT toward a conversion goal by their own utm_source, utm_campaign, and matched integration. Returns recent sample events for inspection. This is a flat per-event breakdown of the conversion events themselves — NOT an analysis of the user's prior journey, and NOT the dashboard's attribution calculation (first-touch / last-touch / multi-touch weighting is applied by the dashboard, not here). Use when the user asks \"what utm_sources are behind my N conversions?\" or \"where do these conversions come from?\". Only EventsNode and ActionsNode goals are explained at the event level; DataWarehouseNode goals short-circuit with a note. Requires conversion_goal_id — call marketing-analytics-conversion-goals first and pass the conversion_goal_id of the goal you want.",
    "requiredScopes": ["marketing_analytics:read"],
    "annotations": {
        "readOnly": true,
        "destructive": false,
        "idempotent": true
    },
