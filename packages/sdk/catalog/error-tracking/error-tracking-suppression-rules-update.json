    "methodDocumentation": [
        {
            "role": "override",
            "text": "Update an error tracking suppression rule by ID. Only the fields you include in the request body are applied; omitted fields keep their existing values. Supports updating `filters` and `sampling_rate`. WARNING: broadening `filters` will start dropping additional events at ingestion silently. Keep filters tightly scoped to the exact errors you want gone. Prefer raising `sampling_rate` to dampen volume over widening the match. Confirm with the user before changing a rule's filters in a way that could match more than one distinct error.",
            "source": {
                "kind": "mcp_yaml",
                "file": "products/error_tracking/mcp/tools.yaml"
            }
        }
    ],
    "typeDocumentation": [
        {
            "typeName": "ErrorTrackingErrorTrackingSuppressionRulesUpdateInput",
            "field": "filters",
            "effectiveDescription": "Property-group filters that define which incoming error events should be suppressed. Provide an empty `values` array to convert the rule into a match-all suppression. Omit to preserve the existing filters.",
            "layers": [
                {
                    "role": "original",
                    "text": "Property-group filters that define which incoming error events should be suppressed. Provide an empty `values` array to convert the rule into a match-all suppression. Omit to preserve the existing filters.",
