{
    "name": "@posthog/sdk",
    "version": "0.1.0",
    "description": "Typed PostHog API client and offline operation discovery for agents",
    "license": "MIT",
    "bin": {
        "posthog-sdk": "./dist/cli.js"
    },
    "files": [
        "dist",
        "src/define",
        "src/generated/api.ts",
        "src/types.ts",
        "api-index.tsv",
        "domains.tsv",
        "coverage.json",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./discovery": {
            "types": "./dist/discovery.d.ts",
            "default": "./dist/discovery.js"
        },
        "./define": {
            "posthog-source": "./src/define/index.ts",
            "types": "./dist/define/index.d.ts",
            "default": "./dist/define/index.js"
        },
        "./stack": {
            "types": "./dist/stack/index.d.ts",
            "default": "./dist/stack/index.js"
        },
        "./coverage.json": "./coverage.json",
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/generated/*/index.d.ts",
            "default": "./dist/generated/*/index.js"
        },
        "./api": {
            "types": "./dist/generated/api.d.ts",
            "default": "./dist/generated/api.js"
        },
        "./api-index.tsv": "./api-index.tsv",
        "./domains.tsv": "./domains.tsv"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/types/tsconfig.json",
        "generate": "node --max-old-space-size=4096 ../../services/mcp/scripts/generate-sdk.mjs",
        "test": "node --test tests/*.test.mjs",
        "fixture:description": "node scripts/write-fixture-description.mjs",
        "check:package": "node scripts/check-package.mjs",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@posthog/mcp": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
