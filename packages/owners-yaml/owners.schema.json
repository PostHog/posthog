{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/PostHog/posthog/blob/master/packages/owners-yaml/owners.schema.json",
    "title": "owners.yaml",
    "description": "Code ownership for a directory, version 1. See SPEC.md. Keys under 'Repository settings' are valid only in the repository root file.",
    "type": "object",
    "required": ["version", "owners"],
    "additionalProperties": false,
    "properties": {
        "version": { "const": 1, "description": "The format version." },
        "owners": { "$ref": "#/$defs/owners" },
        "status": { "$ref": "#/$defs/status" },
        "inherit": {
            "type": "boolean",
            "description": "Whether fields fall through from ancestor files. Default true."
        },
        "rules": {
            "type": "array",
            "description": "Per-path overrides inside this directory. Every matching rule applies in order, and each replaces only the fields it sets.",
            "items": { "$ref": "#/$defs/rule" }
        },
        "additions": { "$ref": "#/$defs/additions" },
        "teams": {
            "type": "object",
            "description": "Repository settings: team slug to its channels.",
            "propertyNames": { "not": { "pattern": "^@" } },
            "additionalProperties": { "$ref": "#/$defs/teamEntry" }
        },
        "github_org": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/]+$",
            "description": "Repository settings: the GitHub organization of the team slugs."
        },
        "producers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Repository settings: automation names a team can address in notifications."
        },
        "reserved_dirs": {
            "type": "array",
            "items": { "$ref": "#/$defs/pattern" },
            "description": "Repository settings: patterns where owners.yaml must not be placed."
        },
        "alias_files": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "not": { "pattern": "[/\\\\]|^\\.{1,2}$|^owners\\.yaml$" } },
            "default": ["product.yaml"],
            "description": "Repository settings: other bare file names that count as ownership files. Undeclared means [product.yaml]; a declared list replaces that default, and [] turns alias files off."
        },
        "codeowners": {
            "type": "object",
            "description": "Repository settings: how the owners-yaml CODEOWNERS export spells test paths.",
            "additionalProperties": false,
            "properties": {
                "jest_root": { "type": "string", "minLength": 1 },
                "jest_root_tests": { "$ref": "#/$defs/pattern" },
                "jest_root_packages": { "type": "string", "minLength": 1 }
            }
        }
    },
    "$defs": {
        "owners": {
            "description": "Team slugs or @handles, primary owner first. null means unowned by design.",
            "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "items": { "type": "string", "minLength": 1 } },
                { "type": "null" }
            ]
        },
        "additions": {
            "description": "Team slugs or @handles who own additions, separate from the owners. Appends to the file-level value and to what ancestor files declare. A consumer decides what counts as an addition.",
            "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "items": { "type": "string", "minLength": 1 } }
            ]
        },
        "status": {
            "enum": ["active", "deprecated", "generated", "vendored"],
            "description": "The lifecycle of the code. Default active."
        },
        "pattern": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "\\*\\*\\*" },
            "description": "A GitHub CODEOWNERS pattern."
        },
        "rule": {
            "type": "object",
            "required": ["match"],
            "additionalProperties": false,
            "properties": {
                "match": {
                    "oneOf": [
                        { "$ref": "#/$defs/pattern" },
                        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pattern" } }
                    ]
                },
                "owners": { "$ref": "#/$defs/owners" },
                "status": { "$ref": "#/$defs/status" },
                "inherit": { "type": "boolean" },
                "additions": { "$ref": "#/$defs/additions" }
            }
        },
        "channel": {
            "description": "A Slack channel, or false for no channel.",
            "oneOf": [{ "type": "string", "pattern": "^#" }, { "const": false }]
        },
        "teamEntry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "slack": { "$ref": "#/$defs/channel" },
                "notifications": {
                    "oneOf": [
                        { "$ref": "#/$defs/channel" },
                        {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": { "$ref": "#/$defs/channel" }
                        }
                    ]
                }
            }
        }
    }
}
