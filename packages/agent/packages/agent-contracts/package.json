{
  "name": "@posthog/agent-contracts",
  "version": "1.0.0",
  "description": "Types, schemas and helpers the agent runtime and its hosts share",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/rimraf.mjs dist .turbo"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}
