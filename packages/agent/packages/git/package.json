{
  "name": "@posthog/git",
  "version": "1.0.0",
  "description": "Git utilities for PostHog",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rimraf.mjs dist .turbo",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "dependencies": {
    "@posthog/agent-contracts": "workspace:*",
    "git-url-parse": "^16.1.0",
    "simple-git": "^3.36.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PostHog/posthog.git",
    "directory": "packages/agent/packages/git"
  },
  "publishConfig": {
    "access": "public"
  }
}
