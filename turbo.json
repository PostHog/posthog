{
    "$schema": "https://turbo.build/schema.json",
    "futureFlags": {
        "affectedUsingTaskInputs": true
    },
    "tasks": {
        // Only affectedness reads this task: turbo-discover asks which products' inputs changed.
        // CI runs the tests with .github/scripts/run-product-tests.sh.
        "backend:test": {
            "inputs": [
                "backend/**/*.py",
                "!backend/**/__pycache__/**",
                // A few products keep tests outside backend/:
                // experiments (stats/), logs (skills/), posthog_ai (scripts/).
                // These globs anchor per-package, so they only match where the
                // dir exists. Do NOT collapse to a leading "**/*.py" — that
                // resolves from the workspace root and marks every product's
                // backend:test affected on any .py change, forcing the full suite.
                "stats/**/*.py",
                "skills/**/*.py",
                "scripts/**/*.py",
                "../../pyproject.toml",
                "../../uv.lock",
                "../../common/**/*.py"
            ],
            "outputs": [],
            "cache": true
        },
        "backend:lint": {
            "inputs": ["backend/**/*.py", "!backend/**/__pycache__/**"],
            "outputs": [],
            "cache": true
        },
        "backend:contract-check": {
            "inputs": ["backend/**/*.py", "!backend/**/__pycache__/**"],
            "outputs": [],
            "cache": true
        },
        "prepare": {
            "dependsOn": ["^build"]
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["src", "vite.config.ts", "Cargo.toml", "!**/*.pyc"],
            "outputs": ["dist", "index.node", ".turbo"],
            "env": ["RUST_VERSION", "SHARD_INDEX", "SHARD_COUNT"],
            "passThroughEnv": [
                "RUSTUP_HOME",
                "CARGO_HOME",
                "DATABASE_URL",
                "REDIS_URL",
                "NODE_OPTIONS",
                "SSL_CERT_FILE"
            ]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["src", "tests", "Cargo.toml", "!**/*.pyc"],
            // JEST_JUNIT_* must live in `env` (the cache key), not just passThroughEnv:
            // flipping them on without invalidating the cache replays a previous run's
            // test logs while skipping jest entirely, which the CI upload step then reads
            // as "no junit files were produced" and the shard silently passes untested.
            "env": [
                "RUST_VERSION",
                "SHARD_INDEX",
                "SHARD_COUNT",
                "JEST_JUNIT_OUTPUT_DIR",
                "JEST_JUNIT_OUTPUT_NAME",
                "JEST_JUNIT_SUITE_NAME",
                "JEST_JUNIT_ADD_FILE_ATTRIBUTE"
            ],
            "passThroughEnv": [
                "RUSTUP_HOME",
                "CARGO_HOME",
                "DATABASE_URL",
                "REDIS_URL",
                "NODE_OPTIONS",
                "PERSONS_DATABASE_URL",
                "PERSONS_READONLY_DATABASE_URL"
            ]
        },
        "start": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false,
            "passThroughEnv": ["SKIP_TYPEGEN", "COREPACK_ENABLE_DOWNLOAD_PROMPT", "SSL_CERT_FILE", "JS_URL"]
        },
        "start-vite": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false,
            // Turbo strips undeclared env vars, so an opt-in set in .env.local never reaches vite.config.mts
            // unless it is listed here. DEV_CODE_INSPECTOR loads the click-to-source plugin, and CODE_EDITOR picks the editor it opens.
            "passThroughEnv": [
                "SKIP_TYPEGEN",
                "COREPACK_ENABLE_DOWNLOAD_PROMPT",
                "SSL_CERT_FILE",
                "JS_URL",
                "DEV_CODE_INSPECTOR",
                "CODE_EDITOR"
            ]
        },
        "dev": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "clean": {
            "dependsOn": ["^clean"],
            "cache": false
        }
    }
}
