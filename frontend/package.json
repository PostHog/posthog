        "url": "https://github.com/posthog/posthog/issues"
    },
    "license": "MIT",
    "author": "PostHog Inc.",
    "repository": {
        "type": "git",
        "url": "https://github.com/posthog/posthog.git"
    },
    "browser": {
        "path": "path-browserify"
    },
    "scripts": {
        "copy-scripts": "mkdir -p dist/ && ./bin/copy-posthog-js",
        "clean": "rm -rf dist && mkdir dist",
        "build": "pnpm copy-scripts && pnpm build:esbuild",
        "build:with-report": "pnpm build && node ./bin/build-bundle-report.mjs && node ./bin/build-bundle-size-report.mjs && node ./bin/check-eager-graph.mjs --report-only && node ./bin/check-layers.mjs --report-only --html layer-graph.html && node ./bin/check-toolbar-size.mjs --report-only",
        "build:esbuild": "DEBUG=0 node ./build.mjs",
        "build:products": "DEBUG=0 node build-products.mjs",
        "build:app-urls": "node bin/build-app-url-manifest.mjs",
        "build:app-urls:check": "node bin/build-app-url-manifest.mjs --check",
        "build:admin-console": "node bin/build-admin-console.mjs && oxfmt public/admin-console/console.css",
        "build:message-preferences": "node bin/build-message-preferences.mjs && oxfmt public/message-preferences.css",
        "start": "pnpm start-http",
        "start-http": "pnpm clean && pnpm copy-scripts && pnpm build:esbuild --dev",
        "start-docker": "pnpm start-http --host 0.0.0.0",
        "openapi:types": "node ./bin/generate-openapi-types.mjs",
        "typegen:check": "cd .. && NODE_OPTIONS=--max-old-space-size=16384 kea-typegen check",
        "typegen:clean": "cd .. && find frontend/src products common -type f -name '*Type.ts' -delete",
        "typegen:file": "node ./bin/typegen-file.mjs",
        "typegen:watch": "cd .. && NODE_OPTIONS=--max-old-space-size=16384 kea-typegen watch --delete --show-ts-errors --use-cache",
        "typegen:write": "cd .. && NODE_OPTIONS=--max-old-space-size=16384 kea-typegen write --delete --show-ts-errors --use-cache",
        "typegen:write:no-cache": "cd .. && NODE_OPTIONS=--max-old-space-size=16384 kea-typegen write --delete --show-ts-errors",
        "schema:build:json": "ts-node ./bin/build-schema-json.mjs && oxfmt ./src/queries/schema.json && ts-node ./bin/build-validators.mjs && oxfmt ./src/queries/validators.js ./src/queries/web-analytics-validators.js",
        "test": "SHARD_IDX=${SHARD_INDEX:-1}; SHARD_TOTAL=${SHARD_COUNT:-1}; echo $SHARD_IDX/$SHARD_TOTAL; pnpm build:products && jest --testPathPattern='(frontend/|products/|common/|packages/quill/|packages/llm-normalizer/)' --forceExit --shard=$SHARD_IDX/$SHARD_TOTAL",
        "jest": "pnpm build:products && jest",
        "typescript:check": "node ./bin/typescript-check.mjs",
        "typescript:version": "tsgo --version",
        "lint": "cd .. && oxlint --quiet",
        "lint:fix": "cd .. && oxlint --fix --quiet",
        "format": "cd .. && oxfmt \"./{products,frontend/src,docs}/**/*.{js,mjs,ts,tsx,json,yaml,yml,css,scss}\"",
        "format:check": "cd .. && oxfmt --check \"./{products,frontend/src,docs}/**/*.{js,mjs,ts,tsx,json,yaml,yml,css,scss}\"",
        "fix": "pnpm lint:fix; s=$?; pnpm format && exit $s",
        "visualize-toolbar-bundle": "pnpm exec esbuild-visualizer --metadata ./toolbar-esbuild-meta.json --filename=toolbar-esbuild-bundle-visualization.html",
        "check-toolbar-csp-eval": "node ./bin/check-toolbar-csp-eval.mjs",
        "check-color-tokens": "node ./bin/check-color-tokens.mjs",
        "check-toolbar-graph": "node ./bin/check-toolbar-graph.mjs",
        "check-toolbar-size": "node ./bin/check-toolbar-size.mjs",
        "start-vite": "pnpm build:products && concurrently --kill-others-on-fail -n VITE,TOOLBAR,WORKERS -c green,magenta,cyan \"vite --host 0.0.0.0\" \"pnpm watch:toolbar-floating\" \"pnpm watch:workers\"",
        "watch:workers": "node ./bin/watch-workers.mjs --dev",
        "build:toolbar-floating": "node ./bin/build-toolbar.mjs",
        "watch:toolbar-floating": "node ./bin/build-toolbar.mjs --dev",
        "build:toolbar-extension": "node ./bin/build-toolbar-extension.mjs",
        "watch:toolbar-extension": "node ./bin/build-toolbar-extension.mjs --dev",
        "build:toolbar-all": "pnpm build:toolbar-floating && pnpm build:toolbar-extension",
        "watch:toolbar-all": "concurrently --kill-others-on-fail -n FLOATING,EXTENSION -c magenta,blue \"pnpm watch:toolbar-floating\" \"pnpm watch:toolbar-extension\"",
        "mobile-replay:web:schema:build:json": "ts-json-schema-generator -f ./tsconfig.json --path 'node_modules/posthog-js/dist/rrweb-types.d.ts' --type 'eventWithTime' --expose all --no-top-ref --no-type-check --out ./src/scenes/session-recordings/mobile-replay/schema/web/rr-web-schema.json && oxfmt ./src/scenes/session-recordings/mobile-replay/schema/web/rr-web-schema.json",
        "mobile-replay:mobile:schema:build:json": "ts-json-schema-generator -f ./tsconfig.json --path './src/scenes/session-recordings/mobile-replay/mobile.types.ts' --type 'mobileEventWithTime' --expose all --no-top-ref --no-type-check --out ./src/scenes/session-recordings/mobile-replay/schema/mobile/rr-mobile-schema.json && oxfmt ./src/scenes/session-recordings/mobile-replay/schema/mobile/rr-mobile-schema.json",
        "mobile-replay:schema:build:json": "pnpm mobile-replay:web:schema:build:json && pnpm mobile-replay:mobile:schema:build:json",
        "build:survey-sdk-docs": "TS_NODE_BASEURL=.. ts-node -r tsconfig-paths/register --transpile-only -O '{\"rootDir\":\".\"}' ./bin/docs/build-survey-sdk-docs.ts"
    },
